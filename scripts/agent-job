#!/usr/bin/env python3
"""Run a long Kandelo build or test in the background and wait on it by PID.

Why it exists: long builds and suites (./run.sh setup, local-build, full
vitest, the conformance runners) take 10-40 minutes, and waiting on them was
one of the largest token costs in agent sessions. In Aug-Sep 2026, about 849M
input-equivalent tokens went to poll turns (`sleep 60; tail log`), each of
which re-reads the whole conversation. 370 waits used `until ! pgrep -f
<pattern>`, which matches the waiting shell itself and never returns, and
second runs started in the same checkout broke the first. This tool removes
those choices:

  agent-job start [--name N] [--allow-concurrent] -- <command...>
      Start <command> (run by bash in the current directory) detached, with
      its output in a log file. Prints the job id. Several words run as
      that exact argv; one quoted word runs as a shell string. Refuses to
      start a second locked run (vitest, run.sh test, ci-run-test-suite.sh,
      npm ci, setup, local-build) while one is running in the same worktree.
  agent-job wait <id> [--timeout SECONDS]
  agent-job wait --peer <text> [--timeout SECONDS]
      Block until the job ends (keyed on its supervisor PID), then print the
      result and exit with the job's exit status. The default timeout, 540 s,
      stays under the Bash tool's 10-minute limit; on timeout it prints status
      and exits 124, and you run the same command again. One call per
      9 minutes, instead of a poll every few seconds. --timeout 0 waits
      without limit, for an interactive main session that runs it with
      run_in_background and ends its turn. Never end your turn to wait in a
      headless (claude -p) session or a subagent: they stop when the turn
      ends.
      Another worktree's job (another Conductor workspace's build) works the
      same way: find it with `list --all` and wait on its id. That is
      supported, and is the right tool instead of a `kill -0` or `pgrep`
      loop on its PID. --peer <text> picks the one running job, in any
      worktree, whose command contains <text> (for example `local-build` or
      `prepare-browser`). If none or several match, it lists them on stderr
      and exits 2 rather than guess.
  agent-job status [<id>]
      What is running: elapsed vs the usual duration, log age, local-build
      node progress, and every process in the job with command line and age.
      Also the job's worktree and git commit, and how that commit relates to
      your HEAD.
  agent-job result <id>
      Exit status, duration, the [suite-health] lines if any, and the last
      lines of the log.
  agent-job list [--all]
      Recent jobs in this worktree. --all lists every worktree's jobs on
      this machine, with each job's worktree, commit, and how that commit
      relates to your HEAD (same, ancestor, descendant, diverged), so you
      can tell whether a peer's build is of the tree you are on.

State lives in ~/.cache/kandelo/agent-jobs (override: KANDELO_AGENT_JOBS_DIR):
one directory per job and an append-only ledger.jsonl of finished jobs, which
evals/build-waiting/wait-impact.py reads to judge whether this tool helps.

Why Python rather than an xtask verb (the usual choice for new tools): the
waiting tool must work while xtask itself is being edited or rebuilt, and in a
fresh worktree before anything has been compiled. It uses the standard
library only.
"""
import argparse
import json
import os
import re
import shlex
import signal
import statistics
import subprocess
import sys
import time

ROOT = os.path.expanduser(os.environ.get("KANDELO_AGENT_JOBS_DIR", "~/.cache/kandelo/agent-jobs"))
JOBS = os.path.join(ROOT, "jobs")
LEDGER = os.path.join(ROOT, "ledger.jsonl")
# Runs that execute vitest's global setup, npm ci, or the local-build engine.
# Two of these in one worktree at once race on program-packages.json,
# node_modules, or the local-binaries tier.
LOCKED = re.compile(r"npx\s+vitest|node_modules/\.bin/vitest|\bvitest\s+run|run\.sh\s+(test|setup|local-build|"
                    r"prepare-browser)\b|ci-run-test-suite\.sh|suite-baseline\.mjs|\bnpm\s+ci\b|"
                    r"xtask\s+(local-build|bootstrap)|scripts/setup\.sh")
# What an agent reads after a run: enough of the log to see how it ended,
# without pulling a 100k-line build log into the conversation.
LOG_TAIL = 30


def now():
    return time.time()


def fmt_secs(s):
    s = int(s)
    return f"{s // 3600}h{s % 3600 // 60:02d}m" if s >= 3600 else f"{s // 60}m{s % 60:02d}s"


def git(*args, cwd):
    try:
        return subprocess.run(["git", *args], cwd=cwd, capture_output=True, check=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return None


def worktree_of(cwd):
    top = git("rev-parse", "--show-toplevel", cwd=cwd)
    return top.decode().strip() if top else os.path.realpath(cwd)


# How many uncommitted paths a job records; enough to judge whether they
# matter (a submodule's generated files vs. kernel sources), not a full diff.
DIRTY_PATHS_KEPT = 20


def tree_state(cwd):
    """(HEAD commit, uncommitted tracked paths) of the checkout at cwd.

    Recorded at `start` so an agent can decide whether another workspace's
    build is of the tree it is on before it waits on that build or reuses its
    cache. Untracked files are left out: every worktree has some (.context/,
    editor state), and counting them would mark every job dirty. Either value
    is None when git cannot answer.
    """
    head = git("rev-parse", "--verify", "-q", "HEAD", cwd=cwd)
    if not head:
        return None, None
    st = git("status", "--porcelain", "--untracked-files=no", cwd=cwd)
    paths = None if st is None else [l[3:] for l in st.decode(errors="replace").splitlines() if l.strip()]
    return head.decode().strip(), paths


_relations = {}


def relation(job_head, my_head, cwd):
    """How a job's commit relates to the caller's HEAD: (kind, job_only, mine_only).

    kind is same, ancestor (the job built an older commit of your history),
    descendant (a newer one), diverged, unrelated (no common history), or
    unknown (no recorded commit, or one this repository does not have). All
    worktrees of a clone share one object store, so a peer's commit resolves
    here even when it was never checked out here.
    """
    if not job_head or not my_head:
        return "unknown", None, None
    if job_head == my_head:
        return "same", 0, 0
    if (job_head, my_head) not in _relations:
        out = ("unknown", None, None)
        if git("cat-file", "-e", f"{job_head}^{{commit}}", cwd=cwd) is not None:
            if git("merge-base", job_head, my_head, cwd=cwd) is None:
                out = ("unrelated", None, None)
            else:
                counts = git("rev-list", "--left-right", "--count", f"{job_head}...{my_head}", cwd=cwd)
                theirs, mine = (int(x) for x in counts.split()) if counts else (None, None)
                kind = "ancestor" if theirs == 0 else "descendant" if mine == 0 else "diverged"
                out = (kind, theirs, mine)
        _relations[(job_head, my_head)] = out
    return _relations[(job_head, my_head)]


def commits(n):
    return f"{n} commit" + ("" if n == 1 else "s")


def relation_short(rel):
    kind, theirs, mine = rel
    return {"same": "same", "ancestor": f"{mine} behind", "descendant": f"{theirs} ahead",
            "diverged": f"diverged +{theirs}/-{mine}"}.get(kind, kind)


def commit_label(meta):
    # `abc1234*` = uncommitted tracked changes when the job started;
    # `abc1234?` = a job recorded before the dirty flag existed.
    head = meta.get("head")
    if not head:
        return "-"
    dirty = meta.get("dirty")
    return head[:9] + ("*" if dirty else "?" if dirty is None else "")


def describe_commit(meta, cwd):
    """One line for `status` and `result`: the job's commit and its relation to yours."""
    head = meta.get("head")
    if not head:
        return "commit: not recorded (the job predates agent-job recording it)"
    dirty = meta.get("dirty")
    paths = meta.get("dirty_paths") or []
    if dirty is None:
        tree = "uncommitted changes not recorded"
    elif dirty:
        more = f", +{len(paths) - 5} more" if len(paths) > 5 else ""
        tree = f"uncommitted changes in {', '.join(paths[:5])}{more}"
    else:
        tree = "clean"
    my_head, my_paths = tree_state(cwd)
    kind, theirs, mine = rel = relation(head, my_head, cwd)
    if kind == "same":
        vs = "the same commit as your HEAD"
    elif kind == "ancestor":
        vs = f"an ancestor of your HEAD ({commits(mine)} behind it)"
    elif kind == "descendant":
        vs = f"a descendant of your HEAD ({commits(theirs)} ahead of it)"
    elif kind == "diverged":
        vs = f"diverged from your HEAD ({commits(theirs)} only it has, {mine} only yours has)"
    elif kind == "unrelated":
        vs = "unrelated to your HEAD (no common history)"
    elif not my_head:
        vs = "not comparable (you are not in a git checkout)"
    else:
        vs = "not in this repository's history"
    yours = "; your tree has uncommitted changes" if my_paths else ""
    return f"commit: {head[:12]} ({tree}), {vs}{yours}"


WRAPPERS = re.compile(r"^(\S*dev-shell\.sh|bash|sh|-c|-lc|-euo|pipefail|nohup|env|time|exec)$")


def job_key(cmd):
    """A stable name for "the same kind of run", for duration history.

    The first three words of the command that does the work, without
    wrappers (dev-shell.sh, bash -c, timeout N), env assignments, `cd`, or
    redirections: `./run.sh setup`, `scripts/ci-run-test-suite.sh vitest`,
    `npx vitest run`. Wrappers are dropped so that the same build started
    different ways shares one history, instead of each spelling starting
    from nothing.
    """
    words = []
    for part in re.split(r"&&|\|\||[;|\n]", cmd.replace("'", " ").replace('"', " ")):
        toks = [w for w in re.split(r"\s\d?>\S*", part)[0].split()]
        while toks:
            if WRAPPERS.match(toks[0]) or re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", toks[0]):
                toks.pop(0)
            elif toks[0] == "timeout":
                toks = toks[2:]
            else:
                break
        if not toks or toks[0] in ("cd", "set", "export", "echo", "true", ":"):
            continue
        words = toks
        break
    return " ".join(words[:3])


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def alive(pid):
    # kill(pid, 0) asks "does this exact process exist?". Waiting on a PID,
    # never on a name pattern, is the point of this tool: `pgrep -f
    # "<pattern>"` also matches the shell running the wait, so such waits
    # never ended.
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True


def history(key, limit=7):
    # Durations of past successful runs of the same kind (see job_key). They
    # let `start` and `status` say "usually takes 18m", which answers "is it
    # stuck?" without spending turns on process and log probes.
    out = []
    try:
        with open(LEDGER) as f:
            for line in f:
                try:
                    r = json.loads(line)
                except ValueError:
                    continue
                if r.get("key") == key and r.get("exit_code") == 0 and r.get("duration"):
                    out.append(r["duration"])
    except OSError:
        pass
    return out[-limit:]


def usual_duration(key):
    # One past run is an anecdote; require two before claiming a "usual".
    h = history(key)
    return statistics.median(h) if len(h) >= 2 else None


def job_dir(job_id):
    d = os.path.join(JOBS, job_id)
    if not os.path.isdir(d):
        sys.exit(f"agent-job: no such job {job_id!r} (see `agent-job list`)")
    return d


def state_of(d):
    meta = read_json(os.path.join(d, "meta.json")) or {}
    result = read_json(os.path.join(d, "result.json"))
    if result:
        return "finished", meta, result
    if meta.get("supervisor_pid") and alive(meta["supervisor_pid"]):
        return "running", meta, None
    # The supervisor died without recording an exit status (machine sleep,
    # kill -9). Report that plainly: treating it as "still running" would
    # make an agent wait forever, and treating it as success would be false.
    return "lost", meta, None


def jobs_in(worktree):
    """(id, dir) of the jobs started in worktree, oldest first; None means every worktree."""
    out = []
    try:
        names = os.listdir(JOBS)
    except OSError:
        return out
    for name in names:
        d = os.path.join(JOBS, name)
        meta = read_json(os.path.join(d, "meta.json"))
        if meta and (worktree is None or meta.get("worktree") == worktree):
            out.append((meta.get("started", 0), name, d))
    return [x[1:] for x in sorted(out)]


# ---------------------------------------------------------------- supervisor

def supervise(d):
    """Detached process: run the command, then record its result.

    A separate supervisor, not the agent's own shell, owns the run. The
    agent's Bash call can then return, time out, or be interrupted without
    killing the build. The exit status is written to result.json, so `wait`,
    `result`, and the ledger outlive the process that produced it.
    """
    meta = read_json(os.path.join(d, "meta.json"))
    log = open(os.path.join(d, "output.log"), "ab", buffering=0)
    # KANDELO_LOCAL_BUILD_EVENTS asks local-build/setup to write progress
    # events, which `status` reads. That replaces turns spent probing
    # processes and log sizes to guess how far along a build is.
    env = dict(os.environ, KANDELO_LOCAL_BUILD_EVENTS=os.path.join(d, "events.jsonl"),
               KANDELO_AGENT_JOB=meta["id"])
    # Its own session/process group, so a stop request can reach every
    # process the build spawned (cargo, clang, node workers), not just bash.
    child = subprocess.Popen(["bash", "-c", meta["cmd"]], cwd=meta["cwd"], stdin=subprocess.DEVNULL,
                             stdout=log, stderr=subprocess.STDOUT, env=env, start_new_session=True)
    # `start` writes meta.json a second time, to add supervisor_pid, after
    # this process exists. Merge child_pid into that write, not into the
    # copy read above: writing the stale copy could drop supervisor_pid, and
    # a running job would then read as LOST. Once supervisor_pid is in the
    # file, `start` never writes again.
    deadline = now() + 10
    while not meta.get("supervisor_pid") and now() < deadline:
        time.sleep(0.02)
        meta = read_json(os.path.join(d, "meta.json")) or meta
    meta["supervisor_pid"] = os.getpid()
    meta["child_pid"] = child.pid
    write_json(os.path.join(d, "meta.json"), meta)

    # Forward a stop to the whole build group. A wrapper that dies alone
    # leaves the build running and holding the checkout, and the next run
    # then collides with an orphan nobody is waiting on. SIGHUP is ignored
    # because the agent's terminal or shell going away must not kill a
    # 40-minute build halfway.
    def forward(sig, _frame):
        try:
            os.killpg(child.pid, signal.SIGTERM)
        except OSError:
            pass
    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGINT, forward)
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    code = child.wait()
    end = now()
    result = dict(
        exit_code=code if code >= 0 else 128 - code,
        signal=-code if code < 0 else None,
        ended=end,
        duration=round(end - meta["started"], 1),
    )
    write_json(os.path.join(d, "result.json"), result)
    # The ledger is how evals/build-waiting/wait-impact.py judges whether this
    # tool earns its place, and how history() learns usual durations.
    record = {k: meta.get(k) for k in ("id", "name", "key", "cmd", "cwd", "worktree", "head", "dirty", "started",
                                       "usual_duration")}
    record.update(result)
    os.makedirs(ROOT, exist_ok=True)
    with open(LEDGER, "a") as f:
        f.write(json.dumps(record) + "\n")


def write_json(path, value):
    # Write-then-rename, so a reader (wait, status) never sees half a file
    # and mistakes a running job for a lost one. The temporary name is per
    # process: `start` and the supervisor both write meta.json.
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f:
        json.dump(value, f, indent=1)
    os.replace(tmp, path)


# ---------------------------------------------------------------- commands

def shell_command(words):
    """The bash -c string that runs what the caller wrote after `--`.

    Two forms, both documented:
      start -- ./run.sh setup                       several words: an argv
      start -- "cd host && npx vitest run"          one word: a shell string
    Several words are an argv the caller's shell already parsed, so they are
    re-quoted to reach bash unchanged. A plain-space join dropped that
    quoting: `start -- scripts/dev-shell.sh bash -c 'cd host && npx vitest'`
    ran `bash -c cd` inside the dev shell and the vitest run outside it, from
    the repo root, and every result of that run was invalid. One word is kept
    verbatim, so pipes, `&&` and redirections in it work as typed.
    """
    return shlex.join(words) if len(words) > 1 else words[0]


def cmd_start(args):
    if not args.command:
        sys.exit("agent-job start: give the command after --")
    cmd = shell_command(args.command)
    cwd = os.getcwd()
    worktree = worktree_of(cwd)
    # Refuse a second locked run instead of letting it start. Two such runs
    # fail each other (program-index races alone did so 44 times in Aug-Sep
    # 2026), wasting both runs plus the diagnosis and a re-run.
    if LOCKED.search(cmd) and not args.allow_concurrent:
        for job_id, d in jobs_in(worktree):
            state, meta, _ = state_of(d)
            if state == "running" and LOCKED.search(meta.get("cmd", "")):
                sys.exit(f"agent-job: refusing to start: {job_id} is already running a locked run in "
                         f"{worktree} ({meta['cmd'][:120]}, {fmt_secs(now() - meta['started'])} so far).\n"
                         f"Two such runs race on program-packages.json, node_modules or local-binaries. "
                         f"Wait for it (`agent-job wait {job_id}`), or pass --allow-concurrent if this "
                         f"run truly touches none of those.")
    key_words = job_key(cmd).split()
    default_name = " ".join([os.path.basename(key_words[0])] + key_words[1:]) if key_words else "job"
    name = re.sub(r"[^A-Za-z0-9._-]+", "-", args.name or default_name)[:40].strip("-.") or "job"
    job_id = f"{name}-{time.strftime('%m%d-%H%M%S')}-{os.urandom(2).hex()}"
    d = os.path.join(JOBS, job_id)
    os.makedirs(d)
    key = job_key(cmd)
    head, dirty_paths = tree_state(cwd)
    meta = dict(id=job_id, name=name, key=key, cmd=cmd, cwd=cwd, worktree=worktree, started=now(),
                usual_duration=usual_duration(key), head=head,
                dirty=None if dirty_paths is None else bool(dirty_paths),
                dirty_paths=(dirty_paths or [])[:DIRTY_PATHS_KEPT])
    write_json(os.path.join(d, "meta.json"), meta)
    # Detach the supervisor fully: new session, no inherited stdio, so the
    # Bash tool call that ran `start` returns immediately instead of
    # blocking on the build's output.
    sup = subprocess.Popen([sys.executable, os.path.abspath(__file__), "_supervise", d],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           start_new_session=True, close_fds=True)
    meta["supervisor_pid"] = sup.pid
    write_json(os.path.join(d, "meta.json"), meta)
    usual = f"; usually takes {fmt_secs(meta['usual_duration'])}" if meta["usual_duration"] else ""
    print(f"{job_id}\nlog: {os.path.join(d, 'output.log')}{usual}\n"
          f"wait with: {sys.argv[0]} wait {job_id}   (repeat if it exits 124; do not poll)")


def peer_job(text):
    """The one running job, in any worktree, whose command contains text.

    Exits 2 when none or several match, listing them. Picking "the newest"
    of several would wait on a build the agent did not choose, and a wrong
    build's result is worse than a question.
    """
    rows = []
    for job_id, d in jobs_in(None):
        state, meta, _ = state_of(d)
        if state == "running" and text in meta.get("cmd", ""):
            rows.append((job_id, d, meta))
    if len(rows) == 1:
        return rows[0][:2]
    if not rows:
        print(f"agent-job: --peer {text!r}: no running job's command contains it. "
              f"See `agent-job list --all`.", file=sys.stderr)
    else:
        print(f"agent-job: --peer {text!r} matches {len(rows)} running jobs; wait on one by id "
              f"(`agent-job wait <id>`) or give longer text:", file=sys.stderr)
        for job_id, _, meta in rows:
            print(f"  {job_id}  {os.path.basename(meta.get('worktree', ''))}  {meta.get('cmd', '')[:100]}",
                  file=sys.stderr)
    sys.exit(2)


def cmd_wait(args):
    # The waiting happens inside this one process, checking the PID every
    # 2 s. That costs no tokens: the agent spends one tool call per --timeout
    # window (9 minutes by default), however many checks happen inside it.
    if (args.id is None) == (args.peer is None):
        print("agent-job wait: give either a job id or --peer <text>", file=sys.stderr)
        sys.exit(2)
    if args.peer is not None:
        args.id, d = peer_job(args.peer)
        meta = read_json(os.path.join(d, "meta.json")) or {}
        # Name the chosen job up front, so the agent knows which build it
        # waited on (and can re-run `wait <id>` by id after an exit 124).
        print(f"waiting on {args.id} in {meta.get('worktree', '?')}: {meta.get('cmd', '')[:120]}")
        print(describe_commit(meta, os.getcwd()), flush=True)
    else:
        d = job_dir(args.id)
    deadline = now() + args.timeout if args.timeout else None
    while True:
        state, meta, result = state_of(d)
        if state != "running":
            break
        if deadline and now() >= deadline:
            print(f"agent-job: still running after {args.timeout}s of waiting; run the same wait again "
                  f"(exit 124 means not finished, not failed)\n")
            print_status(args.id, d)
            sys.exit(124)
        time.sleep(2)
    sys.exit(print_result(args.id, d))


def print_result(job_id, d):
    state, meta, result = state_of(d)
    log = os.path.join(d, "output.log")
    if state == "lost":
        print(f"{job_id}: LOST — the supervisor died without recording an exit status. "
              f"Treat the run as failed; log: {log}")
        return 125
    if state == "running":
        print(f"{job_id}: still running ({fmt_secs(now() - meta['started'])}); log: {log}")
        return 124
    code = result["exit_code"]
    verdict = "succeeded" if code == 0 else f"FAILED (exit {code}" + (
        f", signal {result['signal']})" if result.get("signal") else ")")
    print(f"{job_id}: {verdict} after {fmt_secs(result['duration'])}")
    print(f"command: {meta['cmd']}")
    print_where(meta)
    lines = tail_lines(log, 4000)
    health = [l for l in lines[:-LOG_TAIL] if "[suite-health]" in l]
    for l in health[-8:]:
        print(l)
    print(f"--- last {LOG_TAIL} log lines ({log}) ---")
    for l in lines[-LOG_TAIL:]:
        print(l)
    return code


def print_where(meta):
    cwd = os.getcwd()
    if meta.get("worktree") and meta["worktree"] != worktree_of(cwd):
        print(f"worktree: {meta['worktree']} (not yours)")
    print(describe_commit(meta, cwd))


def tail_lines(path, n):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            size = f.tell()
            f.seek(max(0, size - 512 * 1024))
            data = f.read().decode(errors="replace")
    except OSError:
        return []
    data = re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", data)
    return data.splitlines()[-n:]


def processes():
    # Every process with its parent, age, CPU and full command line. A
    # liveness claim needs all three: a stale or unrelated process (another
    # worktree's build, an MCP server) once passed for "the run" because
    # only its name or count was checked.
    #
    # Inside scripts/dev-shell.sh, PATH has no `ps`, and a crash here turned
    # `wait`'s exit 124 ("still running") into exit 1. So fall back to the
    # system's ps, and without one show no process list (None) instead.
    for ps in ("ps", "/bin/ps", "/usr/bin/ps"):
        try:
            out = subprocess.run([ps, "-axo", "pid=,ppid=,etime=,pcpu=,command="], capture_output=True,
                                 text=True).stdout
            break
        except OSError:
            continue
    else:
        return None
    procs = {}
    for line in out.splitlines():
        parts = line.split(None, 4)
        if len(parts) == 5 and parts[0].isdigit():
            procs[int(parts[0])] = dict(ppid=int(parts[1]), etime=parts[2], cpu=parts[3], cmd=parts[4])
    return procs


def descendants(root, procs):
    kids = {}
    for pid, p in procs.items():
        kids.setdefault(p["ppid"], []).append(pid)
    out, stack = [], [(root, 0)]
    while stack:
        pid, depth = stack.pop()
        if pid in procs:
            out.append((depth, pid, procs[pid]))
        for k in sorted(kids.get(pid, []), reverse=True):
            stack.append((k, depth + 1))
    return out


def events_progress(path):
    # Turns local-build's event stream into "143/154 nodes done, running X
    # for 4m", the answer agents otherwise assembled from several probe
    # turns.
    """Summarize local-build scheduler events (written when KANDELO_LOCAL_BUILD_EVENTS is set)."""
    state = {}
    total = None
    try:
        with open(path) as f:
            for line in f:
                try:
                    e = json.loads(line)
                except ValueError:
                    continue
                if e.get("event") == "plan":
                    total = e.get("nodes")
                elif e.get("node"):
                    state[e["node"]] = (e.get("event"), e.get("at"))
    except OSError:
        return None
    done = sum(1 for s, _ in state.values() if s in ("succeeded", "cached", "reused"))
    failed = [n for n, (s, _) in state.items() if s == "failed"]
    blocked = sum(1 for s, _ in state.values() if s == "blocked")
    running = [(n, at) for n, (s, at) in state.items() if s == "running"]
    return dict(total=total, done=done, failed=failed, blocked=blocked, running=running)


def print_status(job_id, d):
    state, meta, result = state_of(d)
    if state != "running":
        print_result(job_id, d)
        return
    log = os.path.join(d, "output.log")
    elapsed = now() - meta["started"]
    usual = meta.get("usual_duration")
    print(f"{job_id}: running {fmt_secs(elapsed)}" + (f" (usually {fmt_secs(usual)})" if usual else ""))
    print(f"command: {meta['cmd']}")
    print_where(meta)
    try:
        age = now() - os.path.getmtime(log)
        print(f"log: {log} (last write {fmt_secs(age)} ago)")
    except OSError:
        print(f"log: {log} (not written yet)")
    prog = events_progress(os.path.join(d, "events.jsonl"))
    if prog:
        total = prog["total"] or "?"
        print(f"local-build: {prog['done']}/{total} nodes done, {len(prog['failed'])} failed, "
              f"{prog['blocked']} blocked")
        for n, at in prog["running"]:
            print(f"  running {n}" + (f" ({fmt_secs(now() - at)})" if at else ""))
        if prog["failed"]:
            print(f"  failed: {', '.join(prog['failed'][:8])}")
    procs = processes()
    if procs is None:
        print("processes: unavailable (no ps found)")
        procs = {}
    tree = descendants(meta.get("child_pid") or meta["supervisor_pid"], procs)
    print(f"processes ({len(tree)}; pid, age, cpu%, command):")
    for depth, pid, p in tree[:25]:
        print(f"  {'  ' * depth}{pid} {p['etime']} {p['cpu']}% {p['cmd'][:150]}")
    if len(tree) > 25:
        print(f"  ... {len(tree) - 25} more")
    last = [l for l in tail_lines(log, 3) if l.strip()]
    if last:
        print(f"last log line: {last[-1][:200]}")


def cmd_status(args):
    if args.id:
        print_status(args.id, job_dir(args.id))
        return
    worktree = worktree_of(os.getcwd())
    running = [(j, d) for j, d in jobs_in(worktree) if state_of(d)[0] == "running"]
    if not running:
        print(f"no running jobs in {worktree}")
    for j, d in running:
        print_status(j, d)
        print()


def cmd_result(args):
    sys.exit(print_result(args.id, job_dir(args.id)))


def cmd_list(args):
    cwd = os.getcwd()
    worktree = worktree_of(cwd)
    rows = jobs_in(None if args.all else worktree)[-args.limit:]
    if not rows:
        print("no jobs" if args.all else f"no jobs in {worktree}")
        return
    if args.all:
        my_head, my_paths = tree_state(cwd)
        print(f"your HEAD: {my_head[:9] + ('*' if my_paths else '') if my_head else 'none (not a git checkout)'}; "
              f"commit* = uncommitted changes at start, ? = not recorded; "
              f"'N behind' = an ancestor of your HEAD, 'N ahead' = a descendant, "
              f"'diverged +A/-B' = A commits only it has, B only yours has")
        w = max(len(j) for j, _ in rows)
        print(f"{'job':{w}s} {'state':20s} {'worktree':18s} {'commit':10s} {'vs your HEAD':18s} command")
    for j, d in rows:
        state, meta, result = state_of(d)
        if state == "finished":
            extra = f"exit {result['exit_code']} in {fmt_secs(result['duration'])}"
        elif state == "running":
            extra = f"running {fmt_secs(now() - meta['started'])}"
        else:
            extra = "LOST"
        if args.all:
            rel = relation_short(relation(meta.get("head"), my_head, cwd)) if meta.get("head") else "-"
            wt = os.path.basename(meta.get("worktree") or "?")
            print(f"{j:{w}s} {extra:20s} {wt[:18]:18s} {commit_label(meta):10s} {rel:18s} {meta.get('cmd', '')[:80]}")
        else:
            print(f"{j:48s} {extra:28s} {meta.get('cmd', '')[:80]}")


def main():
    if len(sys.argv) == 3 and sys.argv[1] == "_supervise":
        supervise(sys.argv[2])
        return
    # --help shows the command reference from this file's docstring, so the
    # help and the docstring cannot drift apart.
    ref = __doc__[__doc__.index("  agent-job start"):__doc__.index("Why Python")].rstrip()
    ap = argparse.ArgumentParser(prog="agent-job", description=__doc__.split("\n\n")[0], epilog=ref,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="sub", required=True)
    p = sub.add_parser("start", help="run a command detached; prints the job id")
    p.add_argument("--name")
    p.add_argument("--allow-concurrent", action="store_true")
    p.add_argument("command", nargs=argparse.REMAINDER)
    p = sub.add_parser("wait", help="block until a job ends (any worktree's job)")
    p.add_argument("id", nargs="?")
    p.add_argument("--peer", metavar="TEXT", help="wait on the one running job, in any worktree, whose command "
                   "contains TEXT; exits 2 if none or several match")
    # 540 s keeps one wait inside the Bash tool's 10-minute limit. A wait
    # the tool kills is pushed to the background, and a headless session or
    # subagent that then ends its turn loses the result.
    p.add_argument("--timeout", type=int, default=540, help="seconds (default 540, under the Bash tool limit); "
                   "0 waits until the job ends")
    p = sub.add_parser("status", help="progress, processes, and commit of running jobs")
    p.add_argument("id", nargs="?")
    p = sub.add_parser("result", help="exit status and log tail of a finished job")
    p.add_argument("id")
    p = sub.add_parser("list", help="recent jobs in this worktree (--all: every worktree)")
    p.add_argument("--limit", type=int, default=15)
    p.add_argument("--all", action="store_true", help="jobs from every worktree on this machine, with worktree, "
                   "commit, and relation to your HEAD")
    args = ap.parse_args()
    if args.sub == "start" and args.command and args.command[0] == "--":
        args.command = args.command[1:]
    {"start": cmd_start, "wait": cmd_wait, "status": cmd_status, "result": cmd_result, "list": cmd_list}[args.sub](args)


if __name__ == "__main__":
    main()
