#!/usr/bin/env python3
"""Validate fragments, prepare dated updates, and assemble the public changelog."""
import argparse
from datetime import date
import json
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import tomllib

ROOT = Path(__file__).resolve().parent.parent
HEADER = """# Kandelo changelog

What you can build, run, and do with Kandelo. Each dated update collects
highlights, improvements, and compatibility notes.

<!-- Generated by scripts/changelog assemble; edit changelog/updates/*.md. -->
"""
META = "<!-- kandelo-update "


def git(*args):
    return subprocess.check_output(["git", *args], cwd=ROOT, text=True).strip()


def categories():
    config = tomllib.loads((ROOT / "towncrier.toml").read_text())
    return {item["directory"] for item in config["tool"]["towncrier"]["type"]}


def read_fragment(path):
    text = path.read_text().strip()
    nomination = None
    lines = text.splitlines()
    if lines and lines[0] == "+++":
        try:
            end = lines.index("+++", 1)
        except ValueError:
            raise ValueError(f"unclosed fragment metadata: {path.name}") from None
        metadata = tomllib.loads("\n".join(lines[1:end]))
        if set(metadata) != {"headline", "highlight"}:
            raise ValueError(f"highlight metadata needs only headline and highlight: {path.name}")
        for key in ("headline", "highlight"):
            if not isinstance(metadata[key], str) or not metadata[key].strip():
                raise ValueError(f"{key} must be nonempty text: {path.name}")
        headline = metadata["headline"].strip()
        if "\n" in headline or "\r" in headline:
            raise ValueError(f"headline must fit on one line: {path.name}")
        nomination = (headline, " ".join(metadata["highlight"].split()))
        text = "\n".join(lines[end + 1:]).strip()
    if not text:
        raise ValueError(f"empty fragment: {path.name}")
    return text, nomination


def fragments():
    result = []
    for path in sorted((ROOT / "changelog.d").iterdir()):
        if path.name == "README.md":
            continue
        if path.is_symlink() or not path.is_file():
            raise ValueError(f"not a regular fragment: {path.name}")
        if not re.fullmatch(r"(?:[1-9][0-9]*|\+[a-z0-9][a-z0-9-]*)\.[a-z]+", path.name):
            raise ValueError(f"invalid fragment name: {path.name}")
        if path.suffix[1:] not in categories():
            raise ValueError(f"unknown fragment category: {path.name}")
        read_fragment(path)
        result.append(path)
    return result


def update_id(value):
    if not re.fullmatch(r"[0-9]{4}\.[0-9]{2}\.[0-9]{2}", value):
        raise ValueError("update identifier must be YYYY.MM.DD")
    date.fromisoformat(value.replace(".", "-"))
    return value


def source_versions(source):
    snapshot = json.loads(git("show", f"{source}:abi/snapshot.json"))
    return snapshot["abi_version"], snapshot["host_adapter"]["manifest"]["required_host_adapter_version"]


def updates():
    result = []
    for path in sorted((ROOT / "changelog/updates").glob("*.md"), reverse=True):
        identifier = update_id(path.stem)
        if path.is_symlink():
            raise ValueError(f"not a regular update: {path.name}")
        text = path.read_text()
        first, _, body = text.partition("\n")
        if not first.startswith(META) or not first.endswith(" -->"):
            raise ValueError(f"missing update metadata: {path.name}")
        metadata = json.loads(first[len(META):-4])
        if metadata["id"] != identifier or not re.fullmatch(r"[0-9a-f]{40}", metadata["source"]):
            raise ValueError(f"invalid update metadata: {path.name}")
        git("merge-base", "--is-ancestor", metadata["source"], "HEAD")
        abi, host = source_versions(metadata["source"])
        if (metadata["program_abi"], metadata["kernel_host"]) != (abi, host):
            raise ValueError(f"versions differ from the source commit: {path.name}")
        if not body.lstrip().startswith(f"## {identifier}"):
            raise ValueError(f"missing dated heading: {path.name}")
        result.append((path, metadata, body.strip()))
    return result


def assembled():
    return HEADER + "\n" + "\n\n".join(body for _, _, body in updates()) + "\n"


def check(base=None, event=None):
    pending = fragments()
    updates()
    if (ROOT / "CHANGELOG.md").read_text() != assembled():
        raise ValueError("CHANGELOG.md is stale; run scripts/changelog assemble")
    if base:
        changed = git("diff", "--name-only", "--diff-filter=A", f"{base}...HEAD").splitlines()
        if not any(str(p.relative_to(ROOT)) in changed for p in pending):
            # Aggregation consumes entries already reviewed with their changes.
            if not any(re.fullmatch(r"changelog/updates/[0-9.]+\.md", p) for p in changed):
                payload = json.loads(Path(event).read_text()) if event else {}
                body = payload.get("pull_request", {}).get("body") or ""
                if not re.search(r"(?im)^Changelog: none[ \t]+\S[^\r\n]*$", body):
                    raise ValueError("add a fragment, or explain 'Changelog: none <reason>' in the PR body")
    print(f"Changelog valid: {len(pending)} pending fragment(s).", file=sys.stderr)


def prepare(day, preview):
    identifier = update_id(day.replace("-", "."))
    paths = fragments()
    if not paths:
        raise ValueError("no pending changelog fragments")
    existing = updates()
    if existing and identifier <= existing[0][1]["id"]:
        raise ValueError("update date must be later than the latest published entry")
    # The entries and compatibility versions must describe the same source.
    if git("status", "--porcelain", "--untracked-files=no"):
        raise ValueError("prepare requires a clean checkout; commit the changes and fragments first")
    for path in paths:
        git("ls-files", "--error-unmatch", str(path.relative_to(ROOT)))
    source = git("rev-parse", "HEAD")
    abi, host = source_versions(source)
    nominations = []
    with tempfile.TemporaryDirectory(prefix="kandelo-changelog-") as tmp:
        work = Path(tmp)
        shutil.copy(ROOT / "towncrier.toml", work)
        (work / "changelog.d").mkdir()
        for path in paths:
            news, nomination = read_fragment(path)
            (work / "changelog.d" / path.name).write_text(news + "\n")
            if nomination and nomination not in nominations:
                nominations.append(nomination)
        subprocess.run([
            str(ROOT / "scripts/changelog-tool"), "changelog-builder", "build",
            "--yes", "--version", identifier, "--date", day, "--dir", tmp,
        ], check=True, stdout=sys.stderr)
        heading, _, entries = (work / "CHANGELOG.md").read_text().partition("\n")
    highlights = ""
    if nominations:
        bullets = []
        for headline, summary in nominations:
            if not headline.endswith((".", "!", "?")):
                headline += "."
            bullets.append(f"- **{headline}** {summary}")
        highlights = "### Highlights\n\n" + "\n".join(bullets) + "\n\n"
        print(f"Collected {len(nominations)} nominated highlight(s); review the lead and selection.", file=sys.stderr)
    previous = existing[0][1]["source"] if existing else None
    links = f"[Source](https://github.com/Automattic/kandelo/commit/{source})"
    if previous:
        links += f" · [Full diff](https://github.com/Automattic/kandelo/compare/{previous}...{source})"
    body = f"{heading}\n\n{highlights}{entries.strip()}\n\n{links} · Program ABI **{abi}** · Kernel/host **{host}**\n"
    metadata = dict(id=identifier, source=source, program_abi=abi, kernel_host=host)
    if preview:
        print(body, end="")
        return
    destination = ROOT / "changelog/updates" / f"{identifier}.md"
    destination.write_text(META + json.dumps(metadata, sort_keys=True) + " -->\n\n" + body)
    (ROOT / "CHANGELOG.md").write_text(assembled())
    for path in paths:
        path.unlink()
    print(f"Prepared {identifier}; review the update and commit all changelog changes.")


def publish(identifier, repository):
    identifier = update_id(identifier)
    check()
    match = next((item for item in updates() if item[1]["id"] == identifier), None)
    if match is None:
        raise ValueError(f"unknown update: {identifier}")
    _, metadata, body = match
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repository):
        raise ValueError("repository must be owner/name")
    tag = f"kandelo-update-{identifier}"

    def api(endpoint):
        result = subprocess.run(["gh", "api", f"repos/{repository}/{endpoint}"],
                                capture_output=True, text=True)
        if result.returncode:
            if "HTTP 404" in result.stderr:
                return None
            raise ValueError(f"GitHub lookup failed: {result.stderr.strip()}")
        return json.loads(result.stdout)

    # Never move an existing tag or edit a published update on a retry.
    ref = api(f"git/ref/tags/{tag}")
    if ref is None:
        subprocess.run(["gh", "api", "--method", "POST", f"repos/{repository}/git/refs",
                        "-f", f"ref=refs/tags/{tag}", "-f", f"sha={metadata['source']}"],
                       check=True, stdout=sys.stderr)
    elif ref["object"]["type"] != "commit" or ref["object"]["sha"] != metadata["source"]:
        raise ValueError(f"existing tag {tag} does not identify the update source")
    release = api(f"releases/tags/{tag}")
    if release is not None:
        if release["draft"] or (release.get("body") or "").strip() != body:
            raise ValueError(f"existing release {tag} differs; refusing to overwrite it")
        print(f"Already published: {release['html_url']}")
        return
    with tempfile.TemporaryDirectory(prefix="kandelo-update-publish-") as tmp:
        notes = Path(tmp) / "notes.md"
        notes.write_text(body + "\n")
        subprocess.run(["gh", "release", "create", tag, "--repo", repository,
                        "--verify-tag", "--latest=false", "--title", f"Kandelo update {identifier}",
                        "--notes-file", str(notes)], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    validation = commands.add_parser("check")
    validation.add_argument("--base")
    validation.add_argument("--event")
    commands.add_parser("assemble")
    build = commands.add_parser("prepare")
    build.add_argument("--date", required=True, help="YYYY-MM-DD")
    build.add_argument("--preview", action="store_true")
    history = commands.add_parser("history")
    history.add_argument("revision", nargs="?", default="HEAD")
    notes = commands.add_parser("notes")
    notes.add_argument("id")
    publication = commands.add_parser("publish")
    publication.add_argument("id")
    publication.add_argument("--repo", required=True)
    args = parser.parse_args()
    if args.command == "check":
        check(args.base, args.event)
    elif args.command == "assemble":
        (ROOT / "CHANGELOG.md").write_text(assembled())
    elif args.command == "prepare":
        prepare(args.date, args.preview)
    elif args.command == "history":
        # Collapse artifact/archive tags so the inventory never mistakes those
        # releases for public updates or omits changes at those boundaries.
        refs = args.revision.split("..")
        if len(refs) > 2 or not all(refs):
            raise ValueError("history expects a commit or a two-dot commit range")
        revision = "..".join(git("rev-parse", "--verify", "--end-of-options", f"{ref}^{{commit}}") for ref in refs)
        subprocess.run([str(ROOT / "scripts/changelog-tool"), "git-cliff", "--config",
                        str(ROOT / "cliff.toml"), "--ignore-tags", ".*", revision],
                       cwd=ROOT, check=True)
    elif args.command == "notes":
        identifier = update_id(args.id)
        matches = [body for _, meta, body in updates() if meta["id"] == identifier]
        if not matches:
            raise ValueError(f"unknown update: {identifier}")
        print(matches[0])
    elif args.command == "publish":
        publish(args.id, args.repo)


if __name__ == "__main__":
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.CalledProcessError) as error:
        sys.exit(f"changelog: {error}")
