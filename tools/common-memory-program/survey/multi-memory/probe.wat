(module
 (import "env" "private" (memory $private 2 4 shared))
 (import "env" "shared" (memory $shared 2 4 shared))
 (func (export "private_load") (param $p i32) (result i32)
  (i32.load $private (local.get $p)))
 (func (export "private_store") (param $p i32) (param $v i32)
  (i32.store $private (local.get $p) (local.get $v)))
 (func (export "load") (param $p i32) (result i32)
  (if (result i32) (i32.lt_u (local.get $p) (i32.const -2147483648))
   (then (i32.load $private (local.get $p)))
   (else (i32.load $shared (i32.sub (local.get $p) (i32.const -2147483648))))))
 (func (export "store") (param $p i32) (param $v i32)
  (if (i32.lt_u (local.get $p) (i32.const -2147483648))
   (then (i32.store $private (local.get $p) (local.get $v)))
   (else (i32.store $shared (i32.sub (local.get $p) (i32.const -2147483648)) (local.get $v)))))
 (func (export "shared_add") (param $p i32) (param $v i32) (result i32)
  (i32.atomic.rmw.add 1 (local.get $p) (local.get $v)))
 (func (export "private_pages") (result i32) (memory.size $private))
 (func (export "shared_pages") (result i32) (memory.size $shared))
 (func (export "grow_private") (param i32) (result i32) (memory.grow $private (local.get 0)))
 (func (export "grow_shared") (param i32) (result i32) (memory.grow $shared (local.get 0)))
)
