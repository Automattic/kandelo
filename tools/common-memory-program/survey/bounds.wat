(module
 (import "env" "memory" (memory 2 65536 shared))
 (func (export "load32") (param i32) (result i32) local.get 0 i32.load)
 (func (export "store32") (param i32 i32) local.get 0 local.get 1 i32.store)
 (func (export "load32_small") (param i32) (result i32) local.get 0 i32.load offset=16)
 (func (export "store32_small") (param i32 i32) local.get 0 local.get 1 i32.store offset=16)
 (func (export "load8_max") (param i32) (result i32) local.get 0 i32.load8_u offset=4294967295)
 (func (export "load8") (param i32) (result i32) local.get 0 i32.load8_u)
 (func (export "load8s") (param i32) (result i32) local.get 0 i32.load8_s)
 (func (export "store8") (param i32 i32) local.get 0 local.get 1 i32.store8)
 (func (export "load16") (param i32) (result i32) local.get 0 i32.load16_u)
 (func (export "load16s") (param i32) (result i32) local.get 0 i32.load16_s)
 (func (export "store16") (param i32 i32) local.get 0 local.get 1 i32.store16)
 (func (export "load64") (param i32) (result i64) local.get 0 i64.load)
 (func (export "store64") (param i32 i64) local.get 0 local.get 1 i64.store)
 (func (export "load64_32u") (param i32) (result i64) local.get 0 i64.load32_u)
 (func (export "load64_32s") (param i32) (result i64) local.get 0 i64.load32_s)
 (func (export "float32") (param i32 f32) (result f32) local.get 0 local.get 1 f32.store local.get 0 f32.load)
 (func (export "float64") (param i32 f64) (result f64) local.get 0 local.get 1 f64.store local.get 0 f64.load)
)
