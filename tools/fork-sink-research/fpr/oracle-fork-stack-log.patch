+/**
+ * Research hook (fork-path precision oracle; not for production use): when
+ * KANDELO_FORK_STACK_LOG names a file on a Node host, append the complete
+ * JavaScript/Wasm call stack at the start of every fork capture.
+ */
+function recordForkStackForResearch(who: string, mode: number): void {
+  const proc = (globalThis as { process?: { env?: Record<string, string | undefined>; getBuiltinModule?: (id: string) => unknown } }).process;
+  const path = proc?.env?.KANDELO_FORK_STACK_LOG;
+  if (!path) return;
+  const E = Error as unknown as { stackTraceLimit: number };
+  const limit = E.stackTraceLimit;
+  E.stackTraceLimit = Infinity;
+  const stack = new Error("fork").stack ?? "";
+  E.stackTraceLimit = limit;
+  const fs = proc?.getBuiltinModule?.("node:fs") as { appendFileSync(p: string, d: string): void } | undefined;
+  fs?.appendFileSync(path, `== ${who} mode=${mode}\n${stack}\n`);
+}
