{
  "file": "crates/sffs-module/src/lib.rs",
  "verify": "scripts/dev-shell.sh cargo test -q -p sffs-module --target \"$(rustc -vV | sed -n 's/^host: //p')\" >/dev/null 2>&1",
  "trials": [
    {
      "name": "errno returned positive instead of negative",
      "scope": "fn err(e: Errno) -> i32 {",
      "scope_end": "\n}\n",
      "find": "    -(e as i32)",
      "replace": "    e as i32"
    },
    {
      "name": "chown ignores the clear_setid flag",
      "scope": "pub unsafe extern \"C\" fn sm_chown",
      "scope_end": "\n}\n",
      "find": "        clear_setid != 0,",
      "replace": "        false,"
    },
    {
      "name": "chown swaps uid and gid",
      "scope": "pub unsafe extern \"C\" fn sm_chown",
      "scope_end": "\n}\n",
      "find": "        uid,\n        gid,",
      "replace": "        gid,\n        uid,"
    },
    {
      "name": "symlink ownership comes from nowhere",
      "scope": "pub unsafe extern \"C\" fn sm_symlink",
      "scope_end": "\n}\n",
      "find": "        uid,\n        gid,",
      "replace": "        0,\n        0,"
    },
    {
      "name": "reset does not actually reset",
      "scope": "pub extern \"C\" fn sm_reset",
      "scope_end": "\n}\n",
      "find": "    rootfs::reset();",
      "replace": ""
    },
    {
      "name": "writes never truncate",
      "scope": "pub unsafe extern \"C\" fn sm_write_file",
      "scope_end": "\n}\n",
      "find": "content, mode, true,",
      "replace": "content, mode, false,"
    },
    {
      "name": "mode is ignored on write",
      "scope": "pub unsafe extern \"C\" fn sm_write_file",
      "scope_end": "\n}\n",
      "find": "content, mode, true,",
      "replace": "content, 0o644, true,"
    },
    {
      "name": "read_file ignores the offset",
      "scope": "pub unsafe extern \"C\" fn sm_read_file",
      "scope_end": "\n}\n",
      "find": "rootfs::read_file_at(path, offset, out,",
      "replace": "rootfs::read_file_at(path, 0, out,"
    },
    {
      "name": "read_file invents zeroes instead of reading the loaded image",
      "scope": "pub unsafe extern \"C\" fn sm_read_file",
      "scope_end": "\n}\n",
      "find": "    match rootfs::read_file_at(path, offset, out, image_source) {",
      "replace": "    match rootfs::read_file_at(path, offset, out, |_r, d: &mut [u8]| Ok(d.len())) {"
    },
    {
      "name": "readlink returns success regardless of length",
      "scope": "pub unsafe extern \"C\" fn sm_readlink",
      "scope_end": "\n}\n",
      "find": "        Ok(n) => n as i32,",
      "replace": "        Ok(_n) => 0,"
    },
    {
      "name": "an undersized buffer truncates instead of failing",
      "scope": "pub unsafe extern \"C\" fn sm_read_dir",
      "scope_end": "\n}\n",
      "find": "    if out_len < required {\n        return err(Errno::ERANGE);\n    }",
      "replace": ""
    },
    {
      "name": "a missing directory reports an empty listing",
      "scope": "pub unsafe extern \"C\" fn sm_read_dir",
      "scope_end": "\n}\n",
      "find": "        Err(e) => return err(e),\n    };",
      "replace": "        Err(_) => return 0,\n    };"
    },
    {
      "name": "the length prefix is dropped",
      "scope": "pub unsafe extern \"C\" fn sm_read_dir",
      "scope_end": "\n}\n",
      "find": "    let required: usize = names.iter().map(|n| 4 + n.len()).sum();",
      "replace": "    let required: usize = names.iter().map(|n| n.len()).sum();"
    },
    {
      "name": "entries stop after the first",
      "scope": "pub unsafe extern \"C\" fn sm_read_dir",
      "scope_end": "\n}\n",
      "find": "            Ok(Some((_ino, _kind, len))) => names.push(name_buf[..len].to_vec()),",
      "replace": "            Ok(Some((_ino, _kind, len))) => { names.push(name_buf[..len].to_vec()); break; }"
    },
    {
      "name": "export ignores the offset and always restarts",
      "scope": "pub unsafe extern \"C\" fn sm_export_image_read",
      "scope_end": "\n}\n",
      "find": "rootfs::export_container_read(offset, out, &mut source)",
      "replace": "rootfs::export_container_read(0, out, &mut source)"
    },
    {
      "name": "the stat record forgets whether the bytes are present",
      "scope": "    let fields: [u64; 8] = [",
      "scope_end": "\n    ];\n",
      "find": "        u64::from(deferred),",
      "replace": "        0,"
    },
    {
      "name": "the stat record forgets which archive backs the file",
      "scope": "    let fields: [u64; 8] = [",
      "scope_end": "\n    ];\n",
      "find": "        u64::from(archive_id),",
      "replace": "        0,"
    },
    {
      "name": "deferred and archive_id are written in the wrong order",
      "scope": "    let fields: [u64; 8] = [",
      "scope_end": "\n    ];\n",
      "find": "        u64::from(deferred),\n        u64::from(archive_id),",
      "replace": "        u64::from(archive_id),\n        u64::from(deferred),"
    },
    {
      "name": "the bridge declares an archive even when there is none",
      "scope": "    if archive_id != 0 {\n        if let Err(e) = rootfs::declare_archive",
      "scope_end": "\n    }\n",
      "find": "    if archive_id != 0 {\n        if let Err(e) = rootfs::declare_archive(archive_id, archive_bytes, archive_payload) {\n            return err(e);\n        }\n    }",
      "replace": "    if let Err(e) = rootfs::declare_archive(archive_id, archive_bytes, archive_payload) {\n        return err(e);\n    }"
    },
    {
      "name": "a standalone file's description is discarded at registration",
      "scope": "        if archive_id == 0 { archive_payload } else { b\"\" },",
      "scope_end": "\n",
      "find": "        if archive_id == 0 { archive_payload } else { b\"\" },",
      "replace": "        b\"\","
    },
    {
      "name": "a headroom breach reports success",
      "scope": "    let rc = if outcome.met { 0 } else { err(Errno::EDOM) };",
      "scope_end": "\n",
      "find": "    let rc = if outcome.met { 0 } else { err(Errno::EDOM) };",
      "replace": "    let rc = 0;"
    },
    {
      "name": "the verdict reports the required numbers as the free ones",
      "scope": "    let fields = [\n        outcome.free_bytes,",
      "scope_end": "\n    ];\n",
      "find": "        outcome.free_bytes,\n        outcome.required_bytes,",
      "replace": "        outcome.required_bytes,\n        outcome.free_bytes,"
    },
    {
      "name": "the capacity field is written into the headroom slot",
      "scope": "    let fields = [\n        outcome.free_bytes,",
      "scope_end": "\n    ];\n",
      "find": "        outcome.required_inodes,\n        capacity,",
      "replace": "        capacity,\n        outcome.required_inodes,"
    },
    {
      "name": "export reports a negative errno as a byte count",
      "scope": "pub unsafe extern \"C\" fn sm_export_image_read",
      "scope_end": "\n}\n",
      "find": "        Err(e) => err(e),",
      "replace": "        Err(_e) => 0,"
    },
    {
      "name": "export silently invents base bytes",
      "scope": "pub unsafe extern \"C\" fn sm_export_image_read",
      "scope_end": "\n}\n",
      "find": "    let mut source = image_source;",
      "replace": "    let mut source = |_r: rootfs::ByteReq, d: &mut [u8]| Ok(d.len());"
    },
    {
      "name": "a refused load adopts the host's buffer anyway",
      "scope": "pub unsafe extern \"C\" fn sm_load_image",
      "scope_end": "\n}\n",
      "find": "            unsafe { *IMAGE.0.get() = None };",
      "replace": "            unsafe { core::hint::black_box(&IMAGE) };"
    },
    {
      "name": "loading a second image leaks the first",
      "scope": "pub unsafe extern \"C\" fn sm_load_image",
      "scope_end": "\n}\n",
      "find": "    release_image();",
      "replace": "    // release_image();"
    },
    {
      "name": "a zero-length range is accepted as an image",
      "scope": "pub unsafe extern \"C\" fn sm_load_image",
      "scope_end": "\n}\n",
      "find": "    if ptr == 0 || len == 0 {",
      "replace": "    if ptr == 0 {"
    },
    {
      "name": "reset keeps the image its tree was built on",
      "scope": "pub extern \"C\" fn sm_reset() {",
      "scope_end": "\n}\n",
      "find": "    release_image();",
      "replace": "    // release_image();"
    },
    {
      "name": "the byte source answers a blob or archive request from the image",
      "scope": "fn image_source(",
      "scope_end": "\n}\n",
      "find": "    let rootfs::ByteReq::Image { offset } = req else {\n        return Err(Errno::EIO);\n    };",
      "replace": "    let offset = match req {\n        rootfs::ByteReq::Image { offset } => offset,\n        rootfs::ByteReq::Base { offset, .. } => offset,\n        rootfs::ByteReq::Archive { offset, .. } => offset,\n    };"
    },
    {
      "name": "the byte source reads past the end of the image",
      "scope": "fn image_source(",
      "scope_end": "\n}\n",
      "find": "    let n = core::cmp::min(dst.len(), bytes.len() - start);",
      "replace": "    let n = dst.len();"
    },
    {
      "name": "the byte source serves bytes with nothing loaded",
      "scope": "fn image_source(",
      "scope_end": "\n}\n",
      "find": "    let bytes = image_bytes().ok_or(Errno::EIO)?;",
      "replace": "    let bytes = image_bytes().unwrap_or(&[]);"
    },
    {
      "name": "the stat probe reports a length that is not the record's",
      "scope": "pub unsafe extern \"C\" fn sm_lstat(",
      "scope_end": "\n}\n",
      "find": "    const RECORD: usize = 8 * 8;",
      "replace": "    const RECORD: usize = 6 * 8;"
    },
    {
      "name": "the stat probe is answered only after the path resolves",
      "scope": "pub unsafe extern \"C\" fn sm_lstat(",
      "scope_end": "\n}\n",
      "find": "    if out_len == 0 {\n        return RECORD as i32;\n    }\n    let path = unsafe { slice(path_ptr, path_len) };",
      "replace": "    let path = unsafe { slice(path_ptr, path_len) };\n    if out_len == 0 {\n        return RECORD as i32;\n    }"
    }
  ],
  "build": "scripts/dev-shell.sh cargo build -q -p sffs-module --target \"$(rustc -vV | sed -n 's/^host: //p')\" >/dev/null 2>&1"
}
