{
  "file": "host/src/vfs/rootfs-lazy-archives.ts",
  "verify": "cd host && npx vitest run test/rootfs-lazy-archives.test.ts >/dev/null 2>&1",
  "trials": [
    {
      "name": "a failed fetch reports EAGAIN forever instead of failing",
      "scope": "  const deferredProvider = (",
      "scope_end": "\n  };\n",
      "find": "    if (slot.state === \"failed\") return EIO;",
      "replace": "    if (slot.state === \"failed\") return EAGAIN;"
    },
    {
      "name": "an empty address is guessed at rather than refused",
      "scope": "  const deferredProvider = (",
      "scope_end": "\n  };\n",
      "find": "    if (uri === \"\") return EIO;",
      "replace": "    if (uri === \"\") return EAGAIN;"
    },
    {
      "name": "a read past the end reports an error instead of end-of-file",
      "scope": "  const deferredProvider = (",
      "scope_end": "\n  };\n",
      "find": "    if (at >= slot.bytes.byteLength) return 0; // end of resource",
      "replace": "    if (at >= slot.bytes.byteLength) return EIO;"
    },
    {
      "name": "every address is served from the first fetch, because the cache ignores which one was asked for",
      "scope": "  const deferredProvider = (",
      "scope_end": "\n  };\n",
      "find": "    const slot = slots.get(uri);",
      "replace": "    const slot = slots.size > 0 ? slots.values().next().value : undefined;"
    },
    {
      "name": "a mirror of the wrong length is believed",
      "scope": "async function fetchDeferred(",
      "scope_end": "\n}\n",
      "find": "      if (known !== undefined && bytes.length !== known.size) continue;",
      "replace": "      if (known !== undefined && false) continue;"
    },
    {
      "name": "an address with no policy is fetched through some other address's transports",
      "scope": "async function fetchDeferred(",
      "scope_end": "\n}\n",
      "find": "  const transports = known?.transports ?? [uri];",
      "replace": "  const transports = known?.transports ?? [];"
    }
  ]
}
