{
  "file": "images/vfs/lib/sffs-image-fs.ts",
  "verify": "cd host && npx vitest run test/sffs-image-fs.test.ts >/dev/null 2>&1",
  "trials": [
    {
      "name": "the memory view is cached instead of taken fresh",
      "scope": "  private get mem(): Uint8Array {",
      "scope_end": "\n  }\n",
      "find": "    return new Uint8Array(this.exports.memory.buffer);",
      "replace": "    this.cachedMem ??= new Uint8Array(this.exports.memory.buffer);\n    return this.cachedMem;"
    },
    {
      "name": "a negative errno is not thrown",
      "scope": "  private check(rc: number",
      "scope_end": "\n  }\n",
      "find": "    if (rc < 0) throw new SffsImageError(-rc, operation, path);",
      "replace": ""
    },
    {
      "name": "readdir ignores the length prefix",
      "scope": "  readDirNames(path: string): string[] {",
      "scope_end": "\n  }\n",
      "find": "        const len = view.getUint32(at, true);",
      "replace": "        const len = 4;"
    },
    {
      "name": "clearSetid is never passed through",
      "scope": "  chown(path: string",
      "scope_end": "\n  }\n",
      "find": "clearSetid ? 1 : 0",
      "replace": "0"
    },
    {
      "name": "read ignores an explicit position and always uses the cursor",
      "scope": "  read(handle: number",
      "scope_end": "\n  }\n",
      "find": "    const at = position ?? open.offset;",
      "replace": "    const at = open.offset;"
    },
    {
      "name": "read never advances the cursor",
      "scope": "  read(handle: number",
      "scope_end": "\n  }\n",
      "find": "      if (position === null) open.offset += n;",
      "replace": ""
    },
    {
      "name": "close accepts a handle it never issued",
      "scope": "  close(handle: number): void {",
      "scope_end": "\n  }\n",
      "find": "    if (!this.openFiles.delete(handle)) {\n      throw new Error(`sffs-module: bad file handle ${handle}`);\n    }",
      "replace": "    this.openFiles.delete(handle);"
    },
    {
      "name": "readdir reports an empty directory forever",
      "scope": "  readdir(handle: number)",
      "scope_end": "\n  }\n",
      "find": "    if (dir.index >= dir.names.length) return null;",
      "replace": "    return null;"
    }
  ],
  "build": "cd host && npx tsc --noEmit -p . >/dev/null 2>&1 || true"
}
