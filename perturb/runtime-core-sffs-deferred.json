      "scope": "pub fn decode(",
      "scope_end": "\n}\n",
      "find": "        if (archive_id == 0) != (source_path_len == 0) {\n            return Err(Errno::EINVAL);\n        }",
      "replace": ""
    },
    {
      "name": "encoder drops the source-path cap",
      "scope": "pub fn encode(",
      "scope_end": "\n}\n",
      "find": "        if record.source_path.len() > MAX_SOURCE_PATH_LEN as usize {\n            return Err(Errno::EINVAL);\n        }",
