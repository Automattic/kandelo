Subject: [PATCH] Preserve full interface init callbacks and adapt unary sites explicitly

GInterfaceInitFunc has two arguments. Keep its public registration macros at
that arity; a shared one-argument trampoline must not erase genuine callbacks.
Known one-argument initializers use explicit GLib unary adapter macros.
Apply after the existing callback-signature portability patch.

--- a/pango/fonts.c
+++ b/pango/fonts.c
@@ -2664,7 +2664,7 @@
 }
 
 G_DEFINE_ABSTRACT_TYPE_WITH_CODE (PangoFontFamily, pango_font_family, G_TYPE_OBJECT,
-                                  G_IMPLEMENT_INTERFACE (G_TYPE_LIST_MODEL, pango_font_family_list_model_init))
+                                  G_IMPLEMENT_INTERFACE_UNARY (G_TYPE_LIST_MODEL, pango_font_family_list_model_init))
 
 static PangoFontFace *pango_font_family_real_get_face (PangoFontFamily *family,
                                                        const char      *name);
--- a/pango/pango-fontmap.c
+++ b/pango/pango-fontmap.c
@@ -71,7 +71,7 @@
 G_DEFINE_ABSTRACT_TYPE_WITH_CODE (PangoFontMap, pango_font_map, G_TYPE_OBJECT,
                                   G_ADD_PRIVATE (PangoFontMap)
                                   g_type_add_class_private (g_define_type_id, sizeof (PangoFontMapClassPrivate));
-                                  G_IMPLEMENT_INTERFACE (G_TYPE_LIST_MODEL, pango_font_map_list_model_init))
+                                  G_IMPLEMENT_INTERFACE_UNARY (G_TYPE_LIST_MODEL, pango_font_map_list_model_init))
 
 static void
 pango_font_map_get_property (GObject    *object,
--- a/pango/pangocairo-coretextfont.c
