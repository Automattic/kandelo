+
+bool js::GetPropertyWithFound(JSContext* cx, HandleObject obj,
+                               HandleValue receiver, HandleId id,
+                               MutableHandleValue vp, bool* found) {
+  MOZ_ASSERT(found);
+  AutoCheckRecursionLimit recursion(cx);
+  if (!recursion.check(cx)) return false;
+  if (obj->is<NativeObject>()) {
+    return NativeGetPropertyInline<CanGC>(cx, obj.as<NativeObject>(), receiver,
+                                        id, NotNameLookup, vp, found);
+  }
+  if (IsScriptedProxy(obj)) {
+    return ScriptedProxyHandler::singleton.getWithFound(cx, obj, receiver, id,
+                                                        vp, found);
+  }
+  // Engine wrappers transport the lookup across realms; they must not turn a
+  // missing forwarded property into a found undefined value. Preserve access
+  // checks and wrap both the original receiver and the resulting real value.
+  if (IsWrapper(obj)) {
+    RootedObject target(cx, CheckedUnwrapDynamic(obj, cx, false));
+    if (!target) {
+      ReportAccessDenied(cx);
+      return false;
+    }
+    {
+      AutoRealm realm(cx, target);
+      RootedValue wrappedReceiver(cx, receiver);
+      RootedId wrappedId(cx, id);
+      if (!JS_WrapValue(cx, &wrappedReceiver) || !JS_WrapId(cx, &wrappedId) ||
+          !GetPropertyWithFound(cx, target, wrappedReceiver, wrappedId, vp, found))
+        return false;
+    }
+    return JS_WrapValue(cx, vp);
+  }
+  // Other exotic get operations are already terminal lookup results, as in
+  // the pre-existing embedding path. Their own algorithm remains authoritative.
+  *found = true;
+  return GetProperty(cx, obj, receiver, id, vp);
 }

