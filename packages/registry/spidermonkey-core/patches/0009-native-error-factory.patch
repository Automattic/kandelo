+// Native embedding entry to the original ordinary Error factory. Primitive
+// options are ignored; an object supplies the standard optional cause. This
+// does not invoke a replaceable global constructor or a JS return checkpoint.
+extern JS_PUBLIC_API bool CreateErrorFromOptions(
+    JSContext* cx, JSExnType type, HandleString message, HandleValue options,
+    MutableHandleValue rval);
