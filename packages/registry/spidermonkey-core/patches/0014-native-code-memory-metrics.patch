+size_t GeckoProfilerRuntime::sizeOfExcludingThis(
+    mozilla::MallocSizeOf mallocSizeOf) {
+  size_t bytes = scriptSources_.readLock()->shallowSizeOfExcludingThis(mallocSizeOf);
+  for (AllZonesIter zone(rt); !zone.done(); zone.next()) {
+    if (!zone->profilerStrings) {
+      continue;
+    }
+    bytes += mallocSizeOf(zone->profilerStrings.get());
+    const ProfileStringMap& strings = zone->profilerStrings->get();
+    bytes += strings.shallowSizeOfExcludingThis(mallocSizeOf);
+    for (auto iter = strings.iter(); !iter.done(); iter.next()) {
+      bytes += mallocSizeOf(iter.get().value().get());
+    }
+  }
+  return bytes;
 }

