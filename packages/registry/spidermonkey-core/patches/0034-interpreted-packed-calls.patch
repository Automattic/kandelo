+enum class PackedCallStatus { Fallback, Entered, Error };
+
+static PackedCallStatus TryInlinePackedCall(JSContext* cx, InterpreterRegs& regs,
+                                            HandleValue target, HandleValue receiver,
+                                            HandleValue list) {
+  JSFunction* fun;
+  if (!IsFunctionObject(target, &fun) || !fun->isInterpreted() ||
+      fun->isClassConstructor() || fun->realm() != cx->realm() ||
+      cx->realm()->isDebuggee() || cx->realm()->debuggerObservesNativeCall() ||
+      !list.isObject() ||
+      !IsPackedArray(&list.toObject())) {
+    return PackedCallStatus::Fallback;
+  }
+  Rooted<ArrayObject*> args(cx, &list.toObject().as<ArrayObject>());
+  if (args->length() > ARGS_LENGTH_MAX) {
+    return PackedCallStatus::Fallback;
+  }
+  RootedFunction callee(cx, fun);
+  if (!cx->checkEmbedderScriptExecution()) {
+    return PackedCallStatus::Error;
+  }
+  RootedScript script(cx, JSFunction::getOrCreateScript(cx, callee));
+  if (!script || !cx->interpreterStack().pushPackedCallFrame(
+                     cx, regs, callee, script, receiver, args)) {
+    return PackedCallStatus::Error;
+  }
+  return PackedCallStatus::Entered;
+}
