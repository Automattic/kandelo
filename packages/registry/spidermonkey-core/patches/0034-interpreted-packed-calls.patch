 // Unlike the other methods of this class, this method is defined here so that
 // we don't have to #include jsautooplen.h in vm/Stack.h.
+unsigned InterpreterRegs::packedCallerArgSlots(const jsbytecode* pc) {
+  if (JSOp(*pc) == JSOp::SpreadCall) {
+    return 1;
+  }
+  MOZ_ASSERT(JSOp(*pc) == JSOp::Call || JSOp(*pc) == JSOp::CallContent ||
+             JSOp(*pc) == JSOp::CallIgnoresRv);
+  return GET_ARGC(pc);
+}
+
+bool InterpreterStack::pushPackedCallFrame(
+    JSContext* cx, InterpreterRegs& regs, HandleFunction callee,
+    HandleScript script, HandleValue receiver, Handle<ArrayObject*> args) {
+  MOZ_ASSERT(script->realm() == cx->realm());
+  MOZ_ASSERT(IsPackedArray(args));
+  size_t actual = args->length();
+  size_t padded = std::max<size_t>(callee->nargs(), actual);
+  // Keep the expanded arguments with the frame. Caller stack tracing and
+  // exception unwinding must still see the original call-site operands.
+  uint64_t values = 2 + uint64_t(padded) + script->nslots();
+  if (values > (SIZE_MAX - sizeof(InterpreterFrame)) / sizeof(Value)) {
+    ReportOutOfMemory(cx);
+    return false;
+  }
+  LifoAlloc::Mark mark = allocator_.mark();
+  uint8_t* buffer =
+      allocateFrame(cx, sizeof(InterpreterFrame) + size_t(values) * sizeof(Value));
+  if (!buffer) {
+    return false;
+  }
+  Value* argv = reinterpret_cast<Value*>(buffer) + 2;
+  argv[-2] = ObjectValue(*callee);
+  argv[-1] = receiver;
+  for (size_t i = 0; i < actual; i++) {
+    argv[i] = args->getDenseElement(i);
+  }
+  SetValueRangeToUndefined(argv + actual, padded - actual);
+  InterpreterFrame* fp = reinterpret_cast<InterpreterFrame*>(argv + padded);
+  fp->mark_ = mark;
+  fp->initCallFrame(regs.fp(), regs.pc, regs.sp, *callee, script, argv,
+                    args->length(), NO_CONSTRUCT);
+  fp->flags_ |= InterpreterFrame::HAS_PACKED_CALL_ARGS;
+  regs.prepareToRun(*fp, script);
+  return true;
+}
