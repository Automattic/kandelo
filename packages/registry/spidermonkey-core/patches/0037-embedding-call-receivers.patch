+JS_PUBLIC_API JSObject* TakeErrorStackCallRecords(JSContext* cx, HandleObject stack) {
+  if (!stack || !stack->is<js::SavedFrame>()) return nullptr;
+  cx->check(stack);
+  return stack->as<js::SavedFrame>().takeCallRecords();
 }
 
+JS_PUBLIC_API bool GetSavedFrameCall(JSContext* cx, JSPrincipals* principals,
+                                     HandleObject savedFrame, HandleObject records,
+                                     MutableHandleValue receiver,
+                                     MutableHandleObject callee, bool* constructing,
+                                     SavedFrameSelfHosted selfHosted) {
+  js::AssertHeapIsIdle();
+  CHECK_THREAD(cx);
+  bool skippedAsync;
+  Rooted<js::SavedFrame*> frame(cx, UnwrapSavedFrame(
+      cx, principals, savedFrame, selfHosted, skippedAsync));
+  if (!frame) {
+    JS_ReportErrorASCII(cx, "Captured frame is not visible in this realm");
+    return false;
+  }
+  receiver.setUndefined();
+  callee.set(nullptr);
+  *constructing = false;
+  if (!records) return true;
+  RootedValue key(cx, ObjectValue(*frame)), value(cx);
+  if (!JS_WrapValue(cx, &key) || !GetWeakMapEntry(cx, records, key, &value)) return false;
+  if (value.isUndefined()) return true;
+  const auto& record = value.toObject().as<js::NativeObject>();
+  receiver.set(record.getReservedSlot(js::CallReceiver));
+  callee.set(&record.getReservedSlot(js::CallCallee).toObject());
+  *constructing = record.getReservedSlot(js::CallConstructing).toBoolean();
+  return true;
+}
