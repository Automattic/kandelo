+static inline JS::Symbol* NewPrivateName(JSContext* cx, HandleScript script,
+                                         Handle<JSAtom*> name,
+                                         uint32_t classIndex,
+                                         uint32_t readKind) {
+  if (readKind > uint32_t(JS::PrivateReadKind::StaticMember)) {
+    JS_ReportErrorASCII(cx, "Invalid private name diagnostic kind");
+    return nullptr;
+  }
+  auto kind = JS::PrivateReadKind(readKind);
+  if (kind == JS::PrivateReadKind::Field) {
+    return JS::Symbol::new_(cx, JS::SymbolCode::PrivateFieldNameSymbol, name);
+  }
+  if (kind == JS::PrivateReadKind::None ||
+      !cx->realm()->creationOptions().getPrivateReadErrorReporter()) {
+    return JS::Symbol::new_(cx, JS::SymbolCode::PrivateNameSymbol, name);
+  }
+
+  // Use the same checked metadata lookup in every execution tier.
+  auto things = script->gcthings();
+  if (classIndex >= things.size() || !things[classIndex].is<JSString>() ||
+      !things[classIndex].as<JSString>().isAtom()) {
+    JS_ReportErrorASCII(cx, "Invalid private name diagnostic class atom");
+    return nullptr;
+  }
+  Rooted<JSAtom*> className(cx, &things[classIndex].as<JSString>().asAtom());
+  return JS::Symbol::new_(cx, JS::SymbolCode::PrivateNameSymbol, name, className,
+                          kind == JS::PrivateReadKind::StaticMember);
 }
 
