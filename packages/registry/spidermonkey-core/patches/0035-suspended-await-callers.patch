+static SavedFrame::KandeloSourceKind CaptureScriptKind(JSScript* script) {
+  auto sourceKind = SavedFrame::KandeloSourceKind::Script;
+  auto* source = script->scriptSource();
+  if (script->isForEval()) sourceKind = SavedFrame::KandeloSourceKind::Eval;
+  if (source->hasIntroductionType()) {
+    const char* type = source->introductionType();
+    if (strcmp(type, "eval") == 0) {
+      sourceKind = SavedFrame::KandeloSourceKind::Eval;
+    } else if (strcmp(type, "Function") == 0 ||
+               strcmp(type, "AsyncFunction") == 0 ||
+               strcmp(type, "GeneratorFunction") == 0 ||
+               strcmp(type, "AsyncGenerator") == 0) {
+      sourceKind = SavedFrame::KandeloSourceKind::Function;
+    }
+  }
+  return sourceKind;
+}
