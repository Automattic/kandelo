+bool js::GetAwaitingGenerators(JSContext* cx, HandleObject job, uint32_t limit,
+                               MutableHandleObjectVector generators) {
+  auto visible = [cx](JSObject* obj) -> JSObject* {
+    if (!obj) return nullptr;
+    obj = CheckedUnwrapDynamic(obj, cx);
+    if (!obj || JS_IsDeadWrapper(obj)) return nullptr;
+    auto* from = cx->realm()->principals();
+    auto* to = obj->nonCCWRealm()->principals();
+    auto subsumes = cx->runtime()->securityCallbacks->subsumes;
+    return from == to || (subsumes && subsumes(from, to)) ? obj : nullptr;
+  };
+  auto generatorPromise = [cx](AbstractGeneratorObject* generator) -> JSObject* {
+    if (generator->is<AsyncFunctionGeneratorObject>()) {
+      return generator->as<AsyncFunctionGeneratorObject>().promise();
+    }
+    Rooted<AsyncGeneratorObject*> gen(cx, &generator->as<AsyncGeneratorObject>());
+    return gen->isQueueEmpty() ? nullptr : AsyncGeneratorObject::peekRequest(gen)->promise();
+  };
+
+  RootedObject current(cx, visible(job));
+  if (!current) return true;
+  if (current->is<PromiseReactionRecord>()) {
+    auto& reaction = current->as<PromiseReactionRecord>();
+    if (reaction.isAsyncFunction()) current = generatorPromise(reaction.asyncFunctionGenerator());
+    else if (reaction.isAsyncGenerator()) current = generatorPromise(reaction.asyncGenerator());
+    else current = reaction.promise();
+  } else if (current->is<ThenableJob>()) {
+    current = current->as<ThenableJob>().promise();
+  } else {
+    return true;
+  }
+
+  Rooted<GCHashSet<HeapPtr<JSObject*>, StableCellHasher<HeapPtr<JSObject*>>,
+                   SystemAllocPolicy>> visited(cx);
+  while (generators.length() < limit && (current = visible(current))) {
+    if (!current->is<PromiseObject>()) break;
+    auto& promise = current->as<PromiseObject>();
+    if (promise.state() != JS::PromiseState::Pending || !promise.reactions().isObject()) break;
+    if (visited.has(current)) break;
+    if (!visited.put(current)) { ReportOutOfMemory(cx); return false; }
+
+    RootedObject next(cx, visible(&promise.reactions().toObject()));
+    // Multiple reactions are stored as an array. There is no unique caller.
+    if (!next || !next->is<PromiseReactionRecord>()) break;
+    auto& reaction = next->as<PromiseReactionRecord>();
+    Rooted<AbstractGeneratorObject*> generator(cx);
+    if (reaction.isAsyncFunction()) generator = reaction.asyncFunctionGenerator();
+    else if (reaction.isAsyncGenerator()) generator = reaction.asyncGenerator();
+    if (generator) {
+      if (!visible(generator) || !generator->isSuspended()) break;
+      if (!generators.append(generator)) return false;
+      current = generatorPromise(generator);
+    } else if (reaction.isDefaultResolvingHandler()) {
+      current = reaction.defaultResolvingPromise();
+    } else {
+      current = reaction.promise();
+    }
+  }
+  return true;
+}
