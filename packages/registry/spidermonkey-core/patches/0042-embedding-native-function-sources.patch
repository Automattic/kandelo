# Match native-function source presentation when requested by the Node embedding.
# Keep SpiderMonkey's source-backed function output and toSource behavior.
--- a/js/public/RealmOptions.h
+++ b/js/public/RealmOptions.h
@@ -246,6 +246,13 @@
   bool captureCallReceivers() const { return captureCallReceivers_; }
   RealmCreationOptions& setCaptureCallReceivers(bool enabled) {
     captureCallReceivers_ = enabled;
+    return *this;
+  }
+
+  // The Node embedding uses V8's native-function source presentation.
+  bool getNodeNativeFunctionSource() const { return nodeNativeFunctionSource_; }
+  RealmCreationOptions& setNodeNativeFunctionSource(bool enabled) {
+    nodeNativeFunctionSource_ = enabled;
     return *this;
   }

@@ -309,6 +316,7 @@
   uint32_t maxLazyTypedArrayBytes_ = UINT32_MAX;
   bool captureCallReceivers_ = false;
   bool toSource_ = false;
+  bool nodeNativeFunctionSource_ = false;

   bool secureContext_ = false;
