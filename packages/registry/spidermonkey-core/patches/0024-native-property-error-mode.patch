+  mozilla::Maybe<bool> nativePropertyFailureMode() const {
+    return nativePropertyFailureMode_;
+  }
+  // Explicit [[Set]]/[[Delete]]/[[DefineOwnProperty]] failure policy belongs to
+  // the operation, not the nearest caller's strictness. A new JS invocation
+  // clears the override so a proxy/getter cannot leak it into reentrant JS.
+  class AutoNativePropertyFailureMode {
+    JSContext* cx_;
+    mozilla::Maybe<bool> saved_;
+   public:
+    AutoNativePropertyFailureMode(JSContext* cx, mozilla::Maybe<bool> mode)
+        : cx_(cx), saved_(cx->nativePropertyFailureMode_) {
+      cx_->nativePropertyFailureMode_ = mode;
+    }
+    ~AutoNativePropertyFailureMode() {
+      cx_->nativePropertyFailureMode_ = saved_;
+    }
+  };
+
