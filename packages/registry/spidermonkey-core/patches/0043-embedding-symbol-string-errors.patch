+void js::ReportSymbolToStringError(JSContext* cx) {
+  JS::Realm* realm = cx->realm();
+  if (auto reporter =
+          realm ? realm->creationOptions().getSymbolToStringErrorReporter()
+                : nullptr) {
+    reporter(cx);
+    return;
+  }
+  JS_ReportErrorNumberASCII(cx, GetErrorMessage, nullptr,
+                            JSMSG_SYMBOL_TO_STRING);
+}
