+static bool intrinsic_ThrowStringRepeatError(JSContext* cx, unsigned argc,
+                                              Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  MOZ_ASSERT(args.length() == 2);
+  MOZ_ASSERT(args[0].isInt32());
+  MOZ_ASSERT(args[1].isNumber());
+  const unsigned errorNumber = args[0].toInt32();
+  MOZ_ASSERT(errorNumber == JSMSG_NEGATIVE_REPETITION_COUNT ||
+             errorNumber == JSMSG_RESULTING_STRING_TOO_LARGE);
+  auto reporter = cx->realm()->creationOptions().getStringRepeatErrorReporter();
+  if (reporter) {
+    reporter(cx, args[1].toNumber());
+  } else {
+    JS_ReportErrorNumberASCII(cx, GetErrorMessage, nullptr, errorNumber);
+  }
   return false;
 }
 
