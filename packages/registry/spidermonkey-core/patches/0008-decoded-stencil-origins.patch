+
+bool ScriptSource::setSourceMapCommentURL(FrontendContext* fc,
+                                          const char16_t* url) {
+  if (!setSourceMapURL(fc, url)) {
+    return false;
+  }
+  sourceMapCommentURL_ = sourceMapURL_.clone();
+  return true;
+}
+
+bool ScriptSource::resetDecodedOrigin(
+    FrontendContext* fc, const ReadOnlyCompileOptions& options) {
+  // Only an unpublished decoded source may use this reset. Source data and
+  // function parameter boundaries remain independently owned and unchanged.
+  filename_ = SharedImmutableString();
+  introducerFilename_ = SharedImmutableString();
+  filenameHash_ = 0;
+  introductionOffset_.reset();
+  if (!initFromOptions(fc, options)) {
+    return false;
+  }
+  sourceMapURL_ = sourceMapCommentURL_ ? sourceMapCommentURL_.clone()
+                                      : SharedImmutableTwoByteString();
+  if (options.sourceMapURL() && !setSourceMapURL(fc, options.sourceMapURL())) {
+    return false;
+  }
+  return true;
 }

