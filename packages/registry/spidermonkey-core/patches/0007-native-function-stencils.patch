+
+JS_PUBLIC_API JSFunction* JS::CompileFunction(
+    JSContext* cx, const EnvironmentChain& envChain,
+    const ReadOnlyCompileOptions& options, const char* name,
+    const HandleValueArray& argnames, SourceText<char16_t>& srcBuf,
+    Stencil** stencilOut, Stencil* cachedStencil) {
+  MOZ_ASSERT(stencilOut);
+  *stencilOut = nullptr;
+  ManualReportFrontendContext fc(cx);
+  FunctionCompiler compiler(cx, &fc);
+  if (!compiler.init(name, argnames) || !compiler.addFunctionBody(srcBuf)) {
+    fc.failure();
+    return nullptr;
+  }
+
+  fc.ok();
+  return compiler.finish(envChain, options, stencilOut, cachedStencil,
+                         /* nativeFunctionBody = */ true);
 }

