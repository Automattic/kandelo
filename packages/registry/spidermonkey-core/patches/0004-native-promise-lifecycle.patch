 using namespace js;

+// Observe real engine operations; never replace Promise algorithms or jobs.
+static bool EmitEmbedderPromiseHook(
+    JSContext* cx, JSContext::EmbedderPromiseHookKind kind,
+    HandleObject promise, HandleObject parent = nullptr) {
+  if (!cx->embedderPromiseLifecycleHook) return true;
+  cx->emitEmbedderPromiseHook(kind, promise, parent);
+  return !cx->isExceptionPending() && !cx->isNativeExecutionTerminating();
+}
+
+template <class Run>
+static bool RunEmbedderPromiseJob(JSContext* cx, HandleObject promise, Run run) {
+  if (!EmitEmbedderPromiseHook(cx, JSContext::EmbedderPromiseHookKind::Before,
+                               promise)) return false;
+  if (!run()) return false;
+  return EmitEmbedderPromiseHook(cx, JSContext::EmbedderPromiseHookKind::After,
+                                 promise);
+}
