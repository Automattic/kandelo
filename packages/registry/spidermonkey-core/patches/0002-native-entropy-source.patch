# Kandelo patch rationale (S28)
# Judgment: Supported. Keep the agreed entropy hook because it connects
# engine startup to Node’s existing randomness policy and fatal failure
# handling.
#
# SpiderMonkey startup needs secure random bytes before Node's Environment
# exists. This hook lets the bridge connect Node's original native
# randomness policy, including fatal failure handling, before engine
# initialization. The OS still supplies the entropy and must be correct
# independently; it does not own Node's failure policy. Keep this agreed
# small callback boundary and review a stock equivalent when upgrading the
# engine.
#
# Retained provisionally; see README.md: Future work: platform omissions.

--- a/mfbt/RandomNum.h
+++ b/mfbt/RandomNum.h
@@ -11,6 +11,11 @@
 #include "mozilla/Types.h"

 namespace mozilla {
+
+// Process-resident native entropy source. Install before engine initialization.
+// A false result is propagated; callers retain their own failure policy.
+using RandomBytesSource = bool (*)(unsigned char*, size_t);
+MFBT_API void SetRandomBytesSource(RandomBytesSource source);

 /**
  *  Generate cryptographically secure random bytes using the best facilities
--- a/mfbt/RandomNum.cpp
+++ b/mfbt/RandomNum.cpp
@@ -3,6 +3,8 @@
  * file, You can obtain one at https://mozilla.org/MPL/2.0/. */

 #include "mozilla/RandomNum.h"
+
+#include <atomic>

 #ifdef XP_UNIX
 #  include <fcntl.h>
@@ -83,9 +85,19 @@

 namespace mozilla {

+static std::atomic<RandomBytesSource> sRandomBytesSource{nullptr};
+
+MFBT_API void SetRandomBytesSource(RandomBytesSource source) {
+  sRandomBytesSource.store(source, std::memory_order_release);
+}
+
 MFBT_API bool GenerateRandomBytesFromOS(void* aBuffer, size_t aLength) {
   MOZ_ASSERT(aBuffer);
   MOZ_ASSERT(aLength > 0);
+
+  if (auto source = sRandomBytesSource.load(std::memory_order_acquire)) {
+    return source(static_cast<unsigned char*>(aBuffer), aLength);
+  }

 #if defined(XP_WIN)
   return !!RtlGenRandom(aBuffer, aLength);
