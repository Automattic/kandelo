# Kandelo patch rationale (S27)
# Judgment: Weak. This only exempts a Node header that should leave the
# engine when fatal logging is decoupled.
#
# The current execution-gate patch includes a Node fatal-logger header,
# which Mozilla's include checker otherwise rejects. This exemption is
# needed only because of that temporary coupling, not because of a missing
# OS feature. Remove it when the logger is registered by the bridge through
# a generic hook; do not replace it with a broader checker disable or
# another Node exception.
#
# Retained provisionally; see README.md: Future work: platform omissions.

--- a/config/check_spidermonkey_style.py
+++ b/config/check_spidermonkey_style.py
@@ -54,6 +54,7 @@

 # We ignore #includes of these files, because they don't follow the usual rules.
 included_inclnames_to_ignore = set([
+    "kandelo/v8-native-fatal.h",  # declared native fatal logger dependency
     "ffi.h",  # generated in ctypes/libffi/
     "builtin/intl/glue/Locale.h",  # generated
     "devtools/Instruments.h",  # we ignore devtools/ in general
