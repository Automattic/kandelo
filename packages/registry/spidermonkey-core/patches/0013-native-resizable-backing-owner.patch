+/* static */ ResizableArrayBufferObject*
+ResizableArrayBufferObject::createWithKandeloContents(
+    JSContext* cx, const std::shared_ptr<KandeloArrayBufferContents>& owner) {
+  MOZ_RELEASE_ASSERT(owner && owner->committed && owner->resizable);
+  try {
+    // Prepare the only throwing metadata allocation before publishing a buffer.
+    auto slot = std::make_unique<std::shared_ptr<KandeloArrayBufferContents>>(owner);
+    AutoSetNewObjectMetadata metadata(cx);
+    constexpr auto kind = GetArrayBufferGCObjectKind(RESERVED_SLOTS);
+    Rooted<ResizableArrayBufferObject*> buffer(
+        cx, NewArrayBufferObject<ResizableArrayBufferObject>(cx, nullptr, kind));
+    if (!buffer) return nullptr;
+    const auto& contents = owner->contents;
+    // initialize performs no GC. Attach the preallocated owner slot afterwards
+    // so setDataPointer does not allocate a second shared-owner metadata cell.
+    buffer->initialize(owner->byteLength.load(std::memory_order_relaxed),
+                       owner->maxByteLength,
+                       BufferContents(contents.data(), contents.kind(),
+                                      contents.freeFunc(), contents.freeUserData()));
+    buffer->setFixedSlot(KANDELO_CONTENTS_SLOT, PrivateValue(slot.release()));
+    if (buffer->isMalloced() || buffer->isMapped()) {
+      AddCellMemory(buffer, owner->allocationLength, MemoryUse::ArrayBufferContents);
+    }
+    return buffer;
+  } catch (const std::bad_alloc&) {
+    ReportOutOfMemory(cx);
+    return nullptr;
+  }
