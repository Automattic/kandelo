# Kandelo patch rationale (S36)
# Judgment: Supported. Keep precisely timed allocator and GC hooks because
# the stock callbacks do not provide the required retry opportunity and
# heap-idle notification.
#
# Node memory policy needs a retry at the real heap-limit failure and GC
# notifications when the heap is safe for native callbacks. Stock OOM
# callbacks do not provide that retry protocol, and nursery callbacks occur
# at a different GC phase. The bridge cannot recreate those opportunities
# after they pass; the OS only sees memory, not JS collector phases. Keep
# narrowly timed hooks, with callback lists, reentry rules and cleanup
# owned by the bridge.
#
# Retained provisionally; see README.md: Future work: platform omissions.

--- a/js/src/gc/Allocator.cpp
+++ b/js/src/gc/Allocator.cpp
@@ -12,6 +12,7 @@
 #include "gc/GCProbes.h"
 #include "gc/Nursery.h"
 #include "gc/PublicIterators.h"
+#include "js/MemoryCallbacks.h"
 #include "threading/CpuCount.h"
 #include "util/Poison.h"
 #include "vm/BigIntType.h"
@@ -227,12 +228,37 @@
   runtime->gc.attemptLastDitchGC();

   void* ptr = AllocTenuredCellUnchecked<NoGC>(zone, kind);
+  JSContext* cx = runtime->mainContextFromOwnThread();
+  if (!ptr && runtime->gc.heapSize.bytes() >= runtime->gc.tunables.gcMaxBytes() &&
+      cx->tryNativeCellHeapLimitRecovery()) {
+    if (cx->isNativeExecutionTerminating() || cx->isExceptionPending()) {
+      return nullptr;
+    }
+    ptr = AllocTenuredCellUnchecked<NoGC>(zone, kind);
+  }
   if (!ptr) {
+    if (cx->isNativeExecutionTerminating() || cx->isExceptionPending()) {
+      return nullptr;
+    }
     ReportOutOfMemory(runtime->mainContextFromOwnThread());
     return nullptr;
   }

   return ptr;
+}
+
+JS_PUBLIC_API void JS::SetNativeCellHeapLimitCallback(
+    JSContext* cx, NativeCellHeapLimitCallback callback, void* data) {
+  MOZ_RELEASE_ASSERT(cx == js::TlsContext.get());
+  cx->nativeCellHeapLimitCallback = callback;
+  cx->nativeCellHeapLimitData = callback ? data : nullptr;
+}
+
+JS_PUBLIC_API void JS::SetNativeMinorGCObserver(
+    JSContext* cx, NativeMinorGCObserver observer, void* data) {
+  MOZ_RELEASE_ASSERT(cx == js::TlsContext.get());
+  cx->nativeMinorGCObserver = observer;
+  cx->nativeMinorGCObserverData = observer ? data : nullptr;
 }

