+// Owner-thread embedding recovery after the original last-ditch GC/retry hits
+// the GC-cell heap cap. A true result requests one ordinary allocation retry.
+// The callback may collect or raise the real cap, must not run JS, and cannot
+// reenter itself. It is retired before the embedding's owner is destroyed.
+using NativeCellHeapLimitCallback = bool (*)(JSContext*, void*);
+extern JS_PUBLIC_API void SetNativeCellHeapLimitCallback(
+    JSContext* cx, NativeCellHeapLimitCallback callback, void* data);
+
+// Unlike the low-level nursery notifications inside a collecting heap, this
+// observer brackets an outer nursery collection while the heap permits native
+// allocation and collection. Internal nursery work during a major GC remains
+// part of that major event. Callbacks must not run JS or throw C++ exceptions.
+using NativeMinorGCObserver = void (*)(JSContext*, bool, void*);
+extern JS_PUBLIC_API void SetNativeMinorGCObserver(
+    JSContext* cx, NativeMinorGCObserver observer, void* data);
+
 }  // namespace JS

 #endif  // js_MemoryCallbacks_h
