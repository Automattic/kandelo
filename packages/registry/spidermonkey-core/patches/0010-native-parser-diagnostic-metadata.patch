+// Native parser facts belong to the actual report, not a last-error singleton.
+// Token numbers identify the matching engine's TokenKind. Strings are canonical
+// parsed names; neither consumers nor copy code need to inspect source/text.
+struct ParserDiagnostic {
+  enum class Origin : uint8_t {
+    None, TokenMismatch, UnexpectedToken, Redeclaration,
+    MetaProperty, SourceImportWithoutCall
