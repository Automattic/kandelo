+  Origin origin = Origin::None;
+  uint16_t actualToken = UINT16_MAX;
+  uint16_t expectedToken = UINT16_MAX;
+  bool escaped = false;
+  bool inModule = false;
+  const char* word = nullptr;
+  const char* identifier = nullptr;
+  // Frontend reports own these allocations. A copied ErrorObject report uses
+  // borrowed pointers into its existing single report allocation instead.
+  UniqueChars ownedWord;
+  UniqueChars ownedIdentifier;
+};
