 template <class ParseHandler, typename Unit>
+bool GeneralParser<ParseHandler, Unit>::fillParserTokenDiagnostic(
+    TokenKind actual, bool lookahead, JS::ParserDiagnostic::Origin origin,
+    TokenKind expected, JS::ParserDiagnostic* output) {
+  auto& diagnostic = *output;
+  diagnostic.origin = origin;
+  diagnostic.actualToken = uint16_t(actual);
+  diagnostic.expectedToken = expected == TokenKind::Limit ? UINT16_MAX
+                                                          : uint16_t(expected);
+  diagnostic.inModule = pc_->atModuleLevel();
+  const Token& token = lookahead ? anyChars.nextToken() : anyChars.currentToken();
+  MOZ_ASSERT(actual == TokenKind::Eol || actual == token.type);
+  if (actual == TokenKind::Name || actual == TokenKind::PrivateName) {
+    diagnostic.ownedWord = this->parserAtoms().toNewUTF8CharsZ(fc_, token.name());
+    if (!diagnostic.ownedWord) {
+      return false;
+    }
+    diagnostic.escaped =
+        token.pos.end - token.pos.begin != this->parserAtoms().length(token.name());
+  } else if (TokenKindIsPossibleIdentifierName(actual)) {
+    const char* word = ReservedWordToCharZ(actual);
+    const size_t bytes = strlen(word) + 1;
+    diagnostic.ownedWord.reset(js_pod_malloc<char>(bytes));
+    if (!diagnostic.ownedWord) {
+      ReportOutOfMemory(fc_);
+      return false;
+    }
+    memcpy(diagnostic.ownedWord.get(), word, bytes);
+  }
+  diagnostic.word = diagnostic.ownedWord.get();
+  return true;
+}
+
+template <class ParseHandler, typename Unit>
+void GeneralParser<ParseHandler, Unit>::errorWithParserToken(
+    TokenKind actual, bool lookahead, JS::ParserDiagnostic::Origin origin,
+    TokenKind expected, unsigned errorNumber, ...) {
+  JS::ParserDiagnostic diagnostic;
+  if (!fillParserTokenDiagnostic(actual, lookahead, origin, expected,
+                                 &diagnostic)) {
+    return;
+  }
+  va_list args;
+  va_start(args, errorNumber);
+  this->errorWithNotesAtVA(nullptr,
+      mozilla::AsVariant(ErrorReportMixin::Current()), errorNumber, &args,
+      &diagnostic);
+  va_end(args);
+}
