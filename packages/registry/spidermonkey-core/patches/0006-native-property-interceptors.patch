+// Embedding hooks for actual native objects. All JS edges remain in traced
+// object storage owned by the embedding; this vtable holds native code only.
+// A false return propagates the existing engine failure. A true return with
+// handled=false continues the complete original native operation. hasOwn is
+// own-only; the engine retains prototype traversal. Private names never enter
+// these hooks. Callbacks must root values they retain across engine calls.
+struct NativePropertyInterceptorOps {
+  bool (*get)(JSContext*, HandleObject holder, HandleValue receiver, HandleId,
+              MutableHandleValue, bool* handled) = nullptr;
+  bool (*hasOwn)(JSContext*, HandleObject holder, HandleId, bool* found,
+                 bool* handled) = nullptr;
+  bool (*getOwnPropertyDescriptor)(
+      JSContext*, HandleObject holder, HandleId,
+      MutableHandle<mozilla::Maybe<JS::PropertyDescriptor>>,
+      bool* handled) = nullptr;
+  bool (*defineProperty)(JSContext*, HandleObject holder, HandleId,
+                         Handle<JS::PropertyDescriptor>, JS::ObjectOpResult&,
+                         bool* handled) = nullptr;
+  bool (*set)(JSContext*, HandleObject holder, HandleValue receiver, HandleId,
+              HandleValue, JS::ObjectOpResult&, bool* handled) = nullptr;
+  bool (*deleteProperty)(JSContext*, HandleObject holder, HandleId,
+                         JS::ObjectOpResult&, bool* handled) = nullptr;
+  bool (*preventExtensions)(JSContext*, HandleObject, JS::ObjectOpResult&) = nullptr;
+};
+
+// Bypass is an explicit argument of one engine operation, never ambient state
+// that could leak into a getter, proxy trap or nested user operation.
+enum class NativePropertyInterception { Allow, Bypass };

