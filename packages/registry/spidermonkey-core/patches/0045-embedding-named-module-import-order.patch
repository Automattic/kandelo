+                           atomCache.getExistingAtomAt(cx, rhs->localName)) < 0;
+              });
+  }
+
+  size_t nextNamedImport = 0;
+  for (const StencilModuleEntry& originalEntry : importEntries) {
+    const StencilModuleEntry& entry =
+        orderNamedImports && originalEntry.importName
+            ? *namedImports[nextNamedImport++]
+            : originalEntry;
     Rooted<ModuleRequestObject*> moduleRequest(cx);
