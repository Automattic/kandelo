+  const bool orderNamedImports =
+      JS::ContextOptionsRef(cx).moduleResolutionErrorFormatter() &&
+      importEntries.length() > 1;
+  mozilla::Vector<const StencilModuleEntry*, 8, SystemAllocPolicy> namedImports;
