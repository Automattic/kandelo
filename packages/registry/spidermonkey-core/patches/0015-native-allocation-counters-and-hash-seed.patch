+// Event counters for native consumers of the collector's malloc accounting.
+// The runtime counter observes all zones; it is not a sampled sum of peaks.
+class NativeAllocationCounters {
+  mozilla::Atomic<uint64_t, mozilla::Relaxed> bytes_{0};
+  mozilla::Atomic<uint64_t, mozilla::Relaxed> peak_{0};
+ public:
+  void add(size_t bytes) {
+    const uint64_t current = (bytes_ += uint64_t(bytes));
+    uint64_t previous = peak_;
+    while (previous < current && !peak_.compareExchange(previous, current)) {
+      previous = peak_;
+    }
+  }
+  void remove(size_t bytes) {
+    MOZ_RELEASE_ASSERT(uint64_t(bytes) <= bytes_);
+    bytes_ -= uint64_t(bytes);
+  }
+  uint64_t bytes() const { return bytes_; }
+  uint64_t peak() const { return peak_; }
+};
