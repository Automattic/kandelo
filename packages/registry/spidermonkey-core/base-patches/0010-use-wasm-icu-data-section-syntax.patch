# Kandelo patch rationale (S08)
# Judgment: Supported. Keep the assembly adjustment because the bundled ICU
# data uses syntax that must match the Wasm object format.
#
# The engine embeds ICU's Unicode data through assembly, and Wasm requires
# these section and size directives. Reuse Mozilla's existing Wasm syntax
# instead of changing the data or assembler to accept another object
# format. The OS and bridge run after this file must assemble. Review a
# stock ICU packaging option if one can produce the same data symbols and
# alignment.
#
# Retained provisionally; see README.md: Future work: platform omissions.

--- a/config/external/icu/data/icu_data.S
+++ b/config/external/icu/data/icu_data.S
@@ -18,7 +18,7 @@
 #elif defined(__APPLE__)
 .data
 .const
-#elif defined(__wasi__)
+#elif defined(__wasi__) || defined(__wasm32__)
 .section .rodata,"",@
 #else
 .section .rodata
@@ -28,5 +28,5 @@
 ICU_DATA_SYMBOL:
 .incbin ICU_DATA_FILE
-#ifdef __wasi__
+#if defined(__wasi__) || defined(__wasm32__)
 .size ICU_DATA_SYMBOL, . - ICU_DATA_SYMBOL
 #endif
