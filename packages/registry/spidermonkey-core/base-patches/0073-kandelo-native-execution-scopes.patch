+ public:
+  enum EmbedderExecutionRestriction : uint8_t {
+    EmbedderCrashOnExecution = 1,
+    EmbedderThrowOnExecution = 2
+  };
+  uint8_t embedderExecutionRestrictions() const {
+    MOZ_ASSERT(js::TlsContext.get() == this);
+    return embedderExecutionRestrictions_;
+  }
+  void setEmbedderExecutionRestrictions(uint8_t restrictions) {
+    MOZ_RELEASE_ASSERT(js::TlsContext.get() == this);
+    MOZ_RELEASE_ASSERT(!(restrictions &
+        ~(EmbedderCrashOnExecution | EmbedderThrowOnExecution)));
+    MOZ_RELEASE_ASSERT(!(restrictions & EmbedderCrashOnExecution) ||
+                       embedderExecutionFatal_);
+    embedderExecutionRestrictions_ = restrictions;
+  }
+  bool checkEmbedderScriptExecution() {
+    // Match admission ordering: denial scopes precede termination delivery.
+    if (embedderExecutionRestrictions_) return onDisallowedEmbedderExecution();
+    return checkNativeTermination();
+  }

  private:
   // One thread-safe termination record. Low bits are request/active state;
