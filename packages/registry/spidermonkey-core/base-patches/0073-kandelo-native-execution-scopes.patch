+namespace {
+void DefaultNativeExecutionFatal(const char*) { std::abort(); }
+std::atomic<JS::NativeExecutionFatalHandler> nativeExecutionFatalHandler{
+    DefaultNativeExecutionFatal};
+}  // namespace
+
+void JS::SetNativeExecutionFatalHandler(NativeExecutionFatalHandler handler) {
+  MOZ_RELEASE_ASSERT(handler);
+  nativeExecutionFatalHandler.store(handler, std::memory_order_release);
+}
+
+bool JSContext::onDisallowedEmbedderExecution() {
+  MOZ_RELEASE_ASSERT(js::TlsContext.get() == this);
+  if (embedderExecutionRestrictions_ & EmbedderCrashOnExecution) {
+    MOZ_RELEASE_ASSERT(embedderExecutionFatal_);
+    embedderExecutionFatal_("Invoke in DisallowJavascriptExecutionScope");
+    // A returning handler is invalid; never continue or substitute a Wasm trap.
+    std::abort();
+  }
+  MOZ_RELEASE_ASSERT(embedderExecutionRestrictions_ & EmbedderThrowOnExecution);
+  if (!isNativeExecutionTerminating() && !isExceptionPending() &&
+      !isPropagatingForcedReturn()) {
+    js::AssertHeapIsIdle();
+    JS::RootedValue denied(this, JS::StringValue(names().kandeloIllegalAccess));
+    // Restore the native state directly: no allocation, stack capture,
+    // optional error interception or Error constructor during denial.
+    restorePendingExceptionState(JS::ExceptionStatus::Throwing, denied, nullptr);
+  }
+  return false;
+}
