# Kandelo patch rationale (S07)
# Judgment: Mixed. Per-thread stack identity is needed, but standard
# pthread bounds may replace this frame-address path.
#
# Engine recursion checks need a stack reference from the thread creating
# the JSContext, not the process startup thread. Each guest pthread has its
# own linear-memory stack; the bridge separately sets Node's lower limit. A
# frame address is only a reference, not the full stack bounds. Standard
# pthread stack queries are a plausible platform replacement, but their use
# through Mozilla's path has not been qualified. Keep this provisionally.
#
# Retained provisionally; see README.md: Future work: platform omissions.

--- a/js/src/util/NativeStack.cpp
+++ b/js/src/util/NativeStack.cpp
@@ -8,7 +8,7 @@

 #ifdef XP_WIN
 #  include "util/WindowsWrapper.h"
-#elif defined(__wasi__)
+#elif defined(__wasi__) || (defined(__wasm32__) && !defined(__EMSCRIPTEN__))
 // Nothing
 #elif defined(XP_DARWIN) || defined(DARWIN) || defined(XP_UNIX)
 #  include <pthread.h>
@@ -114,10 +114,21 @@
 #  endif
 }

+#elif defined(__wasm32__) && !defined(__EMSCRIPTEN__) && !defined(__wasi__)
+
+void* js::GetNativeStackBaseImpl() {
+  static_assert(JS_STACK_GROWTH_DIRECTION < 0);
+  // The guest has a separate linear-memory stack for every pthread. Capture
+  // this context's creating-thread frame, never the process startup thread.
+  // JSContext retains the address and Node supplies the real lower limit.
+  return __builtin_frame_address(0);
+}
+
 #elif defined(__wasi__)

-// Since we rearrange the layout for wasi via --stack-first flag for the linker
-// the final layout is: 0x00 | <- stack | data | heap -> |.
+// On wasm there is no native pthread stack mapping to query. Capture the
+// frame address during startup and use that as the high-water mark for the
+// downward-growing native stack checks.
 static void* const NativeStackBase = __builtin_frame_address(0);

