+// Existing-object native DATA semantics. The embedding supplies a native
+// record object whose first reserved slot is a PrivateValue pointing at these
+// immutable operations. That object is traced from the real property slot;
+// the embedding owns its remaining slots, callback records and finalizer.
+struct NativeDataPropertyOperations {
+  bool (*getter)(JSContext*, HandleObject, HandleId, HandleValue,
+                 MutableHandleValue);
+  bool (*liveGetter)(JSContext*, HandleObject, HandleValue, HandleId, HandleValue,
+                     MutableHandleValue);
+  bool (*setter)(JSContext*, HandleObject, HandleId, HandleValue, HandleValue,
+                 ObjectOpResult&);
+};
+extern bool DefineNativeDataPropertyWithRecord(
+    JSContext* cx, HandleObject target, HandleId id, HandleObject record,
+    unsigned attrs, ObjectOpResult& result);

