+// The embedding owns the record class, callback storage and finalization.
+// Its first reserved slot points to immutable, process-resident operations;
+// remaining traced slots belong entirely to the embedding.
+static const NativeDataPropertyOperations& NativeDataOperations(JSObject* record) {
+  return *static_cast<const NativeDataPropertyOperations*>(
+      record->as<NativeObject>().getReservedSlot(0).toPrivate());
+}
+
+bool js::DefineNativeDataPropertyWithRecord(
+    JSContext* cx, HandleObject target, HandleId id, HandleObject record,
+    unsigned attrs, ObjectOpResult& result) {
+  cx->check(target, id, record);
+  if (!target->is<NativeObject>()) {
+    JS_ReportErrorASCII(cx, "Native data properties require a native target");
+    return false;
+  }
+  MOZ_ASSERT(record->is<NativeObject>());
+  MOZ_ASSERT(JSCLASS_RESERVED_SLOTS(record->getClass()) >= 1);
+  const auto& operations = NativeDataOperations(record);
+  MOZ_ASSERT(bool(operations.getter) != bool(operations.liveGetter));
+  RootedValue value(cx, ObjectValue(*record));
+  Rooted<PropertyDescriptor> desc(cx, PropertyDescriptor::Data(value, attrs));
+  return NativeDefineProperty(cx, target.as<NativeObject>(), id, desc, result, true);
+}
+
+static bool IsKandeloLiveDataProperty(NativeObject* obj, PropertyInfo prop) {
+  MOZ_ASSERT(prop.isKandeloLazyDataProperty());
+  auto& record = obj->getSlot(prop.slot()).toObject().as<NativeObject>();
+  const auto* callback = &NativeDataOperations(&record);
+  return callback->liveGetter != nullptr;
+}
+static bool HasKandeloNativeDataSetter(HandleValue value) {
+  auto& record = value.toObject().as<NativeObject>();
+  const auto* callback = &NativeDataOperations(&record);
+  return callback->setter != nullptr;
+}
+static bool SetKandeloNativeDataProperty(JSContext* cx,
+                                         Handle<NativeObject*> obj,
+                                         HandleId id, HandleValue value,
+                                         HandleValue input,
+                                         ObjectOpResult& result) {
+  Rooted<NativeObject*> record(
+      cx, &value.toObject().as<NativeObject>());
+  const auto* callback = &NativeDataOperations(record);
+  MOZ_ASSERT(callback->setter);
+  RootedValue data(cx, ObjectValue(*record));
+  return callback->setter(cx, obj, id, data, input, result);
+}
+static bool GetKandeloLazyDataProperty(JSContext* cx, Handle<NativeObject*> obj,
+                                       HandleId id, PropertyInfo prop,
+                                       MutableHandleValue value) {
+  RootedValue receiver(cx, ObjectValue(*obj));
+  return GetKandeloLazyDataProperty(cx, obj, receiver, id, prop, value);
+}
+static bool GetKandeloLazyDataProperty(JSContext* cx, Handle<NativeObject*> obj,
+                                       HandleValue receiver, HandleId id,
+                                       PropertyInfo prop,
+                                       MutableHandleValue value) {
+  MOZ_ASSERT(prop.isKandeloLazyDataProperty());
+  Rooted<NativeObject*> record(
+      cx, &obj->getSlot(prop.slot()).toObject().as<NativeObject>());
+  const auto* callback = &NativeDataOperations(record);
+  RootedValue data(cx, ObjectValue(*record));
+  if (callback->liveGetter) {
+    return callback->liveGetter(cx, obj, receiver, id, data, value);
+  }
+  if (!callback->getter(cx, obj, id, data, value)) return false;
+
+  // The callback may collect, throw, delete or redefine the property. Cache
+  // only into the exact still-live record; never resurrect a deleted property
+  // or overwrite a value assigned by reentrant script.
+  PropertyResult current;
+  if (!NativeLookupOwnPropertyNoResolve(cx, obj, id, &current)) return false;
+  if (current.isNativeProperty()) {
+    auto info = current.propertyInfo();
+    if (info.isKandeloLazyDataProperty() &&
+        obj->getSlot(info.slot()) == ObjectValue(*record)) {
+      auto flags = info.flags();
+      flags.clearFlag(PropertyFlag::KandeloLazyDataProperty);
+      uint32_t slot;
+      if (!NativeObject::changeProperty(cx, obj, id, flags, &slot)) return false;
+      Watchtower::watchPropertyValueChange<AllowGC::CanGC>(cx, obj, id, value, info);
+      obj->setSlot(slot, value);
+    }
+  }
+  return true;
 }

