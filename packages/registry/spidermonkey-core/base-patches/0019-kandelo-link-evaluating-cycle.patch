# Kandelo patch rationale (S10)
# Judgment: Weak. The rejected frontend motivated this broad cycle change;
# a remaining need under Node loaders is unproven.
#
# This changes module-cycle bookkeeping for reentrant linking/evaluation.
# It was introduced for the old compatibility frontend, which is no longer
# an accepted runtime path. A remaining need under Node's original loaders
# has NOT been established. Keep it only until cycle behavior can be
# checked and the bridge's module-state handling reviewed; prefer removing
# this broad algorithm change over treating it as a permanent missing
# engine capability.
#
# Retained provisionally; see README.md: Future work: platform omissions.

--- a/js/src/vm/Modules.cpp
+++ b/js/src/vm/Modules.cpp
@@ -1910,8 +1910,20 @@

   // Step 2. If module.[[Status]] is linking, linked, evaluating-async, or
   //         evaluated, then:
+  //
+  // Kandelo: also early-return for `evaluating`. The ES spec omits it because
+  // it assumes the whole module graph is linked before any evaluation begins,
+  // so a dependency can never be mid-evaluation during linking. Kandelo's
+  // node-compat loads modules incrementally (each require()/import() during
+  // evaluation links a fresh sub-graph), so linking a newly loaded module can
+  // legitimately recurse into an already-evaluating module reached through a
+  // dependency cycle. Such a module is already fully linked (its environment
+  // and bindings were resolved before evaluation started), so treat it like
+  // linked/evaluated and skip re-linking instead of throwing
+  // "module record has unexpected status: Evaluating".
   if (module->status() == ModuleStatus::Linking ||
       module->status() == ModuleStatus::Linked ||
+      module->status() == ModuleStatus::Evaluating ||
       module->status() == ModuleStatus::EvaluatingAsync ||
       module->status() == ModuleStatus::Evaluated) {
     // Step 2.a. Return index.
@@ -2277,6 +2289,19 @@
       MOZ_ASSERT(requiredModule->status() == ModuleStatus::Evaluating ||
                  requiredModule->status() == ModuleStatus::EvaluatingAsync ||
                  requiredModule->status() == ModuleStatus::Evaluated);
+
+      // Kandelo: an `evaluating` module that is NOT in |stack| is an ancestor
+      // on an outer evaluation that is suspended inside its own body, because
+      // node-compat require()s or imports a fresh module graph from there (the
+      // same incremental loading the linking early-return above accepts). It
+      // is already linked and finishes evaluating when control returns to it,
+      // so this graph neither joins its strongly connected component nor
+      // waits for it: skip the cycle bookkeeping instead of throwing
+      // "module record has unexpected status: Evaluating".
+      if (requiredModule->status() == ModuleStatus::Evaluating &&
+          !ContainsElement(stack, requiredModule)) {
+        continue;
+      }

       // Step 11.b.ii.2. Assert: requiredModule.[[Status]] is evaluating if
       // and only if requiredModule is in stack.
