# Kandelo patch rationale (S04)
#
# Mozilla's Rust entropy crate must use Kandelo libc rather than a browser
# import. Keep this small same-crate module hook so Rust's Result/Error types
# match the original shim. The actual byte-filling code lives in platform/
# getrandom.rs; the runtime bridge cannot configure a Rust crate after it is
# compiled. Preserve short-read and failure behavior.
#
# Source-only cleanup; not rebuilt or behavior-qualified. Retention remains
# subject to README.md: Future work: platform omissions.

--- a/build/rust/getrandom/lib.rs
+++ b/build/rust/getrandom/lib.rs
@@ -3,3 +3,7 @@
  * file, You can obtain one at http://mozilla.org/MPL/2.0/. */

 pub use {getrandom::fill as getrandom, getrandom::Error};
+
+// The platform owns the implementation; this crate preserves Rust type identity.
+#[cfg(all(target_arch = "wasm32", target_os = "unknown"))]
+mod kandelo_getrandom;
