+void JSContext::requestNativeTermination() {
+  // Publication and cancellation are linearized by the same atomic record.
+  // Notification may outlive a canceled request; it cannot re-activate it.
+  while (true) {
+    uint64_t state = nativeTermination_;
+    if ((state & NativeTerminationMask) != 0) break;
+    if (nativeTermination_.compareExchange(
+            state, state | NativeTerminationRequested)) break;
+  }
+  requestInterrupt(js::InterruptReason::CallbackUrgent);
+}
+
+void JSContext::cancelNativeTermination() {
+  while (true) {
+    uint64_t state = nativeTermination_;
+    uint64_t next = state & ~NativeTerminationMask;
+    if ((state & NativeTerminationMask) == NativeTerminationActive) next += 4;
+    if (nativeTermination_.compareExchange(state, next)) return;
+  }
+}
