                                       js::NativeFrameMetadata**) = nullptr;
+
+  // Synchronous construction observations; the embedding must not enter JS.
+  // Objects and actual constructors are rooted at the original event sites.
+  bool (*embedderConstructionObserver)(JSContext*, JS::HandleObject,
+                                       JS::HandleObject, bool direct) = nullptr;

   JSRuntime* runtime() { return runtime_; }
