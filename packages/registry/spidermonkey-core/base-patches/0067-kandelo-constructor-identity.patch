+class NativeObjectRealmMetadata {
+ public:
+  virtual ~NativeObjectRealmMetadata() = default;
+  virtual void trace(JSTracer*) = 0;
+  virtual void finishRoots() = 0;
+  virtual size_t sizeOfIncludingThis(mozilla::MallocSizeOf) = 0;
+};
