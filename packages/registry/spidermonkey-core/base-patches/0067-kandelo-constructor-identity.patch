+bool ObjectRealm::recordConstructorIdentity(JSContext* cx, HandleObject obj,
+                                            HandleObject constructor) {
+  if (auto observer = cx->embedderConstructionObserver) {
+    return observer(cx, obj, constructor, true);
+  }
+  return true;
+}
