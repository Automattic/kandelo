+    JSCLASS_HAS_RESERVED_SLOTS(ModuleRequestObject::SlotCount) |
+        JSCLASS_FOREGROUND_FINALIZE,
+    &moduleRequestOps,
 };
+
+static size_t ImportAttributesBytes(const ImportAttributeVector& attributes) {
+  return sizeof(ImportAttributeVector) +
+         attributes.capacity() * sizeof(ImportAttribute);
+}
+
+void ModuleRequestObject::trace(JSTracer* trc, JSObject* obj) {
+  auto& self = obj->as<ModuleRequestObject>();
+  const auto& slot = self.getReservedSlot(AttributesDataSlot);
+  if (!slot.isUndefined()) {
+    static_cast<ImportAttributeVector*>(slot.toPrivate())->trace(trc);
+  }
+}
+
+void ModuleRequestObject::finalize(JS::GCContext* gcx, JSObject* obj) {
+  auto& self = obj->as<ModuleRequestObject>();
+  const auto& slot = self.getReservedSlot(AttributesDataSlot);
+  if (!slot.isUndefined()) {
+    auto* attributes = static_cast<ImportAttributeVector*>(slot.toPrivate());
+    gcx->removeCellMemory(obj, ImportAttributesBytes(*attributes),
+                          MemoryUse::Embedding3);
+    js_delete(attributes);
+  }
+}

