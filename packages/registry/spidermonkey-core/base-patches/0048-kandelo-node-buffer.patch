+void ArrayBufferObject::accountKandeloExternalBytes() {
+  MOZ_RELEASE_ASSERT(isExternal() && !(flags() & KANDELO_EXTERNAL_CREDIT));
+  if (!byteLength()) return;
+  AddCellMemory(this, byteLength(), MemoryUse::Embedding2);
+  setFlags(flags() | KANDELO_EXTERNAL_CREDIT);
+}
+
+KandeloArrayBufferContents::~KandeloArrayBufferContents() {
+  if (!committed) return;
+  switch (contents.kind()) {
+    case ArrayBufferObject::MALLOCED_ARRAYBUFFER_CONTENTS_ARENA:
+    case ArrayBufferObject::MALLOCED_UNKNOWN_ARENA: js_free(contents.data()); break;
+    case ArrayBufferObject::MAPPED:
+      gc::DeallocateMappedContent(contents.data(), allocationLength); break;
+    case ArrayBufferObject::EXTERNAL:
+      contents.freeFunc()(contents.data(), contents.freeUserData()); break;
+    case ArrayBufferObject::WASM: WasmArrayRawBuffer::Release(contents.data()); break;
+    case ArrayBufferObject::USER_OWNED:
+    case ArrayBufferObject::NO_DATA: break;
+    case ArrayBufferObject::INLINE_DATA:
+      MOZ_CRASH("Native owner cannot retain moving inline bytes");
+  }
+}
