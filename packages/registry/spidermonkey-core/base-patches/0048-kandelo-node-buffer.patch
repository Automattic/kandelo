+// Native allocation owner. It has no GC edges and may outlive every realm.
+// The embedding owns the concrete native lifetime and release policy. The
+// engine only adopts that lease and notifies it when the real length changes.
+class NativeArrayBufferOwner {
+ public:
+  virtual ~NativeArrayBufferOwner() = default;
+  virtual const ArrayBufferObject::BufferContents& contents() const = 0;
+  virtual size_t allocationLength() const = 0;
+  virtual size_t byteLength() const = 0;
+  virtual size_t maxByteLength() const = 0;
+  virtual bool resizable() const = 0;
+  virtual bool committed() const = 0;
+  virtual void commit() = 0;
+  virtual void resize(size_t length) = 0;
+};
+using NativeArrayBufferOwnerFactory = std::shared_ptr<NativeArrayBufferOwner> (*)(
+    ArrayBufferObject::BufferContents, size_t, size_t, bool);
+// Register before any embedding retains contents. The function and concrete
+// deleter must remain resident until every native lease has retired.
+void SetNativeArrayBufferOwnerFactory(NativeArrayBufferOwnerFactory factory);
+// Release a committed allocation using its actual engine allocator. The
+// caller owns exactly-once policy; this primitive neither runs JS nor a GC.
+void ReleaseNativeArrayBufferContents(
+    const ArrayBufferObject::BufferContents& contents, size_t allocationLength);

