+void ArrayBufferObject::accountKandeloExternalBytes() {
+  MOZ_RELEASE_ASSERT(isExternal() && !(flags() & KANDELO_EXTERNAL_CREDIT));
+  if (!byteLength()) return;
+  AddCellMemory(this, byteLength(), MemoryUse::Embedding2);
+  setFlags(flags() | KANDELO_EXTERNAL_CREDIT);
+}
+
+namespace {
+std::atomic<NativeArrayBufferOwnerFactory> nativeBufferOwnerFactory{nullptr};
+}
+void js::SetNativeArrayBufferOwnerFactory(NativeArrayBufferOwnerFactory factory) {
+  MOZ_RELEASE_ASSERT(factory);
+  nativeBufferOwnerFactory.store(factory, std::memory_order_release);
+}
+
+void js::ReleaseNativeArrayBufferContents(
+    const ArrayBufferObject::BufferContents& contents, size_t allocationLength) {
+  switch (contents.kind()) {
+    case ArrayBufferObject::MALLOCED_ARRAYBUFFER_CONTENTS_ARENA:
+    case ArrayBufferObject::MALLOCED_UNKNOWN_ARENA: js_free(contents.data()); break;
+    case ArrayBufferObject::MAPPED:
+      gc::DeallocateMappedContent(contents.data(), allocationLength); break;
+    case ArrayBufferObject::EXTERNAL:
+      contents.freeFunc()(contents.data(), contents.freeUserData()); break;
+    case ArrayBufferObject::WASM: WasmArrayRawBuffer::Release(contents.data()); break;
+    case ArrayBufferObject::USER_OWNED:
+    case ArrayBufferObject::NO_DATA: break;
+    case ArrayBufferObject::INLINE_DATA:
+      MOZ_CRASH("Native owner cannot retain moving inline bytes");
+  }
+}
+
+std::shared_ptr<NativeArrayBufferOwner> ArrayBufferObject::kandeloContentsOwner() const {
+  const auto& slot = getFixedSlot(KANDELO_CONTENTS_SLOT);
+  if (slot.isUndefined()) return {};
+  return *static_cast<std::shared_ptr<NativeArrayBufferOwner>*>(slot.toPrivate());
+}
+
+/* static */ std::shared_ptr<NativeArrayBufferOwner> ArrayBufferObject::retainKandeloContents(
+    JSContext* cx, Handle<ArrayBufferObject*> buffer) {
+  if (auto owner = buffer->kandeloContentsOwner()) return owner;
+  if (buffer->isDetached()) return {};
+  if (buffer->isInlineData() && !ensureNonInline(cx, buffer)) return {};
+  BufferContents contents = buffer->contents();
+  const size_t length = buffer->byteLength();
+  // Allocate both metadata owners before committing byte ownership.
+  // Resizing updates the shared native length; detachment retains that length.
+  try {
+    auto factory = nativeBufferOwnerFactory.load(std::memory_order_acquire);
+    if (!factory) {
+      JS_ReportErrorASCII(cx, "Native buffer owner factory is not installed");
+      return {};
+    }
+    auto owner = factory(contents, length, buffer->maxByteLength(), buffer->isResizable());
+    MOZ_RELEASE_ASSERT(owner);
+    auto slot = std::make_unique<std::shared_ptr<NativeArrayBufferOwner>>(owner);
+    buffer->setFixedSlot(KANDELO_CONTENTS_SLOT, PrivateValue(slot.release()));
+    owner->commit();
+    return owner;
+  } catch (const std::bad_alloc&) {
+    ReportOutOfMemory(cx);
+    return {};
+  }
+}
