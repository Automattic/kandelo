   initReservedSlot(JSSLOT_SOURCEID, PrivateUint32Value(sourceId));
+}
+
+void SavedFrame::initKandeloSourceKind(KandeloSourceKind kind) {
+  initReservedSlot(JSSLOT_KANDELO_SOURCE_KIND, PrivateUint32Value(uint32_t(kind)));
+}
+
+void SavedFrame::initNativeFrameMetadata(NativeFrameMetadata* metadata) {
+  if (metadata) metadata->AddRef();
+  initReservedSlot(JSSLOT_NATIVE_FRAME_METADATA, PrivateValue(metadata));
