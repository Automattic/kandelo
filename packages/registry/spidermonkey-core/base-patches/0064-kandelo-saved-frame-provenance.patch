+void SavedFrame::initKandeloSourceKind(KandeloSourceKind kind) {
+  initReservedSlot(JSSLOT_KANDELO_SOURCE_KIND, PrivateUint32Value(uint32_t(kind)));
+}
+
+void SavedFrame::initKandeloScriptSource(ScriptSource* source) {
+  // Retain immutable source ownership without retaining a script or its realm.
+  if (source) source->AddRef();
+  initReservedSlot(JSSLOT_KANDELO_SCRIPT_SOURCE, PrivateValue(source));
 }

