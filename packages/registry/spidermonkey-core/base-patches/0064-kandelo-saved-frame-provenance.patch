+SavedFrame::KandeloSourceKind SavedFrame::getKandeloSourceKind() {
+  auto value = getReservedSlot(JSSLOT_KANDELO_SOURCE_KIND);
+  return value.isUndefined() ? KandeloSourceKind::Unknown
+                             : KandeloSourceKind(value.toPrivateUint32());
+}
+
+ScriptSource* SavedFrame::getKandeloScriptSource() {
+  auto value = getReservedSlot(JSSLOT_KANDELO_SCRIPT_SOURCE);
+  return value.isUndefined() ? nullptr
+                             : static_cast<ScriptSource*>(value.toPrivate());
+}
