+SavedFrame::KandeloSourceKind SavedFrame::getKandeloSourceKind() {
+  auto value = getReservedSlot(JSSLOT_KANDELO_SOURCE_KIND);
+  return value.isUndefined() ? KandeloSourceKind::Unknown
+                             : KandeloSourceKind(value.toPrivateUint32());
+}
+
+NativeFrameMetadata* SavedFrame::getNativeFrameMetadata() {
+  auto value = getReservedSlot(JSSLOT_NATIVE_FRAME_METADATA);
+  return value.isUndefined() ? nullptr
+                             : static_cast<NativeFrameMetadata*>(value.toPrivate());
+}
+
 uint32_t SavedFrame::getSourceId() {
   const Value& v = getReservedSlot(JSSLOT_SOURCEID);
   return v.toPrivateUint32();
