+// Opaque, thread-confined embedding metadata. It must contain no untraced JS
+// edges. The embedding owns the concrete record, storage and retirement.
+class NativeFrameMetadata {
+ public:
+  virtual void AddRef() = 0;
+  virtual void Release() = 0;
+ protected:
+  virtual ~NativeFrameMetadata() = default;
+};

