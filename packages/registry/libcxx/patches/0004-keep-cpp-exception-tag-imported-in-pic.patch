# libunwind linkage boundary: keep __cpp_exception imported in PIC builds
#
# Wasm C++ exceptions are thrown and caught with one exception tag,
# __cpp_exception. A throw and a catch interoperate only if both modules
# use the same tag identity. Since llvm-project #185770, LLVM 23's
# libunwind always defines the tag in Unwind-wasm.c, and compiled code
# only references it. Upstream assumes one libunwind per process, for
# example a single libunwind.so, so the definition is unique.
#
# Kandelo does not ship a shared C++ runtime. Each C++ side module
# statically links libc++abi-pic.a, which bundles libunwind (PHP's
# intl.so, for example). With upstream's definition every such side
# module defines and exports its own private tag instead of importing
# env.__cpp_exception, so exceptions cannot cross module boundaries.
# That breaks the program ABI's "C++ exception tag shared with the host"
# entry (crates/program-abi/src/lib.rs). LLVM 21 left the tag undefined
# in PIC objects and defined it weak in non-PIC objects.
#
# Guard the definition with !__PIC__. Clang defines __PIC__ for -fPIC,
# which the recipe passes only for the libc++-pic.a/libc++abi-pic.a
# build, so side modules import the process's canonical tag again. The
# non-PIC archives keep upstream's single definition for main programs.
# The recipe fails the build if a PIC archive defines the tag or the
# non-PIC libc++abi.a does not.
#
# Retire this patch once a process shares one C++ runtime across its
# side modules (docs/future-improvements.md, "Share one C++ runtime per
# process across side modules").
#
# Upstream: llvm-project, tag llvmorg-23.1.3 (LLVM 23.1.3).
# Upstream status: not proposed upstream; it adapts upstream's
# single-libunwind model to Kandelo's statically bundled side modules.
--- a/libunwind/src/Unwind-wasm.c
+++ b/libunwind/src/Unwind-wasm.c
@@ -74,6 +74,12 @@
 // definition for this API and it's required for users to ensure that there's
 // only one copy of `libunwind` within a wasm module to ensure this is only
 // defined once and exactly once.
+//
+// Kandelo: the position-independent build is statically linked into each
+// C++ side module, so a definition there would give every side module a
+// private tag. Leave the symbol undefined in PIC builds so that each side
+// module imports the process's canonical env.__cpp_exception tag.
+#ifndef __PIC__
 __asm__(".globl __cpp_exception\n"
 #if defined(__wasm32__)
         ".tagtype __cpp_exception i32\n"
@@ -83,6 +89,7 @@
 #error "Unsupported Wasm architecture"
 #endif
         "__cpp_exception:\n");
+#endif // !defined(__PIC__)
 
 /// Called by __cxa_end_catch.
 _LIBUNWIND_EXPORT void
