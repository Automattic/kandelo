--- a/libunwind/src/CMakeLists.txt
+++ b/libunwind/src/CMakeLists.txt
@@ -27,10 +27,15 @@
                               # libunwind.  See #56825 and #120657 for context.
                               COMPILE_FLAGS "-std=c99 -fexceptions")
 
-set(LIBUNWIND_ASM_SOURCES
-    UnwindRegistersRestore.S
-    UnwindRegistersSave.S
-    )
+set(LIBUNWIND_ASM_SOURCES)
+# Wasm unwinding is performed by the VM through Unwind-wasm.c. Hardware
+# register save/restore assembly has no implementation for Wasm objects.
+if (NOT CMAKE_SYSTEM_PROCESSOR MATCHES "^wasm(32|64)$")
+  list(APPEND LIBUNWIND_ASM_SOURCES
+      UnwindRegistersRestore.S
+      UnwindRegistersSave.S
+      )
+endif()
 
 set(LIBUNWIND_HEADERS
     AddressSpace.hpp
