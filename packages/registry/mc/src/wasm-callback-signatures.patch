+
+/* --------------------------------------------------------------------------------------------- */
+
+/**
+ * Destroy one child widget of a group.
+ *
+ * Exists so the callback has the exact GFunc signature. Casting
+ * widget_destroy (one parameter) to GFunc (two) is undefined behaviour that
+ * native ABIs happen to tolerate; WebAssembly type-checks every indirect
+ * call and traps on it, which killed mc whenever a group was destroyed --
+ * closing any dialog, or quitting.
+ */
+static void
+group_widget_destroy (gpointer data, gpointer user_data)
+{
+    (void) user_data;
+    widget_destroy (WIDGET (data));
 }
 
