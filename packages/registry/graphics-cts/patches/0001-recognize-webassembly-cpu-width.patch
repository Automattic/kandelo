+#if !((DE_CPU == DE_CPU_X86_64 || DE_CPU == DE_CPU_ARM_64 || DE_CPU == DE_CPU_MIPS_64 || DE_CPU == DE_CPU_RISCV_64 || DE_CPU == DE_CPU_WASM64) && \
       (DE_PTR_SIZE == 8)) &&                                                                                           \
-    !((DE_CPU == DE_CPU_X86 || DE_CPU == DE_CPU_ARM || DE_CPU == DE_CPU_MIPS || DE_CPU == DE_CPU_RISCV_32) &&          \
+    !((DE_CPU == DE_CPU_X86 || DE_CPU == DE_CPU_ARM || DE_CPU == DE_CPU_MIPS || DE_CPU == DE_CPU_RISCV_32 || DE_CPU == DE_CPU_WASM32) &&          \
       (DE_PTR_SIZE == 4))
 #error "DE_CPU and DE_PTR_SIZE mismatch"
