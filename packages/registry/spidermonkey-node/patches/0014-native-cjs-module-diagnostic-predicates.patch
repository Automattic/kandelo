+  const auto diagnostic = message->GetNativeCompileDiagnostic();
+  using Kind = v8::NativeCompileDiagnosticKind;
+  if (diagnostic.kind == Kind::Unclassified) {
+    FPrintF(stderr, "Unclassified native compiler diagnostic: %u\n",
+            diagnostic.engineCode);
+    // Do not guess a module retry or abort on a user syntax error. This
+    // diagnostic remains an explicit nonpassing classification gap.
+    return false;
+  }
+
+  // Preserve the original immediate ESM branch before conditional compilation.
+  if (diagnostic.kind == Kind::DefiniteModuleSyntax) {
+    return true;
+  }
+
+  bool maybe_valid_in_esm = diagnostic.kind == Kind::ConditionalModule;
+  if (diagnostic.kind == Kind::Redeclaration) {
+    CHECK(!diagnostic.identifier.IsEmpty());
+    Utf8Value identifier(isolate, diagnostic.identifier);
+    const auto identifier_view = identifier.ToStringView();
+    for (const auto& name : cjs_wrapper_names) {
+      if (identifier_view == name) {
+        maybe_valid_in_esm = true;
+        break;
+      }
     }
   }

