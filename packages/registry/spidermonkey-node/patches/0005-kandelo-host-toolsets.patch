+  # Darwin's native linker cannot consume GNU thin archives. Use the original
+  # standalone archive rule for build tools, independently of guest libraries.
+  output['target_conditions'].append([
+    '_toolset=="host" and _type=="static_library"', {'standalone_static_library': 1}])
+
 # Add configurations to target defaults
