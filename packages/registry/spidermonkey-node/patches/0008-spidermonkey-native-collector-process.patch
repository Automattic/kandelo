# Kandelo patch rationale (O29)
#
# Node startup/shutdown otherwise initializes V8's separate cppgc
# collector. Under this port SpiderMonkey traces the native wrappers
# through the approved lifetime hooks. Guard only cppgc process
# setup/teardown rather than link a second collector or provide successful
# fake initialization. The guest OS cannot choose JS reachability, and
# required wrapper tracing and resource cleanup must remain real in the
# bridge.
#
# Judgment: Supported. SpiderMonkey owns collection under the approved
# design, so V8 cppgc process initialization is inappropriate.
#
--- a/src/node.cc
+++ b/src/node.cc
@@ -74,7 +74,9 @@
 #endif  // NODE_USE_V8_PLATFORM
 #include "v8-profiler.h"

+#if !defined(KANDELO_SPIDERMONKEY_ENGINE)
 #include "cppgc/platform.h"
+#endif

 #if HAVE_INSPECTOR
 #include "inspector/worker_inspector.h"  // ParentInspectorHandle
@@ -1372,6 +1374,7 @@
     result->platform_ = per_process::v8_platform.Platform();
   }

+#if !defined(KANDELO_SPIDERMONKEY_ENGINE)
   if (!(flags & ProcessInitializationFlags::kNoInitializeCppgc)) {
     v8::PageAllocator* allocator = nullptr;
     if (result->platform_ != nullptr) {
@@ -1379,6 +1382,7 @@
     }
     cppgc::InitializeProcess(allocator);
   }
+#endif

   if (flags & ProcessInitializationFlags::kNoHarvestBuiltinCodeCache) {
     builtins::BuiltinLoader::SetHarvestCodeCache(false);
@@ -1445,9 +1449,11 @@
     ResetSignalHandlers();
   }

+#if !defined(KANDELO_SPIDERMONKEY_ENGINE)
   if (!(flags & ProcessInitializationFlags::kNoInitializeCppgc)) {
     cppgc::ShutdownProcess();
   }
+#endif

   per_process::v8_initialized = false;
   if (!(flags & ProcessInitializationFlags::kNoInitializeV8)) {
