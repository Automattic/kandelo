# Kandelo patch rationale (O30)
#
# Node startup must not configure V8's private Abseil deadlock detector
# when that engine is absent. Kandelo also lacks the native execinfo stack
# interface selected by other Unix targets. These guards avoid unrelated
# private machinery and an unavailable native header; they do not disable
# Node's platform or JS error stacks. Review real build-capability
# conditions and general native-stack support if the platform gains an
# equivalent interface.
#
# Judgment: Supported. V8-private mutex instrumentation and unsupported
# native stack headers do not describe this engine or target.
#
--- a/src/node.cc
+++ b/src/node.cc
@@ -127,7 +127,9 @@
 #include <unistd.h>        // STDIN_FILENO, STDERR_FILENO
 #endif

+#if !defined(KANDELO_SPIDERMONKEY_ENGINE)
 #include "absl/synchronization/mutex.h"
+#endif

 // ========== global C++ headers ==========

@@ -1394,7 +1396,9 @@
     // Disable absl deadlock detection in V8 as it reports false-positive cases.
     // TODO(legendecas): Replace this global disablement with case suppressions.
     // https://github.com/nodejs/node-v8/issues/301
+#if !defined(KANDELO_SPIDERMONKEY_ENGINE)
     absl::SetMutexDeadlockDetectionMode(absl::OnDeadlockCycle::kIgnore);
+#endif
   }

 #if NODE_USE_V8_WASM_TRAP_HANDLER
--- a/src/debug_utils.cc
+++ b/src/debug_utils.cc
@@ -14,7 +14,8 @@

 #if defined(__linux__) && !defined(__GLIBC__) || \
     defined(__UCLIBC__) || \
-    defined(_AIX)
+    defined(_AIX) || \
+    defined(__kandelo__)
 #define HAVE_EXECINFO_H 0
 #else
 #define HAVE_EXECINFO_H 1
