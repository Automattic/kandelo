--- /dev/null
+++ b/deps/openssl/openssl/Configurations/50-kandelo.conf
@@ -0,0 +1,19 @@
+# Kandelo's wasm32 POSIX target. SDK tools own Wasm linkage/imports/exports.
+# Keep Node's no-assembly generation profile, thread safety and dlfcn support.
+my %targets = (
+    "kandelo-wasm32" => {
+        inherit_from     => [ "BASE_unix" ],
+        CC               => "wasm32posix-cc",
+        AR               => "wasm32posix-ar",
+        RANLIB           => "wasm32posix-ranlib",
+        CFLAGS           => picker(debug => "-O0 -g", release => "-O3"),
+        cppflags         => "-D__kandelo__=1",
+        cflags           => add("-pthread"),
+        ex_libs          => add("-pthread"),
+        bn_ops           => "BN_LLONG",
+        thread_scheme    => "pthreads",
+        dso_scheme       => "dlfcn",
+        shared_target    => "kandelo-shared",
+        shared_extension => ".so",
+    },
+);
