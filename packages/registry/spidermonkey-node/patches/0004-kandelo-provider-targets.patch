+    'kandelo-shared' => {
+        # The SDK selects Wasm side-module linkage and exported entrypoints.
+        # ELF sonames/version scripts and Darwin install names do not apply.
+        shared_ldflag         => '-shared',
+        module_ldflags        => '-shared',
+    },
     'gnu-shared' => {
         shared_ldflag         => '-shared -Wl,-Bsymbolic',
         shared_sonameflag     => '-Wl,-soname=',
