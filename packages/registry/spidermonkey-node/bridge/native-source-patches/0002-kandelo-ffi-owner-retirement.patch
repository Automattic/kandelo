# Kandelo patch rationale (O11)
#
# Node's FFI function/callback objects own a prepared call interface. Our
# Wasm backend allocates generated adapter resources for it, and standard
# ffi_cif has no automatic cleanup operation. Connect release to the
# original owner's destructor rather than leak adapters or free them while
# callbacks can run. The OS cannot infer that C++ ownership. A private RAII
# wrapper may simplify the interface later, but removing retirement is not
# equivalent.
#
# Judgment: Supported. The original Node FFI owner must release the
# generated resources whose lifetime it controls.
#
--- a/src/node_ffi.h
+++ b/src/node_ffi.h
@@ -29,6 +29,9 @@
 
 struct FFIFunction {
   FFIFunction() = default;
+#if defined(FFI_KANDELO_TARGET)
+  ~FFIFunction() { ffi_kandelo_release_cif(&cif); }
+#endif
   FFIFunction(const FFIFunction&) = delete;
   FFIFunction& operator=(const FFIFunction&) = delete;
   FFIFunction(FFIFunction&&) = delete;
@@ -103,6 +106,9 @@
       ffi_closure_free(closure);
       closure = nullptr;
     }
+#if defined(FFI_KANDELO_TARGET)
+    ffi_kandelo_release_cif(&cif);
+#endif
   }
 };
 
