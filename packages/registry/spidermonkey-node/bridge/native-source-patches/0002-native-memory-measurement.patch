+// Same result structure and construction order through the shared public
+// source interface; no V8 heap layout or factory is imported.
+class MemoryMeasurementResultBuilder final {
+ public:
+  explicit MemoryMeasurementResultBuilder(v8::Isolate* isolate)
+      : isolate_(isolate), result_(v8::Object::New(isolate)) {}
+  void AddTotal(size_t estimate,size_t lower,size_t upper) {
+    AddProperty(result_,"total",NewResult(estimate,lower,upper));
+  }
+  void AddCurrent(size_t estimate,size_t lower,size_t upper) {
+    detailed_=true;AddProperty(result_,"current",NewResult(estimate,lower,upper));
+  }
+  void AddOther(size_t estimate,size_t lower,size_t upper) {
+    detailed_=true;other_.push_back(NewResult(estimate,lower,upper));
+  }
+  void AddWasm(size_t code,size_t metadata) {
+    auto wasm=v8::Object::New(isolate_);
+    AddProperty(wasm,"code",v8::Number::New(isolate_,code));
+    AddProperty(wasm,"metadata",v8::Number::New(isolate_,metadata));
+    AddProperty(result_,"WebAssembly",wasm);
+  }
+  v8::Local<v8::Object> Build() {
+    if(detailed_){
+      auto other=v8::Array::New(isolate_,int(other_.size()));
+      for(size_t i=0;i<other_.size();++i)
+        CHECK(other->CreateDataProperty(isolate_->GetCurrentContext(),uint32_t(i),other_[i]).FromMaybe(false));
+      AddProperty(result_,"other",other);
+    }
+    return result_;
+  }
+ private:
+  v8::Local<v8::Object> NewResult(size_t estimate,size_t lower,size_t upper) {
+    auto result=v8::Object::New(isolate_);
+    AddProperty(result,"jsMemoryEstimate",v8::Number::New(isolate_,estimate));
+    auto range=v8::Array::New(isolate_,2);
+    CHECK(range->CreateDataProperty(isolate_->GetCurrentContext(),uint32_t(0),v8::Number::New(isolate_,lower)).FromMaybe(false));
+    CHECK(range->CreateDataProperty(isolate_->GetCurrentContext(),uint32_t(1),v8::Number::New(isolate_,upper)).FromMaybe(false));
+    AddProperty(result,"jsMemoryRange",range);return result;
+  }
+  void AddProperty(v8::Local<v8::Object> object,const char* name,v8::Local<v8::Value> value) {
+    auto key=v8::String::NewFromUtf8(isolate_,name).ToLocalChecked();
+    CHECK(object->CreateDataProperty(isolate_->GetCurrentContext(),key,value).FromMaybe(false));
+  }
+  v8::Isolate* isolate_;
+  v8::Local<v8::Object> result_;
+  std::vector<v8::Local<v8::Object>> other_;
+  bool detailed_=false;
+};
+#endif
 }  // anonymous namespace
 
