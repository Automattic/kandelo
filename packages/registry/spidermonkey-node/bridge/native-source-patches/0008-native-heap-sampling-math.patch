# Kandelo patch rationale (O18)
#
# The bridge's heap sampler uses V8's portable sample-interval and size-
# scaling formulas with SpiderMonkey allocation observations. Guard V8 heap
# internals rather than rewrite the arithmetic or change its probability
# distribution. The OS sees memory pages, not JavaScript allocations. Keep
# the engine-specific observer separate; review an upstream portable
# extraction if one becomes available, retaining real sampling and
# allocation-failure behavior.
#
# Judgment: Supported. Reusing the upstream probability formulas avoids
# changing Node heap-sampling behavior.
#
--- a/deps/v8/src/profiler/sampling-heap-profiler.cc
+++ b/deps/v8/src/profiler/sampling-heap-profiler.cc
@@ -2,6 +2,9 @@
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.

+#ifdef KANDELO_NATIVE_NODE_ENGINE
+#include "kandelo-node/engine-heap-allocation-data.h"
+#else
 #include "src/profiler/sampling-heap-profiler.h"

 #include <stdint.h>
@@ -18,6 +21,7 @@
 #include "src/heap/heap.h"
 #include "src/profiler/strings-storage.h"

+#endif
 namespace v8 {
 namespace internal {

@@ -28,8 +32,10 @@
 // Let u be a uniformly distributed random number between 0 and 1, then
 // next_sample = (- ln u) / λ
 intptr_t SamplingHeapProfiler::Observer::GetNextSampleInterval(uint64_t rate) {
+#ifndef KANDELO_NATIVE_NODE_ENGINE
   if (v8_flags.sampling_heap_profiler_suppress_randomness)
     return static_cast<intptr_t>(rate);
+#endif
   double u = random_->NextDouble();
   double next = (-base::ieee754::log(u)) * rate;
   return next < kTaggedSize
@@ -51,6 +57,7 @@
   return {size, static_cast<unsigned int>(count * scale + 0.5)};
 }

+#ifndef KANDELO_NATIVE_NODE_ENGINE
 SamplingHeapProfiler::SamplingHeapProfiler(
     Heap* heap, StringsStorage* names, uint64_t rate, int stack_depth,
     v8::HeapProfiler::SamplingFlags flags)
@@ -320,5 +327,6 @@
   return samples;
 }

+#endif  // !KANDELO_NATIVE_NODE_ENGINE
 }  // namespace internal
 }  // namespace v8
