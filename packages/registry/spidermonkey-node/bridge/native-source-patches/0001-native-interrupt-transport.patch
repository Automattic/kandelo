--- /dev/null
+++ b/deps/v8/src/execution/kandelo-native-interrupts.inc
@@ -0,0 +1,28 @@
+// Copyright 2012 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Complete queue methods relocated from isolate.cc for the SpiderMonkey
+// adapter. V8 CPU-profiler/runtime-counter scopes are not imported.
+void Isolate::RequestInterrupt(InterruptCallback callback, void* data) {
+  std::lock_guard access(native_interrupt_mutex_);
+  CHECK(native_interrupts_accepting_);
+  api_interrupts_queue_.push(InterruptEntry(callback, data));
+  JS_RequestInterruptCallback(native_interrupt_context_);
+}
+
+void Isolate::InvokeApiInterruptCallbacks() {
+  // Note: callback below should be called outside of execution access lock.
+  while (true) {
+    InterruptEntry entry;
+    {
+      std::lock_guard access(native_interrupt_mutex_);
+      if (api_interrupts_queue_.empty()) return;
+      entry = api_interrupts_queue_.front();
+      api_interrupts_queue_.pop();
+    }
+    HandleScope handle_scope(this);
+    entry.first(this, entry.second);
+  }
+}
+
