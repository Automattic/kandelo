Build libinput with library() so default_library selects its kind.

meson.build hard-codes shared_library('input'), so the build ignores
default_library=static. Kandelo has no shared libraries: programs link
every library statically (sdk/meson/wasm32posix.ini). library() keeps
the shared build as the default everywhere else.

--- a/meson.build
+++ b/meson.build
@@ -388,7 +388,7 @@
 
 mapfile = dir_src / 'libinput.sym'
 version_flag = '-Wl,--version-script,@0@'.format(mapfile)
-lib_libinput = shared_library('input',
+lib_libinput = library('input',
 		src_libinput,
 		include_directories : [include_directories('.'), includes_include],
 		dependencies : deps_libinput,
