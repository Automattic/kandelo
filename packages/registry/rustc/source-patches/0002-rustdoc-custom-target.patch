+    let (target, _) = Target::search(
+        &options.target,
+        options.sysroot.path(),
+        #[allow(rustc::bad_opt_access)] // There is no Session in this runner.
+        options.unstable_opts.unstable_options,
+    )?;
+    Ok(input + &target.options.exe_suffix)
