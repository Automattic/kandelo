+
+/// The build target's cfg values, from the `CARGO_CFG_*` variables Cargo
+/// sets for build scripts.
+struct CargoCfgTarget {
+    os: String,
+    arch: String,
+    env: String,
+    abi: String,
+    vendor: String,
+    families: Vec<String>,
+    endian: String,
+    pointer_width: String,
+    has_atomic: Vec<String>,
+    panic: String,
 }
 
+impl CargoCfgTarget {
+    fn from_env(env: &EnvVariables) -> Option<Self> {
+        let get = |name: &str| env.get(name).unwrap_or_default();
+        let list = |name: &str| {
+            get(name)
+                .split(',')
+                .filter(|s| !s.is_empty())
+                .map(str::to_owned)
+                .collect()
+        };
+        Some(Self {
+            os: env.get("CARGO_CFG_TARGET_OS")?,
+            arch: get("CARGO_CFG_TARGET_ARCH"),
+            env: get("CARGO_CFG_TARGET_ENV"),
+            abi: get("CARGO_CFG_TARGET_ABI"),
+            vendor: get("CARGO_CFG_TARGET_VENDOR"),
+            families: list("CARGO_CFG_TARGET_FAMILY"),
+            endian: get("CARGO_CFG_TARGET_ENDIAN"),
+            pointer_width: get("CARGO_CFG_TARGET_POINTER_WIDTH"),
+            has_atomic: list("CARGO_CFG_TARGET_HAS_ATOMIC"),
+            panic: get("CARGO_CFG_PANIC"),
+        })
+    }
+}
+
+impl cfg_expr::expr::TargetMatcher for CargoCfgTarget {
+    fn matches(&self, tp: &cfg_expr::TargetPredicate) -> bool {
+        use cfg_expr::{targets::Endian, TargetPredicate as T};
+
+        match tp {
+            T::Os(v) => v.as_str() == self.os,
+            T::Arch(v) => v.as_str() == self.arch,
+            T::Env(v) => v.as_str() == self.env,
+            T::Abi(v) => v.as_str() == self.abi,
+            T::Vendor(v) => v.as_str() == self.vendor,
+            T::Family(v) => self.families.iter().any(|f| f == v.as_str()),
+            T::Endian(Endian::little) => self.endian == "little",
+            T::Endian(Endian::big) => self.endian == "big",
+            T::PointerWidth(w) => w.to_string() == self.pointer_width,
+            T::HasAtomic(a) => self.has_atomic.iter().any(|h| *h == a.to_string()),
+            T::Panic(v) => v.as_str() == self.panic,
+        }
+    }
+}
