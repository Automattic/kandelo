# system-deps 7.0.8: evaluate cfg-keyed dependencies of a custom Rust
# target from the CARGO_CFG_* values Cargo gives build scripts, instead
# of panicking when the target name is not a target-lexicon triple.
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -957,6 +957,15 @@
                 Predicate::Target(tp) => Some(tp.matches(target)),
                 _ => None,
             })
+        } else if let Some(target) = CargoCfgTarget::from_env(&self.env) {
+            // A custom target (a target spec installed in the sysroot or
+            // given as JSON) is not a builtin, and its name need not parse
+            // as a target-lexicon triple. Cargo hands build scripts the
+            // target's cfg values directly; evaluate against those.
+            cfg.eval(|pred| match pred {
