{
  "kind": "kandelo-package-sessions",
  "version": 1,
  "package": "termchat",
  "packageVersion": "1.3.1",
  "offers": [
    {
      "id": "chat",
      "title": "Terminal chat",
      "description": "Chat and exchange files with everyone in this room.",
      "join": "participant",
      "attachExisting": true,
      "fields": [
        {
          "id": "name",
          "label": "Your name",
          "type": "text",
          "default": "host",
          "maxLength": 32
        }
      ],
      "launch": {
        "executable": "/usr/bin/termchat",
        "cwd": "/",
        "args": [
          "-u",
          {
            "field": "offer.name"
          }
        ],
        "requires": [],
        "surface": "terminal"
      }
    }
  ],
  "joins": [
    {
      "id": "participant",
      "title": "Open chat",
      "fields": [
        {
          "id": "name",
          "label": "Your name",
          "type": "text",
          "default": "guest",
          "maxLength": 32
        }
      ],
      "launch": {
        "executable": "/usr/bin/termchat",
        "cwd": "/",
        "args": [
          "-u",
          {
            "field": "join.name"
          }
        ],
        "requires": [],
        "surface": "terminal"
      },
      "description": "Choose a different name to chat and exchange files with everyone in the room."
    }
  ]
}
