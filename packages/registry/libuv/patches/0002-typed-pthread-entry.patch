+#if defined(UV_PLATFORM_KANDELO)
+/* Calling a void callback through pthread's pointer-returning type is C UB.
+ * Wasm enforces the actual function type. Transfer a real callback/argument
+ * pair to an exactly typed pthread entry; the child owns it on success.
+ */
+struct uv__thread_start_context {
+  void (*entry)(void*);
+  void* arg;
+};
+
+static void* uv__thread_start(void* opaque) {
+  struct uv__thread_start_context context;
+  context = *(struct uv__thread_start_context*) opaque;
+  uv__free(opaque);
+  context.entry(context.arg);
+  return NULL;
+}
+#endif
+
 int uv_thread_create_ex(uv_thread_t* tid,
                         const uv_thread_options_t* params,
                         void (*entry)(void *arg),
