# Kandelo patch rationale (O04)
#
# The current port avoids presenting placeholder resource-usage records as
# successful measurements. Returning an unsupported error is more honest,
# but libuv is the wrong permanent owner: Kandelo libc/kernel must supply
# real getrusage data or truthful failure for every guest program. Keep
# this guard only until that shared platform correction is reviewed and
# qualified. It does not complete Node's resource-usage APIs or justify
# excluding them.
#
# Judgment: Weak. This compensates for missing OS accounting and belongs at
# the shared platform owner.
#
--- a/src/unix/core.c
+++ b/src/unix/core.c
@@ -1095,6 +1095,15 @@
 
 
 static int uv__getrusage(int who, uv_rusage_t* rusage) {
+#if defined(UV_PLATFORM_KANDELO)
+  /* The kernel currently has no genuine resource-usage accounting. Do not
+   * publish its simulated zero records as successful libuv measurements.
+   */
+  (void) who;
+  if (rusage == NULL)
+    return UV_EINVAL;
+  return UV_ENOSYS;
+#else
   struct rusage usage;
 
   if (getrusage(who, &usage))
@@ -1133,6 +1142,7 @@
 #endif
 
   return 0;
+#endif
 }
 
 
