@@ -324,6 +324,19 @@
        src/unix/hurd.c)
 endif()
 
+# Kandelo is a POSIX WebAssembly target, not a Linux target. Use the
+# portable poll/clock backend and expose its public loop layout to consumers.
+if(CMAKE_SYSTEM_NAME STREQUAL "Kandelo")
+  list(APPEND uv_defines _GNU_SOURCE)
+  list(APPEND uv_public_defines UV_PLATFORM_KANDELO=1)
+  set(UV_PLATFORM_CFLAGS "-DUV_PLATFORM_KANDELO=1")
+  list(APPEND uv_sources
+       src/unix/posix-hrtime.c
+       src/unix/posix-poll.c
+       src/unix/no-fsevents.c
+       src/unix/kandelo-proctitle.c)
+endif()
+
 if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
   list(APPEND uv_defines _GNU_SOURCE _POSIX_C_SOURCE=200112)
   list(APPEND uv_libraries dl rt)
@@ -455,6 +468,7 @@
 if(LIBUV_BUILD_SHARED)
   add_library(uv SHARED ${uv_sources})
   target_compile_definitions(uv
+    PUBLIC ${uv_public_defines}
     INTERFACE
       USING_UV_SHARED=1
     PRIVATE
@@ -476,7 +490,7 @@
 endif()
 
