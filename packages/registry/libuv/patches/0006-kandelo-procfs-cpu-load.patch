# Kandelo patch rationale (O06)
# Reuse upstream procfs CPU/load readers without selecting Linux-only I/O.
# The shared OS now reports unsupported accounting instead of invented data,
# so uv_loadavg keeps its original sysinfo query/failure path unchanged.
# Preserve the CPU reader's matching allocation/free policy. Target partition
# cleanup and actual CPU/load measurements still require qualification/work.

--- a/src/unix/linux.c
+++ b/src/unix/linux.c
@@ -26,6 +26,15 @@
 #include "uv.h"
 #include "internal.h"
 
+#if defined(UV_PLATFORM_KANDELO)
+/* Portable procfs queries only. This is not a Linux target or event loop. */
+#include <errno.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+/* The unchanged uv_loadavg fallback declares and calls sysinfo. */
+#include <sys/sysinfo.h>
+#else
 #include <inttypes.h>
 #include <stdatomic.h>
 #include <stddef.h>  /* offsetof */
@@ -1691,6 +1700,8 @@
   return 0;
 }
 
+
+#endif  /* !UV_PLATFORM_KANDELO */
 
 int uv_cpu_info(uv_cpu_info_t** ci, int* count) {
 #if defined(__PPC__)
@@ -1921,6 +1932,7 @@
 }
 
 
+#if !defined(UV_PLATFORM_KANDELO)
 static int uv__ifaddr_exclude(struct ifaddrs *ent, int exclude_type) {
   if (!((ent->ifa_flags & IFF_UP) && (ent->ifa_flags & IFF_RUNNING)))
     return 1;
@@ -2448,6 +2460,7 @@
 }
 
 
+#endif  /* !UV_PLATFORM_KANDELO */
 void uv_loadavg(double avg[3]) {
   struct sysinfo info;
   char buf[128];  /* Large enough to hold all of /proc/loadavg. */
@@ -2465,6 +2478,7 @@
 }
 
 
+#if !defined(UV_PLATFORM_KANDELO)
 static int compare_watchers(const struct watcher_list* a,
                             const struct watcher_list* b) {
   if (a->wd < b->wd) return -1;
@@ -2742,3 +2756,5 @@
 void uv__fs_event_close(uv_fs_event_t* handle) {
   uv_fs_event_stop(handle);
 }
+
+#endif  /* !UV_PLATFORM_KANDELO */
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -337,6 +337,7 @@
        src/unix/no-fsevents.c
        src/unix/bsd-ifaddrs.c
        src/unix/kandelo-uptime.c
+       src/unix/linux.c
        src/unix/kandelo-memory.c
        src/unix/kandelo-proctitle.c)
 endif()
--- a/src/uv-common.c
+++ b/src/uv-common.c
@@ -950,7 +950,8 @@
 
 
 void uv_free_cpu_info(uv_cpu_info_t* cpu_infos, int count) {
-#ifdef __linux__
+/* The portable CPU reader uses one allocation for the array and models. */
+#if defined(__linux__) || defined(UV_PLATFORM_KANDELO)
   (void) &count;
   uv__free(cpu_infos);
 #else
