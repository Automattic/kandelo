{
  "version": 1,
  "defaultProfile": "ruby-todo",
  "profiles": {
    "ruby-todo": {
      "identity": {
        "title": "Ruby + Roda todo",
        "summary": "A Roda web app on Ruby 4 with a SQLite database, served on :8080. Not Rails.",
        "accent": "#b31217",
        "glyph": "rb",
        "packages": [
          "ruby@local"
        ]
      },
      "runtime": {
        "requests": {
          "memoryPages": 4096,
          "maxWorkers": 12
        }
      },
      "init": {
        "program": "/usr/bin/ruby",
        "args": [
          "/var/lib/todo/server.rb"
        ],
        "cwd": "/var/lib/todo",
        "uid": 1000,
        "gid": 1000
      },
      "web": {
        "requiredPorts": [
          8080
        ]
      },
      "presentation": {
        "bootPrimary": "syslog",
        "runningPrimary": [
          "web",
          "syslog",
          "terminal"
        ],
        "terminalAccess": "drawer",
        "internalsAccess": "drawer"
      }
    }
  }
}
