      "launch": {
        "executable": "/usr/local/bin/doom-activity",
        "cwd": "/",
        "args": [
          {
            "field": "dependency.iwad.source"
          },
          "-iwad",
          "/tmp/kandelo-doom.wad",
          "-server",
          "-privateserver",
          "-nodes",
          {
            "field": "offer.players"
          },
          {
            "options": "offer.mode"
          },
          {
            "options": "offer.level"
          }
        ],
        "requires": [
          "/tmp/kandelo-doom-data.bin"
        ],
        "surface": "display"
      }
    }
  ],
  "joins": [
    {
      "id": "player",
      "title": "Play Doom",
      "fields": [],
      "launch": {
        "executable": "/usr/local/bin/doom-activity",
        "cwd": "/",
        "args": [
          {
            "field": "dependency.iwad.source"
          },
          "-iwad",
          "/tmp/kandelo-doom.wad",
          "-connect",
          {
            "field": "network.host"
          }
        ],
        "requires": [
          "/tmp/kandelo-doom-data.bin"
        ],
        "surface": "display"
      },
      "description": "Join the host\u2019s game using the same WAD."
    }
  ],
  "dependencies": [
    {
      "id": "iwad",
      "title": "Game WAD",
      "path": "/tmp/kandelo-doom-data.bin",
