{
  "kind": "kandelo-package-sessions",
  "version": 1,
  "package": "fbdoom",
  "packageVersion": "0.1.0",
  "offers": [
    {
      "id": "game",
      "title": "Doom game",
      "description": "Start a private Doom game.",
      "join": "player",
      "attachExisting": false,
      "fields": [
        {
          "id": "mode",
          "label": "Game type",
          "type": "choice",
          "default": "cooperative",
          "options": [
            {
              "value": "cooperative",
              "label": "Cooperative",
              "args": []
            },
            {
              "value": "deathmatch",
              "label": "Deathmatch",
              "args": [
                "-deathmatch"
              ]
            },
            {
              "value": "altdeath",
              "label": "Deathmatch with item respawn",
              "args": [
                "-altdeath"
              ]
            }
          ]
        },
        {
          "id": "players",
          "label": "Players",
          "type": "integer",
          "default": 2,
          "min": 2,
          "max": 4
        },
        {
          "id": "level",
