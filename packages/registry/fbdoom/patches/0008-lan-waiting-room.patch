 void I_InitGraphics (void)
 {
+    static boolean initialized = false;
     int i;
 
+    // NET_WaitForLaunch opens the display early to draw the LAN waiting
+    // room; /dev/fb0 has a single owner, so the game loop's later call
+    // must not open it again.
+    if (initialized)
+        return;
+    initialized = true;
+
     /* Open fbdev file descriptor */
     fd_fb = open("/dev/fb0", O_RDWR);
     if (fd_fb < 0)
