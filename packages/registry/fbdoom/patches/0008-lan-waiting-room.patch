+// wait, not a busy loop.
 
 extern boolean net_waiting_for_launch;
+int kbd_read(int *released, unsigned char *key);
+void kbd_shutdown(void);
+
+#define WAIT_KEY_ESCAPE 0x01
+#define WAIT_KEY_SPACE  0x39
+
+static patch_t *wait_font[HU_FONTSIZE];
+
+static int WaitTextWidth(const char *text)
+{
+    int width = 0;
+
+    for (; *text != '\0'; ++text)
+    {
+        int c = toupper((unsigned char) *text) - HU_FONTSTART;
+
+        width += c < 0 || c >= HU_FONTSIZE ? 4 : SHORT(wait_font[c]->width);
+    }
+    return width;
+}
+
+static void WaitText(int y, const char *text)
+{
+    int x = (SCREENWIDTH - WaitTextWidth(text)) / 2;
+
+    for (; *text != '\0'; ++text)
+    {
+        int c = toupper((unsigned char) *text) - HU_FONTSTART;
+
+        if (c < 0 || c >= HU_FONTSIZE)
+        {
+            x += 4;
+            continue;
+        }
+        if (x >= 0 && x + SHORT(wait_font[c]->width) <= SCREENWIDTH)
+            V_DrawPatch(x, y, wait_font[c]);
+        x += SHORT(wait_font[c]->width);
+    }
+}
+
+static void OpenWaitingRoom(void)
+{
+    char name[9];
+    int i;
+
+    for (i = 0; i < HU_FONTSIZE; ++i)
+    {
+        M_snprintf(name, sizeof(name), "STCFN%.3d", HU_FONTSTART + i);
+        wait_font[i] = W_CacheLumpName(DEH_String(name), PU_STATIC);
+    }
+    I_InitGraphics();
+    V_RestoreBuffer();
+    I_SetPalette(W_CacheLumpName(DEH_String("PLAYPAL"), PU_CACHE));
+}
+
+static void DrawWaitingRoom(int expected_nodes)
+{
+    char line[64];
+    int target, i, y;
+
+    if (W_CheckNumForName(DEH_String("INTERPIC")) >= 0)
+        V_DrawPatch(0, 0, W_CacheLumpName(DEH_String("INTERPIC"), PU_CACHE));
+    else
+        memset(I_VideoBuffer, 0, SCREENWIDTH * SCREENHEIGHT);
+
+    y = 24;
+    WaitText(y, "LAN GAME");
+    y += 20;
+    if (!net_client_received_wait_data)
+    {
+        WaitText(y, "CONNECTING TO THE SERVER...");
+    }
+    else
+    {
+        target = expected_nodes > 0 ? expected_nodes
+                                    : net_client_wait_data.max_players;
+        M_snprintf(line, sizeof(line), "%d OF %d PLAYERS HAVE JOINED",
+                   net_client_wait_data.num_players, target);
+        WaitText(y, line);
+        y += 16;
+        for (i = 0; i < net_client_wait_data.num_players && i < NET_MAXPLAYERS; ++i)
+        {
+            M_snprintf(line, sizeof(line), "%d. %s%s", i + 1,
+                       net_client_wait_data.player_names[i],
+                       i == net_client_wait_data.consoleplayer ? " (YOU)" : "");
+            WaitText(y, line);
+            y += 10;
+        }
+        y = SCREENHEIGHT - 44;
+        if (net_client_wait_data.is_controller)
+        {
+            if (expected_nodes > 0)
+                WaitText(y, "THE GAME STARTS WHEN EVERYONE HAS JOINED");
+            WaitText(y + 12, "PRESS SPACE TO START NOW");
+        }
+        else
+        {
+            WaitText(y + 12, "WAITING FOR THE HOST TO START");
+        }
+    }
+    WaitText(SCREENHEIGHT - 16, "PRESS ESC TO QUIT");
+    I_FinishUpdate();
+}
 
