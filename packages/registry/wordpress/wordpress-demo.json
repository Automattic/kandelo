{
  "version": 1,
  "defaultProfile": "wordpress-sqlite",
  "profiles": {
    "wordpress-frankenphp-caddy": {
      "identity": {
        "title": "WordPress on FrankenPHP + Caddy",
        "summary": "WordPress SQLite served by FrankenPHP's Caddy php_server, without nginx or PHP-FPM.",
        "accent": "#21759b",
        "glyph": "wp",
        "packages": [
          "dinit@local",
          "frankenphp-caddy@local",
          "wordpress@local",
          "sqlite@local",
          "bash@local",
          "coreutils@local"
        ]
      },
      "runtime": {
        "requests": {
          "memoryPages": 16384,
          "maxWorkers": 12
        }
      },
      "init": {
        "program": "/bin/sh",
        "args": [
          "/sbin/kandelo-init",
          "frankenphp-caddy"
        ],
        "cwd": "/root",
        "uid": 0,
        "gid": 0
      },
      "web": {
        "requiredPorts": [
          8080
        ]
      },
      "presentation": {
        "bootPrimary": "syslog",
        "runningPrimary": [
          "web",
          "syslog",
          "terminal"
        ],
        "terminalAccess": "drawer",
        "internalsAccess": "drawer"
      }
    },
