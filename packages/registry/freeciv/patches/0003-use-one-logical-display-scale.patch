+
+  if ((font_tmp = TTF_OpenFont(font_with_full_path, pixels)) == NULL) {
     log_error("load_font: Couldn't load %d pt font from %s: %s",
               ptsize, font_with_full_path, SDL_GetError());
     return NULL;
