Use one logical display scale for the SDL2 renderer and input.

KMS windows use device pixels, while upstream's software surfaces and theme
art assume logical pixels. Render the complete scene at 96 logical DPI and
let SDL scale its output once, transforming mouse events and explicit state
queries into the same coordinates. Wayland keeps its compositor-owned scale.
Font point conversion stays at 96 logical DPI, never physical DPI.

--- a/client/gui-sdl2/graphics.c
+++ b/client/gui-sdl2/graphics.c
@@ -554,6 +554,20 @@
 bool create_surfaces(int width, int height)
 {
   unsigned flags;
+
+  float scale = 1.0f, dpi;
+  const char *driver = SDL_GetCurrentVideoDriver();
+
+  /* Only KMS windows use raw device pixels. Wayland windows already use
+   * compositor-scaled logical coordinates. Scale the entire scene once,
+   * including bitmap icons, fonts, map tiles, and mouse hit targets. */
+  if (driver && SDL_strcasecmp(driver, "kmsdrm") == 0
+      && SDL_GetDisplayDPI(SDL_GetWindowDisplayIndex(main_data.screen),
+                           NULL, NULL, &dpi) == 0 && dpi > 96.0f) {
+    scale = dpi / 96.0f;
+  }
+  width = MAX(1, (int)(width / scale + 0.5f));
+  height = MAX(1, (int)(height / scale + 0.5f));
 
   free_surfaces();
 
@@ -592,6 +606,12 @@
     return FALSE;
   }
 
+  /* SDL also transforms queued mouse events into these logical units. */
+  if (SDL_RenderSetLogicalSize(main_data.renderer, width, height) < 0) {
+    log_fatal(_("Failed to set logical display size: %s"), SDL_GetError());
+    return FALSE;
+  }
+
   main_data.maintext = SDL_CreateTexture(main_data.renderer,
                                          SDL_PIXELFORMAT_ARGB8888,
                                          SDL_TEXTUREACCESS_STREAMING,
@@ -680,6 +700,22 @@
 /**********************************************************************//**
   Return width of the main window
 **************************************************************************/
+Uint32 get_logical_mouse_state(int *x, int *y)
+{
+  int wx, wy;
+  float lx, ly;
+  Uint32 buttons = SDL_GetMouseState(&wx, &wy);
+
+  SDL_RenderWindowToLogical(main_data.renderer, wx, wy, &lx, &ly);
+  if (x) {
+    *x = (int)lx;
+  }
+  if (y) {
+    *y = (int)ly;
+  }
+  return buttons;
+}
+
 int main_window_width(void)
 {
   return main_surface->w;
--- a/client/gui-sdl2/graphics.h
+++ b/client/gui-sdl2/graphics.h
@@ -286,6 +286,8 @@
 bool create_surfaces(int width, int height);
 
 void update_main_screen(void);
+
+Uint32 get_logical_mouse_state(int *x, int *y);
 
 int main_window_width(void);
 int main_window_height(void);
