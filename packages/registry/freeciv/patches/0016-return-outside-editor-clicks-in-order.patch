Return outside editor clicks to the enclosing event loop in order.

The modal text editor consumes the press that ends editing. Commit its
value first, then route that press through ordinary hit testing before
polling SDL again. Requeueing at the tail would reverse press/release order
when the release is already queued. This applies to all SDL2 edit widgets,
including the repeating lobby chat editor.

--- a/client/gui-sdl2/gui_main.c
+++ b/client/gui-sdl2/gui_main.c
@@ -611,6 +611,28 @@
   }
 }
 
+/* One event returned by a nested editor belongs to the enclosing loop.
+ * Keep it ahead of SDL's queue: appending it would overtake its release. */
+static bool input_event_returned = FALSE;
+static SDL_Event returned_input_event;
+
+void return_input_event(const SDL_Event *event)
+{
+  fc_assert_ret(!input_event_returned);
+  returned_input_event = *event;
+  input_event_returned = TRUE;
+}
+
+static int poll_gui_event(SDL_Event *event)
+{
+  if (input_event_returned) {
+    *event = returned_input_event;
+    input_event_returned = FALSE;
+    return 1;
+  }
+  return SDL_PollEvent(event);
+}
+
