 /* ====================================================================== */
+
+/**********************************************************************//**
+  Stack artwork and measured text without clipping the description.
+**************************************************************************/
+static SDL_Surface *worklist_target_surface(int width, int min_height,
+                                           SDL_Surface *art,
+                                           SDL_Surface *name,
+                                           SDL_Surface *details,
+                                           SDL_Color color)
+{
+  int content_height = art->h + name->h + details->h + adj_size(8);
+  int height = MAX(min_height, content_height + adj_size(8));
+  SDL_Surface *surface = create_surf(width, height, SDL_SWSURFACE);
+  SDL_Rect dst;
+
+  SDL_FillRect(surface, NULL, map_rgba(surface->format, color));
+  create_frame(surface, 0, 0, width - 1, height - 1,
+               get_theme_color(COLOR_THEME_WLDLG_FRAME));
+  dst.x = (width - art->w) / 2;
+  dst.y = (height - content_height) / 2;
+  alphablit(art, NULL, surface, &dst, 255);
+  dst.x = (width - name->w) / 2;
+  dst.y += art->h + adj_size(4);
+  alphablit(name, NULL, surface, &dst, 255);
+  dst.x = (width - details->w) / 2;
+  dst.y += name->h + adj_size(4);
+  alphablit(details, NULL, surface, &dst, 255);
+
+  return surface;
+}
 
