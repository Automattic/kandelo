Keep button content visible when measured fonts exceed fixed minima.

Use signed offsets in the shared icon/text button renderer so negative
centering does not wrap to 65535. The nation dialog must also retain the
minimum heights measured by its edit/button constructors.

--- a/client/gui-sdl2/dialogs.c
+++ b/client/gui-sdl2/dialogs.c
@@ -3332,7 +3332,7 @@
   pwidget = create_edit_from_chars_fonto(NULL, pwindow->dst,
                                          NULL, FONTO_BIG,
                                          adj_size(200), 0);
-  pwidget->size.h = adj_size(24);
+  pwidget->size.h = MAX(pwidget->size.h, adj_size(24));
 
   set_wstate(pwidget, FC_WS_NORMAL);
   pwidget->action = leader_name_edit_callback;
@@ -3360,8 +3360,8 @@
                                                 sex_name_translation(SEX_MALE),
                                                 FONTO_HEADING, 0);
   pwidget->action = change_sex_callback;
-  pwidget->size.w = adj_size(100);
-  pwidget->size.h = adj_size(22);
+  pwidget->size.w = MAX(pwidget->size.w, adj_size(100));
+  pwidget->size.h = MAX(pwidget->size.h, adj_size(22));
   set_wstate(pwidget, FC_WS_NORMAL);
   setup->change_sex = pwidget;
 
--- a/client/gui-sdl2/widget_button.c
+++ b/client/gui-sdl2/widget_button.c
@@ -56,8 +56,10 @@
   SDL_Rect dest = { 0, 0, 0, 0 };
   utf8_str tmp_str;
   SDL_Surface *button = NULL, *text = NULL, *icon = icon_button->theme2;
-  Uint16 ix, iy, x;
-  Uint16 y = 0; /* FIXME: possibly uninitialized */
+  /* Centering can be negative when a caller constrains the widget size.
+   * Unsigned offsets wrap and send the content far outside the surface. */
+  int ix, iy, x;
+  int y = 0;
   int ret;
 
   ret = (*baseclass_redraw)(icon_button);
