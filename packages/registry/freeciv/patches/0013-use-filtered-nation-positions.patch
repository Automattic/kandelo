 }
 
 /**********************************************************************//**
+  Select from the filtered nations, not from the same-sized prefix of IDs.
+**************************************************************************/
+static struct nation_type *random_available_nation(void)
+{
+  int count = get_playable_nation_count();
+  int choice;
+
+  if (count == 0) {
+    return NULL;
+  }
+  choice = fc_rand(count);
+  nations_iterate(pnation) {
+    if (is_nation_playable(pnation) && is_nation_pickable(pnation)
+        && !pnation->player && choice-- == 0) {
+      return pnation;
+    }
+  } nations_iterate_end;
+
+  return NULL;
+}
+
