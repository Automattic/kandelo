 /**********************************************************************//**
   Resize the main window after option changed.
 **************************************************************************/
+static void real_change_resolution(void *unused)
+{
+  int width = GUI_SDL_OPTION(screen.width);
+  int height = GUI_SDL_OPTION(screen.height);
+
+  if (GUI_SDL_OPTION(fullscreen)) {
+    SDL_DisplayMode mode = { .w = width, .h = height };
+
+    /* Desktop fullscreen deliberately ignores resolution requests. */
+    if (SDL_SetWindowDisplayMode(main_data.screen, &mode) < 0
+        || SDL_SetWindowFullscreen(main_data.screen, SDL_WINDOW_FULLSCREEN) < 0) {
+      log_error("Cannot change screen resolution: %s", SDL_GetError());
+      return;
+    }
+  } else {
+    SDL_SetWindowSize(main_data.screen, width, height);
+  }
+  SDL_GetWindowSize(main_data.screen, &width, &height);
+  if (!create_surfaces(width, height)) {
+    force_exit_from_event_loop();
+    return;
+  }
+  real_resize_window_callback(NULL);
+}
+
+/**********************************************************************//**
+  Apply after the option dialog has finished using the old surfaces.
+**************************************************************************/
 static void resize_window_callback(struct option *poption)
 {
-  update_queue_add(real_resize_window_callback, NULL);
+  update_queue_add(real_change_resolution, NULL);
 }
 
