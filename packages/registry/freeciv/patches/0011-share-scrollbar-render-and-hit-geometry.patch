 /* =================================================== */
 /* =====================            ================== */
 /* =================================================== */
+
+/**********************************************************************//**
+  One thumb extent for drawing, hit testing, and drag limits. Long lists can
+  have a proportional size smaller than the theme's end caps; applying the
+  minimum only while drawing makes most of the visible thumb unclickable.
+**************************************************************************/
+int scrollbar_size(const struct scroll_bar *scroll)
+{
+  int track = MAX(0, scroll->max - scroll->min);
+  int minimum = adj_size(16);
+  int visible = scroll->active * scroll->step;
+
+  if (scroll->pscroll_bar && scroll->pscroll_bar->theme) {
+    const struct widget *thumb = scroll->pscroll_bar;
+    int theme_extent = get_wtype(thumb) == WT_VSCROLLBAR
+      ? thumb->theme->h : thumb->theme->w;
+
+    minimum = MAX(minimum, 2 * (theme_extent / 16));
+  }
+  if (scroll->count <= visible || scroll->count == 0) {
+    return track;
+  }
+  return MIN(track, MAX(minimum, (int)((float)visible * track / scroll->count)));
+}
 
