Size the unit information panel from the configured font metrics.

The fixed 104-pixel panel overlapped the name, veteran and multi-line
movement/terrain status at larger font sizes and display DPI. Give the
header and status distinct rows, and scale the minimum panel dimensions
with their actual fonts. Use the status font for expanded-detail checks.

--- a/client/gui-sdl2/mapctrl.c
+++ b/client/gui-sdl2/mapctrl.c
@@ -872,6 +872,30 @@
 #endif /* SCALE_MINIMAP */
 
 /* ==================================================================== */
+/* The name, veteran line and multi-line status must fit above the panel's
+ * bottom edge even when the display DPI or configured font size increases. */
+int unit_info_base_height(void)
+{
+  utf8_str *text = create_utf8_from_char_fonto(NULL, FONTO_ATTENTION);
+  int heading = TTF_FontHeight(text->font);
+  int height;
+
+  change_fonto_utf8(text, FONTO_DEFAULT);
+  height = heading + 7 * TTF_FontHeight(text->font) + adj_size(12);
+  FREEUTF8STR(text);
+  return MAX(adj_size(104), height);
+}
+
+int unit_info_base_width(void)
+{
+  utf8_str *text = create_utf8_from_char_fonto("MMMMMMMMMMMM", FONTO_DEFAULT);
+  SDL_Rect size;
+
+  utf8_str_size(text, &size);
+  FREEUTF8STR(text);
+  return MAX(adj_size(158), size.w + adj_size(12)) + BLOCKU_W;
+}
+
 #ifdef SCALE_UNITINFO
 
 /**********************************************************************//**
