+// Public Buffer metadata describes the engine executing the guest program.
+// Do not copy V8/host limits or probe by reserving a maximum-sized allocation:
+// smaller real allocation failures still depend on the machine's live budget.
+static bool KandeloNativeBufferLimits(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  RootedObject target(cx, JS_NewPlainObject(cx));
+  if (!target ||
+      !JS_DefineProperty(cx, target, "MAX_LENGTH",
+                         double(js::TypedArrayObject::ByteLengthLimit),
+                         JSPROP_ENUMERATE) ||
+      !JS_DefineProperty(cx, target, "MAX_STRING_LENGTH",
+                         double(JSString::MAX_LENGTH), JSPROP_ENUMERATE)) {
+    return false;
+  }
+  args.rval().setObject(*target);
+  return true;
+}
