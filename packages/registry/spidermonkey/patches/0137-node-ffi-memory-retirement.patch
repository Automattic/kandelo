+static bool KandeloShutdownNodeEnvironment(ShellContext* sc) {
+  if (sc->kandeloNativeTeardownComplete) return sc->kandeloNativeTeardownOk;
+  // Completion is recorded only after producers have actually stopped/joined,
+  // queued/running work has retired, and every owning span consumer is closed.
+  // Admission of shutdown alone never authorizes unmapping foreign bytes.
+  KandeloShutdownLocks(sc->cx_);
+  KandeloShutdownWorkers(sc->cx_);
+  // Finish/cancel native jobs and retire pins/roots while the JSContext lives.
+  KandeloStopStatWatchers(sc);
+  KandeloShutdownUdp(sc);
+  KandeloShutdownNativeWork(sc);
+  KandeloShutdownStatWatchers(sc);
+  KandeloShutdownChildWatches(sc->cx_);
+  KandeloShutdownPorts(sc->cx_);
+  KandeloELDShutdown(sc->cx_);
+  KandeloShutdownHistograms(sc->cx_);
+  KandeloShutdownSocketOwners(sc->cx_);
+  if (!KandeloShutdownFfi(sc)) sc->kandeloNativeTeardownOk = false;
+  KandeloShutdownNativeAsync(sc);
+  sc->kandeloNativeTeardownComplete = true;
+  return sc->kandeloNativeTeardownOk;
+}
+
+static int KandeloFinishNodeEnvironment(ShellContext* sc, int result,
+                                       bool restoreNodeStatus, int32_t nodeStatus) {
+  // Preserve Node's chosen status before retirement, including explicit zero
+  // after an exit-listener exception. Unload failure promotes only success.
+  if (restoreNodeStatus) {
+    sc->exitCode = nodeStatus;
+    result = nodeStatus;
+  } else if (sc->exitCode) result = sc->exitCode;
+  const bool retired = KandeloShutdownNodeEnvironment(sc);
+  if (!result && (!retired || sc->exitCode))
+    result = sc->exitCode ? sc->exitCode : EXIT_FAILURE;
+  sc->exitCode = result;  // Keep the chosen terminal status durable on reentry.
+  return result;
+}
