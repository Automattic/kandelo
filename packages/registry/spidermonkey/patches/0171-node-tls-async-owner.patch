+static bool KandeloTlsResourceInfo(JSContext* cx, HandleObject owner,
+                                     MutableHandleValue result) {
+  RootedObject actual(cx);
+  RootedValue resource(cx, ObjectValue(*owner));
+  auto* state = KandeloTlsStateFor(cx, resource, &actual); if (!state) return false;
+  if (state->id < 0) {
+    JS_ReportErrorASCII(cx, "TLS native identity is not initialized"); return false;
+  }
+  JS::RootedValueArray<5> entries(cx);
+  entries[0].setNumber(state->id); entries[1].setNumber(state->trigger);
+  entries[2].set(JS::GetReservedSlot(actual, TlsFrameSlot));
+  RootedString provider(cx, JS_NewStringCopyZ(cx, "TLSWRAP")); if (!provider) return false;
+  entries[3].setString(provider); entries[4].setObject(*actual);
+  for (size_t i = 0; i < 5; ++i) if (!JS_WrapValue(cx, entries[i])) return false;
+  RootedObject array(cx, JS::NewArrayObject(cx, entries)); if (!array) return false;
+  result.setObject(*array); return true;
+}
+static bool KandeloTlsInitialize(JSContext* cx, HandleObject owner,
+                                   KandeloTlsState* state) {
+  MOZ_RELEASE_ASSERT(state->id < 0 && !state->lifetime);
+  RootedValue frame(cx); double trigger;
+  if (!cx->kandeloAsyncProperty("frame", &frame) ||
+      !cx->getKandeloDefaultTriggerAsyncId(&trigger)) return false;
+  auto* lifetime = js::shell::KandeloGetNativeAsyncState(cx);
+  if (!lifetime || !JS_WrapValue(cx, &frame)) return false;
+  lifetime->Retain(); state->lifetime = lifetime;
+  state->id = cx->allocateKandeloAsyncId(); state->trigger = trigger;
+  JS::SetReservedSlot(owner, TlsFrameSlot, frame);
+  // The provider and its real state/frame exist before native:init reentry.
+  // No TCP ID or fabricated public socket is substituted for this resource.
+  return cx->notifyKandeloAsyncLifecycle("native:init", owner, frame);
