+// Kandelo's current-runtime object census is deliberately not a V8/process
+// memoryUsage record. Only mallocUsableBytes measures allocator extent; inline
+// payload is logical object storage. Shared/mapped/Wasm/external/native-only
+// stores and unmaterialized views do not become guessed byte measurements.
+struct KandeloArrayBufferSnapshot {
+  uint64_t realms = 0;
+  uint64_t arrayBufferObjects = 0;
+  uint64_t detachedObjects = 0;
+  uint64_t noDataObjects = 0;
+  uint64_t inlineObjects = 0;
+  uint64_t inlinePayloadBytes = 0;
+  uint64_t mallocBackedObjects = 0;
+  uint64_t uniqueMallocAllocations = 0;
+  uint64_t mallocUsableBytes = 0;
+  uint64_t mappedObjects = 0;
+  uint64_t wasmObjects = 0;
+  uint64_t externalObjects = 0;
+  uint64_t userOwnedObjects = 0;
+  uint64_t sharedObjects = 0;
+  uint64_t unmaterializedTenuredTypedArrayObjects = 0;
+  bool nurseryEmpty = false;
+};
+enum class KandeloArrayBufferSnapshotStatus { Ok, Busy, OutOfMemory, Overflow };
+// No JS/object pointers escape the protected walk. Returns Busy rather than
