+namespace {
+enum class KandeloBufferKind { Inline, Malloc, Detached, NoData, Mapped, Wasm,
+                               External, UserOwned, Shared, UnmaterializedView };
+struct KandeloBufferRow {
+  KandeloBufferKind kind = KandeloBufferKind::NoData;
+  uintptr_t allocation = 0; // Native malloc identity only; never a GC-cell pointer.
+  uint64_t bytes = 0;
+};
+struct KandeloBufferWalk {
+  MallocSizeOf mallocSizeOf;
+  Vector<KandeloBufferRow, 0, SystemAllocPolicy> rows;
+  uint64_t realms = 0;
+  bool failed = false;
+  explicit KandeloBufferWalk(MallocSizeOf sizeOf) : mallocSizeOf(sizeOf) {}
+};
+void KandeloBufferZone(JSRuntime*, void*, Zone*, const JS::AutoRequireNoGC&) {}
+void KandeloBufferRealm(JSContext*, void* data, Realm*, const JS::AutoRequireNoGC&) {
+  ++static_cast<KandeloBufferWalk*>(data)->realms;
+}
+void KandeloBufferArena(JSRuntime*, void*, gc::Arena*, JS::TraceKind, size_t,
+                        const JS::AutoRequireNoGC&) {}
+void KandeloBufferCell(JSRuntime*, void* data, JS::GCCellPtr cell, size_t,
+                       const JS::AutoRequireNoGC&) {
+  auto* walk = static_cast<KandeloBufferWalk*>(data);
+  if (walk->failed || cell.kind() != JS::TraceKind::Object) return;
+  JSObject* object = &cell.as<JSObject>();
+  KandeloBufferRow row;
+  if (object->is<SharedArrayBufferObject>()) {
+    row.kind = KandeloBufferKind::Shared;
+  } else if (object->is<ArrayBufferObject>()) {
+    auto& buffer = object->as<ArrayBufferObject>();
+    if (buffer.isDetached()) row.kind = KandeloBufferKind::Detached;
+    else switch (buffer.bufferKind()) {
+      case ArrayBufferObject::INLINE_DATA:
+        row.kind = KandeloBufferKind::Inline;row.bytes = buffer.byteLength();break;
+      case ArrayBufferObject::MALLOCED_ARRAYBUFFER_CONTENTS_ARENA:
+      case ArrayBufferObject::MALLOCED_UNKNOWN_ARENA:
+        row.kind = KandeloBufferKind::Malloc;
+        row.allocation = reinterpret_cast<uintptr_t>(buffer.dataPointer());
+        row.bytes = row.allocation ? walk->mallocSizeOf(buffer.dataPointer()) : 0;
+        break;
+      case ArrayBufferObject::NO_DATA: row.kind = KandeloBufferKind::NoData;break;
+      case ArrayBufferObject::MAPPED: row.kind = KandeloBufferKind::Mapped;break;
+      case ArrayBufferObject::WASM: row.kind = KandeloBufferKind::Wasm;break;
+      case ArrayBufferObject::EXTERNAL: row.kind = KandeloBufferKind::External;break;
+      case ArrayBufferObject::USER_OWNED: row.kind = KandeloBufferKind::UserOwned;break;
+      default: MOZ_CRASH("unknown ArrayBuffer backing kind");
+    }
+  } else if (object->is<TypedArrayObject>() && !object->as<TypedArrayObject>().hasBuffer()) {
+    row.kind = KandeloBufferKind::UnmaterializedView;
+  } else return;
+  // System allocation cannot run JS or move GC things. A failed append stops
+  // observation, never publishes a partial success or exception under tracing.
+  if (!walk->rows.append(row)) walk->failed = true;
+}
+} // namespace
+JS_PUBLIC_API JS::KandeloArrayBufferSnapshotStatus
+JS::CollectKandeloArrayBufferSnapshot(JSContext* cx, MallocSizeOf mallocSizeOf,
+                                     KandeloArrayBufferSnapshot* result) {
+  using Status = KandeloArrayBufferSnapshotStatus;
+  MOZ_RELEASE_ASSERT(mallocSizeOf && result);
+  // IterateHeapUnbarriered internally prepares tracing by FinishGC. With no
+  // active incremental collection and no callback before entry, that operation
+  // cannot collect/reenter. Busy contexts fail before taking any data pointers.
+  if (RuntimeHeapIsBusy() || IsIncrementalGCInProgress(cx) || cx->suppressGC ||
+      !cx->isNurseryAllocAllowed()) return Status::Busy;
+  KandeloBufferWalk walk(mallocSizeOf);
+  KandeloArrayBufferSnapshot snapshot;
+  {
+    JS::AutoAssertNoGC nogc(cx);
+    WaitForAllHelperThreads();
+    snapshot.nurseryEmpty = cx->nursery().isEmpty();
+    IterateHeapUnbarriered(cx, &walk, KandeloBufferZone, KandeloBufferRealm,
+                           KandeloBufferArena, KandeloBufferCell);
+    if (walk.failed) return Status::OutOfMemory;
+    // ArrayBuffer allocation is explicitly tenured in this pin. Nursery-only
+    // unmaterialized typed views remain outside this census and are labeled.
+    // Deduplicate native allocation identities while no GC/JS can release them.
+    if (walk.rows.length() > 1) {
+      std::sort(walk.rows.begin(), walk.rows.end(), [](const auto& a, const auto& b) {
+        return a.allocation < b.allocation;
+      });
+    }
+    snapshot.realms = walk.realms;
+    uintptr_t previousAllocation = 0;
+    auto add = [](uint64_t* total, uint64_t bytes) {
+      if (bytes > UINT64_MAX - *total) return false;
+      *total += bytes;return true;
+    };
+    for (const auto& row : walk.rows) {
+      if (row.kind == KandeloBufferKind::Shared) { ++snapshot.sharedObjects;continue; }
+      if (row.kind == KandeloBufferKind::UnmaterializedView) {
+        ++snapshot.unmaterializedTenuredTypedArrayObjects;continue;
+      }
+      ++snapshot.arrayBufferObjects;
+      switch (row.kind) {
+        case KandeloBufferKind::Inline:
+          ++snapshot.inlineObjects;
+          if (!add(&snapshot.inlinePayloadBytes, row.bytes)) return Status::Overflow;
+          break;
+        case KandeloBufferKind::Malloc:
+          ++snapshot.mallocBackedObjects;
+          if (row.allocation && row.allocation != previousAllocation) {
+            ++snapshot.uniqueMallocAllocations;previousAllocation = row.allocation;
+            if (!add(&snapshot.mallocUsableBytes, row.bytes)) return Status::Overflow;
+          }
+          break;
+        case KandeloBufferKind::Detached: ++snapshot.detachedObjects;break;
+        case KandeloBufferKind::NoData: ++snapshot.noDataObjects;break;
+        case KandeloBufferKind::Mapped: ++snapshot.mappedObjects;break;
+        case KandeloBufferKind::Wasm: ++snapshot.wasmObjects;break;
+        case KandeloBufferKind::External: ++snapshot.externalObjects;break;
+        case KandeloBufferKind::UserOwned: ++snapshot.userOwnedObjects;break;
+        default: MOZ_CRASH("unexpected backing snapshot row");
+      }
+    }
+  }
+  // Only native scalars leave tracing. No moving object, raw data pointer or
+  // pending JS root escapes to the caller's subsequent object allocations.
+  *result = snapshot;return Status::Ok;
+}
