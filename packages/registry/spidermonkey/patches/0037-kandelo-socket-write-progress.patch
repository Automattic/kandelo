+// Report pending bytes from the actual write operations, including partial
+// native writes. Socket inactivity timers must distinguish progress from a
+// stalled write rather than suppressing timeouts whenever a write is pending.
+static bool KandeloNativeSocketWriteQueueSize(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  int32_t fd;
+  if (args.length() < 1 || !JS::ToInt32(cx, args[0], &fd)) return false;
+  double bytes = 0;
+  for (auto* watch = gKandeloSocketWatches; watch; watch = watch->next) {
+    if (watch->fd == fd && watch->kind == KandeloSocketWatchKind::Write) {
+      bytes += double(watch->buffer.size() - watch->offset);
+    }
+  }
+  args.rval().setDouble(bytes);
+  return true;
+}
