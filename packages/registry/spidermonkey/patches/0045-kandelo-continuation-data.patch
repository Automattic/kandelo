+// Even an undefined frame needs a record: a reaction registered outside a
+// scope must not inherit the resolver's context when it runs later.
+class KandeloContinuationSnapshot : public NativeObject {
+ public:
+  static const JSClass class_;
+};
+const JSClass KandeloContinuationSnapshot::class_ = {
+    "KandeloContinuationSnapshot", JSCLASS_HAS_RESERVED_SLOTS(1)};
+
+bool JSContext::kandeloContinuationSnapshot(HandleObject hostData,
+                                           MutableHandleValue snapshot) {
+  snapshot.setUndefined();
+  if (!hostData) return true;
+  RootedObject record(this, CheckedUnwrapStatic(hostData));
+  if (!record || !record->is<KandeloContinuationSnapshot>()) {
+    JS_ReportErrorASCII(this, "Invalid promise async-context host data");
+    return false;
+  }
+  snapshot.set(record->as<KandeloContinuationSnapshot>().getReservedSlot(0));
+  return compartment()->wrap(this, snapshot);
+}
