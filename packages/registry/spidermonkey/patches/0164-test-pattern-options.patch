+static bool KandeloDefineTestPatternOptions(JSContext* cx, HandleObject cli) {
+  auto list = [&](const char* name, const std::vector<std::string>& values) {
+    RootedObject array(cx, JS::NewArrayObject(cx, 0));
+    if (!array) return false;
+    uint32_t index = 0;
+    for (const auto& value : values) {
+      UniqueChars utf8 = JS::EncodeNarrowToUtf8(cx, value.c_str());
+      RootedString text(cx, utf8 ? NewStringCopyUTF8(cx, utf8.get()) : nullptr);
+      if (!text || !JS_DefineElement(cx, array, index++, text, JSPROP_ENUMERATE))
+        return false;
+    }
+    return JS_DefineProperty(cx, cli, name, array, 0);
+  };
+  return list("testNamePatterns", kandeloNodeCLI.testNamePatterns) &&
+         list("testSkipPatterns", kandeloNodeCLI.testSkipPatterns);
+}
