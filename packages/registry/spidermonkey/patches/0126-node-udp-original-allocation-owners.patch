+SpanRef AcquireBuffer(JSContext* cx, HandleObject input) {
+  try {
+    RootedObject buffer(cx, JS::UnwrapSharedArrayBuffer(input));
+    const bool shared = bool(buffer);
+    if (!buffer) buffer = JS::UnwrapArrayBuffer(input);
+    if (!buffer) {
+      if (!cx->isExceptionPending() && !cx->isThrowingOutOfMemory() &&
+          !cx->isThrowingOverRecursed() && !cx->isPropagatingForcedReturn()) {
+        JS_ReportErrorASCII(cx, "Backing lease requires an accessible actual buffer");
+      }
+      return {};
+    }
+    JSAutoRealm realm(cx, buffer);
+    const size_t length = shared ? buffer->as<SharedArrayBufferObject>().byteLength() :
+                                  buffer->as<ArrayBufferObject>().byteLength();
+    return CaptureBufferOwner(cx, buffer, shared, 0, length);
+  } catch (const std::bad_alloc&) { ReportOutOfMemory(cx); return {}; }
+  catch (const std::exception& error) { JS_ReportErrorASCII(cx, "Backing lease: %s", error.what()); return {}; }
