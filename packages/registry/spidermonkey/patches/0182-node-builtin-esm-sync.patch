@@ -215,4 +217,38 @@ static const JSClass KandeloSyntheticOwnerClass = {
     "NodeSyntheticExportsOwner", JSCLASS_HAS_RESERVED_SLOTS(KandeloSyntheticSlotCount)};

+// A real synthetic module environment, not a caller-provided URL or record.
+static bool KandeloSetSyntheticExport(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (!args.thisv().isObject()) {
+    JS_ReportErrorASCII(cx, "Invalid native synthetic export owner");
+    return false;
+  }
+  RootedObject owner(cx, &args.thisv().toObject());
+  owner = CheckedUnwrapDynamic(owner, cx);
+  if (!owner) {
+    if (!JS_IsExceptionPending(cx)) ReportAccessDenied(cx);
+    return false;
+  }
+  if (JS::GetClass(owner) != &KandeloSyntheticOwnerClass ||
+      args.length() != 2 || !args[0].isString()) {
+    JS_ReportErrorASCII(cx, "Invalid native synthetic export operation");
+    return false;
+  }
+  JSAutoRealm realm(cx, owner);
+  RootedValue exportName(cx, args[0]), value(cx, args[1]);
+  if (!JS_WrapValue(cx, &exportName) || !JS_WrapValue(cx, &value)) return false;
+  Rooted<ModuleObject*> module(cx,
+      &JS::GetReservedSlot(owner, KandeloSyntheticRecord).toObject().as<ModuleObject>());
+  Rooted<JSAtom*> name(cx, AtomizeString(cx, exportName.toString()));
+  if (!name) return false;
+  if (!ModuleObject::setSyntheticExport(cx, module, name, value)) {
+    if (!JS_IsExceptionPending(cx))
+      JS_ReportErrorASCII(cx, "Unknown actual synthetic export name");
+    return false;
+  }
+  args.rval().setUndefined();
+  return true;
+}
