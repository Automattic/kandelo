+#include "kandelo-node-monotonic-clock.h"
+static bool KandeloNativeHrtime(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  uint64_t value;
+  if (kandelo::clock::Nanoseconds(&value) != 0) {
+    const int error = errno;
+    JS_ReportErrorUTF8(cx, "clock_gettime: %s", strerror(error));
+    KandeloDecoratePendingError(cx, error); return false;
+  }
+  JS::BigInt* result = JS::NumberToBigInt(cx, value);
+  if (!result) return false;
+  args.rval().setBigInt(result); return true;
+}
