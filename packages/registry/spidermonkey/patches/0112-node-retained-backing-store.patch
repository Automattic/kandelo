+#ifndef js_experimental_KandeloBackingTransfers_h
+#define js_experimental_KandeloBackingTransfers_h
+#include <mutex>
+#include <vector>
+
+#include "js/experimental/KandeloBackingCapabilities.h"
+namespace JS::KandeloBacking {
+MetadataRef TrackMetadata(size_t, const AccountRef&);
+class TransferEntry {
+  std::mutex mutex_;
+  AllocationRef allocation_;
+  enum State { Available, Reading, Consumed, Aborted } state_ = Available;
+  MetadataRef material_;
+ public:
+  const uint32_t kind;
+  const size_t byteLength, maxByteLength;
+  const bool resizable;
+  void (*const externalFree)(void*, void*);
+  void* const externalUser;
+  TransferEntry(AllocationRef allocation, uint32_t kind, size_t bytes, size_t maximum,
+                bool resizable, void (*free)(void*,void*), void* user)
+      : allocation_(std::move(allocation)), material_(TrackMetadata(sizeof(TransferEntry), {})),
+        kind(kind), byteLength(bytes), maxByteLength(maximum), resizable(resizable), externalFree(free), externalUser(user) {}
+  AllocationRef BeginRead() {
+    std::lock_guard lock(mutex_);
+    if (state_ != Available || !allocation_) return {};
+    state_ = Reading; return allocation_;
+  }
+  bool CommitRead() {
+    AllocationRef old;
+    { std::lock_guard lock(mutex_); if (state_ != Reading) return false;
+      state_ = Consumed; old = std::move(allocation_); }
+    return true;
+  }
+  void CancelRead() { std::lock_guard lock(mutex_); if (state_ == Reading) state_ = Available; }
+  void Abort() {
+    AllocationRef old;
+    { std::lock_guard lock(mutex_); if (state_ == Consumed) return;
+      state_ = Aborted; old = std::move(allocation_); }
+  }
+};
+class Transfers {
+  mutable std::mutex mutex_;
+  std::vector<std::shared_ptr<TransferEntry>> entries_;
+  MetadataRef material_ = TrackMetadata(sizeof(Transfers), {});
+ public:
+  ~Transfers() { Abort(); }
+  size_t Add(std::shared_ptr<TransferEntry> entry) {
+    std::lock_guard lock(mutex_); const size_t index = entries_.size(); entries_.push_back(std::move(entry));
+    if (material_) material_->Resize(sizeof(Transfers) + entries_.capacity()*sizeof(entries_[0]));
+    return index;
+  }
+  std::shared_ptr<TransferEntry> Get(size_t index) const {
+    std::lock_guard lock(mutex_); return index < entries_.size() ? entries_[index] : nullptr;
+  }
+  void Abort() {
+    std::vector<std::shared_ptr<TransferEntry>> old;
+    { std::lock_guard lock(mutex_); old.swap(entries_); if (material_) material_->Resize(sizeof(Transfers)); }
+    for (auto& entry : old) entry->Abort();
+  }
+};
+} // namespace JS::KandeloBacking
+#endif
