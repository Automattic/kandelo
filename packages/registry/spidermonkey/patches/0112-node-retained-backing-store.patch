+    size_t capacity = buffer->isWasm() ? buffer->wasmClampedMaxByteLength() : buffer->maxByteLength();
+    if (buffer->isMapped()) capacity = buffer->associatedBytes();
+    if (buffer->bufferKind() == USER_OWNED && capacity) {
+      JS_ReportErrorASCII(cx, "User-owned backing requires an actual embedder retain capability"); return false;
+    }
+    if (buffer->bufferKind() == INLINE_DATA && capacity) {
+      // This pin reserves RAB maximum storage at creation. Establish that same
+      // real capacity before capturing a span; do not pin its visible length.
+      ArrayBufferContents copy = AllocateArrayBufferContents(cx, capacity);
+      if (!copy) return false;
+      uint8_t* old = buffer->dataPointer();
+      if (buffer->byteLength()) memcpy(copy.get(), old, buffer->byteLength());
+      auto contents = BufferContents::createMallocedArrayBufferContentsArena(copy.release());
+      buffer->setDataPointer(contents);
+      AddCellMemory(buffer, capacity, MemoryUse::ArrayBufferContents);
+      if (auto* first = buffer->firstView()) first->as<ArrayBufferViewObject>().notifyBufferMoved(old, contents.data());
+      auto& views = ObjectRealm::get(buffer).innerViews.get();
+      if (auto* list = views.maybeViewsUnbarriered(buffer))
+        for (JSObject* view : *list) view->as<ArrayBufferViewObject>().notifyBufferMoved(old, contents.data());
+    }
+    auto contents = buffer->contents();
+    // Empty external/malloc allocations still own their actual free callback
+    // and metadata. Only inline/no-data/user-borrowed empty spans need no store.
+    const bool empty = capacity == 0 && (contents.kind() == INLINE_DATA || contents.kind() == NO_DATA || contents.kind() == USER_OWNED);
+    auto policy = std::make_unique<KandeloBackingFreePolicy>(KandeloBackingFreePolicy{
+        empty ? NO_DATA : contents.kind(), contents.freeFunc(), contents.freeUserData(), buffer->byteLength(),
+        JS::KandeloBacking::TrackMetadata(sizeof(KandeloBackingFreePolicy))});
+    auto allocation = JS::KandeloBacking::Prepare(empty ? nullptr : contents.data(), capacity,
+        KandeloReleaseBackingAllocation, policy.get());
+    if (!allocation) { JS_ReportErrorASCII(cx, "Backing ownership provider is unavailable"); return false; }
+    const bool engineAccounts = !empty && !buffer->isExternal();
+    auto owner = PrepareKandeloBackingOwner(cx, allocation, engineAccounts);
+    if (!owner) return false;
+    buffer->setKandeloBackingOwner(owner.release());
