+/* static */ ArrayBufferObject* ArrayBufferObject::createForRetainedContents(JSContext* cx,
+    size_t byteLength, size_t maxByteLength, bool resizable, BufferContents contents, bool charge) {
+  MOZ_ASSERT(contents.retained());
+  auto owner = PrepareKandeloBackingOwner(cx, contents.retained(), (contents.kind() == MALLOCED_ARRAYBUFFER_CONTENTS_ARENA || contents.kind() == MALLOCED_UNKNOWN_ARENA || contents.kind() == MAPPED || contents.kind() == WASM));
+  if (!owner) return nullptr;
+  AutoSetNewObjectMetadata metadata(cx);
+  Rooted<ArrayBufferObject*> object(cx);
+  if (resizable) object = NewResizableArrayBufferObject(cx);
+  else {
+    size_t slots = FixedLengthArrayBufferObject::RESERVED_SLOTS;
+    if (contents.kind() == EXTERNAL) slots += HowMany(sizeof(FreeInfo), sizeof(Value));
+    object = NewArrayBufferObject<FixedLengthArrayBufferObject>(cx, nullptr, GetArrayBufferGCObjectKind(slots));
+  }
+  if (!object) return nullptr;
+  object->setKandeloBackingOwner(owner.release());
+  if (resizable) object->as<ResizableArrayBufferObject>().initialize(byteLength, maxByteLength, contents);
+  else object->as<FixedLengthArrayBufferObject>().initialize(byteLength, contents);
+  if (charge && (object->isMalloced() || object->isMapped())) AddCellMemory(object, object->associatedBytes(), MemoryUse::ArrayBufferContents);
+  else if (charge && object->isWasm()) AddCellMemory(object, byteLength, MemoryUse::ArrayBufferContents);
+  return object;
