+// Kandelo: synchronous require() of an ES module. Node's require() CJS-wraps
+// its target (a classic-script goal), which cannot host top-level import/export
+// declarations. This drives the SAME module load path that import and dynamic
+// import() use -- loadAndParse hits (and populates) the per-path module
+// registry, so require/import/import() of one resolved path collapse onto a
+// single module instance and namespace. A module with a pending top-level await
+// cannot complete synchronously, so it throws ERR_REQUIRE_ASYNC_MODULE; a
+// synchronous evaluation rejection is rethrown to the caller.
+bool ModuleLoader::requireModuleNamespace(JSContext* cx, HandleString path,
+                                          MutableHandleValue rval) {
+  RootedObject module(cx, loadAndParse(cx, path, nullptr));
+  if (!module) {
+    return false;
+  }
+
+  if (!JS::ModuleLink(cx, module)) {
+    return false;
+  }
+
+  RootedValue evalResult(cx);
+  if (!JS::ModuleEvaluate(cx, module, &evalResult)) {
+    return false;
+  }
+
+  if (!evalResult.isObject()) {
+    JS_ReportErrorASCII(cx, "module evaluation did not return a promise");
+    return false;
+  }
+
+  RootedObject evalPromise(cx, &evalResult.toObject());
+  JS::PromiseState state = JS::GetPromiseState(evalPromise);
+
+  if (state == JS::PromiseState::Rejected) {
+    RootedValue reason(cx, JS::GetPromiseResult(evalPromise));
+    JS_SetPendingException(cx, reason);
+    return false;
+  }
+
+  if (state == JS::PromiseState::Pending) {
+    UniqueChars pathUtf8 = JS_EncodeStringToUTF8(cx, path);
+    if (!pathUtf8) {
+      return false;
+    }
+    JS_ReportErrorUTF8(
+        cx, "require() of ES Module %s with top-level await is not supported",
+        pathUtf8.get());
+    RootedValue exn(cx);
+    if (JS_GetPendingException(cx, &exn) && exn.isObject()) {
+      JS_ClearPendingException(cx);
+      RootedObject exnObj(cx, &exn.toObject());
+      RootedString codeStr(cx,
+                           JS_NewStringCopyZ(cx, "ERR_REQUIRE_ASYNC_MODULE"));
+      if (!codeStr) {
+        return false;
+      }
+      RootedValue codeVal(cx, StringValue(codeStr));
+      if (!JS_DefineProperty(cx, exnObj, "code", codeVal, JSPROP_ENUMERATE)) {
+        return false;
+      }
+      JS_SetPendingException(cx, exn);
+    }
+    return false;
+  }
+
+  RootedObject ns(cx, JS::GetModuleNamespace(cx, module));
+  if (!ns) {
+    return false;
+  }
+  rval.setObject(*ns);
+  return true;
+}
