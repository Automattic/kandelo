+static bool KandeloDefineWarningOptions(JSContext* cx, HandleObject cli) {
+  if (!KandeloDefineBooleanProperty(cx, cli, "noDeprecation", kandeloNodeCLI.noDeprecation, 0) ||
+      !KandeloDefineBooleanProperty(cx, cli, "throwDeprecation", kandeloNodeCLI.throwDeprecation, 0) ||
+      !KandeloDefineBooleanProperty(cx, cli, "traceDeprecation", kandeloNodeCLI.traceDeprecation, 0) ||
+      !KandeloDefineBooleanProperty(cx, cli, "traceWarnings", kandeloNodeCLI.traceWarnings, 0)) return false;
+  auto stringOption = [&](const char* name, const std::string& value) {
+    UniqueChars utf8 = JS::EncodeNarrowToUtf8(cx, value.c_str());
+    RootedString text(cx, utf8 ? NewStringCopyUTF8(cx, utf8.get()) : nullptr);
+    return text && JS_DefineProperty(cx, cli, name, text, 0);
+  };
+  if (!stringOption("redirectWarnings", kandeloNodeCLI.redirectWarnings) ||
+      !stringOption("diagnosticDir", kandeloNodeCLI.diagnosticDir)) return false;
+  RootedObject disabled(cx, JS::NewArrayObject(cx, 0));
+  if (!disabled) return false;
+  uint32_t index = 0;
+  for (const auto& item : kandeloNodeCLI.disableWarnings) {
+    UniqueChars utf8 = JS::EncodeNarrowToUtf8(cx, item.c_str());
+    RootedString text(cx, utf8 ? NewStringCopyUTF8(cx, utf8.get()) : nullptr);
+    if (!text || !JS_DefineElement(cx, disabled, index++, text, JSPROP_ENUMERATE)) return false;
+  }
+  return JS_DefineProperty(cx, cli, "disableWarnings", disabled, 0);
+}
