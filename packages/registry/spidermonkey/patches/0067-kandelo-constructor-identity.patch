+bool ObjectRealm::recordConstructorIdentity(JSContext* cx, HandleObject obj,
+                                            HandleObject constructor) {
+  MOZ_ASSERT(&ObjectRealm::get(obj) == this);
+  MOZ_ASSERT(&ObjectRealm::get(constructor) == this);
+  cx->check(obj, constructor);
+  if (!constructorIdentity_) {
+    auto map = cx->make_unique<ObjectWeakMap>(cx);
+    if (!map) {
+      return false;
+    }
+    constructorIdentity_ = std::move(map);
+  }
+  MOZ_RELEASE_ASSERT(!constructorIdentity_->lookup(obj));
+  if (!constructorIdentity_->put(obj, constructor)) {
+    ReportOutOfMemory(cx);
+    return false;
+  }
+  return true;
+}
+
+JSObject* ObjectRealm::getConstructorIdentity(JSObject* obj) {
+  MOZ_ASSERT(&ObjectRealm::get(obj) == this);
+  return constructorIdentity_ ? constructorIdentity_->get(obj) : nullptr;
+}
+
 void ObjectRealm::trace(JSTracer* trc) {
+  if (constructorIdentity_) {
+    constructorIdentity_->trace(trc);
+  }
