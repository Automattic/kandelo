+// No JS/allocation: capture only an actual matching terminal operation whose
+// output has been fully acknowledged (or which genuinely produced no output).
+static bool KandeloTlsCaptureEncryptedCompletion(KandeloTlsWatch* watch) {
+  using Result = KandeloTlsWatch::Result;
+  if (watch->encryptedComplete) return true;
+  if ((watch->result == Result::Connected || watch->result == Result::Count) &&
+      !watch->state->encryptedError && watch->state->owner.Matches(watch->generation) &&
+      !watch->state->owner.EncryptedPending()) watch->encryptedComplete = true;
+  return watch->encryptedComplete;
+}
+static void KandeloTlsCaptureOwnerCompletions(KandeloTlsState* state) {
+  // The ordinary pump runs no JS and mutates neither index. The write index
+  // also covers a request temporarily unlinked for publication/close batches.
+  for (auto* watch = gKandeloTlsWatches; watch; watch = watch->next)
+    if (watch->state == state) (void)KandeloTlsCaptureEncryptedCompletion(watch);
+  for (auto* watch = state->writes; watch; watch = watch->nextWrite)
+    (void)KandeloTlsCaptureEncryptedCompletion(watch);
+}
