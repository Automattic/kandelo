+// Called only by the real TLS write consumer after its callback, or when
+// reaction admission fails and it must abort instead of losing an SSL retry.
+static bool KandeloNativeTlsWriteRelease(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp); args.rval().setBoolean(false);
+  RootedObject capability(cx); auto* state = KandeloTlsStateFor(cx, args.get(0), &capability);
+  if (!state) return false;
+  if (!args.get(1).isObject()) return true;
+  RootedObject promise(cx, js::CheckedUnwrapDynamic(&args[1].toObject(), cx));
+  if (!promise) {
+    if (!JS_IsExceptionPending(cx)) js::ReportAccessDenied(cx);
+    return false;
+  }
+  const bool abandon = args.get(2).isTrue();
+  for (auto* watch = state->writes; watch; watch = watch->nextWrite) {
+    if (watch->generation != state->owner.Generation() || watch->promise.get() != promise.get())
+      continue;
+    if (!abandon && !watch->awaitingWriteCallback &&
+        !(watch->publishingWrite &&
+          JS::GetPromiseState(watch->promise) != JS::PromiseState::Pending)) return true;
+    // No JS, root allocation or borrowed public descriptor crosses retirement.
+    // Abandonment first destroys SSL, so an OpenSSL WANT retry cannot outlive
+    // its retained write buffer. Other requests keep their own cancellation.
+    if (abandon) state->BeginClose(false);
+    watch->writeCallbackAcknowledged = true;
+    // A dispatch frame or detached close batch still owns an unlinked ticket.
+    // Mark it without deleting a raw pointer that the native frame will use.
+    if (!watch->dispatchLinked) { args.rval().setBoolean(true); return true; }
+    KandeloTlsWatchUnlink(watch); js_delete(watch);
+    args.rval().setBoolean(true); return true;
+  }
+  return true;
