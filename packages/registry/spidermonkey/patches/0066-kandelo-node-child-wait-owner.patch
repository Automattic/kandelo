+// Convert one retained wait outcome in its promise's actual realm. Failed
+// conversion leaves the outcome in the registered owner for failure/teardown.
+static bool KandeloDeliverChildWatch(JSContext* cx, KandeloSocketWatch* watch) {
+  RootedObject promise(cx, watch->promise.get());
+  JSAutoRealm realm(cx, promise);
+  return watch->childWait.Deliver([&](const kandelo::child_wait::Outcome& result) {
+    using Kind = kandelo::child_wait::Kind;
+    if (result.kind == Kind::Error)
+      return KandeloRejectSocketOperation(cx, promise, result.error, "waitpid",
+                                          KandeloErrnoCode(result.error));
+    if (result.kind == Kind::Exit)
+      return KandeloResolveChild(cx, promise, true, result.code, nullptr);
+    if (result.kind == Kind::Signal)
+      return KandeloResolveChild(cx, promise, false, 0, KandeloSignalName(result.signal));
+    MOZ_CRASH("Cannot deliver a pending child wait");
+  });
+}
+
+static void KandeloShutdownChildWatches(JSContext* cx) {
+  auto** link = &gKandeloSocketWatches;
+  while (*link) {
+    auto* watch = *link;
+    if (watch->kind == KandeloSocketWatchKind::Child && watch->cx == cx) {
+      *link = watch->next;
+      // WNOHANG owns no outstanding syscall. Release only this context's JS
+      // roots, without a callback, invented status, signal or second reap.
+      js_delete(watch);
+    } else link = &watch->next;
+  }
 }
 
