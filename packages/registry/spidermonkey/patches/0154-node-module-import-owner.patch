+// Original specifier/referrer/attributes enter the same genuine module graph
+// as static imports and require(esm); no source wrapper or require surrogate.
+static bool KandeloNativeImportModule(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (args.length() < 1 || !args[0].isString() ||
+      (!args.get(1).isUndefined() && !args[1].isString()) ||
+      (!args.get(2).isUndefined() && !args[2].isObject())) {
+    JS_ReportErrorASCII(cx,
+        "importModule requires a string specifier, optional string referrer "
+        "and optional attribute record");
+    return false;
+  }
+  ShellContext* sc = GetShellContext(cx);
+  if (!sc || !sc->moduleLoader) {
+    JS_ReportErrorASCII(cx, "module loader is not initialized");
+    return false;
+  }
+  RootedString specifier(cx, args[0].toString());
+  return sc->moduleLoader->importModuleNamespace(
+      cx, specifier, args.get(1), args.get(2), args.rval());
+}
