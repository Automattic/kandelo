+// The import promise and actual module are traced native-function slots. A
+// fulfilled evaluation must not resolve the specifier again: user hooks can
+// intentionally select a different module on the next import (cache:false).
+template <bool Reject>
+static bool KandeloModuleImportSettled(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  RootedObject promise(
+      cx, &GetFunctionNativeReserved(&args.callee(), 0).toObject());
+  RootedObject module(
+      cx, &GetFunctionNativeReserved(&args.callee(), 1).toObject());
+  args.rval().setUndefined();
+  if constexpr (Reject) {
+    return JS::RejectPromise(cx, promise, args.get(0));
+  } else {
+    RootedObject ns(cx, JS::GetModuleNamespace(cx, module));
+    if (!ns) {
+      RootedValue error(cx);
+      if (!JS_GetPendingException(cx, &error)) return false;
+      JS_ClearPendingException(cx);
+      return JS::RejectPromise(cx, promise, error);
+    }
+    RootedValue value(cx, ObjectValue(*ns));
+    return JS::ResolvePromise(cx, promise, value);
+  }
+}
+
+static bool KandeloModuleImportRejectPending(JSContext* cx,
+                                               HandleObject promise) {
+  RootedValue error(cx);
+  if (!JS_GetPendingException(cx, &error)) return false;
+  JS_ClearPendingException(cx);
+  return JS::RejectPromise(cx, promise, error);
+}
+
+static bool KandeloStartModuleImportEvaluation(JSContext* cx,
+                                                HandleObject module,
+                                                HandleObject promise) {
+  // Reentrant imports may see a linking/evaluating cached module before this
+  // job runs. Never call ModuleLink on an already evaluating module.
+  if (module->as<ModuleObject>().status() == ModuleStatus::Unlinked &&
+      !JS::ModuleLink(cx, module))
+    return KandeloModuleImportRejectPending(cx, promise);
+  RootedValue evaluation(cx);
+  if (!JS::ModuleEvaluate(cx, module, &evaluation))
+    return KandeloModuleImportRejectPending(cx, promise);
+  if (!evaluation.isObject()) {
+    JS_ReportErrorASCII(cx, "Module evaluation did not return a promise");
+    return KandeloModuleImportRejectPending(cx, promise);
+  }
+  RootedObject completion(cx, &evaluation.toObject());
+  RootedFunction fulfilled(
+      cx, NewFunctionWithReserved(cx, KandeloModuleImportSettled<false>, 1, 0,
+                                  ""));
+  RootedFunction rejected(
+      cx, NewFunctionWithReserved(cx, KandeloModuleImportSettled<true>, 1, 0,
+                                  ""));
+  if (!fulfilled || !rejected)
+    return KandeloModuleImportRejectPending(cx, promise);
+  for (JSFunction* function : {fulfilled.get(), rejected.get()}) {
+    SetFunctionNativeReserved(function, 0, ObjectValue(*promise));
+    SetFunctionNativeReserved(function, 1, ObjectValue(*module));
+  }
+  RootedObject onFulfilled(cx, JS_GetFunctionObject(fulfilled));
+  RootedObject onRejected(cx, JS_GetFunctionObject(rejected));
+  if (!JS::AddPromiseReactions(cx, completion, onFulfilled, onRejected))
+    return KandeloModuleImportRejectPending(cx, promise);
+  return true;
+}
+
+static bool KandeloModuleImportEvaluate(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  RootedObject promise(
+      cx, &GetFunctionNativeReserved(&args.callee(), 0).toObject());
+  RootedObject module(
+      cx, &GetFunctionNativeReserved(&args.callee(), 1).toObject());
+  args.rval().setUndefined();
+  return KandeloStartModuleImportEvaluation(cx, module, promise);
+}
+
+bool ModuleLoader::importModuleNamespace(JSContext* cx, HandleString specifier,
+                                         HandleValue parentURL,
+                                         HandleValue attributes,
+                                         MutableHandleValue rval) {
+  RootedObject promise(cx, JS::NewPromiseObject(cx, nullptr));
+  if (!promise) return false;
+  auto reject = [&]() {
+    if (!KandeloModuleImportRejectPending(cx, promise)) return false;
+    rval.setObject(*promise);
+    return true;
+  };
+
+  Rooted<JSAtom*> name(cx, AtomizeString(cx, specifier));
+  if (!name) return reject();
+  Rooted<ModuleRequestObject*> request(
+      cx, ModuleRequestObject::create(cx, name, JS::ModuleType::JavaScript));
+  if (!request) return reject();
+  // Raw Node loader attributes belong to the real Node resolve/load hooks.
+  // They must not receive syntax-only filtering, a copy, or an early `type`
+  // getter. Node's actual record selects its URL/type registry identity.
+  if (attributes.isObject()) {
+    JS::SetReservedSlot(request, ModuleRequestObject::ImportAttributesSlot,
+                        attributes);
+  }
+  RootedValue referencingPrivate(cx, UndefinedValue());
+  if (parentURL.isString()) {
+    RootedString parent(cx, parentURL.toString());
+    RootedObject info(cx, CreateScriptPrivate(cx, parent));
+    if (!info) return reject();
+    referencingPrivate.setObject(*info);
+  }
+  // Use the original string overload so even an empty specifier reaches the
+  // actual Node resolver/error owner instead of the shell's early rejection.
+  Rooted<JSLinearString*> path(
+      cx, resolve(cx, specifier, referencingPrivate, request));
+  if (!path) return reject();
+  RootedObject module(cx, loadAndParse(cx, path, request));
+  if (!module) return reject();
+  if (module->as<ModuleObject>().status() == ModuleStatus::Unlinked &&
+      !JS::ModuleLink(cx, module)) return reject();
+  // Resolution/source/linking stay synchronous like Node's sync hook path;
+  // user module evaluation starts only after the import call has returned.
+  RootedFunction evaluate(
+      cx, NewFunctionWithReserved(cx, KandeloModuleImportEvaluate, 1, 0, ""));
+  if (!evaluate) return reject();
+  SetFunctionNativeReserved(evaluate, 0, ObjectValue(*promise));
+  SetFunctionNativeReserved(evaluate, 1, ObjectValue(*module));
+  RootedObject callback(cx, JS_GetFunctionObject(evaluate));
+  RootedObject delay(cx, JS::CallOriginalPromiseResolve(cx, UndefinedHandleValue));
+  if (!delay || !JS::AddPromiseReactions(cx, delay, callback, nullptr))
+    return reject();
+  rval.setObject(*promise);
+  return true;
+}
