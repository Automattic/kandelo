+// Captured TTY input uses the real fd-read reactor, with actual opaque owner
+// roots and exact request matching. It is not a TCPWRAP or TTYWRAP identity.
+static KandeloSocketWatch* KandeloTerminalPendingRead(KandeloTerminalLease* lease) {
+  for (auto* watch = gKandeloSocketWatches; watch; watch = watch->next)
+    if (watch->terminalLease == lease) return watch;
+  return nullptr;
+}
+static bool KandeloTerminalRead(JSContext* cx, HandleObject owner,
+    KandeloTerminalLease* lease, int32_t length, MutableHandleValue result) {
+  try {
+    RootedObject promise(cx, JS::NewPromiseObject(cx, nullptr));if (!promise) return false;
+    result.setObject(*promise);
+    // Promise creation can run hooks. Re-read the actual lease after that
+    // allocation, never use a previously captured numeric fd after reentry.
+    if (lease->inputClosing || lease->input.Descriptor() < 0)
+      return KandeloResolvePromiseWithErrno(cx, promise, EBADF, nullptr);
+    if (KandeloTerminalPendingRead(lease))
+      return KandeloResolvePromiseWithErrno(cx, promise, EALREADY, nullptr);
+    std::vector<uint8_t> bytes(size_t(length), uint8_t(0));
+    const int fd = lease->input.Descriptor();
+    ssize_t size;do { size = read(fd, bytes.data(), bytes.size()); } while (size < 0 && errno == EINTR);
+    if (size >= 0) return KandeloResolvePromiseWithBytes(cx, promise, bytes.data(), size_t(size));
+    if (errno != EAGAIN && errno != EWOULDBLOCK)
+      return KandeloResolvePromiseWithErrno(cx, promise, errno, nullptr);
+    auto* watch = js_new<KandeloSocketWatch>(cx, fd, KandeloSocketWatchKind::Read, promise);
+    if (!watch) { JS_ReportOutOfMemory(cx);return false; }
+    watch->buffer = std::move(bytes);watch->terminalOwner = owner;watch->terminalLease = lease;
+    KandeloSocketWatchLink(watch);return true;
+  } catch (const std::bad_alloc&) { JS_ReportOutOfMemory(cx);return false; }
+}
+static bool KandeloTerminalCancelRead(JSContext* cx, KandeloTerminalLease* lease,
+                                      bool notify, bool* cancelled) {
+  auto* watch = KandeloTerminalPendingRead(lease);*cancelled = watch != nullptr;
+  if (!watch) return true;
+  KandeloSocketWatchUnlink(watch);
+  if (!notify) { js_delete(watch);return true; }
+  MOZ_RELEASE_ASSERT(cx && watch->cx == cx);
+  RootedObject promise(cx, watch->promise);
+  // Caller holds its admitted actual lease. Remove reactor/root bookkeeping
+  // before rejected-Promise hooks can close/reuse anything in this context.
+  js_delete(watch);
+  return KandeloResolvePromiseWithErrno(cx, promise, ECANCELED, nullptr);
+}
+static bool KandeloTerminalReadControl(JSContext* cx, KandeloTerminalLease* lease,
+    HandleObject promise, HandleValue control, MutableHandleValue result) {
+  result.setBoolean(false);
+  auto* watch = KandeloTerminalPendingRead(lease);
+  if (!watch || watch->cx != cx || watch->promise.get() != promise) return true;
+  result.setBoolean(true);
+  if (control.isBoolean()) { watch->referenced = control.toBoolean();return true; }
+  bool cancelled;return KandeloTerminalCancelRead(cx, lease, true, &cancelled);
 }

