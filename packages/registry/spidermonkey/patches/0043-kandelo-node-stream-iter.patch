+namespace {
+std::vector<std::string> ParseNodeOptionsEnvVar(
+    const std::string& node_options, std::vector<std::string>* errors) {
+  std::vector<std::string> env_argv;
+
+  bool is_in_string = false;
+  bool will_start_new_arg = true;
+  for (std::string::size_type index = 0; index < node_options.size(); ++index) {
+    char c = node_options.at(index);
+
+    // Backslashes escape the following character
+    if (c == '\\' && is_in_string) {
+      if (index + 1 == node_options.size()) {
+        errors->push_back("invalid value for NODE_OPTIONS "
+                          "(invalid escape)\n");
+        return env_argv;
+      } else {
+        c = node_options.at(++index);
+      }
+    } else if (c == ' ' && !is_in_string) {
+      will_start_new_arg = true;
+      continue;
+    } else if (c == '"') {
+      is_in_string = !is_in_string;
+      continue;
+    }
+
+    if (will_start_new_arg) {
+      env_argv.emplace_back(std::string(1, c));
+      will_start_new_arg = false;
+    } else {
+      env_argv.back() += c;
+    }
+  }
+
+  if (is_in_string) {
+    errors->push_back("invalid value for NODE_OPTIONS "
+                      "(unterminated string)\n");
+  }
+  return env_argv;
+}
+
+// These are guest process options. Keep original CLI arguments for execArgv;
+// NODE_OPTIONS contributes values but never appears in that CLI-only array.
+struct KandeloNodeCLIState {
+  bool noWarnings = false;
+  bool experimentalStreamIter = false;
+  bool version = false;
+  std::vector<std::string> execArgs;
+  std::vector<std::string> parserArgs;
+  std::vector<char*> parserArgv;
+};
+static KandeloNodeCLIState kandeloNodeCLI;
+
+static std::string KandeloNodeOptionName(const std::string& arg) {
+  std::string name = arg.substr(0, arg.find('='));
+  for (size_t i = 2; i < name.size(); ++i) {
+    if (name[i] == '_') name[i] = '-';
+  }
+  return name;
+}
+
+static bool ApplyKandeloNodeBooleanOption(const std::string& arg) {
+  std::string name = KandeloNodeOptionName(arg);
+  bool value = true;
+  if (name.find("--no-") == 0) {
+    name.erase(2, 3);
+    value = false;
+  }
+  // Node's boolean parser uses presence/negation; an '=...' suffix does not
+  // supply the boolean value (see pinned node_options-inl.h, kBoolean).
+  if (name == "--warnings") {
+    kandeloNodeCLI.noWarnings = !value;
+    return true;
+  }
+  if (name == "--experimental-stream-iter") {
+    kandeloNodeCLI.experimentalStreamIter = value;
+    return true;
+  }
+  return false;
+}
+
+static bool PrepareKandeloNodeCLI(int argc, char** argv) {
+  if (const char* value = getenv("NODE_OPTIONS")) {
+    std::vector<std::string> errors;
+    auto envArgs = ParseNodeOptionsEnvVar(value, &errors);
+    if (!errors.empty()) {
+      for (const auto& error : errors) fprintf(stderr, "%s: %s", argv[0], error.c_str());
+      return false;
+    }
+    for (const auto& arg : envArgs) {
+      if (!ApplyKandeloNodeBooleanOption(arg)) {
+        // Do not silently accept unsupported allowed Node options or treat
+        // guest environment text as a SpiderMonkey shell command line.
+        fprintf(stderr, "%s: NODE_OPTIONS option is not implemented: %s\n",
+                argv[0], arg.c_str());
+        return false;
+      }
+    }
+  }
+  kandeloNodeCLI.parserArgs.emplace_back(argv[0]);
+  for (int i = 1; i < argc; ++i) {
+    std::string arg = argv[i];
+    if (ApplyKandeloNodeBooleanOption(arg)) {
+      kandeloNodeCLI.execArgs.push_back(arg);
+      continue;
+    }
+    std::string name = KandeloNodeOptionName(arg);
+    if (name == "--version" || name == "--no-version" || arg == "-v") {
+      kandeloNodeCLI.version = name != "--no-version";
+      kandeloNodeCLI.execArgs.push_back(arg);
+      continue;
+    }
+    if (name == "-e" || name == "--eval" || name == "--execute") {
+      kandeloNodeCLI.execArgs.push_back(arg);
+      auto equals = arg.find('=');
+      if (equals != std::string::npos && name != "-e") {
+        kandeloNodeCLI.parserArgs.push_back("--execute" + arg.substr(equals));
+      } else {
+        if (++i == argc) {
+          fprintf(stderr, "%s: %s requires an argument\n", argv[0], arg.c_str());
+          return false;
+        }
+        kandeloNodeCLI.execArgs.emplace_back(argv[i]);
+        kandeloNodeCLI.parserArgs.emplace_back("--execute");
+        kandeloNodeCLI.parserArgs.emplace_back(argv[i]);
+      }
+      continue;
+    }
+    // Positional arguments/-- belong to the user; existing shell-specific
+    // options retain their original parser and argument-consumption behavior.
+    for (; i < argc; ++i) kandeloNodeCLI.parserArgs.emplace_back(argv[i]);
+    break;
+  }
+  // Strings are stable only after all vector growth has finished.
+  for (auto& arg : kandeloNodeCLI.parserArgs) kandeloNodeCLI.parserArgv.push_back(arg.data());
+  kandeloNodeCLI.parserArgv.push_back(nullptr);
+  return true;
+}
