+// Native promise metadata is the owner of rejection handling. This does not
+// install reactions, call a user-visible then method or change async lineage.
+static bool KandeloNativeMarkPromiseHandled(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (!args.get(0).isObject()) {
+    JS_ReportErrorASCII(cx, "markPromiseAsHandled requires a native Promise");
+    return false;
+  }
+  RootedObject promise(cx, CheckedUnwrapStatic(&args[0].toObject()));
+  if (!promise) { ReportAccessDenied(cx); return false; }
+  if (!JS::IsPromiseObject(promise)) {
+    JS_ReportErrorASCII(cx, "markPromiseAsHandled requires a native Promise");
+    return false;
+  }
+  {
+    AutoRealm ar(cx, promise);
+    if (!JS::SetAnyPromiseIsHandled(cx, promise)) return false;
+  }
+  args.rval().setUndefined();
+  return true;
+}
