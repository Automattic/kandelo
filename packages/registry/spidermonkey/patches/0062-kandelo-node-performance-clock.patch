 #include "kandelo-node-monotonic-clock.h"
+#include "kandelo-node-performance-clock.h"
+static kandelo::clock::PerformanceOrigin kandeloPerformanceOrigin;
+static bool KandeloNativePerformanceNow(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  double milliseconds;
+  if (kandeloPerformanceOrigin.Now(&milliseconds) != 0) {
+    const int error = errno;
+    JS_ReportErrorUTF8(cx, "performance clock: %s", strerror(error));
+    KandeloDecoratePendingError(cx, error); return false;
+  }
+  args.rval().setDouble(milliseconds); return true;
+}
+static bool KandeloNativePerformanceTimeOrigin(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (!kandeloPerformanceOrigin.initialized) {
+    JS_ReportErrorASCII(cx, "Performance process origin is unavailable"); return false;
+  }
+  args.rval().setDouble(kandeloPerformanceOrigin.unixMilliseconds); return true;
+}
