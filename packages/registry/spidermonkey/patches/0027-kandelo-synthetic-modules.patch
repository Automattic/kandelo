+JS_PUBLIC_API JSObject* JS::CreateSyntheticModule(
+    JSContext* cx, const HandleValueArray& names,
+    SyntheticModuleEvaluationSteps steps, HandleValue privateValue) {
+  AssertHeapIsIdle();
+  CHECK_THREAD(cx);
+  cx->check(names, privateValue);
+  if (!steps) {
+    JS_ReportErrorASCII(cx, "Synthetic module requires evaluation steps");
+    return nullptr;
+  }
+  Rooted<ExportNameVector> exportNames(cx);
+  Rooted<ExportNameVector> bindingNames(cx);
+  for (size_t i = 0; i < names.length(); i++) {
+    if (!names[i].isString()) {
+      JS_ReportErrorASCII(cx, "Synthetic export names must be strings");
+      return nullptr;
+    }
+    Rooted<JSAtom*> atom(cx, AtomizeString(cx, names[i].toString()));
+    if (!atom) return nullptr;
+    if (ContainsElement(exportNames, atom)) {
+      JS_ReportErrorASCII(cx, "Duplicate synthetic export name");
+      return nullptr;
+    }
+    // Export names may be numeric, empty or even *namespace*. Use distinct
+    // local identifiers so they cannot collide with the internal namespace slot.
+    char localName[48];
+    snprintf(localName, sizeof(localName), "synthetic%zu", i);
+    Rooted<JSAtom*> binding(cx, Atomize(cx, localName, strlen(localName)));
+    if (!binding) return nullptr;
+    if (!exportNames.append(atom) || !bindingNames.append(binding)) {
+      ReportOutOfMemory(cx);
+      return nullptr;
+    }
+  }
+  Rooted<ModuleObject*> module(cx, ModuleObject::createSynthetic(cx, &exportNames));
+  if (!module) return nullptr;
+  module->initSyntheticEvaluation(steps, privateValue, &bindingNames);
+  RootedVector<Value> values(cx);
+  if (!values.resize(names.length())) return nullptr;
+  for (auto& value : values) value = UndefinedValue();
+  if (!ModuleObject::createSyntheticEnvironment(cx, module, values)) return nullptr;
+  return module;
+}
+
+JS_PUBLIC_API bool JS::SetSyntheticModuleExport(
+    JSContext* cx, HandleObject moduleObject, HandleString name, HandleValue value) {
+  AssertHeapIsIdle();
+  CHECK_THREAD(cx);
+  cx->check(moduleObject, name, value);
+  if (!moduleObject->is<ModuleObject>() ||
+      !moduleObject->as<ModuleObject>().hasSyntheticModuleFields()) {
+    JS_ReportErrorASCII(cx, "Expected a synthetic module");
+    return false;
+  }
+  Rooted<ModuleObject*> module(cx, &moduleObject->as<ModuleObject>());
+  Rooted<JSAtom*> atom(cx, AtomizeString(cx, name));
+  if (!atom) return false;
+  if (!ContainsElement(module->syntheticExportNames(), atom)) {
+    JS_ReportErrorASCII(cx, "Unknown synthetic export name");
+    return false;
+  }
+  if (module->status() == ModuleStatus::Unlinked) {
+    JS_ReportErrorASCII(cx, "Synthetic module must be linked before setting exports");
+    return false;
+  }
+  Rooted<ModuleEnvironmentObject*> env(cx, module->environment());
+  MOZ_ASSERT(env);
+  size_t index = 0;
+  while (module->syntheticExportNames()[index] != atom) index++;
+  Rooted<JSAtom*> binding(cx, module->syntheticBindingNames()[index]);
+  RootedId id(cx, AtomToId(binding));
+  auto property = env->lookup(cx, id);
+  MOZ_ASSERT(property.isSome());
+  env->setAliasedBinding(property->slot(), value);
+  return true;
+}
+
 JS_PUBLIC_API void JS::SetModulePrivate(JSObject* module, const Value& value) {
+  if (module->as<ModuleObject>().hasSyntheticModuleFields()) {
+    module->as<ModuleObject>().setSyntheticPrivate(value);
+    return;
+  }
   JSRuntime* rt = module->zone()->runtimeFromMainThread();
   module->as<ModuleObject>().scriptSourceObject()->setPrivate(rt, value);
 }
 
 JS_PUBLIC_API void JS::ClearModulePrivate(JSObject* module) {
   // |module| may be gray, be careful not to create edges to it.
+  if (module->as<ModuleObject>().hasSyntheticModuleFields()) {
+    module->as<ModuleObject>().setSyntheticPrivate(UndefinedValue());
+    return;
+  }
   JSRuntime* rt = module->zone()->runtimeFromMainThread();
   module->as<ModuleObject>().scriptSourceObject()->clearPrivate(rt);
 }
 
 JS_PUBLIC_API JS::Value JS::GetModulePrivate(JSObject* module) {
+  if (module->as<ModuleObject>().hasSyntheticModuleFields()) {
+    return module->as<ModuleObject>().syntheticPrivate();
+  }
   return module->as<ModuleObject>().scriptSourceObject()->getPrivate();
 }
 
