+static bool KandeloNativeSocketAddress(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  int32_t fd;
+  if (args.length() < 1 || !JS::ToInt32(cx, args[0], &fd)) return false;
+  sockaddr_storage address = {};
+  socklen_t length = sizeof(address);
+  const bool peer = args.length() >= 2 && JS::ToBoolean(args[1]);
+  const int result = peer ? getpeername(fd, reinterpret_cast<sockaddr*>(&address), &length)
+                          : getsockname(fd, reinterpret_cast<sockaddr*>(&address), &length);
+  if (result < 0) { JS_ReportErrorASCII(cx, "socket address failed: %s", strerror(errno)); return false; }
+  char text[INET6_ADDRSTRLEN];
+  const void* bytes = address.ss_family == AF_INET6
+      ? static_cast<const void*>(&reinterpret_cast<sockaddr_in6*>(&address)->sin6_addr)
+      : static_cast<const void*>(&reinterpret_cast<sockaddr_in*>(&address)->sin_addr);
+  if (!inet_ntop(address.ss_family, bytes, text, sizeof(text))) { JS_ReportErrorASCII(cx, "socket address family is not implemented"); return false; }
+  const int port = ntohs(address.ss_family == AF_INET6 ? reinterpret_cast<sockaddr_in6*>(&address)->sin6_port
+                                                    : reinterpret_cast<sockaddr_in*>(&address)->sin_port);
+  RootedObject record(cx, JS_NewPlainObject(cx));
+  if (!record || !KandeloDefineSocketString(cx, record, "address", text) ||
+      !KandeloDefineSocketString(cx, record, "family", address.ss_family == AF_INET6 ? "IPv6" : "IPv4") ||
+      !KandeloDefineSocketInt(cx, record, "port", port)) return false;
+  args.rval().setObject(*record);
   return true;
 }
 
