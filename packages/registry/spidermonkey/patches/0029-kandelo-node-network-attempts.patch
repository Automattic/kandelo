+static bool KandeloNativeSocketLookup(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  UniqueChars host;
+  int32_t family = 0, flags = 0;
+  if (args.length() < 1 || !KandeloGetString(cx, args[0], &host) ||
+      (args.length() >= 2 && !JS::ToInt32(cx, args[1], &family)) ||
+      (args.length() >= 3 && !JS::ToInt32(cx, args[2], &flags))) return false;
+  RootedObject promise(cx, JS::NewPromiseObject(cx, nullptr));
+  if (!promise) return false;
+  args.rval().setObject(*promise);
+  addrinfo hints = {};
+  hints.ai_family = family == 6 ? AF_INET6 : family == 4 ? AF_INET : AF_UNSPEC;
+  hints.ai_socktype = SOCK_STREAM;
+  hints.ai_flags = flags;
+  addrinfo* result = nullptr;
+  const int status = getaddrinfo(host.get(), nullptr, &hints, &result);
+  if (status != 0) {
+    const char* code = status == EAI_NONAME ? "ENOTFOUND"
+        : status == EAI_AGAIN ? "EAI_AGAIN"
+        : status == EAI_FAMILY ? "EAI_FAMILY"
+        : status == EAI_MEMORY ? "EAI_MEMORY" : "EAI_FAIL";
+    const int nodeError = status == EAI_NONAME ? 3008 : status == EAI_AGAIN ? 3001
+        : status == EAI_FAMILY ? 3005 : status == EAI_MEMORY ? 3006 : 3004;
+    return KandeloRejectSocketOperation(cx, promise, nodeError, "getaddrinfo", code);
+  }
+  auto cleanup = mozilla::MakeScopeExit([&] { freeaddrinfo(result); });
+  RootedObject records(cx, JS::NewArrayObject(cx, 0));
+  if (!records) return false;
+  uint32_t count = 0;
+  for (addrinfo* item = result; item; item = item->ai_next) {
+    char text[INET6_ADDRSTRLEN];
+    const void* address;
+    const int recordFamily = item->ai_family == AF_INET6 ? 6 : 4;
+    if (item->ai_family == AF_INET) {
+      address = &reinterpret_cast<sockaddr_in*>(item->ai_addr)->sin_addr;
+    } else if (item->ai_family == AF_INET6) {
+      address = &reinterpret_cast<sockaddr_in6*>(item->ai_addr)->sin6_addr;
+    } else continue;
+    if (!inet_ntop(item->ai_family, address, text, sizeof(text))) continue;
+    RootedObject record(cx, JS_NewPlainObject(cx));
+    if (!record || !KandeloDefineSocketString(cx, record, "address", text) ||
+        !KandeloDefineSocketInt(cx, record, "family", recordFamily)) return false;
+    RootedValue value(cx, ObjectValue(*record));
+    if (!JS_SetElement(cx, records, count++, value)) return false;
+  }
+  RootedValue value(cx, ObjectValue(*records));
+  return JS::ResolvePromise(cx, promise, value);
+}
