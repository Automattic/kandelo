+static bool KandeloDefineSocketString(JSContext* cx, HandleObject object,
+                                      const char* name, const char* text) {
+  RootedString string(cx, JS_NewStringCopyZ(cx, text));
+  if (!string) return false;
+  RootedValue value(cx, StringValue(string));
+  return JS_DefineProperty(cx, object, name, value, JSPROP_ENUMERATE);
+}
+
+static bool KandeloDefineSocketInt(JSContext* cx, HandleObject object,
+                                   const char* name, int32_t number) {
+  RootedValue value(cx, Int32Value(number));
+  return JS_DefineProperty(cx, object, name, value, JSPROP_ENUMERATE);
+}
+
+// Socket errors cross the private engine boundary as data. The shared Node
+// module constructs public Error objects without inspecting errno text.
+static bool KandeloRejectSocketOperation(JSContext* cx, HandleObject promise,
+                                         int error, const char* syscallName,
+                                         const char* code = nullptr) {
+  RootedObject reason(cx, JS_NewPlainObject(cx));
+  if (!reason || !KandeloDefineSocketInt(cx, reason, "errno", -error) ||
+      !KandeloDefineSocketString(cx, reason, "syscall", syscallName) ||
+      (code && !KandeloDefineSocketString(cx, reason, "code", code))) return false;
+  RootedValue value(cx, ObjectValue(*reason));
+  return JS::RejectPromise(cx, promise, value);
+}
