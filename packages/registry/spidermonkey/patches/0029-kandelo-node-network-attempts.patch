+// A promise identifies the pending operation, never a possibly reused fd.
+static bool KandeloNativeSocketCancelConnect(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  args.rval().setBoolean(false);
+  if (args.length() < 1 || !args[0].isObject()) return true;
+  JSObject* token = &args[0].toObject();
+  KandeloSocketWatch** current = &gKandeloSocketWatches;
+  while (*current) {
+    KandeloSocketWatch* watch = *current;
+    if (watch->kind == KandeloSocketWatchKind::Connect && watch->promise.get() == token) {
+      *current = watch->next;
+      const bool ok = KandeloRejectSocketOperation(cx, watch->promise, ECANCELED, "connect");
+      close(watch->fd);
+      js_delete(watch);
+      args.rval().setBoolean(true);
+      return ok;
+    }
+    current = &watch->next;
+  }
+  return true;
+}
