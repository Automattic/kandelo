+// This is the actual descriptor/event pair consumed by the legacy poll
+// collector, not retained fd/ref/material ownership. Membership in the real
+// watch list is the queued admission; terminal publication unlinks it first.
+struct KandeloSocketPollInterest { int fd = -1; short events = 0; };
+static KandeloSocketPollInterest KandeloSocketWatchPollInterest(
+    JSContext* cx, const KandeloSocketWatch* watch) {
+  if (watch->cx != cx || watch->kind == KandeloSocketWatchKind::Child) return {};
+  int fd = watch->fd;
+  if (watch->listenerState) {
+    if (!KandeloListenerReadRegistered(cx, watch->listenerState)) return {};
+    fd = watch->listenerState->listener.Fd();
+  } else if (watch->terminalLease) {
+    if (watch->terminalRead && !watch->terminalLease->reads.Reading()) return {};
+    fd = watch->terminalLease->io.Descriptor();
+  }
+  return fd < 0 ? KandeloSocketPollInterest{} : KandeloSocketPollInterest{fd, watch->events};
+}
+// A no-JS native admission seam for the held supplied-fd composition. It is
+// intentionally not exported or used to activate that path before TLS and
+// legacy descriptor-lifetime prerequisites are complete.
+[[maybe_unused]] static short KandeloLegacySocketRegisteredEvents(JSContext* cx, int fd) {
+  if (fd < 0) return 0;
+  short events = 0;
+  for (auto* watch = gKandeloSocketWatches; watch; watch = watch->next) {
+    const auto interest = KandeloSocketWatchPollInterest(cx, watch);
+    if (interest.fd == fd) events |= interest.events;
+  }
+  return events;
+}
