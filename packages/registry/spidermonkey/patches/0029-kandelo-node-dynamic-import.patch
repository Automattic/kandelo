+static bool OnDynamicImportValueFulfilled(JSContext* cx, unsigned argc,
+                                         Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  Rooted<PromiseObject*> promise(cx, TargetFromHandler<PromiseObject>(args));
+  args.rval().setUndefined();
+  return PromiseObject::resolve(cx, promise, args.get(0));
+}
+
+static bool OnDynamicImportValueRejected(JSContext* cx, unsigned argc,
+                                        Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  Rooted<PromiseObject*> promise(cx, TargetFromHandler<PromiseObject>(args));
+  args.rval().setUndefined();
+  return PromiseObject::reject(cx, promise, args.get(0));
+}
+
+bool js::FinishDynamicModuleImportWithValue(JSContext* cx, HandleValue value,
+                                           HandleObject promise) {
+  // The intermediate Promise belongs to the referrer realm even when the
+  // callback returns a foreign Promise, thenable or ordinary value.
+  RootedObject adopted(cx, JS::NewPromiseObject(cx, nullptr));
+  if (!adopted || !JS::ResolvePromise(cx, adopted, value)) return false;
+  RootedFunction fulfilled(cx, NewHandler(cx, OnDynamicImportValueFulfilled,
+                                        promise.as<PromiseObject>()));
+  RootedFunction rejected(cx, NewHandler(cx, OnDynamicImportValueRejected,
+                                       promise.as<PromiseObject>()));
+  if (!fulfilled || !rejected) return false;
+  return JS::AddPromiseReactions(cx, adopted, fulfilled, rejected);
+}
