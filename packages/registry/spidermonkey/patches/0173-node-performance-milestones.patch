+static bool KandeloPerformanceClockError(JSContext* cx, const char* phase) {
+  const int error = errno;
+  JS_ReportErrorUTF8(cx, "performance %s clock: %s", phase, strerror(error));
+  KandeloDecoratePendingError(cx, error); return false;
+}
+static bool KandeloNativePerformanceMilestone(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  UniqueChars name; if (!KandeloGetString(cx, args.get(0), &name)) return false;
+  uint64_t stamp = 0; bool recorded = false;
+  if (strcmp(name.get(), "nodeStart") == 0) {
+    stamp = kandeloPerformanceOrigin.nativeEntry;
+    recorded = kandeloPerformanceOrigin.nativeEntryRecorded;
+  } else {
+    using Milestone = kandelo::clock::EventLoopClock::Milestone;
+    Milestone kind;
+    if (strcmp(name.get(), "environment") == 0) kind = Milestone::Environment;
+    else if (strcmp(name.get(), "bootstrapComplete") == 0) kind = Milestone::BootstrapComplete;
+    else if (strcmp(name.get(), "loopExit") == 0) kind = Milestone::LoopExit;
+    else if (strcmp(name.get(), "v8Start") == 0) kind = Milestone::V8Start;
+    else { JS_ReportErrorASCII(cx, "Unknown performance lifecycle milestone"); return false; }
+    if (GetShellContext(cx)->kandeloPerformanceLoop.ReadMilestone(kind, &stamp, &recorded) != 0)
+      return KandeloPerformanceClockError(cx, "lifecycle");
+  }
+  if (!kandeloPerformanceOrigin.initialized ||
+      (recorded && stamp < kandeloPerformanceOrigin.monotonic)) {
+    JS_ReportErrorASCII(cx, "Performance lifecycle origin is unavailable"); return false;
+  }
+  args.rval().setDouble(recorded ? double(stamp - kandeloPerformanceOrigin.monotonic) / 1e6 : -1.0);
+  return true;
+}
+static bool KandeloNativePerformanceBootstrapComplete(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (GetShellContext(cx)->kandeloPerformanceLoop.MarkBootstrapComplete() != 0)
+    return KandeloPerformanceClockError(cx, "bootstrap");
+  args.rval().setUndefined(); return true;
+}
+static bool KandeloRecordPerformanceLoopExit(JSContext* cx) {
+  if (GetShellContext(cx)->kandeloPerformanceLoop.MarkLoopExit() != 0)
+    return KandeloPerformanceClockError(cx, "loop exit");
+  return true;
