+ModuleObject* ModuleObject::createEmbedderSynthetic(
+    JSContext* cx, MutableHandle<ExportNameVector> exportNames,
+    HandleObject evaluationSteps, HandleObject owner) {
+  cx->check(evaluationSteps, owner);
