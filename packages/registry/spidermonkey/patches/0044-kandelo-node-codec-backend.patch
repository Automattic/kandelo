+// Unzip accepts zlib and gzip wrappers; Gunzip remains gzip-only.
+static bool KandeloNativeCreateUnzip(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  return KandeloMakeZlib(cx, false, 15 + 32, 0, args.rval());
+}
+
+// Report versions from the actual linked libraries. The Node API source pin
+// alone does not prove which codec implementation satisfied the linker.
+static bool KandeloNativeCompressionVersions(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  RootedObject result(cx, JS_NewPlainObject(cx));
+  if (!result) return false;
+  const uint32_t version = BrotliEncoderVersion();
+  char brotli[32];
+  SprintfLiteral(brotli, "%u.%u.%u", version >> 24, (version >> 12) & 0xfff, version & 0xfff);
+  const char* keys[] = { "zlib", "brotli", "zstd" };
+  const char* values[] = { zlibVersion(), brotli, ZSTD_versionString() };
+  for (size_t i = 0; i < 3; ++i) {
+    RootedString text(cx, JS_NewStringCopyZ(cx, values[i]));
+    if (!text || !JS_DefineProperty(cx, result, keys[i], text, JSPROP_ENUMERATE)) return false;
+  }
+  args.rval().setObject(*result);
+  return true;
+}
