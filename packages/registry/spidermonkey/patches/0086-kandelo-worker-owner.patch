+      std::lock_guard<std::mutex> lock(input->mutex); input->child = nullptr;
+    });
+    JS_AddInterruptCallback(cx, KandeloWorkerInterrupt);
+    if (input->stopping.load()) { input->exitCode = 1; return; }
+    if (!JS::InitSelfHostedCode(cx)) {
