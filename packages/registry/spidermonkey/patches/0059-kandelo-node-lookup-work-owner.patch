+class KandeloDnsLookupWork final : public js::shell::KandeloNativeWork {
+  JS::PersistentRootedObject promise_;
+  UniqueChars hostname_;
+  int family_;
+  int flags_;
+  kandelo::dns::LookupResult result_;
+
+ public:
+  KandeloDnsLookupWork(JSContext* cx, JSObject* promise, UniqueChars&& hostname,
+                       int family, int flags)
+      : promise_(cx, promise), hostname_(std::move(hostname)),
+        family_(family), flags_(flags) {
+    workClass = WorkClass::SlowIo;
+  }
+
+  void Run() override {
+    result_ = kandelo::dns::Lookup(hostname_.get(), family_, flags_);
+  }
+
+  bool Complete(JSContext* cx) override {
+    RootedObject promise(cx, promise_);
+    if (failure != Failure::None) {
+      if (failure == Failure::OutOfMemory)
+        return KandeloRejectSocketOperation(cx, promise, 3006, "getaddrinfo", "EAI_MEMORY");
+      return KandeloRejectSocketOperation(cx, promise, EIO, "getaddrinfo", "EIO");
+    }
+    const int status = result_.status;
+    if (status != 0) {
+      if (status == EAI_SYSTEM)
+        return KandeloRejectSocketOperation(cx, promise, result_.system_error,
+            "getaddrinfo", KandeloErrnoCode(result_.system_error));
+      const char* code = "EAI_FAIL";
+      int number = 3004;
+      switch (status) {
+        case EAI_AGAIN: code = "EAI_AGAIN"; number = 3001; break;
+        case EAI_BADFLAGS: code = "EAI_BADFLAGS"; number = 3002; break;
+        case EAI_FAMILY: code = "EAI_FAMILY"; number = 3005; break;
+        case EAI_MEMORY: code = "EAI_MEMORY"; number = 3006; break;
+#if defined(EAI_NODATA) && EAI_NODATA != EAI_NONAME
+        case EAI_NODATA: code = "ENOTFOUND"; number = 3007; break;
+#endif
+        case EAI_NONAME: code = "ENOTFOUND"; number = 3008; break;
+        case EAI_SERVICE: code = "EAI_SERVICE"; number = 3010; break;
+        case EAI_SOCKTYPE: code = "EAI_SOCKTYPE"; number = 3011; break;
+      }
+      return KandeloRejectSocketOperation(cx, promise, number, "getaddrinfo", code);
+    }
+    RootedObject records(cx, JS::NewArrayObject(cx, 0));
+    if (!records) return false;
+    uint32_t index = 0;
+    for (const auto& address : result_.addresses) {
+      RootedObject record(cx, JS_NewPlainObject(cx));
+      if (!record || !KandeloDefineSocketString(cx, record, "address", address.address.c_str()) ||
+          !KandeloDefineSocketInt(cx, record, "family", address.family)) return false;
+      RootedValue value(cx, ObjectValue(*record));
+      if (!JS_SetElement(cx, records, index++, value)) return false;
+    }
+    RootedValue value(cx, ObjectValue(*records));
+    return JS::ResolvePromise(cx, promise, value);
+  }
+
+  void Cancel(JSContext*) override {
+    // Queue shutdown joins running work before retiring this JS-owned root.
+    // No user callback is entered while the realm is being destroyed.
+    promise_.reset();
+  }
+};
