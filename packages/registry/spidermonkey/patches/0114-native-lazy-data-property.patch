+namespace {
+const JSClass TestLazyAdapterClass = {
+    "TestLazyAdapter", JSCLASS_HAS_RESERVED_SLOTS(2)};
+
+bool TestCallLazyLoader(JSContext* cx, JS::HandleObject holder, JS::HandleId key,
+                        JS::HandleValue data, JS::MutableHandleValue result) {
+  // This is a native callback, before deliberately entering a JS function's
+  // own realm. Check the owner selected the actual holder's realm.
+  MOZ_RELEASE_ASSERT(JS::GetCurrentRealmOrNull(cx) ==
+                     JS::GetObjectRealmOrNull(holder));
+  JS::RootedObject record(cx, &data.toObject());
+  JS::RootedValue loader(cx, JS::GetReservedSlot(record, 0));
+  JS::RootedValue thisValue(cx, JS::ObjectValue(*holder));
+  JS::RootedValueArray<2> args(cx);
+  args[0].set(JS::GetReservedSlot(record, 1));
+  if (!JS_IdToValue(cx, key, args[1])) return false;
+  return JS::Call(cx, thisValue, loader, args, result);
+}
+
+bool TestInstallNativeLazyData(JSContext* cx, unsigned argc, JS::Value* vp) {
+  JS::CallArgs args = JS::CallArgsFromVp(argc, vp);
+  if (argc < 4 || !args[0].isObject() || !args[2].isObject()) {
+    JS_ReportErrorASCII(cx, "invalid native lazy test arguments");
+    return false;
+  }
+  JS::RootedObject holder(cx, &args[0].toObject());
+  JS::RootedObject loader(cx, &args[2].toObject());
+  JS::RootedId key(cx);
+  if (!JS_ValueToId(cx, args[1], &key)) {
+    return false;
+  }
+  JS::PropertyAttributes attrs{JS::PropertyAttribute::Writable,
+                               JS::PropertyAttribute::Enumerable,
+                               JS::PropertyAttribute::Configurable};
+  if (!JS::IsCallable(loader)) {
+    JS_ReportErrorASCII(cx, "test loader must be callable");
+    return false;
+  }
+  JS::RootedObject record(cx, JS_NewObject(cx, &TestLazyAdapterClass));
+  if (!record) return false;
+  JS::SetReservedSlot(record, 0, args[2]);
+  JS::SetReservedSlot(record, 1, args[3]);
+  JS::RootedValue payload(cx, JS::ObjectValue(*record));
+  if (!JS::DefineNativeLazyDataProperty(cx, holder, key, TestCallLazyLoader,
+                                        payload, attrs)) {
+    return false;
+  }
+  args.rval().setUndefined();
+  return true;
+}
+
+bool TestNativeHolderRealm(JSContext* cx, JS::HandleObject holder,
+                           JS::HandleId key, JS::HandleValue data,
+                           JS::MutableHandleValue result) {
+  MOZ_RELEASE_ASSERT(JS::GetCurrentRealmOrNull(cx) ==
+                     JS::GetObjectRealmOrNull(holder));
+  JS_GC(cx);
+  result.setObject(*holder);
+  return true;
+}
+
+bool TestCollectInLazyLoader(JSContext* cx, unsigned argc, JS::Value* vp) {
+  JS::CallArgs args = JS::CallArgsFromVp(argc, vp);
+  JS_GC(cx);
+  args.rval().set(args.get(0));
+  return true;
+}
