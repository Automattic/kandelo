diff --git a/js/src/vm/NativeLazyDataProperty.cpp b/js/src/vm/NativeLazyDataProperty.cpp
--- /dev/null
+++ b/js/src/vm/NativeLazyDataProperty.cpp
@@ -0,0 +1,177 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#include "vm/NativeLazyDataProperty.h"
+
+#include "jsapi.h"
+
+#include "builtin/Array.h"
+#include "js/Context.h"
+#include "js/NativeLazyDataProperty.h"
+#include "js/Realm.h"
+#include "vm/PlainObject.h"
+#include "vm/Watchtower.h"
+
+#include "vm/JSContext-inl.h"
+#include "vm/JSObject-inl.h"
+#include "vm/NativeObject-inl.h"
+
+using namespace js;
+
+namespace {
+// The owning shape's slot is the only persistent edge to this cell. Ordinary
+// slot barriers/tracing support nursery movement, compacting GC and cycles.
+// This class is never returned to user code. No native allocation/finalizer or
+// per-context root table is needed.
+class NativeLazyDataCell : public NativeObject {
+ public:
+  enum Slot { Callback, Data, Value, State, Count };
+  enum Status { Pending, Loading, Ready };
+  static const JSClass class_;
+
+  Status status() const { return Status(getReservedSlot(State).toInt32()); }
+  void setStatus(Status state) { setReservedSlot(State, Int32Value(state)); }
+};
+
+const JSClass NativeLazyDataCell::class_ = {
+    "NativeLazyDataCell", JSCLASS_HAS_RESERVED_SLOTS(NativeLazyDataCell::Count)};
+
+bool PublishValue(JSContext* cx, Handle<NativeObject*> holder, HandleId key,
+                  PropertyInfo property, HandleValue value) {
+  PropertyFlags flags = property.flags();
+  flags.clearFlag(PropertyFlag::NativeLazyDataProperty);
+  // Materialization is the owner's internal state transition, including for a
+  // frozen property. Preserve every descriptor attribute. changeProperty uses
+  // the normal shape/Watchtower invalidation path; no old raw-slot IC can name
+  // the pending shape because isDataProperty() excluded it.
+  Watchtower::watchPropertyValueChange<AllowGC::CanGC>(cx, holder, key, value,
+                                                     property);
+  uint32_t slot;
+  if (!NativeObject::changeProperty(cx, holder, key, flags, &slot)) {
+    return false;
+  }
+  holder->setSlot(slot, value);
+  return true;
+}
+
+bool LoadInHolderRealm(JSContext* cx, Handle<NativeObject*> holder, HandleId key,
+                       Handle<NativeLazyDataCell*> cell,
+                       MutableHandleValue result) {
+  if (cell->status() == NativeLazyDataCell::Loading) {
+    JS_ReportErrorASCII(cx, "Recursive native lazy data property loading");
+    return false;
+  }
+  if (cell->status() == NativeLazyDataCell::Pending) {
+    auto loader = reinterpret_cast<JS::NativeLazyDataPropertyLoader>(
+        cell->getReservedSlot(NativeLazyDataCell::Callback).toPrivate());
+    RootedValue data(cx, cell->getReservedSlot(NativeLazyDataCell::Data));
+    cell->setStatus(NativeLazyDataCell::Loading);
+    if (!loader(cx, holder, key, data, result)) {
+      // Do not clear, classify or replace the pending exception: this includes
+      // OOM and uncatchable interruption. A callback may have retired the cell;
+      // the local root still owns it until this frame returns.
+      cell->setStatus(NativeLazyDataCell::Pending);
+      return false;
+    }
+    cx->check(result);
+    // Retain a successfully computed value before a fallible shape allocation.
+    // A retry after materialization OOM must not call user code a second time.
+    cell->setReservedSlot(NativeLazyDataCell::Value, result);
+    cell->setStatus(NativeLazyDataCell::Ready);
+    cell->setReservedSlot(NativeLazyDataCell::Callback, UndefinedValue());
+    cell->setReservedSlot(NativeLazyDataCell::Data, UndefinedValue());
+  } else {
+    result.set(cell->getReservedSlot(NativeLazyDataCell::Value));
+  }
+
+  auto current = holder->lookupPure(key);
+  if (!current || !current->isNativeLazyDataProperty() ||
+      &holder->getSlot(current->slot()).toObject() != cell) {
+    // User code deleted/replaced this particular cell. Returning from a get
+    // must not resurrect the property or overwrite a newer value/cell.
+    return true;
+  }
+  return PublishValue(cx, holder, key, *current, result);
+}
+}  // namespace
+
+bool js::GetNativeLazyDataProperty(JSContext* cx,
+                                   Handle<NativeObject*> holder, HandleId key,
+                                   PropertyInfo property,
+                                   MutableHandleValue result) {
+  MOZ_ASSERT(property.isNativeLazyDataProperty());
+  Rooted<NativeLazyDataCell*> cell(
+      cx, &holder->getSlot(property.slot()).toObject().as<NativeLazyDataCell>());
+  bool ok;
+  {
+    JSAutoRealm ar(cx, holder);
+    ok = LoadInHolderRealm(cx, holder, key, cell, result);
+  }
+  if (!ok) {
+    // getPendingException wraps into the restored compartment and preserves
+    // ExceptionStatus, including OutOfMemory. No pending exception means an
+    // uncatchable completion; leave that untouched.
+    if (cx->isExceptionPending()) {
+      RootedValue ignored(cx);
+      (void)cx->getPendingException(&ignored);
+    }
+    return false;
+  }
+  return cx->compartment()->wrap(cx, result);
+}
+
+bool js::SetNativeLazyDataProperty(JSContext* cx,
+                                   Handle<NativeObject*> holder, HandleId key,
+                                   PropertyInfo property, HandleValue value) {
+  MOZ_ASSERT(property.isNativeLazyDataProperty());
+  MOZ_ASSERT(property.writable());
+  // OrdinarySet already validated writability and actual receiver ownership.
+  // An inherited assignment takes SetPropertyByDefining instead of this path.
+  return PublishValue(cx, holder, key, property, value);
+}
+
+JS_PUBLIC_API bool JS::DefineNativeLazyDataProperty(
+    JSContext* cx, HandleObject holder, HandleId key,
+    NativeLazyDataPropertyLoader loader, HandleValue data,
+    PropertyAttributes attributes) {
+  AssertHeapIsIdle();
+  CHECK_THREAD(cx);
+  cx->check(holder, key, data);
+  uint32_t index;
+  if (!holder->is<PlainObject>() || key.isVoid() || key.isPrivateName() ||
+      IdIsIndex(key, &index) || !loader) {
+    JS_ReportErrorASCII(cx, "Invalid native lazy data property owner, key or loader");
+    return false;
+  }
+  Rooted<NativeObject*> owner(cx, &holder->as<NativeObject>());
+  if (!owner->isExtensible() || owner->containsPure(key)) {
+    JS_ReportErrorASCII(cx, "Native lazy data property requires an absent extensible own key");
+    return false;
+  }
+  RootedValue payload(cx, data);
+  JSAutoRealm ar(cx, holder);
+  if (!JS_WrapValue(cx, &payload)) {
+    return false;
+  }
+  Rooted<NativeLazyDataCell*> cell(
+      cx, NewObjectWithGivenProto<NativeLazyDataCell>(cx, nullptr));
+  if (!cell) {
+    return false;
+  }
+  // A native-code pointer has module/code lifetime, not GC lifetime. Only
+  // this private slot interprets it; it is never exposed as a property value.
+  cell->setReservedSlot(NativeLazyDataCell::Callback,
+                        PrivateValue(reinterpret_cast<void*>(loader)));
+  cell->setReservedSlot(NativeLazyDataCell::Data, payload);
+  cell->setStatus(NativeLazyDataCell::Pending);
+  PropertyFlags flags{PropertyFlag::NativeLazyDataProperty};
+  flags.setFlag(PropertyFlag::Configurable, attributes.configurable());
+  flags.setFlag(PropertyFlag::Enumerable, attributes.enumerable());
+  flags.setFlag(PropertyFlag::Writable, attributes.writable());
+  uint32_t slot;
+  if (!NativeObject::addProperty(cx, owner, key, flags, &slot)) {
+    return false;
+  }
+  owner->setSlot(slot, ObjectValue(*cell));
+  return true;
+}
