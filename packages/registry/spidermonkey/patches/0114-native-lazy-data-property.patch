diff --git a/js/public/NativeLazyDataProperty.h b/js/public/NativeLazyDataProperty.h
--- /dev/null
+++ b/js/public/NativeLazyDataProperty.h
@@ -0,0 +1,47 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+#ifndef js_NativeLazyDataProperty_h
+#define js_NativeLazyDataProperty_h
+
+#include "jstypes.h"
+#include "js/PropertyDescriptor.h"
+#include "js/RootingAPI.h"
+#include "js/TypeDecls.h"
+
+namespace JS {
+
+// The callback has native-code lifetime (like JSNative). It runs directly in
+// the actual holder's realm, with data/key in that compartment. It must leave
+// its result there; the owner wraps it back to the caller. Any JS edges retained
+// by an embedding callback must be reachable through |data|, never raw pointers.
+using NativeLazyDataPropertyLoader = bool (*)(
+    JSContext* cx, HandleObject holder, HandleId key, HandleValue data,
+    MutableHandleValue result);
+
+// Install an absent own, non-index, non-private property on an extensible plain
+// object in the current compartment. This admission is deliberately explicit;
+// support for globals and other NativeObject classes remains to be implemented.
+//
+// This is a DATA property, with no observable getter/setter. Keys, has, own
+// assignment/deletion and native seal/freeze/preventExtensions do not load it.
+// Get, own descriptor retrieval and DefineOwnProperty load it on the holder.
+// There is no JS function representation for the native callback. An embedding
+// may deliberately call a checked wrapped JS function from that callback; such
+// a JS function retains its own normal realm/this semantics. The engine enters
+// the holder realm and wraps the native callback result on return.
+//
+// A throw leaves the loader pending for retry, unless user code replaced or
+// deleted the property. Successful loading is retained across a subsequent
+// materialization OOM. Recursive loading reports an error, and loader mutation
+// never resurrects or overwrites a retired cell. The latter policies require
+// separate compatibility review (the pinned Node mutation controls can abort).
+// All JS data/value edges are ordinary traced object slots; there is no
+// global root, external pointer registry, ES accessor or public placeholder.
+extern JS_PUBLIC_API bool DefineNativeLazyDataProperty(
+    JSContext* cx, HandleObject holder, HandleId key,
+    NativeLazyDataPropertyLoader loader, HandleValue data,
+    PropertyAttributes attributes);
+
+}  // namespace JS
+#endif  // js_NativeLazyDataProperty_h
