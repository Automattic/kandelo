+static bool KandeloNativeTlsReadRelease(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp); args.rval().setBoolean(false);
+  RootedObject capability(cx); auto* state = KandeloTlsStateFor(cx, args.get(0), &capability);
+  if (!state) return false;
+  RootedValue stored(cx, JS::GetReservedSlot(capability, 1));
+  if (!stored.isObject() || !args.get(1).isObject()) return true;
+  RootedObject actual(cx, js::CheckedUnwrapDynamic(&args[1].toObject(), cx));
+  RootedObject expected(cx, js::CheckedUnwrapDynamic(&stored.toObject(), cx));
+  if (!actual || !expected) {
+    if (!JS_IsExceptionPending(cx)) js::ReportAccessDenied(cx);
+    return false;
+  }
+  if (actual != expected || JS::GetPromiseState(actual) == JS::PromiseState::Pending) return true;
+  auto read = state->owner.CurrentRead();
+  if (read && !state->owner.AcknowledgeRead(read)) return true;
+  state->readClaim.reset();
+  JS::SetReservedSlot(capability, 1, UndefinedValue());
+  args.rval().setBoolean(true); return true;
