+static bool KandeloNativeProcessAbort(JSContext* cx, unsigned argc, Value* vp) {
+  if (GetShellContext(cx)->isWorker) {
+    // Public Workers use the pinned ERR_WORKER_UNSUPPORTED_OPERATION wrapper.
+    // Keep the private binding from terminating a process owned elsewhere.
+    JS_ReportErrorASCII(cx, "process.abort() is unavailable in Workers");
+    return false;
+  }
+  // Dump real executing guest frames without invoking user getters, exit
+  // listeners or the orderly environment teardown path. Native stack/report
+  // diagnostics remain a separate owning instrumentation prerequisite.
+  js::DumpBacktrace(cx, stderr);
+  kandelo::process_state::Abort();
 }
