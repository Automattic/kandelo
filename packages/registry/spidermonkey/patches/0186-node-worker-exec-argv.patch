+// Parent-thread admission owns only real supported per-environment warning
+// options. The resulting immutable packet is consumed before child bootstrap
+// installs warning handlers; no global/main CLI state is changed by a Worker.
+static bool KandeloPrepareWorkerExecArgv(JSContext* cx, HandleValue input,
+    HandleObject environment, bool explicitEnvironment, HandleValue inherited,
+    MutableHandleValue result) {
+  try {
+    RootedObject array(cx),actual(cx);
+    if (input.isObject()) {
+      array=&input.toObject();actual=js::CheckedUnwrapDynamic(array,cx);
+      if (!actual) { if (!JS_IsExceptionPending(cx)) js::ReportAccessDenied(cx);return false; }
+    }
+    // V8 IsArray admits real cross-realm arrays but not Proxy arrays. Keep
+    // the original caller-realm wrapper for every later Get/ToString operation.
+    const bool explicitArguments=actual && actual->is<js::ArrayObject>();
+    if (!explicitArguments) {
+      if (!inherited.isObject()) { JS_ReportErrorASCII(cx,"Worker inherited CLI arguments are unavailable");return false; }
+      array=&inherited.toObject();
+    }
+    std::vector<std::string> arguments;
+    auto collect=[&]() {
+      uint32_t length;if (!JS::GetArrayLength(cx,array,&length)) return false;
+      for (uint32_t i=0;i<length;++i) {
+        RootedValue value(cx);if (!JS_GetElement(cx,array,i,&value)) return false;
+        RootedString text(cx,JS::ToString(cx,value));if (!text) return false;
+        std::string bytes;if (!KandeloDotenvEncode(cx,text,&bytes)) return false;
+        arguments.push_back(std::move(bytes));
+      }
+      return true;
+    };
+    RootedObject output(cx,JS_NewPlainObject(cx));if (!output) return false;
+    auto errors=[&](const char* name,const std::vector<std::string>& messages) {
+      return KandeloDefineNodeCLIStringList(cx,output,name,messages);
+    };
+    if (explicitArguments || explicitEnvironment) {
+      KandeloNodeCLIState options;
+      RootedValue value(cx);
+      if (!JS_GetProperty(cx,environment,"NODE_REDIRECT_WARNINGS",&value)) return false;
+      if (value.isString()) {
+        RootedString text(cx,value.toString());
+        if (!KandeloDotenvEncode(cx,text,&options.redirectWarnings)) return false;
+      }
+      auto parse=[&](const std::vector<std::string>& values,bool fromEnvironment,
+                     bool rejectUnknown,std::vector<std::string>& failures) {
+        for (size_t i=0;i<values.size();++i) {
+          const auto& arg=values[i];
+          if (ApplyKandeloNodeWarningBooleanOption(arg,options)) continue;
+          if (KandeloNodeWarningStringOption(arg)) {
+            const auto equals=arg.find('=');std::string text;
+            if (equals!=std::string::npos) text=arg.substr(equals+1);
+            else if (i+1<values.size() && !values[i+1].empty() && values[i+1][0]!='-') text=values[++i];
+            if (text.empty()) { failures.push_back(arg+" requires an argument");return; }
+            ApplyKandeloNodeWarningStringOption(arg,text,options);continue;
+          }
+          // Inherited native arguments may contain real non-warning string
+          // options. Do not reinterpret their consumed values as flags.
+          const auto name=KandeloNodeOptionName(arg);
+          if (!rejectUnknown && arg.find('=')==std::string::npos &&
+              (KandeloNodeStringOption(arg) || name=="-e" || name=="--eval" || name=="--execute") &&
+              i+1<values.size()) { ++i;continue; }
+          if (rejectUnknown) failures.push_back(fromEnvironment ? arg+" is not allowed in NODE_OPTIONS" : arg);
+        }
+      };
+      if (!JS_GetProperty(cx,environment,"NODE_OPTIONS",&value)) return false;
+      if (value.isString()) {
+        RootedString source(cx,value.toString());std::string text;
+        if (!KandeloDotenvEncode(cx,source,&text)) return false;
+        std::vector<std::string> failures;
+        auto values=ParseNodeOptionsEnvVar(text,&failures);
+        parse(values,true,explicitEnvironment,failures);
+        if (!failures.empty() && explicitEnvironment) {
+          if (!errors("invalidNodeOptions",failures)) return false;
+          result.setObject(*output);return true;
+        }
+      }
+      // node_worker.cc parses explicit environment options before reading or
+      // coercing any execArgv element. Preserve its abrupt completion order.
+      if (!collect()) return false;
+      std::vector<std::string> failures;
+      parse(arguments,false,explicitArguments,failures);
+      if (!failures.empty()) {
+        if (!errors("invalidExecArgv",failures)) return false;
+        result.setObject(*output);return true;
+      }
+      if (!KandeloDefineWarningOptions(cx,output,options,false) ||
+          !KandeloDefineBooleanProperty(cx,output,"noWarnings",options.noWarnings,0)) return false;
+    } else if (!collect()) return false;
+    if (!KandeloDefineNodeCLIStringList(cx,output,"execArgv",arguments)) return false;
+    result.setObject(*output);return true;
+  } catch (const std::bad_alloc&) { JS_ReportOutOfMemory(cx);return false; }
 }

