+static bool KandeloNativePreviewEntries(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  args.rval().setUndefined();
+  if (!args.length() || !args[0].isObject()) return true;
+  RootedObject obj(cx, js::CheckedUnwrapStatic(&args[0].toObject()));
+  if (!obj) return true;
+  JS::Rooted<JS::GCVector<Value>> entries(cx, JS::GCVector<Value>(cx));
+  bool keyValue = false;
+  {
+    JSAutoRealm ar(cx, obj);
+    if (obj->is<js::MapIteratorObject>() || obj->is<js::SetIteratorObject>()) {
+      // CountSlot tracks live entries to the left of IndexSlot, including
+      // deletions/compaction. Snapshot the table and slice at that count;
+      // never call next() or mutate either the iterator or its table.
+      auto& iter = obj->as<js::NativeObject>();
+      auto kind = js::TableIteratorObject::Kind(
+          iter.getReservedSlot(js::TableIteratorObject::KindSlot).toPrivateUint32());
+      keyValue = kind == js::TableIteratorObject::Kind::Entries;
+      RootedValue target(cx, iter.getReservedSlot(js::TableIteratorObject::TargetSlot));
+      uint32_t count = iter.getReservedSlot(js::TableIteratorObject::CountSlot).toPrivateUint32();
+      if (target.isObject()) {
+        JS::Rooted<JS::GCVector<Value>> snapshot(cx, JS::GCVector<Value>(cx));
+        if (obj->is<js::MapIteratorObject>()) {
+          Rooted<js::MapObject*> map(cx, &target.toObject().as<js::MapObject>());
+          if (!map->getKeysAndValuesInterleaved(&snapshot)) return false;
+          for (size_t i = size_t(count) * 2; i + 1 < snapshot.length(); i += 2) {
+            if (kind != js::TableIteratorObject::Kind::Values && !entries.append(snapshot[i])) return false;
+            if (kind != js::TableIteratorObject::Kind::Keys && !entries.append(snapshot[i + 1])) return false;
+          }
+        } else {
+          Rooted<js::SetObject*> set(cx, &target.toObject().as<js::SetObject>());
+          if (!set->keys(&snapshot)) return false;
+          for (size_t i = count; i < snapshot.length(); i++) {
+            if (!entries.append(snapshot[i])) return false;
+            if (keyValue && !entries.append(snapshot[i])) return false;
+          }
+        }
+      }
+    } else if (obj->is<js::WeakCollectionObject>()) {
+      const bool isMap = obj->is<js::WeakMapObject>();
+      Rooted<js::WeakCollectionObject*> collection(cx, &obj->as<js::WeakCollectionObject>());
+      RootedObject keys(cx);
+      if (!js::WeakCollectionObject::nondeterministicGetKeys(cx, collection, &keys)) return false;
+      uint32_t length;
+      if (!JS::GetArrayLength(cx, keys, &length)) return false;
+      for (uint32_t i = 0; i < length; i++) {
+        RootedValue key(cx), value(cx);
+        if (!JS_GetElement(cx, keys, i, &key) || !entries.append(key)) return false;
+        if (isMap) {
+          if (!JS::GetWeakMapEntry(cx, obj, key, &value) || !entries.append(value)) return false;
+        }
+      }
+      keyValue = isMap;
+    } else {
+      return true;
+    }
+  }
+  for (size_t i = 0; i < entries.length(); i++) {
+    if (!JS_WrapValue(cx, entries[i])) return false;
+  }
+  RootedObject values(cx, JS::NewArrayObject(cx, JS::HandleValueArray::fromMarkedLocation(entries.length(), entries.begin())));
+  if (!values) return false;
+  if (args.length() > 1 && JS::ToBoolean(args[1])) {
+    JS::RootedValueArray<2> pair(cx);
+    pair[0].setObject(*values);
+    pair[1].setBoolean(keyValue);
+    RootedObject result(cx, JS::NewArrayObject(cx, pair));
+    if (!result) return false;
+    args.rval().setObject(*result);
+  } else {
+    args.rval().setObject(*values);
+  }
+  return true;
+}
