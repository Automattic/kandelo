+static bool KandeloNativePromiseDetails(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  args.rval().setUndefined();
+  if (!args.length() || !args[0].isObject()) return true;
+  RootedObject obj(cx, js::CheckedUnwrapStatic(&args[0].toObject()));
+  if (!obj || !JS::IsPromiseObject(obj)) return true;
+  int32_t state;
+  RootedValue value(cx, UndefinedValue());
+  {
+    JSAutoRealm ar(cx, obj);
+    JS::PromiseState engineState = JS::GetPromiseState(obj);
+    state = engineState == JS::PromiseState::Pending ? 0 :
+            engineState == JS::PromiseState::Fulfilled ? 1 : 2;
+    if (engineState != JS::PromiseState::Pending) value = JS::GetPromiseResult(obj);
+  }
+  if (!JS_WrapValue(cx, &value)) return false;
+  JS::RootedValueArray<2> entries(cx);
+  entries[0].setInt32(state);
+  entries[1].set(value);
+  RootedObject result(cx, JS::NewArrayObject(cx, entries));
+  if (!result) return false;
+  args.rval().setObject(*result);
+  return true;
+}
