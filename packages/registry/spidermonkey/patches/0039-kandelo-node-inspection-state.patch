+static bool KandeloNativeProxyDetails(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  args.rval().setUndefined();
+  if (!args.length() || !args[0].isObject()) return true;
+  RootedObject obj(cx, js::CheckedUnwrapStatic(&args[0].toObject()));
+  if (!obj || !js::IsScriptedProxy(obj)) return true;
+  RootedValue target(cx, ObjectOrNullValue(js::GetProxyTargetObject(obj)));
+  if (!JS_WrapValue(cx, &target)) return false;
+  if (args.length() < 2 || !JS::ToBoolean(args[1])) {
+    args.rval().set(target);
+    return true;
+  }
+  RootedValue handler(cx, ObjectOrNullValue(js::ScriptedProxyHandler::handlerObject(obj)));
+  if (!JS_WrapValue(cx, &handler)) return false;
+  JS::RootedValueArray<2> entries(cx);
+  entries[0].set(target);
+  entries[1].set(handler);
+  RootedObject result(cx, JS::NewArrayObject(cx, entries));
+  if (!result) return false;
+  args.rval().setObject(*result);
+  return true;
+}
