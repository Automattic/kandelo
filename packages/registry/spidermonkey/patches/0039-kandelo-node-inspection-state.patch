+static bool KandeloNativeConstructorName(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  args.rval().setUndefined();
+  if (!args.length() || !args[0].isObject()) return true;
+  RootedObject obj(cx, js::CheckedUnwrapStatic(&args[0].toObject()));
+  if (!obj) return true;
+  RootedString name(cx, JS_NewStringCopyZ(cx, JS::GetClass(obj)->name));
+  if (!name) return false;
+  args.rval().setString(name);
+  return true;
+}
