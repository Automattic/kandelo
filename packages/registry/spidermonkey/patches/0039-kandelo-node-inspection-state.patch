+// Private inspection hooks read engine state without invoking user properties,
+// scheduling reactions, advancing iterators or marking rejections handled.
+static bool KandeloNativeHasObjectKind(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  args.rval().setBoolean(false);
+  if (args.length() < 2 || !args[0].isObject() || !args[1].isString()) return true;
+  RootedObject obj(cx, js::CheckedUnwrapStatic(&args[0].toObject()));
+  if (!obj) return true;
+  RootedString kindString(cx, args[1].toString());
+  JS::UniqueChars kind = JS_EncodeStringToUTF8(cx, kindString);
+  if (!kind) return false;
+  bool result = false;
+  if (strcmp(kind.get(), "Proxy") == 0) {
+    result = js::IsScriptedProxy(obj);
+  } else if (strcmp(kind.get(), "ModuleNamespace") == 0) {
+    result = obj->is<js::ModuleNamespaceObject>();
+  } else if (!js::IsProxy(obj)) {
+    if (strcmp(kind.get(), "Arguments") == 0) {
+      JSAutoRealm ar(cx, obj);
+      js::ESClass cls;
+      if (!JS::GetBuiltinClass(cx, obj, &cls)) return false;
+      result = cls == js::ESClass::Arguments;
+    } else if (strcmp(kind.get(), "AsyncFunction") == 0) {
+      result = obj->is<JSFunction>() && obj->as<JSFunction>().isAsync();
+    } else if (strcmp(kind.get(), "GeneratorFunction") == 0) {
+      result = obj->is<JSFunction>() && obj->as<JSFunction>().isGenerator();
+    } else if (strcmp(kind.get(), "GeneratorObject") == 0) {
+      result = obj->is<js::AbstractGeneratorObject>();
+    } else if (strcmp(kind.get(), "MapIterator") == 0) {
+      result = obj->is<js::MapIteratorObject>();
+    } else if (strcmp(kind.get(), "SetIterator") == 0) {
+      result = obj->is<js::SetIteratorObject>();
+    } else if (strcmp(kind.get(), "StackOverflowError") == 0 && obj->is<js::ErrorObject>()) {
+      JSAutoRealm ar(cx, obj);
+      JSErrorReport* report = obj->as<js::ErrorObject>().getOrCreateErrorReport(cx);
+      if (!report) return false;
+      result = report->errorNumber == JSMSG_OVER_RECURSED;
+    }
+  }
+  args.rval().setBoolean(result);
+  return true;
+}
