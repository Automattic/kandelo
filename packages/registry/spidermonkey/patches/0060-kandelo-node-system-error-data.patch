+#include "kandelo-node-uv-error-table.h"
+static bool KandeloNativeUvErrorData(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  RootedObject output(cx, JS::NewArrayObject(cx, 0));
+  if (!output) return false;
+  uint32_t index = 0;
+  for (const auto& entry : kandelo::errors::entries) {
+    JS::RootedValueArray<3> row(cx);
+    row[0].setInt32(entry.number);
+    RootedString name(cx, JS_NewStringCopyZ(cx, entry.name));
+    if (!name) return false;
+    row[1].setString(name);
+    RootedString message(cx, JS_NewStringCopyZ(cx, entry.message));
+    if (!message) return false;
+    row[2].setString(message);
+    RootedObject data(cx, JS::NewArrayObject(cx, row));
+    if (!data) return false;
+    RootedValue value(cx, ObjectValue(*data));
+    if (!JS_SetElement(cx, output, index++, value)) return false;
+  }
+  args.rval().setObject(*output); return true;
+}
