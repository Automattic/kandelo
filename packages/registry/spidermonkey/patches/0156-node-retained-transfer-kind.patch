+bool JSStructuredCloneWriter::appendKandeloTransfer(HandleObject object,
+                                                   KandeloTransferKind kind) {
+  if (!context()->hasKandeloCloneErrors()) {
+    return transferableObjects.append(object);
+  }
+  MOZ_ASSERT(kandeloTransferKinds.length() == transferableObjects.length());
+  if (!kandeloTransferKinds.append(kind)) {
+    ReportOutOfMemory(context()); return false;
+  }
+  if (!transferableObjects.append(object)) {
+    kandeloTransferKinds.popBack(); return false;
+  }
+  return true;
+}
