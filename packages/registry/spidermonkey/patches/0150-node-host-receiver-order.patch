+    return badKandeloHostEnvelope("invalid host table");
+  if (count && !context()->hasKandeloCloneErrors())
+    return badKandeloHostEnvelope("host clone protocol is not initialized");
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t length;
+    if (!in.readPair(&tag, &length) || tag != SCTAG_STRING)
+      return badKandeloHostEnvelope("invalid host constructor info");
