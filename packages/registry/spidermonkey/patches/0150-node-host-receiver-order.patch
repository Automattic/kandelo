+    transferState = data;
+    if (!in.readPair(&tag, &data) || !in.read(&nativeCount)) return false;
+    if (nativeCount > UINT32_MAX || nativeCount > SIZE_MAX / (3 * sizeof(uint64_t)))
+      return badKandeloHostEnvelope("invalid transfer table size");
+    transferEntries = mozilla::Some(in.tell());
+    if (!in.seekBy(size_t(nativeCount) * 3 * sizeof(uint64_t))) return false;
+  }
+  if (!in.getPair(&tag, &data)) return false;
+  if (tag != SCTAG_KANDELO_HOST_HEADER) return true;
+  if (allowedScope != JS::StructuredCloneScope::SameProcess || (data != 1 && data != 2))
+    return badKandeloHostEnvelope("invalid host envelope");
+  if (transferState >= SCTAG_TM_END)
+    return badKandeloHostEnvelope("invalid transfer map header");
+  if (transferState != SCTAG_TM_UNREAD) {
+    ReportDataCloneError(context(), callbacks, JS_SCERR_TRANSFERABLE_TWICE, closure);return false;
+  }
+  kandeloHostVersion = data;
+  // Raw SpiderMonkey graphs never allocate this embedding's order metadata.
+  const auto envelopeStart = in.tell();
+  if (transferEntries.isSome()) {
+    in.seekTo(*transferEntries);
+    for (uint32_t i = 0; i < nativeCount; ++i) {
+      if (!in.readPair(&tag, &data) || !in.seekBy(2 * sizeof(uint64_t))) return false;
+      if (tag != SCTAG_TRANSFER_MAP_ARRAY_BUFFER && tag != SCTAG_TRANSFER_MAP_STORED_ARRAY_BUFFER &&
+          tag != SCTAG_TRANSFER_MAP_KANDELO_BACKING && !nativeSlots.append(i)) {
+        ReportOutOfMemory(context());return false;
+      }
+    }
+    in.seekTo(envelopeStart);
+  }
+  uint64_t offset, payloadOffset;
+  if (!in.readPair(&tag, &data) || !in.read(&offset) || !in.read(&payloadOffset)) return false;
+  kandeloGraphStart = mozilla::Some(in.tell());
+  if (offset > SIZE_MAX || offset % sizeof(uint64_t) ||
+      payloadOffset > offset || payloadOffset % sizeof(uint64_t))
+    return badKandeloHostEnvelope("invalid host offsets");
+  if (!in.seekBy(size_t(payloadOffset))) return false;
