+// SameProcess preflight invokes no protocol/constructor hooks and retains no
+// context pointer in bytes. Normal GC/OOM safepoints remain. Strings and wrappers live only
+// in this reader's rooted vectors. Native packet/read transactions own abort.
+bool JSStructuredCloneReader::prepareKandeloHostEnvelope() {
+  const auto saved = in.tell();
