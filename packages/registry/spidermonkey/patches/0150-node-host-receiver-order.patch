+      if (!in.readPair(&tag, &orderCount) || tag != SCTAG_KANDELO_HOST_ORDER)
+        return badKandeloHostEnvelope("missing host creation order");
+      for (uint32_t i = 0; i < orderCount; ++i) {
+        uint32_t kind, index;if (!in.readPair(&kind, &index)) return false;
