+bool JSStructuredCloneReader::createKandeloHost(uint32_t index) {
+  if (index >= kandeloHostInfo.length() || !kandeloHostObjects[index].isUndefined())
+    return badKandeloHostEnvelope("invalid host constructor index");
+  RootedValue argument(context(), kandeloHostInfo[index]);
+  RootedValue hook(context(), context()->kandeloCloneCreate()), object(context());
+  if (!CallKandeloCloneHook(context(), hook, JS::HandleValueArray(argument), &object)) return false;
+  if (!object.isObject()) return context()->reportKandeloCloneError("Invalid host deserializer result");
+  RootedObject host(context(), &object.toObject());int32_t mode;
+  if (!context()->getKandeloCloneMode(host, &mode)) return false;
+  if (mode < 0) return context()->reportKandeloCloneError("Unregistered host deserializer result");
+  kandeloHostObjects[index].set(object);return true;
+}
