+// A rooted weak registry models private own marks even on frozen objects,
+// functions and proxies. Keys never traverse prototypes or trigger JS traps.
+bool JSContext::getKandeloObjectMarks(HandleObject object, uint32_t* marks) {
+  *marks = 0;
+  RootedObject map(this, kandeloObjectMarks());
+  if (!map) return true;
+  RootedObject key(this, CheckedUnwrapStatic(object));
+  if (!key) { ReportAccessDenied(this); return false; }
+  AutoRealm ar(this, map);
+  if (!JS_WrapObject(this, &key)) return false;
+  RootedValue value(this), keyValue(this, ObjectValue(*key));
+  if (!JS::GetWeakMapEntry(this, map, keyValue, &value)) return false;
+  if (value.isInt32()) *marks = uint32_t(value.toInt32());
+  return true;
+}
+
+bool JSContext::setKandeloObjectMarks(HandleObject object, uint32_t marks) {
+  RootedObject map(this, kandeloObjectMarks());
+  if (!map) {
+    if (!marks) return true;
+    map = JS::NewWeakMapObject(this);
+    if (!map) return false;
+    kandeloObjectMarks() = map;
+  }
+  RootedObject key(this, CheckedUnwrapStatic(object));
+  if (!key) { ReportAccessDenied(this); return false; }
+  AutoRealm ar(this, map);
+  if (!JS_WrapObject(this, &key)) return false;
+  RootedValue keyValue(this, ObjectValue(*key)), value(this, Int32Value(int32_t(marks)));
+  return JS::SetWeakMapEntry(this, map, keyValue, value);
+}
