+
+static bool KandeloNativePerformanceLoopState(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  uint64_t start, idle;
+  if (GetShellContext(cx)->kandeloPerformanceLoop.Read(&start, &idle) != 0) {
+    const int error = errno;
+    JS_ReportErrorUTF8(cx, "performance loop clock: %s", strerror(error));
+    KandeloDecoratePendingError(cx, error); return false;
+  }
+  if (!kandeloPerformanceOrigin.initialized ||
+      (start && start < kandeloPerformanceOrigin.monotonic)) {
+    JS_ReportErrorASCII(cx, "Performance loop origin is unavailable"); return false;
+  }
+  RootedObject result(cx, JS::NewArrayObject(cx, 0));
+  if (!result || !JS_DefineElement(cx, result, 0, double(start), JSPROP_ENUMERATE) ||
+      !JS_DefineElement(cx, result, 1, start ? double(start) / 1e6 - double(kandeloPerformanceOrigin.monotonic) / 1e6 : -1.0, JSPROP_ENUMERATE) ||
+      !JS_DefineElement(cx, result, 2, double(idle) / 1e6, JSPROP_ENUMERATE)) return false;
+  args.rval().setObject(*result); return true;
 }

