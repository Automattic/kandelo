+// Depth here is a real embedding entry, not a synthetic async resource.
+static bool KandeloRunMicrotaskCheckpoint(JSContext* cx) {
+  if (!IsKandeloNodeMode()) { js::RunJobs(cx); return true; }
+  KandeloNativeJsEntryScope entry(cx);
+  if (!entry.Ready()) return false;
+  js::RunJobs(cx);
+  return !cx->isExceptionPending();
+}
+
+// Drain only this context's ticks/jobs; never dispatch another native work
+// item, timer, socket or async destroy before the request retirement fence.
+static bool KandeloPerformCallbackCheckpoint(JSContext* cx) {
+  if (!IsKandeloNodeMode()) return true;
+  ShellContext* sc = GetShellContext(cx);
+  while (!sc->quitting) {
+    double ticks;
+    if (!KandeloCallAsyncQueue(cx, "__kandeloHasNextTicks", &ticks)) return false;
+    if (ticks && !KandeloCallAsyncQueue(cx, "__kandeloRunNextTicks", &ticks)) return false;
+    if (!KandeloRunMicrotaskCheckpoint(cx)) return false;
+    if (sc->quitting) return true;
+    if (!KandeloCallAsyncQueue(cx, "__kandeloHasNextTicks", &ticks)) return false;
+    if (ticks) continue;
+    // Reuse actual embedding rejection data; complete Node rejection
+    // event/mode/fatal recovery remains an independent open owner.
+    if (!ReportUnhandledRejections(cx)) return false;
+    if (cx->isExceptionPending()) return false;
+    if (sc->quitting) return true;
+    if (!KandeloCallAsyncQueue(cx, "__kandeloHasNextTicks", &ticks)) return false;
+    if (!ticks) return true;
+  }
   return true;
 }
 
