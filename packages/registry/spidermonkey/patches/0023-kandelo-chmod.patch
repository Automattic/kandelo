--- a/js/src/shell/OSObject.cpp
+++ b/js/src/shell/OSObject.cpp
@@ -200,2 +200,24 @@
+static bool osfile_chmod(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  int32_t mode;
+  if (args.length() != 2 || !args[0].isString() ||
+      !JS::ToInt32(cx, args[1], &mode)) {
+    JS_ReportErrorASCII(cx, "chmod requires a path and mode");
+    return false;
+  }
+  RootedString given(cx, args[0].toString());
+  RootedString path(cx, ResolvePath(cx, given, RootRelative));
+  if (!path) return false;
+  UniqueChars filename = JS_EncodeStringToUTF8(cx, path);
+  if (!filename) return false;
+#ifdef XP_WIN
+  args.rval().setInt32(-ENOSYS);
+#else
+  int rc = chmod(filename.get(), mode_t(mode));
+  args.rval().setInt32(rc == 0 ? 0 : -errno);
+#endif
+  return true;
+}
