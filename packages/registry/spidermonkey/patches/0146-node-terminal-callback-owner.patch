+// Actual callback mode queues native readiness without manufacturing a Promise.
+// The watch holds the real owner/callback roots until detachment/publication.
+static bool KandeloTerminalStartRead(JSContext* cx, HandleObject owner,
+    KandeloTerminalLease* lease, int32_t length, HandleValue callback, MutableHandleValue result) {
+  JSAutoRealm realm(cx, owner);
+  RootedValue wrapped(cx, callback);if (!JS_WrapValue(cx, &wrapped)) return false;
+  if (lease->inputClosing || lease->input.Descriptor() < 0) { result.setInt32(-EBADF);return true; }
+  if (KandeloTerminalPendingRead(lease)) { result.setInt32(-EALREADY);return true; }
+  try {
+    std::vector<uint8_t> bytes(size_t(length), uint8_t(0));
+    RootedObject noPromise(cx);
+    auto* watch = js_new<KandeloSocketWatch>(cx, lease->input.Descriptor(), KandeloSocketWatchKind::Read, noPromise);
+    if (!watch) { JS_ReportOutOfMemory(cx);return false; }
+    watch->buffer = std::move(bytes);watch->terminalOwner = owner;watch->terminalLease = lease;
+    watch->terminalCallback = wrapped;watch->referenced = lease->referenced;
+    KandeloSocketWatchLink(watch);result.setInt32(0);return true;
+  } catch (const std::bad_alloc&) { JS_ReportOutOfMemory(cx);return false; }
+}
+static bool KandeloTerminalStopRead(KandeloTerminalLease* lease) {
+  auto* watch = KandeloTerminalPendingRead(lease);
+  if (!watch || watch->terminalCallback.isUndefined()) return false;
+  KandeloSocketWatchUnlink(watch);js_delete(watch);return true;
+}
+static bool KandeloTerminalRefRead(KandeloTerminalLease* lease, bool referenced) {
+  auto* watch = KandeloTerminalPendingRead(lease);
+  if (!watch) return false;
+  watch->referenced = referenced;return true;
+}
