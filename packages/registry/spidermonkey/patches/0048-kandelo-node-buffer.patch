+void ArrayBufferObject::accountKandeloExternalBytes() {
+  MOZ_RELEASE_ASSERT(isExternal() && !(flags() & KANDELO_EXTERNAL_CREDIT));
+  if (!byteLength()) return;
+  AddCellMemory(this, byteLength(), MemoryUse::Embedding2);
+  setFlags(flags() | KANDELO_EXTERNAL_CREDIT);
+}
+
+std::shared_ptr<void> ArrayBufferObject::kandeloContentsOwner() const {
+  const auto& slot = getFixedSlot(KANDELO_CONTENTS_SLOT);
+  if (slot.isUndefined()) return {};
+  return *static_cast<std::shared_ptr<void>*>(slot.toPrivate());
+}
+
+/* static */ std::shared_ptr<void> ArrayBufferObject::retainKandeloContents(
+    JSContext* cx, Handle<ArrayBufferObject*> buffer) {
+  if (auto owner = buffer->kandeloContentsOwner()) return owner;
+  if (buffer->isDetached()) return {};
+  if (buffer->isInlineData() && !ensureNonInline(cx, buffer)) return {};
+  BufferContents contents = buffer->contents();
+  const size_t length = buffer->byteLength();
+  // The native owner has no JS edges and may retire on a GC thread. Cell
+  // memory credits still belong to each real buffer and move with transfers.
+  std::shared_ptr<void> owner(new BufferContents(contents), [contents, length](void* metadata) {
+    switch (contents.kind()) {
+      case MALLOCED_ARRAYBUFFER_CONTENTS_ARENA:
+      case MALLOCED_UNKNOWN_ARENA: js_free(contents.data()); break;
+      case MAPPED: gc::DeallocateMappedContent(contents.data(), length); break;
+      case EXTERNAL: contents.freeFunc()(contents.data(), contents.freeUserData()); break;
+      case WASM: WasmArrayRawBuffer::Release(contents.data()); break;
+      case USER_OWNED:
+      case NO_DATA: break;
+      case INLINE_DATA: MOZ_CRASH("Native owner cannot retain moving inline bytes");
+    }
+    delete static_cast<BufferContents*>(metadata);
+  });
+  buffer->setFixedSlot(KANDELO_CONTENTS_SLOT,
+                       PrivateValue(new std::shared_ptr<void>(owner)));
+  return owner;
+}
