+// Node CLI strings are UTF-8 byte material independently of LC_CTYPE.
+// Use the existing maximal-subpart replacement decoder (also used by native
+// POSIX pathname diagnostics), retaining its real allocation until the JS
+// string takes ownership. Generic SpiderMonkey shell conversion is separate.
+static JSString* KandeloNodeCLIString(JSContext* cx, const char* bytes,
+                                     size_t length) {
+  size_t units;
+  JS::UniqueTwoByteChars chars(JS::LossyUTF8CharsToNewTwoByteCharsZ(
+      cx, JS::UTF8Chars(bytes, length), &units, js::MallocArena).get());
+  if (!chars) return nullptr;
+  return JS_NewUCString(cx, std::move(chars), units);
+}
+
+static JSString* KandeloNodeCLIString(JSContext* cx, const char* bytes) {
+  return KandeloNodeCLIString(cx, bytes, strlen(bytes));
+}
+
+static bool KandeloDefineNodeCLIString(JSContext* cx, HandleObject object,
+                                      const char* name,
+                                      const std::string& value) {
+  RootedString text(cx, KandeloNodeCLIString(cx, value.data(), value.size()));
+  return text && JS_DefineProperty(cx, object, name, text, 0);
+}
+
+static JSObject* KandeloNodeCLIStringArray(
+    JSContext* cx, const std::vector<std::string>& values) {
+  RootedObject array(cx, JS::NewArrayObject(cx, 0));
+  if (!array) return nullptr;
+  uint32_t index = 0;
+  for (const auto& value : values) {
+    RootedString text(cx, KandeloNodeCLIString(cx, value.data(), value.size()));
+    if (!text || !JS_DefineElement(cx, array, index++, text, JSPROP_ENUMERATE))
+      return nullptr;
+  }
+  return array;
+}
+
+static bool KandeloDefineNodeCLIStringList(
+    JSContext* cx, HandleObject object, const char* name,
+    const std::vector<std::string>& values) {
+  RootedObject array(cx, KandeloNodeCLIStringArray(cx, values));
+  return array && JS_DefineProperty(cx, object, name, array, 0);
+}
