+namespace {
+struct KandeloLazyCallback {
+  KandeloLazyDataGetter getter;
+  explicit KandeloLazyCallback(KandeloLazyDataGetter input) : getter(input) {}
+};
+class KandeloLazyRecord : public NativeObject {
+ public:
+  static const JSClass class_;
+  static void finalize(JS::GCContext*, JSObject* object) {
+    auto value = object->as<KandeloLazyRecord>().getReservedSlot(0);
+    if (!value.isUndefined()) {
+      js_delete(static_cast<KandeloLazyCallback*>(value.toPrivate()));
+    }
+  }
+};
+static const JSClassOps kandeloLazyOps = {
+    nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
+    KandeloLazyRecord::finalize, nullptr, nullptr, nullptr};
+const JSClass KandeloLazyRecord::class_ = {
+    "KandeloLazyData", JSCLASS_HAS_RESERVED_SLOTS(2), &kandeloLazyOps};
+}  // namespace
+
+bool js::DefineKandeloLazyDataProperty(JSContext* cx, HandleObject target,
+                                      HandleId id, KandeloLazyDataGetter getter,
+                                      HandleValue data, unsigned attrs,
+                                      ObjectOpResult& result) {
+  cx->check(target, id, data);
+  if (!target->is<NativeObject>()) {
+    JS_ReportErrorASCII(cx, "Native lazy data properties require a native target");
+    return false;
+  }
+  auto callback = cx->make_unique<KandeloLazyCallback>(getter);
+  if (!callback) return false;
+  Rooted<KandeloLazyRecord*> record(
+      cx, NewObjectWithGivenProto<KandeloLazyRecord>(cx, nullptr));
+  if (!record) return false;
+  record->setReservedSlot(0, PrivateValue(callback.release()));
+  record->setReservedSlot(1, data);
+  RootedValue value(cx, ObjectValue(*record));
+  Rooted<PropertyDescriptor> desc(cx, PropertyDescriptor::Data(value, attrs));
+  return NativeDefineProperty(cx, target.as<NativeObject>(), id, desc, result, true);
+}
+
+static bool GetKandeloLazyDataProperty(JSContext* cx, Handle<NativeObject*> obj,
+                                       HandleId id, PropertyInfo prop,
+                                       MutableHandleValue value) {
+  MOZ_ASSERT(prop.isKandeloLazyDataProperty());
+  Rooted<KandeloLazyRecord*> record(
+      cx, &obj->getSlot(prop.slot()).toObject().as<KandeloLazyRecord>());
+  auto* callback = static_cast<KandeloLazyCallback*>(
+      record->getReservedSlot(0).toPrivate());
+  RootedValue data(cx, record->getReservedSlot(1));
+  if (!callback->getter(cx, obj, id, data, value)) return false;
+
+  // The callback may collect, throw, delete or redefine the property. Cache
+  // only into the exact still-live record; never resurrect a deleted property
+  // or overwrite a value assigned by reentrant script.
+  PropertyResult current;
+  if (!NativeLookupOwnPropertyNoResolve(cx, obj, id, &current)) return false;
+  if (current.isNativeProperty()) {
+    auto info = current.propertyInfo();
+    if (info.isKandeloLazyDataProperty() &&
+        obj->getSlot(info.slot()) == ObjectValue(*record)) {
+      auto flags = info.flags();
+      flags.clearFlag(PropertyFlag::KandeloLazyDataProperty);
+      uint32_t slot;
+      if (!NativeObject::changeProperty(cx, obj, id, flags, &slot)) return false;
+      Watchtower::watchPropertyValueChange<AllowGC::CanGC>(cx, obj, id, value, info);
+      obj->setSlot(slot, value);
+    }
+  }
+  return true;
 }
 
