+AutoNativeConstructorOrigin::AutoNativeConstructorOrigin(JSContext* cx,
+                                                         const CallArgs& args)
+    : cx_(cx), previous_(cx->nativeConstructorOrigin),
+      constructor_(cx, &args.callee()),
+      direct_(!args.isConstructing() ||
+              &args.newTarget().toObject() == constructor_) {
+  cx_->nativeConstructorOrigin = this;
+}
+
+AutoNativeConstructorOrigin::~AutoNativeConstructorOrigin() {
+  MOZ_ASSERT(cx_->nativeConstructorOrigin == this);
+  cx_->nativeConstructorOrigin = previous_;
+}
+
+void AutoNativeConstructorOrigin::note(const CallArgs& args, JSProtoKey key) {
+  MOZ_ASSERT(&args.callee() == constructor_);
+  pendingClass_ = key == JSProto_Null ? nullptr : ProtoKeyToClass(key);
+}
+
+bool AutoNativeConstructorOrigin::record(HandleObject obj) {
+  pendingClass_ = nullptr;
+  return ObjectRealm::get(obj).recordConstructorIdentity(cx_, obj, constructor_,
+                                                        direct_);
+}
+
+bool AutoNativeConstructorOrigin::recordPending(JSObject* obj) {
+  if (!pendingClass_ || obj->getClass() != pendingClass_) {
+    return true;
+  }
+  // Insertion allocates native table storage only. The receiver's class
+  // initialization may still be in progress, so never permit a GC here.
+  JS::AutoCheckCannotGC nogc(cx_);
+  RootedObject rooted(cx_, obj);
+  return record(rooted);
+}
+
+AutoSuppressConstructorOrigin::AutoSuppressConstructorOrigin(JSContext* cx)
+    : cx_(cx), previous_(cx->nativeConstructorOrigin) {
+  cx_->nativeConstructorOrigin = nullptr;
+}
+
+AutoSuppressConstructorOrigin::~AutoSuppressConstructorOrigin() {
+  MOZ_ASSERT(!cx_->nativeConstructorOrigin);
+  cx_->nativeConstructorOrigin = previous_;
+}
