+static bool KandeloModuleRecord(JSContext* cx, HandleString identifier,
+                                HandleObject request, MutableHandleObject record) {
+  record.set(nullptr);
+  RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+  RootedValue hook(cx);
+  if (!global || !JS_GetProperty(cx, global, "__kandeloModuleRecord", &hook))
+    return !JS_IsExceptionPending(cx);
+  if (!hook.isObject() || !JS::IsCallable(&hook.toObject())) return true;
+  JS::RootedValueArray<2> args(cx);
+  args[0].setString(identifier);
+  if (request && request->as<ModuleRequestObject>().importAttributes())
+    args[1].setObject(*request->as<ModuleRequestObject>().importAttributes());
+  else
+    args[1].setUndefined();
+  RootedValue result(cx);
+  if (!JS_CallFunctionValue(cx, global, hook, args, &result)) return false;
+  if (!result.isObject()) {
+    JS_ReportErrorASCII(cx, "Node module record owner did not return a record");
+    return false;
+  }
+  record.set(&result.toObject());
+  return true;
+}
