+static void KandeloRetireFailedModuleSource(JSContext* cx, HandleObject record) {
+  if (!record || !JS_IsExceptionPending(cx)) return;
+  JS::AutoSaveExceptionState original(cx);
+  RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+  RootedValue hook(cx), result(cx);
+  JS::RootedValueArray<1> args(cx);
+  args[0].setObject(*record);
+  if (global && JS_GetProperty(cx, global, "__kandeloModuleFailed", &hook)) {
+    (void)JS_CallFunctionValue(cx, global, hook, args, &result);
+  }
+  // The destructor preserves a new pending error; restore explicitly so the
+  // actual compile failure wins even when cleanup fails. Cache retirement is
+  // still unproven if that private cleanup hook did not run successfully.
+  original.restore();
