+static bool KandeloLoadNodeModule(JSContext* cx, HandleObject record,
+                                  MutableHandleObject loaded) {
+  RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+  RootedValue hook(cx), result(cx);
+  if (!global || !JS_GetProperty(cx, global, "__kandeloLoadModule", &hook)) return false;
+  JS::RootedValueArray<1> args(cx);
+  args[0].setObject(*record);
+  if (!JS_CallFunctionValue(cx, global, hook, args, &result)) return false;
+  if (!result.isObject()) {
+    JS_ReportErrorASCII(cx, "Node module source owner did not return a load result");
+    return false;
+  }
+  loaded.set(&result.toObject());
+  return true;
