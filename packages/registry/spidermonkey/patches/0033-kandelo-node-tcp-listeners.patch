+static bool KandeloThrowSocketError(JSContext* cx, int error,
+                                    const char* syscallName) {
+  RootedObject reason(cx, JS_NewPlainObject(cx));
+  if (!reason || !KandeloDefineSocketInt(cx, reason, "errno", -error) ||
+      !KandeloDefineSocketString(cx, reason, "syscall", syscallName)) return false;
+  RootedValue value(cx, ObjectValue(*reason));
+  JS_SetPendingException(cx, value);
+  return false;
+}
