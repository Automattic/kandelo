+static bool KandeloNativeSocketAccept(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  int32_t listener;
+  if (args.length() < 1 || !JS::ToInt32(cx, args[0], &listener)) return false;
+  RootedObject promise(cx, JS::NewPromiseObject(cx, nullptr));
+  if (!promise) return false;
+  args.rval().setObject(*promise);
+  const int fd = KandeloAcceptSocket(listener);
+  if (fd >= 0) {
+    if (KandeloResolvePromiseWithInt(cx, promise, fd)) return true;
+    close(fd);
+    return false;
+  }
+  if (errno != EAGAIN && errno != EWOULDBLOCK && errno != EINTR)
+    return KandeloRejectSocketOperation(cx, promise, errno, "accept");
+  auto* watch = js_new<KandeloSocketWatch>(cx, listener, KandeloSocketWatchKind::Accept, promise);
+  if (!watch) { JS_ReportOutOfMemory(cx); return false; }
+  KandeloSocketWatchLink(watch);
+  return true;
+}
+
+static bool KandeloNativeSocketShutdown(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  int32_t fd;
+  if (args.length() < 1 || !JS::ToInt32(cx, args[0], &fd)) return false;
+  if (shutdown(fd, SHUT_WR) < 0) return KandeloThrowSocketError(cx, errno, "shutdown");
+  args.rval().setUndefined();
+  return true;
+}
+
+// Reference state belongs to the owning JS handle; apply it to each native
+// operation. Promise tokens address pending connects without guessing an fd.
+static bool KandeloNativeSocketRef(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  if (args.length() < 2) return false;
+  const bool referenced = JS::ToBoolean(args[1]);
+  for (auto* watch = gKandeloSocketWatches; watch; watch = watch->next) {
+    const bool matches = args[0].isInt32() ? watch->fd == args[0].toInt32()
+        : args[0].isObject() && watch->promise.get() == &args[0].toObject();
+    if (matches) watch->referenced = referenced;
+  }
+  args.rval().setUndefined();
   return true;
 }
 
