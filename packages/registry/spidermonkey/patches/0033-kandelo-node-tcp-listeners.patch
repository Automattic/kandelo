+// Shared JS validates overloads and resolves hostnames. This boundary performs
+// the actual socket/bind/listen and returns only a successfully owned fd.
+static bool KandeloNativeSocketListen(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  UniqueChars address;
+  int32_t port, family, backlog;
+  if (args.length() < 6 || !KandeloGetString(cx, args[0], &address) ||
+      !JS::ToInt32(cx, args[1], &port) || !JS::ToInt32(cx, args[2], &family) ||
+      !JS::ToInt32(cx, args[3], &backlog)) return false;
+  addrinfo hints = {};
+  hints.ai_family = family == 6 ? AF_INET6 : AF_INET;
+  hints.ai_socktype = SOCK_STREAM;
+  hints.ai_flags = AI_NUMERICHOST;
+  addrinfo* result = nullptr;
+  if (getaddrinfo(address.get(), nullptr, &hints, &result) != 0 || !result) {
+    if (result) freeaddrinfo(result);
+    return KandeloThrowSocketError(cx, EINVAL, "listen");
+  }
+  auto freeAddress = mozilla::MakeScopeExit([&] { freeaddrinfo(result); });
+  if (family == 6) reinterpret_cast<sockaddr_in6*>(result->ai_addr)->sin6_port = htons(uint16_t(port));
+  else reinterpret_cast<sockaddr_in*>(result->ai_addr)->sin_port = htons(uint16_t(port));
+  const int fd = socket(hints.ai_family, SOCK_STREAM, 0);
+  if (fd < 0) return KandeloThrowSocketError(cx, errno, "listen");
+  bool retained = false;
+  auto cleanup = mozilla::MakeScopeExit([&] { if (!retained) close(fd); });
+  if (KandeloSetNonblocking(fd) < 0 || fcntl(fd, F_SETFD, FD_CLOEXEC) < 0)
+    return KandeloThrowSocketError(cx, errno, "listen");
+  const int enabled = 1;
+  if (setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &enabled, sizeof(enabled)) < 0)
+    return KandeloThrowSocketError(cx, errno, "listen");
+  if (family == 6) {
+    const int only = JS::ToBoolean(args[4]) ? 1 : 0;
+    if (setsockopt(fd, IPPROTO_IPV6, IPV6_V6ONLY, &only, sizeof(only)) < 0)
+      return KandeloThrowSocketError(cx, errno, "listen");
+  }
+  if (JS::ToBoolean(args[5]) &&
+      setsockopt(fd, SOL_SOCKET, SO_REUSEPORT, &enabled, sizeof(enabled)) < 0)
+    return KandeloThrowSocketError(cx, errno, "listen");
+  if (bind(fd, result->ai_addr, result->ai_addrlen) < 0 || listen(fd, backlog) < 0)
+    return KandeloThrowSocketError(cx, errno, "listen");
+  retained = true;
+  args.rval().setInt32(fd);
+  return true;
+}
