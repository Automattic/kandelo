+// A successful accept transfers one nonblocking, close-on-exec fd to JS.
+// No descriptor survives a failed conversion or Promise resolution.
+static int KandeloAcceptSocket(int listener) {
+  int fd = accept(listener, nullptr, nullptr);
+  if (fd < 0) return -1;
+  if (KandeloSetNonblocking(fd) < 0 ||
+      fcntl(fd, F_SETFD, FD_CLOEXEC) < 0) {
+    const int error = errno;
+    close(fd);
+    errno = error;
+    return -1;
+  }
+  return fd;
+}
