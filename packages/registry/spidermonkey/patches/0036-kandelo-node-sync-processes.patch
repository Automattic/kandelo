+struct KandeloSyncPipe {
+  int fd = -1;
+  bool captured = false;
+  mozilla::Vector<uint8_t, 0, js::SystemAllocPolicy> bytes;
+  void closeFd() {
+    if (fd >= 0) { close(fd); fd = -1; }
+  }
+};
+
+// Own every resource even when allocating the JS result fails. No JS jobs run
+// here: a synchronous subprocess must not reenter the parent's JS event loop.
+struct KandeloSyncChild {
+  pid_t pid;
+  bool reaped = false;
+  mozilla::Vector<KandeloSyncPipe, 3, js::SystemAllocPolicy> pipes;
+  explicit KandeloSyncChild(pid_t child) : pid(child) {}
+  ~KandeloSyncChild() {
+    for (auto& pipe : pipes) pipe.closeFd();
+    if (!reaped) {
+      kill(pid, SIGKILL);
+      int status;
+      while (waitpid(pid, &status, 0) < 0 && errno == EINTR) {}
+    }
+  }
+};
