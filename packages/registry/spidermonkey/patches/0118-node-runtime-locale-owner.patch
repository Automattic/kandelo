+JS_PUBLIC_API UniqueChars JS_GetDefaultLocaleIdentifier(JSContext* cx) {
+  AssertHeapIsIdle();
+  if (const char* locale = cx->runtime()->getDefaultLocaleIdentifier()) {
+    return DuplicateString(cx, locale);
+  }
+
+  return nullptr;
+}
