+class KandeloAsyncResourceData : public NativeObject {
+ public:
+  static const JSClass class_;
+};
+const JSClass KandeloAsyncResourceData::class_ = {
+    "KandeloAsyncResourceData", JSCLASS_HAS_RESERVED_SLOTS(4)};
+
+bool JSContext::kandeloAsyncProperty(const char* name, MutableHandleValue result) {
+  result.setUndefined();
+  RootedValue current(this, kandeloAsyncContext());
+  if (!current.isObject()) return true;
+  RootedObject object(this, &current.toObject());
+  {
+    AutoRealm ar(this, object);
+    if (!JS_GetProperty(this, object, name, result)) return false;
+  }
+  return JS_WrapValue(this, result);
+}
+
+bool JSContext::notifyKandeloAsyncLifecycle(const char* kind,
+                                           HandleObject resource,
+                                           HandleValue frame) {
+  RootedValue callback(this, kandeloAsyncLifecycleHook());
+  if (callback.isUndefined()) return true;
+  if (!JS_WrapValue(this, &callback)) return false;
+  RootedString name(this, JS_NewStringCopyZ(this, kind));
+  if (!name) return false;
+  JS::RootedValueArray<3> args(this);
+  args[0].setString(name);
+  args[1].setObject(*resource);
+  args[2].set(frame);
+  if (!JS_WrapValue(this, args[1]) || !JS_WrapValue(this, args[2])) return false;
+  RootedValue result(this);
+  return JS::Call(this, UndefinedHandleValue, callback, args, &result);
+}
+
+static bool NewKandeloAsyncData(JSContext* cx,
+                                 MutableHandle<KandeloAsyncResourceData*> result) {
+  RootedValue frame(cx), currentId(cx);
+  if (!cx->kandeloAsyncProperty("frame", &frame) ||
+      !cx->kandeloAsyncProperty("id", &currentId)) return false;
+  double trigger = cx->kandeloAsyncParentId();
+  if (trigger < 0) trigger = currentId.isNumber() ? currentId.toNumber() : 0;
+  result.set(NewBuiltinClassInstance<KandeloAsyncResourceData>(cx));
+  if (!result) return false;
+  result->setReservedSlot(0, NumberValue(cx->allocateKandeloAsyncId()));
+  result->setReservedSlot(1, NumberValue(trigger));
+  result->setReservedSlot(2, frame);
+  result->setReservedSlot(3, BooleanValue(false));
+  return true;
+}
+
+bool js::InitKandeloPromiseResource(JSContext* cx, HandleObject promise) {
+  Rooted<KandeloAsyncResourceData*> data(cx);
+  if (!NewKandeloAsyncData(cx, &data)) return false;
+  promise->as<PromiseObject>().setReservedSlot(PromiseSlot_KandeloAsyncResource,
+                                              ObjectValue(*data));
+  const double parent = cx->kandeloAsyncParentId();
+  cx->kandeloAsyncParentId() = -1;
+  auto restore = mozilla::MakeScopeExit([&] { cx->kandeloAsyncParentId() = parent; });
+  RootedValue frame(cx, data->getReservedSlot(2));
+  return cx->notifyKandeloAsyncLifecycle("promise:init", promise, frame);
+}
+
+bool js::ResolveKandeloPromiseResource(JSContext* cx, HandleObject promise) {
+  RootedObject object(cx, CheckedUnwrapStatic(promise));
+  if (!object || !object->is<PromiseObject>()) return true;
+  RootedValue slot(cx, object->as<PromiseObject>().getReservedSlot(PromiseSlot_KandeloAsyncResource));
+  if (!slot.isObject()) {
+    JS_ReportErrorASCII(cx, "Promise has no native async resource record");
+    return false;
+  }
+  Rooted<KandeloAsyncResourceData*> data(cx, &slot.toObject().as<KandeloAsyncResourceData>());
+  if (data->getReservedSlot(3).toBoolean()) return true;
+  data->setReservedSlot(3, BooleanValue(true));
+  RootedValue frame(cx, data->getReservedSlot(2));
+  return cx->notifyKandeloAsyncLifecycle("promise:resolve", promise, frame);
+}
+
+bool js::GetKandeloAsyncResourceInfo(JSContext* cx, HandleObject resource,
+                                     MutableHandleValue result) {
+  RootedObject object(cx, CheckedUnwrapStatic(resource));
+  RootedValue slot(cx);
+  if (object && object->is<PromiseObject>()) {
+    slot = object->as<PromiseObject>().getReservedSlot(PromiseSlot_KandeloAsyncResource);
+  } else if (object && object->is<KandeloAsyncResourceData>()) {
+    slot.setObject(*object);
+  }
+  if (!slot.isObject()) {
+    JS_ReportErrorASCII(cx, "Object has no native async resource record");
+    return false;
+  }
+  Rooted<KandeloAsyncResourceData*> data(cx, &slot.toObject().as<KandeloAsyncResourceData>());
+  JS::RootedValueArray<3> entries(cx);
+  for (size_t i = 0; i < 3; i++) {
+    entries[i].set(data->getReservedSlot(i));
+    if (!JS_WrapValue(cx, entries[i])) return false;
+  }
+  RootedObject array(cx, JS::NewArrayObject(cx, entries));
+  if (!array) return false;
+  result.setObject(*array);
+  return true;
+}
