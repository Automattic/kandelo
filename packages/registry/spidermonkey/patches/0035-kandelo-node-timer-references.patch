+// Scheduling uses the engine's monotonic clock, independently of wall time
+// and user replacements of Date.now(). The epoch is private to this process.
+static bool KandeloNativeMonotonicTime(JSContext* cx, unsigned argc, Value* vp) {
+  CallArgs args = CallArgsFromVp(argc, vp);
+  static const TimeStamp origin = TimeStamp::Now();
+  args.rval().setDouble((TimeStamp::Now() - origin).ToMilliseconds());
+  return true;
+}
