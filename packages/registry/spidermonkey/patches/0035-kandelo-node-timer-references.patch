+static bool KandeloNodeTimersHaveReferences(JSContext* cx, bool* referenced) {
+  RootedObject global(cx, JS::CurrentGlobalOrNull(cx));
+  RootedValue fn(cx), result(cx);
+  if (!global ||
+      !JS_GetProperty(cx, global, "__kandeloHasReferencedTimers", &fn)) {
+    return false;
+  }
+  if (!fn.isObject() || !JS::IsCallable(&fn.toObject())) {
+    JS_ReportErrorASCII(cx, "Node timer scheduler is unavailable");
+    return false;
+  }
+  if (!JS_CallFunctionValue(cx, global, fn, HandleValueArray::empty(), &result)) {
+    return false;
+  }
+  *referenced = JS::ToBoolean(result);
+  return true;
+}
