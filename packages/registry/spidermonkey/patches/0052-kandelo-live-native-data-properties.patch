+bool js::DefineKandeloNativeDataProperty(
+    JSContext* cx, HandleObject target, HandleId id,
+    KandeloNativeDataGetter getter, KandeloNativeDataSetter setter,
+    HandleValue data, unsigned attrs, ObjectOpResult& result) {
+  cx->check(target, id, data);
+  MOZ_ASSERT(getter);
+  if (!target->is<NativeObject>()) {
+    JS_ReportErrorASCII(cx, "Native data properties require a native target");
+    return false;
+  }
+  auto callback = cx->make_unique<KandeloLazyCallback>(getter, setter);
+  if (!callback) return false;
+  Rooted<KandeloLazyRecord*> record(
+      cx, NewObjectWithGivenProto<KandeloLazyRecord>(cx, nullptr));
+  if (!record) return false;
+  record->setReservedSlot(0, PrivateValue(callback.release()));
+  record->setReservedSlot(1, data);
+  RootedValue value(cx, ObjectValue(*record));
+  Rooted<PropertyDescriptor> desc(cx, PropertyDescriptor::Data(value, attrs));
+  return NativeDefineProperty(cx, target.as<NativeObject>(), id, desc, result, true);
+}
+
+static bool IsKandeloLiveDataProperty(NativeObject* obj, PropertyInfo prop) {
+  MOZ_ASSERT(prop.isKandeloLazyDataProperty());
+  auto& record = obj->getSlot(prop.slot()).toObject().as<KandeloLazyRecord>();
+  auto* callback = static_cast<KandeloLazyCallback*>(
+      record.getReservedSlot(0).toPrivate());
+  return callback->liveGetter != nullptr;
+}
+static bool HasKandeloNativeDataSetter(HandleValue value) {
+  auto& record = value.toObject().as<KandeloLazyRecord>();
+  auto* callback = static_cast<KandeloLazyCallback*>(
+      record.getReservedSlot(0).toPrivate());
+  return callback->setter != nullptr;
+}
+static bool SetKandeloNativeDataProperty(JSContext* cx,
+                                         Handle<NativeObject*> obj,
+                                         HandleId id, HandleValue value,
+                                         HandleValue input,
+                                         ObjectOpResult& result) {
+  Rooted<KandeloLazyRecord*> record(
+      cx, &value.toObject().as<KandeloLazyRecord>());
+  auto* callback = static_cast<KandeloLazyCallback*>(
+      record->getReservedSlot(0).toPrivate());
+  MOZ_ASSERT(callback->setter);
+  RootedValue data(cx, record->getReservedSlot(1));
+  return callback->setter(cx, obj, id, data, input, result);
+}
