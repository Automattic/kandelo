-static void KandeloHashFinalize(JS::GCContext* gcx, JSObject* obj) {
-  const Value slot = JS::GetReservedSlot(obj, 0);
-  auto* state = slot.isUndefined() ? nullptr : static_cast<KandeloHashState*>(slot.toPrivate());
-  if (!state) {
-    return;
-  }
-  if (state->md) EVP_MD_CTX_free(state->md);
-  if (state->hmac) HMAC_CTX_free(state->hmac);
-  js_delete(state);
-}
