+JS_PUBLIC_API void SetEmbeddingErrorStackHooks(
+    JSRuntime* rt, ErrorStackLimitHook limit, ErrorStackCreatedHook created) {
+  js::AssertHeapIsIdle();
+  rt->embeddingErrorStackLimit = limit;
+  rt->embeddingErrorStackCreated = created;
+}
+
+JS_PUBLIC_API bool CaptureCurrentStackForError(
+    JSContext* cx, MutableHandleObject stack, uint32_t fallbackLimit,
+    HandleObject startAfter) {
+  js::AssertHeapIsIdle();
+  CHECK_THREAD(cx);
+  bool handled = false;
+  uint32_t limit = fallbackLimit;
+  auto hook = cx->runtime()->embeddingErrorStackLimit.ref();
+  if (hook && !hook(cx, &limit, &handled)) return false;
+  // MaxFrames(0) means unlimited to SavedStacks, not an empty error stack.
+  if (handled && limit == 0) {
+    stack.set(nullptr);
+    return true;
+  }
+  return CaptureCurrentStack(cx, stack, StackCapture(MaxFrames(limit)), startAfter,
+                             handled);
+}
+
+JS_PUBLIC_API bool InitEmbeddingErrorStack(
+    JSContext* cx, HandleObject target, HandleObject stack, bool* handled) {
+  js::AssertHeapIsIdle();
+  CHECK_THREAD(cx);
+  *handled = false;
+  auto hook = cx->runtime()->embeddingErrorStackCreated.ref();
+  return !hook || hook(cx, target, stack, handled);
+}
