# Turn off SDL's dynamic API on Kandelo.
#
# The dynamic API lets an SDL_DYNAMIC_API environment variable name a
# replacement SDL shared library that a statically linked program loads
# with dlopen() at startup. Kandelo builds SDL as a static library only;
# there is no SDL side module to substitute. The SDK links its dlopen
# loader into any program that references dlopen, and the dynamic API's
# reference put it into every SDL program, along with every SDL function
# (its jump table keeps them all). A fork-capable SDL program then imports
# the loader and is instrumented as a dynamic-linking program. SDL turns
# the dynamic API off the same way for Emscripten, the other WebAssembly
# platform, and for RISC OS, where static programs cannot use dlopen().
# SDL_LoadObject() still works: a program that calls it (ScummVM loads its
# engine plugins that way) gets the loader.
--- a/src/dynapi/SDL_dynapi.h
+++ b/src/dynapi/SDL_dynapi.h
@@ -67,6 +67,8 @@
 #define SDL_DYNAMIC_API 0 /* The N-Gage doesn't support dynamic linking either */
 #elif defined(__3DS__)
 #define SDL_DYNAMIC_API 0 /* devkitARM doesn't support dynamic linking */
+#elif defined(__wasm__) && !defined(__EMSCRIPTEN__) /* Kandelo: SDL is linked statically; there is no SDL shared library to substitute. */
+#define SDL_DYNAMIC_API 0
 #elif defined(DYNAPI_NEEDS_DLOPEN) && !defined(HAVE_DLOPEN)
 #define SDL_DYNAMIC_API 0 /* we need dlopen(), but don't have it.... */
 #endif
