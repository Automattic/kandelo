Map inclusive absolute-device bounds to inclusive display pixels.

The device maximum must reach the last pixel, not width/height. An
out-of-window event clears SDL mouse focus and hides the KMS cursor;
later evdev motion cannot restore a focus it no longer has. This also
clamps out-of-range device samples and avoids intermediate overflow.

--- a/src/core/linux/SDL_evdev.c
+++ b/src/core/linux/SDL_evdev.c
@@ -341,6 +341,20 @@
     return first;
 }
 
+/* Absolute device bounds and display pixel indices are both inclusive.
+ * Multiplying by mode.w maps the device maximum one pixel outside the
+ * window, losing mouse focus on direct-display backends. Clamp noisy
+ * device values too, and widen before multiplication. */
+static int SDL_EVDEV_AbsoluteToPixel(int value, int minimum, int range, int extent)
+{
+    Sint64 pixel;
+    if (range <= 0 || extent <= 1) {
+        return 0;
+    }
+    pixel = ((Sint64)value - minimum) * (extent - 1) / range;
+    return (int)SDL_clamp(pixel, 0, extent - 1);
+}
+
 void SDL_EVDEV_Poll(void)
 {
     struct input_event event;
@@ -543,8 +557,8 @@
                     SDL_DisplayMode mode;
                     SDL_GetCurrentDisplayMode(0, &mode);
                     SDL_SendMouseMotion(mouse->focus, (SDL_MouseID)item->fd, item->relative_mouse,
-                        (item->mouse_x - item->min_x) * mode.w / item->range_x,
-                        (item->mouse_y - item->min_y) * mode.h / item->range_y);
+                        SDL_EVDEV_AbsoluteToPixel(item->mouse_x, item->min_x, item->range_x, mode.w),
+                        SDL_EVDEV_AbsoluteToPixel(item->mouse_y, item->min_y, item->range_y, mode.h));
                 }
 
                 if (item->mouse_wheel != 0 || item->mouse_hwheel != 0) {
@@ -821,8 +835,8 @@
             if (ioctl(item->fd, EVIOCGABS(ABS_Y), &abs) >= 0) item->mouse_y = abs.value;
             SDL_GetCurrentDisplayMode(0, &mode);
             SDL_SendMouseMotion(mouse->focus, (SDL_MouseID)item->fd, SDL_FALSE,
-                                (item->mouse_x - item->min_x) * mode.w / item->range_x,
-                                (item->mouse_y - item->min_y) * mode.h / item->range_y);
+                                SDL_EVDEV_AbsoluteToPixel(item->mouse_x, item->min_x, item->range_x, mode.w),
+                                SDL_EVDEV_AbsoluteToPixel(item->mouse_y, item->min_y, item->range_y, mode.h));
