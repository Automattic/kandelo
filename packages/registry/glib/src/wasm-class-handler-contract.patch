--- a/gobject/gclosure.c
+++ b/gobject/gclosure.c
@@ -1164,2 +1164,46 @@

+/* Direct class handlers, unlike connected C callbacks, have no trailing
+ * closure-data argument. Keep the GCClosure ownership/callback storage and
+ * reuse the exact-arity path already used by class/interface vtable slots.
+ * As with that path, the signal's GValue/GType signature drives libffi;
+ * arbitrary custom C-marshaller representation/side effects are not modeled. */
+static void
+g_wasm_class_handler_meta_marshal (GClosure       *closure,
+                                   GValue         *return_value,
+                                   guint           n_param_values,
+                                   const GValue   *param_values,
+                                   gpointer        invocation_hint,
+                                   gpointer        marshal_data)
+{
+  (void) invocation_hint;
+  (void) marshal_data;
+  g_wasm_vtable_meta_marshal (return_value, n_param_values, param_values,
+                               ((GCClosure *) closure)->callback);
+}
+
+static void
+g_wasm_class_handler_meta_marshalv (GClosure *closure,
+                                    GValue   *return_value,
+                                    gpointer  instance,
+                                    va_list   args,
+                                    gpointer  marshal_data,
+                                    int       n_params,
+                                    GType    *param_types)
+{
+  (void) marshal_data;
+  g_wasm_vtable_meta_marshal_va (return_value, instance, args,
+                                  ((GCClosure *) closure)->callback,
+                                  n_params, param_types);
+}
+
+GClosure *
+_g_cclosure_new_class_handler (GCallback callback_func)
+{
+  GClosure *closure = g_cclosure_new (callback_func, NULL, NULL);
+
+  g_closure_set_meta_marshal (closure, NULL, g_wasm_class_handler_meta_marshal);
+  g_closure_set_meta_va_marshal (closure, g_wasm_class_handler_meta_marshalv);
+  return closure;
+}
+
