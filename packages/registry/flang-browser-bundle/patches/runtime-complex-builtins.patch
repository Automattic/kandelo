--- a/flang/tools/flang-driver/CMakeLists.txt
+++ b/flang/tools/flang-driver/CMakeLists.txt
@@ -29,6 +29,17 @@
   clangOptions
   clangBasic
 )
+
+if(CMAKE_SYSTEM_NAME STREQUAL "Kandelo")
+  # Flang's intrinsic evaluator uses Clang's complex-arithmetic libcalls.
+  # Build their target implementations from the same LLVM source.
+  set(builtins "${LLVM_MAIN_SRC_DIR}/../compiler-rt/lib/builtins")
+  add_library(flang-complex-builtins STATIC
+    "${builtins}/divsc3.c" "${builtins}/mulsc3.c"
+    "${builtins}/divdc3.c" "${builtins}/muldc3.c"
+    "${builtins}/divtc3.c" "${builtins}/multc3.c")
+  target_link_libraries(flang PRIVATE flang-complex-builtins)
+endif()

 # This creates the executable with a version appended
 # and creates a symlink to it without the version
