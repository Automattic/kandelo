#Api2
module("appmenu")
include "/etc/xdg/sfwbar/winops.widget"

bar {
  edge = "bottom"
  layer = "top"
  mirror = "*"
  exclusive_zone = "auto"

  label {
    value = "Start"
    style = "startmenu"
    tooltip = "Applications"
    action[LeftClick] = Menu("app_menu_system")
  }
  pager {
    style = "pager"
    rows = 1
    preview = false
  }
  taskbar {
    rows = 1
    labels = true
    icons = false
    tooltips = true
    action[LeftClick] = Focus()
    action[RightClick] = Menu("winops")
  }
  label { css = "* { -GtkWidget-hexpand: true; }" }
  label {
    value = Time("%H:%M:%S")
    interval = 1000
    style = "clock"
    tooltip = Time("%A, %d %B %Y")
  }
}

#CSS
window { background-color: #323232; }
label { font-family: sans; font-size: 14px; color: #eeeeee; }
#startmenu, #clock { padding: 8px 12px; }
#startmenu { font-weight: bold; background-color: #40516b; }
/* Clear the theme's light button images above our dark backgrounds. */
button#pager_item, button#taskbar_item {
  background-image: none;
  background-color: #323232;
  border-image: none;
  box-shadow: none;
  text-shadow: none;
  color: #eeeeee;
}
button#pager_item { padding: 6px 10px; }
button#pager_item.focused, button#taskbar_item.focused,
button#pager_item:hover, button#taskbar_item:hover { background-color: #40516b; }
#taskbar { min-height: 34px; }
menu { background-color: #323232; }
menuitem { padding: 6px 12px; }
menuitem:hover { background-color: #40516b; }
