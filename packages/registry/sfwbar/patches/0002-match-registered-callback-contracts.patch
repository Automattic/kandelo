Subject: [PATCH] Match registered GTK and GLib callback contracts

Signal callbacks include closure data even when it is unused. Preserve
boolean event propagation and source removal results, and adapt helpers
whose direct-call signatures differ from the registration contract.
This corrects upstream C callback types for WebAssembly indirect calls;
it does not change the platform dispatcher or relax type checks.

--- a/src/gui/monitor.c
+++ b/src/gui/monitor.c
@@ -233,7 +233,8 @@
   return gdk_display_get_monitor_at_window(disp, win);
 }
 
-static void monitor_added_cb ( GdkDisplay *gdisp, GdkMonitor *gmon )
+static void monitor_added_cb ( GdkDisplay *gdisp, GdkMonitor *gmon,
+    gpointer data )
 {
   GHashTable *bar_list;
   GHashTableIter iter;
@@ -252,7 +253,8 @@
   trigger_emit(trigger);
 }
 
-static void monitor_removed_cb ( GdkDisplay *gdisp, GdkMonitor *gmon )
+static void monitor_removed_cb ( GdkDisplay *gdisp, GdkMonitor *gmon,
+    gpointer data )
 {
   static char trigger[256];
 
