#!/bin/sh
# Catalog downloads are verified before extraction. Uploaded/local content is
# passed to DOSBox Pure directly; this script never extracts an arbitrary ZIP.
case "${1:-}" in
    --help)
        cat <<'EOF'
Usage: dos-play GAME [DOSBOX-OPTION]...
  or:  dos-play PATH [DOSBOX-OPTION]...
  or:  dos-play --list

Run a DOS game from the catalog, or local DOS content.

GAME is a game's name in the catalog, /usr/share/dos-play/games.tsv. The
first time a game is played, or after its catalog checksum changes,
dos-play downloads it with curl(1), refuses it unless its size and SHA-256
match the catalog, and installs it in $XDG_DATA_HOME/dos-play/GAME (by
default ~/.local/share/dos-play/GAME): a ZIP is extracted with every file
kept, licenses included, and a lone program is installed with its license.
While a game downloads, its lock directory, .GAME.lock beside it, makes
another dos-play of the same game fail; a lock left by a download that was
killed is removed. dos-play then runs the game's program with
dosbox-pure(1).

PATH, which must begin with /, ./ or ../, is local content passed to
dosbox-pure(1) as is: a game ZIP, a DOS program, a disk image, a
dosbox.conf or a directory. dos-play never extracts local content itself.

The remaining arguments are passed to dosbox-pure(1): --keypad-arrows sends
the navigation keys as keypad keys, for older games that expect them, and
--frames N stops after N emulation frames. Ctrl+Shift+F12 quits DOSBox
Pure.

Options:
      --list     list the catalog's games, one per line: name, title and
                 license, separated by tabs, and exit
      --help     display this help and exit
      --version  output version information and exit

The exit status is 2 for a usage error or an unknown game, and nonzero
when a download fails, is refused or is already in progress. Otherwise it
is dosbox-pure's.
EOF
        exit 0
        ;;
    --version) echo 'dos-play (Kandelo dosbox-pure) 1.0-preview8'; exit 0 ;;
esac
set -eu
CATALOG=/usr/share/dos-play/games.tsv
say() { echo "dos-play: $*" >&2; }
usage() { echo 'usage: dos-play GAME|PATH [DOSBOX_OPTIONS] (dos-play --list shows demos)' >&2; exit 2; }
[ "$#" -gt 0 ] || usage
case "$1" in
    --list) cut -f1,8,9 "$CATALOG"; exit 0 ;;
    -h) usage ;;
    /*|./*|../*) exec /usr/bin/dosbox-pure "$@" ;;
    *[!a-z0-9-]*|'') usage ;;
esac
TAB=$(printf '\t')
LINE=$(grep "^$1$TAB" "$CATALOG" || true)
[ -n "$LINE" ] || { say "Unknown game: $1 (use --list, or ./PATH for local content)"; exit 2; }
shift
IFS="$TAB" read -r ID BYTES SHA256 URL FORMAT ROOT EXE TITLE LICENSE <<ROW
$LINE
ROW
DATA=${XDG_DATA_HOME:-${HOME:?HOME or XDG_DATA_HOME is required}/.local/share}
case "$DATA" in /*) ;; *) say 'HOME or XDG_DATA_HOME must be absolute'; exit 2 ;; esac
GAMES="$DATA/dos-play"
DIR="$GAMES/$ID"
mkdir -p "$GAMES"
# The checksum marker is committed last. Failed/interrupted installs are not
# reusable, and a changed catalog hash causes a fresh download.
if [ "$(cat "$DIR/.download-sha256" 2>/dev/null || true)" != "$SHA256" ] ||
   [ ! -f "$DIR/$EXE" ]; then
    LOCK="$GAMES/.$ID.lock"
    if ! mkdir "$LOCK" 2>/dev/null; then
        # A download killed outright (SIGKILL, machine stopped) cannot run
        # its cleanup. Its lock names a process that no longer exists, so it
        # is removed and taken over. A lock without a PID yet belongs to a
        # download that is just starting.
        OWNER=$(cat "$LOCK/pid" 2>/dev/null || true)
        if [ -n "$OWNER" ] && ! kill -0 "$OWNER" 2>/dev/null; then
            say "Removing the lock of an interrupted download: $ID"
            rm -rf "$LOCK"
        fi
        mkdir "$LOCK" 2>/dev/null || { say "Another download is in progress: $ID ($LOCK)"; exit 1; }
    fi
    echo $$ > "$LOCK/pid"
    cleanup() { rm -rf "$LOCK"; }
    trap cleanup EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM HUP
    say "Downloading $TITLE ($BYTES bytes)..."
    curl -fSL --retry 2 --connect-timeout 30 --max-time 180 "$URL" -o "$LOCK/download"
    if [ "$(wc -c < "$LOCK/download")" -ne "$BYTES" ] ||
       ! printf '%s  %s\n' "$SHA256" "$LOCK/download" | sha256sum -c - >/dev/null 2>&1; then
        say 'Download size or SHA-256 mismatch; refusing to run it'
        exit 1
    fi
    mkdir "$LOCK/unpacked"
    case "$FORMAT" in
        com)
            cp "$LOCK/download" "$LOCK/unpacked/$EXE"
            cp /usr/share/dos-play/DOSDEF-UNLICENSE.txt "$LOCK/unpacked/UNLICENSE.txt"
            ;;
        zip) unzip -q "$LOCK/download" -d "$LOCK/unpacked" ;;
        *) say "Unsupported catalog format: $FORMAT"; exit 1 ;;
    esac
    SOURCE="$LOCK/unpacked"
    if [ "$ROOT" != . ]; then SOURCE="$SOURCE/$ROOT"; fi
    [ -f "$SOURCE/$EXE" ] || { say 'Executable missing from download'; exit 1; }
    printf '%s\n' "$SHA256" > "$SOURCE/.download-sha256"
    # Keep every upstream file, including licenses and DOS extenders. The
    # downloaded archive itself is discarded after the installation commits.
    rm -rf "$DIR"
    mv "$SOURCE" "$DIR"
    cleanup
    trap - EXIT INT TERM HUP
fi
say "Starting $TITLE ($LICENSE)... Ctrl+Shift+F12 quits"
exec /usr/bin/dosbox-pure "$DIR/$EXE" "$@"
