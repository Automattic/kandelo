# Kandelo compatibility boundary: no entropy source on target
#
# Kandelo's wasm32 target does not provide a getrandom()/entropy device, so
# std::random_device throws at runtime (or aborts) wherever LLVM/lld use it
# for non-cryptographic purposes (retry-backoff jitter, symbol-order
# shuffling). This patch replaces std::random_device usage in
# ExponentialBackoff and lld's ELF writer with a fixed-seed PRNG (a simple
# splitmix64/LCG-style generator), which is sufficient for these
# non-security-sensitive uses.
#
# Upstream: llvm-project, tag llvmorg-21.1.7 (LLVM 21.1.7).
--- a/llvm/include/llvm/Support/ExponentialBackoff.h	2025-12-01 07:58:50
+++ b/llvm/include/llvm/Support/ExponentialBackoff.h	2026-08-27 13:49:18
@@ -16,7 +16,7 @@
 #include "llvm/Support/Compiler.h"
 #include "llvm/Support/Error.h"
 #include <chrono>
-#include <random>
+#include <cstdint>
 
 namespace llvm {
 
@@ -57,7 +57,7 @@
   duration MinWait;
   duration MaxWait;
   time_point EndTime;
-  std::random_device RandDev;
+  uint64_t RandState = 0x9e3779b97f4a7c15ULL;
   int64_t CurrentMultiplier = 1;
 };
 
--- a/llvm/lib/Support/ExponentialBackoff.cpp	2025-12-01 07:58:50
+++ b/llvm/lib/Support/ExponentialBackoff.cpp	2026-08-27 13:49:18
@@ -17,11 +17,11 @@
     return false;
 
   duration CurMaxWait = std::min(MinWait * CurrentMultiplier, MaxWait);
-  std::uniform_int_distribution<uint64_t> Dist(MinWait.count(),
-                                               CurMaxWait.count());
-  // Use random_device directly instead of a PRNG as uniform_int_distribution
-  // often only takes a few samples anyway.
-  duration WaitDuration = std::min(duration(Dist(RandDev)), EndTime - Now);
+  uint64_t Min = static_cast<uint64_t>(MinWait.count());
+  uint64_t Max = static_cast<uint64_t>(CurMaxWait.count());
+  RandState = RandState * 6364136223846793005ULL + 1;
+  uint64_t Span = Max > Min ? Max - Min + 1 : 1;
+  duration WaitDuration = std::min(duration(Min + (RandState % Span)), EndTime - Now);
   if (CurMaxWait < MaxWait)
     CurrentMultiplier *= 2;
   std::this_thread::sleep_for(WaitDuration);
--- a/lld/ELF/Writer.cpp	2025-12-01 07:58:50
+++ b/lld/ELF/Writer.cpp	2026-08-27 13:49:18
@@ -1066,7 +1066,7 @@
       // reliably.
       std::reverse(matched.begin(), matched.end());
     } else {
-      std::mt19937 g(seed ? seed : std::random_device()());
+      std::mt19937 g(seed ? seed : 0x9e3779b9u);
       llvm::shuffle(matched.begin(), matched.end(), g);
     }
     size_t i = 0;
