# Kandelo compatibility boundary: statvfs semantics on the Kandelo VFS
#
# llvm::sys::fs::is_local() probes filesystem-specific statvfs flags to
# decide whether a path is on local vs. remote storage. Kandelo exposes a
# single local virtual filesystem to guest programs and does not implement
# BSD-style statvfs flags, so this probe is meaningless on the target. This
# patch adds a __wasm__ branch that always reports local storage, matching
# Kandelo's actual (single, local) VFS semantics.
#
# Upstream: llvm-project, tag llvmorg-21.1.7 (LLVM 21.1.7).
--- a/llvm/lib/Support/Unix/Path.inc	2025-12-01 07:58:50
+++ b/llvm/lib/Support/Unix/Path.inc	2026-08-27 13:49:18
@@ -551,6 +551,9 @@
 
   // vmount entry not found; "remote" is the conservative answer.
   return false;
+#elif defined(__wasm__)
+  // Kandelo exposes a local virtual filesystem and does not provide BSD statvfs flags.
+  return true;
 #elif defined(__MVS__)
   // The file system can have an arbitrary structure on z/OS; must go with the
   // conservative answer.
