#!/bin/sh
# Start the Omarchy-shaped desktop and stay in the foreground until it ends.
#
# The tiling compositor with its shell on top: a D-Bus session bus, one
# Quickshell process, which draws the wallpaper, the bar, the launcher and
# menu, the notifications, the on-screen display and the lock screen from
# /usr/share/kandelo/quickshell — the way Omarchy v4 runs its shell — and
# kclipd, which turns host clipboard text into the desktop's selection. The
# desktop comes up bare, wallpaper and bar; the visitor opens clients through
# the keybindings or the launcher (CTRL+Space).
#
# Everything this desktop reads is image data under /usr/share/kandelo: the
# compositor config, themes (/usr/share/kandelo/themes, the compositor's
# default), the .desktop entries the launcher lists, the shell's QML, and the
# D-Bus and fontconfig configurations. Nothing is staged by the page.
set -u

SOCKET=/tmp/wayland-0
BUS=/tmp/dbus-session.socket
HYPR_IPC=/tmp/hypr/wlcompositor/.socket.sock
DATA=/usr/share/kandelo

# Every desktop process gets the session bus: notify-send (the compositor's
# theme hook) reaches the shell's notification server over it.
export DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS"
export FONTCONFIG_FILE="$DATA/fonts/fonts.conf"
# The session's runtime directory. A login manager normally provides it; here
# the desktop's session script does. Stock clients (Quickshell, foot) find
# the compositor's socket as $XDG_RUNTIME_DIR/wayland-0, and /tmp is the one
# directory every uid can write under this kernel (see wldesktop).
export XDG_RUNTIME_DIR=/tmp
# The launcher lists $XDG_DATA_DIRS/applications/*.desktop.
export XDG_DATA_DIRS=$DATA:/usr/share
# QtQuick clients render through the software scenegraph: a Wayland client
# has no GL surface of its own here.
export QT_QUICK_BACKEND=software
# The shell talks to the compositor over the Hyprland IPC socket pair.
export HYPRLAND_INSTANCE_SIGNATURE=wlcompositor

# Wait for a socket path, failing if the process that should bind it died.
wait_socket() {
    path=$1 pid=$2 name=$3 i=0
    while [ ! -S "$path" ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "omarchydesktop: $name exited before binding $path" >&2
            return 1
        fi
        i=$((i + 1))
        if [ "$i" -gt 300 ]; then
            echo "omarchydesktop: timed out waiting for $path ($name)" >&2
            return 1
        fi
        sleep 0.1
    done
}

/usr/local/bin/dbus-daemon --config-file="$DATA/dbus/session.conf" --nofork &
bus_pid=$!

WLC_LAYOUT=dwindle \
WLC_CONFIG="$DATA/omarchy/wlcompositor.conf" \
    /usr/local/bin/wlcompositor &
compositor_pid=$!

wait_socket "$SOCKET" "$compositor_pid" wlcompositor || exit 1
wait_socket "$BUS" "$bus_pid" dbus-daemon || exit 1

# The host-clipboard agent. It needs only the compositor; if it cannot start
# (no /dev/kandelo/clipboard in an older kernel) it says why on stderr, the
# desktop runs on, and a host paste reports that no agent is running.
/usr/local/bin/kclipd &
wait_socket "$HYPR_IPC" "$compositor_pid" wlcompositor || exit 1

# The shell connects to its sockets exactly once, so it starts only after the
# compositor and the bus are up.
/usr/local/bin/quickshell -p "$DATA/quickshell/shell.qml" &

# The compositor's lifetime is the desktop's.
wait "$compositor_pid"
status=$?
kill "$bus_pid" 2>/dev/null
exit "$status"
