#!/bin/sh
# Start the Omarchy desktop on sway and stay in the foreground until it ends.
#
# Omarchy v4's own scripts, menu, themes and key bindings
# (/usr/share/omarchy, the omarchy package) on upstream sway: a D-Bus session
# bus, then sway with /usr/share/kandelo/omarchy/sway.conf, which starts
# mako, swaybg, swayidle and kclipd. The menu and the app launcher are
# fuzzel, the lock screen is swaylock. The desktop comes up bare, background
# and bar; the visitor opens clients through the key bindings or the menus.
#
# The first boot sets Omarchy's Tokyo Night theme the way Omarchy's installer
# does, headless, and turns on Omarchy's stay-awake indicator: the demo user's
# password is public and the browser tab is the boundary, so an idle lock
# only interrupts the visitor. Omarchy's Stay Awake toggle turns the idle lock
# back on. Every boot prints sway's bindings from Omarchy's Lua binding
# declarations before sway reads them.
#
# Once sway is up, the launcher prints sway's IPC events, one `SWAY` line
# each, so the machine's terminal shows what the compositor did.
set -u

DATA=/usr/share/kandelo
BUS=/tmp/dbus-session.socket
STATE=$HOME/.local/state/omarchy

export OMARCHY_PATH=/usr/share/omarchy
export PATH=$OMARCHY_PATH/bin:/usr/bin:/bin
# Every desktop process gets the session bus: Omarchy's notification
# scripts reach mako over it.
export DBUS_SESSION_BUS_ADDRESS="unix:path=$BUS"
export FONTCONFIG_FILE="$DATA/omarchy/fonts.conf"
# The session's runtime directory. A login manager normally provides it; here
# the desktop's session script does. /tmp is the one directory every uid can
# write under this kernel (see wldesktop).
export XDG_RUNTIME_DIR=/tmp
# fuzzel's app launcher lists $XDG_DATA_DIRS/applications/*.desktop. An
# entry here replaces a system entry with the same desktop-file ID:
# kandelo-terminal, scummvm and wayland-demo (Paint) are the IDs the SFWBar
# desktops install in /usr/share/applications, and this desktop's own
# variants of those applications (foot with this desktop's config) take
# their place rather than appearing beside them.
export XDG_DATA_DIRS=$DATA:/usr/share
# QtQuick clients render through the software scenegraph: a Wayland client
# has no GL surface of its own here.
export QT_QUICK_BACKEND=software
export LIBSEAT_BACKEND=noop
export SWAYSOCK=/tmp/sway-ipc.sock

# Wait for a socket path, failing if the process that should bind it died.
wait_socket() {
    path=$1 pid=$2 name=$3 i=0
    while [ ! -S "$path" ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            echo "omarchydesktop: $name exited before binding $path" >&2
            return 1
        fi
        i=$((i + 1))
        if [ "$i" -gt 300 ]; then
            echo "omarchydesktop: timed out waiting for $path ($name)" >&2
            return 1
        fi
        sleep 0.1
    done
}

# sway binds its IPC socket before it loads its config and starts its
# renderer, and answers only once its event loop runs. swaymsg gives up after
# 3 seconds, so ask until sway answers, failing if sway died.
wait_sway_ipc() {
    i=0
    until swaymsg -t get_version >/dev/null 2>&1; do
        if ! kill -0 "$sway_pid" 2>/dev/null; then
            echo "omarchydesktop: sway exited before answering IPC" >&2
            return 1
        fi
        i=$((i + 1))
        if [ "$i" -gt 20 ]; then
            echo "omarchydesktop: timed out waiting for sway's IPC" >&2
            return 1
        fi
    done
}

# One line per event. sway sends the first tick event once the subscription
# is in place; swaymsg prints no reply to a successful subscribe. Later ticks
# carry the payload a client sent with swaymsg -t send_tick. Window lines
# cover new, close and focus (title changes would flood the terminal), and
# count the windows on the focused workspace after the event.
EVENT='if has("first") then (if .first then "SWAY subscribed" else "SWAY tick \(.payload)" end)
  elif has("container") then
    select(.change == "new" or .change == "close" or .change == "focus")
    | .container as $c
    | "SWAY window \(.change) app_id=\($c.app_id // $c.window_properties.class // "") pid=\($c.pid)"
      + " rect=\($c.rect.x),\($c.rect.y),\($c.rect.width)x\($c.rect.height)"
      + " content=\($c.window_rect.x),\($c.window_rect.y),\($c.window_rect.width)x\($c.window_rect.height)"
  elif has("current") then "SWAY workspace \(.change) name=\(.current.name // "")"
  else "SWAY binding \(.binding.command)"
  end'
WINDOWS='[.. | objects | select(.type == "workspace" and any(.. | objects; .focused == true))][0]
  | [.. | objects | select(.pid != null)] | length'

log_sway_events() {
    swaymsg -m -t subscribe '["tick","window","workspace","binding"]' |
        jq --unbuffered -r "$EVENT" |
        while IFS= read -r line; do
            case $line in
            "SWAY window "*) echo "$line windows=$(swaymsg -t get_tree | jq "$WINDOWS")" ;;
            *) echo "$line" ;;
            esac
        done
}

dbus-daemon --config-file="$DATA/dbus/session.conf" --nofork &
bus_pid=$!
wait_socket "$BUS" "$bus_pid" dbus-daemon || exit 1

if [ ! -e "$STATE/current/theme.name" ]; then
    OMARCHY_THEME_HEADLESS=1 omarchy-theme-set "Tokyo Night" ||
        echo "omarchydesktop: omarchy-theme-set failed" >&2
    omarchy-toggle-idle stay-awake >/dev/null
fi
mkdir -p "$HOME/.config/fuzzel" "$STATE/sway"
ln -sf "$STATE/current/theme/fuzzel.ini" "$HOME/.config/fuzzel/fuzzel.ini"
# omarchy-sway-bindings names each Omarchy binding it does not bind and why.
omarchy-sway-bindings >"$STATE/sway/bindings.conf" 2>"$STATE/sway/bindings.skipped" ||
    echo "omarchydesktop: omarchy-sway-bindings failed" >&2

sway -c "$DATA/omarchy/sway.conf" &
sway_pid=$!
wait_socket "$SWAYSOCK" "$sway_pid" sway || exit 1
wait_sway_ipc || exit 1
log_sway_events &

# sway's lifetime is the desktop's.
wait "$sway_pid"
status=$?
kill "$bus_pid" 2>/dev/null
exit "$status"
