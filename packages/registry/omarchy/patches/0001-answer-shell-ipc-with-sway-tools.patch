       printf '%s' "$rows" >"$rows_cache_file.$$.tmp" && mv -f "$rows_cache_file.$$.tmp" "$rows_cache_file"
diff --git a/bin/omarchy-menu-lines b/bin/omarchy-menu-lines
new file mode 100755
index 0000000..9d0abba
--- /dev/null
+++ b/bin/omarchy-menu-lines
@@ -0,0 +1,18 @@
+#!/bin/bash
+
+# omarchy:summary=Count the menu rows that fit on the focused output
+# omarchy:hidden=true
+
+# The shell's menu card stops 10 pixels short of the bar and of the
+# output's far edge. fuzzel centers its card, so the card keeps clear of
+# the bar on both sides; it draws a 2-pixel border, 18-pixel padding,
+# and the header and each row at 50 pixels.
+
+set -euo pipefail
+
+read -r output usable < <({ swaymsg -t get_outputs; swaymsg -t get_workspaces; } |
+  jq -rs '"\(.[0][] | select(.focused) | .rect.height) \(.[1][] | select(.focused) | .rect.height)"')
+bar=$(( output - usable ))
+card=$(( output - 2 * (bar + 10) ))
+
+echo $(( (card - 2 * 2 - 2 * 18 - 50) / 50 ))
