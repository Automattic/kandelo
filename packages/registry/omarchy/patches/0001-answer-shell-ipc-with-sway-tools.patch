-  if exec {rows_lock_fd}>"$rows_cache_file.lock" && flock -w 30 "$rows_lock_fd"; then
+  if exec {rows_lock_fd}>"$rows_cache_file.lock" && flock "$rows_lock_fd"; then
     if [[ $rows_cacheable == true ]]; then
