diff --git a/bin/omarchy-menu-fuzzel b/bin/omarchy-menu-fuzzel
new file mode 100755
index 0000000..497de8f
--- /dev/null
+++ b/bin/omarchy-menu-fuzzel
@@ -0,0 +1,129 @@
+#!/bin/bash
+
+# omarchy:summary=Draw the Omarchy menu with fuzzel, one level at a time
+# omarchy:args=[--check] [route]
+# omarchy:hidden=true
+
+set -euo pipefail
+
+menu_files=(
+  "$OMARCHY_PATH/default/omarchy/omarchy-menu.jsonc"
+  "$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
+)
+cache=${XDG_RUNTIME_DIR:-/tmp}/omarchy-menu.json
+
+# Every process this script starts delays the card, so the merged menu is
+# parsed once and kept until a menu file changes, and each level is read
+# with one jq call.
+stale=0
+for file in "${menu_files[@]}"; do
+  [[ -f $file && ! $cache -nt $file ]] && stale=1
+done
+if (( stale )); then
+  for file in "${menu_files[@]}"; do
+    [[ -f $file ]] || continue
+    sed -E '/^[[:space:]]*\/\//d' "$file" | sed -zE 's/,([[:space:]]*[]}])/\1/g'
+  done | jq -s 'add' >"$cache.$$"
+  mv "$cache.$$" "$cache"
+fi
+read -r -d '' menu <"$cache" || true
+
+# The resolved route and its action, target, provider and title, then one
+# row per child entry: the route, the glyph, the label and the entry's
+# when and checked conditions.
+LEVEL='
+  (if $route == "root" then ""
+   elif has($route) then $route
+   else to_entries | map(select(.value.aliases // [] | index($route))) | first.key // error("unknown menu route: \($route)")
+   end) as $id
+  | (.[$id] // {}) as $entry
+  | ([$id, $entry.action // "", $entry.target // "", $entry.provider // "", $entry.title // $entry.label // ""] | join("\u001f")),
+    (to_entries[]
+     | select((.key | split(".") | .[:-1] | join(".")) == $id)
+     | [.key, .value.icon // "", .value.label, .value.when // "", .value.checked // ""]
+     | join("\u001f"))
+'
+
+level() {
+  mapfile -t lines < <(jq -r --arg route "$1" "$LEVEL" <<<"$menu")
+  (( ${#lines[@]} )) || exit 1
+  IFS=$'\x1f' read -r route action target provider title <<<"${lines[0]}"
+}
+
+# One row per entry: the route, then the entry's glyph and label, the way
+# the shell's menu draws them.
+rows() {
+  local line id icon label when checked
+
+  for line in "${lines[@]:1}"; do
+    IFS=$'\x1f' read -r id icon label when checked <<<"$line"
+    [[ -n $when ]] && ! bash -c "$when" >/dev/null 2>&1 && continue
+    [[ -n $checked ]] && bash -c "$checked" >/dev/null 2>&1 && label+=" ✓"
+    printf '%s\t%s  %s\n' "$id" "$icon" "$label"
+  done
+}
+
+loading_file=${XDG_RUNTIME_DIR:-/tmp}/omarchy-menu-loading
+loading_pid=
+
+# A level starts several processes before fuzzel shows it, so a notification
+# names the level until fuzzel starts. The notification is sent while the
+# level starts those processes, and dismissed in the background.
+show_loading() {
+  omarchy-notification-send -p -t 0 "Loading ${title:-Menu}…" >"$loading_file" 2>/dev/null &
+  loading_pid=$!
+}
+
+end_loading() {
+  local id=
+
+  wait "$loading_pid" || true
+  read -r id <"$loading_file" || true
+  [[ -n $id ]] || return 0
+  makoctl dismiss -n "$id" >/dev/null 2>&1 &
+}
+
+if [[ ${1:-} == "--check" ]]; then
+  level "${2:-root}"
+  [[ -z $provider || $provider == "apps" ]]
+  exit
+fi
+
+level "${1:-root}"
+
+while true; do
+  if [[ -n $action ]]; then
+    # An action can start many processes before its picker or window shows,
+    # so a notification names it until omarchy-shell opens the picker or the
+    # action ends.
+    OMARCHY_MENU_LOADING=$(omarchy-notification-send -p -t 0 "Loading ${title}…") || OMARCHY_MENU_LOADING=""
+    export OMARCHY_MENU_LOADING
+    status=0
+    bash -c "$action" || status=$?
+    [[ -z $OMARCHY_MENU_LOADING ]] || makoctl dismiss -n "$OMARCHY_MENU_LOADING" 2>/dev/null || true
+    exit "$status"
+  elif [[ -n $target ]]; then
+    level "$target"
+  elif [[ $provider == "apps" ]]; then
+    show_loading
+    height=$(omarchy-menu-lines)
+    fuzzel --lines "$height" &
+    fuzzel_pid=$!
+    end_loading
+    wait "$fuzzel_pid"
+    exit
+  elif [[ -n $provider ]]; then
+    echo "omarchy-menu-fuzzel: no fuzzel provider for $provider" >&2
+    exit 1
+  else
+    show_loading
+    height=$(omarchy-menu-lines)
+    entries=$(rows)
+    end_loading
+    # The header shows the menu's title until the visitor types.
+    selection=$(fuzzel --dmenu --only-match --with-nth=2 --accept-nth=1 \
+      --lines "$height" --prompt "" --placeholder "${title:-Go}…" <<<"$entries") || exit 0
+    [[ -n $selection ]] || exit 0
+    level "$selection"
+  fi
+done
