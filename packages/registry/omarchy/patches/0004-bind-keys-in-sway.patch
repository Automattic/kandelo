+#!/usr/bin/env lua
+
+-- omarchy:summary=Print Omarchy's key bindings as sway bind lines, each after a description comment
+
+local omarchy_path = os.getenv("OMARCHY_PATH")
+if omarchy_path == nil or omarchy_path == "" then
+  omarchy_path = "/usr/share/omarchy"
+end
+package.path = omarchy_path .. "/?.lua;" .. package.path
+
+local MODIFIERS = { SUPER = "Mod4", ALT = "Mod1", CTRL = "Control", SHIFT = "Shift" }
+local WHEEL = { mouse_down = "button5", mouse_up = "button4" }
+local DIRECTIONS = { l = "left", r = "right", u = "up", d = "down" }
+local SEPARATORS = { ["||"] = true, ["&&"] = true, [";"] = true, ["|"] = true }
+local CHECKED = { ["omarchy-shell"] = true, ["omarchy-menu"] = true }
+
+-- A dispatcher sway has no command for returns nil, and its binding is skipped.
+local function dispatchers(known)
+  return setmetatable(known, {
+    __index = function()
+      return function() end
+    end,
+  })
+end
+
+local function workspace(name)
+  if name == "e+1" then
+    return { sway = "workspace next_on_output" }
+  elseif name == "e-1" then
+    return { sway = "workspace prev_on_output" }
+  elseif name == "previous" then
+    return { sway = "workspace back_and_forth" }
+  elseif name:match("^%d+$") then
+    return { sway = "workspace number " .. name }
+  end
+end
+
+local function resize(axis, amount)
+  local verb = amount > 0 and "grow" or "shrink"
+  return { sway = string.format("resize %s %s %d px", verb, axis, math.abs(amount)) }
+end
+
+local dsp = dispatchers({
+  exec_cmd = function(command)
+    return { exec = command }
+  end,
+  layout = function(name)
+    if name == "togglesplit" then
+      return { sway = "layout toggle split" }
+    end
+  end,
+  focus = function(args)
+    if args.direction then
+      return { sway = "focus " .. DIRECTIONS[args.direction] }
+    elseif args.workspace then
+      return workspace(args.workspace)
+    end
+  end,
+})
+
+dsp.window = dispatchers({
+  close = function()
+    return { sway = "kill" }
+  end,
+  float = function(args)
+    if args.action == "toggle" then
+      return { sway = "floating toggle" }
+    end
+  end,
+  fullscreen = function(args)
+    if args.mode == "fullscreen" then
+      return { sway = "fullscreen toggle" }
+    end
+  end,
+  move = function(args)
+    if args.workspace == "special:scratchpad" then
+      return { sway = "move scratchpad" }
+    end
+    if not (args.workspace and args.workspace:match("^%d+$")) then
+      return nil
+    end
+
+    local move = "move container to workspace number " .. args.workspace
+    if args.follow == false then
+      return { sway = move }
+    end
+    return { sway = move .. "; workspace number " .. args.workspace }
+  end,
+  swap = function(args)
+    return { sway = "move " .. DIRECTIONS[args.direction] }
+  end,
+  cycle_next = function(args)
+    if args and args.next == false then
+      return { sway = "focus prev" }
+    end
+    return { sway = "focus next" }
+  end,
+  resize = function(args)
+    if not args then
+      return nil
+    end
+    if args.x ~= 0 then
+      return resize("width", args.x)
+    end
+    return resize("height", args.y)
+  end,
+})
+
+dsp.workspace = dispatchers({
+  toggle_special = function(name)
+    if name == "scratchpad" then
+      return { sway = "scratchpad show" }
+    end
+  end,
+  move = function(args)
+    local direction = DIRECTIONS[args.monitor]
+    if direction then
+      return { sway = "move workspace to output " .. direction }
+    end
+  end,
+})
+
+dsp.group = dispatchers({})
+
+local function sway_keys(keys)
+  local bind = "bindsym"
+  local parts = {}
+
+  for part in keys:gmatch("[^+]+") do
+    part = part:match("^%s*(.-)%s*$")
+    local code = part:match("^code:(%d+)$")
+
+    if MODIFIERS[part] then
+      table.insert(parts, MODIFIERS[part])
+    elseif code then
+      bind = "bindcode"
+      table.insert(parts, code)
+    elseif WHEEL[part] then
+      bind = "bindsym --whole-window"
+      table.insert(parts, WHEEL[part])
+    elseif part:find(":", 1, true) then
+      return nil
+    else
+      table.insert(parts, part)
+    end
+  end
+
+  return bind, table.concat(parts, "+")
+end
+
+local function missing_program(command)
+  local expect_program = true
+
+  for word in command:gmatch("%S+") do
+    if SEPARATORS[word] then
+      expect_program = true
+    elseif expect_program then
+      if o.cmd_missing(word) then
+        return word
+      end
+      expect_program = false
+    end
+  end
+end
+
+local bound = {}
+
+local function skip(keys, description, reason)
+  io.stderr:write(string.format("omarchy-sway-bindings: skipped %s (%s): %s\n", keys, description or "", reason))
+end
+
+local function bind(keys, dispatcher, options)
+  local opts = options or {}
+  local description = opts.description
+
+  if not description then
+    return skip(keys, description, "no description")
+  end
+
+  local kind, combo = sway_keys(keys)
+  if not kind then
+    return skip(keys, description, "no sway key")
+  end
+
+  if type(dispatcher) == "table" and dispatcher.exec then
+    local program = missing_program(dispatcher.exec)
+    if program then
+      return skip(keys, description, program .. " is not installed")
+    end
+    local first, arguments = dispatcher.exec:match("^(%S+)(.*)$")
+    if CHECKED[first] and not o.shell_succeeds(first .. " --check" .. arguments) then
+      return skip(keys, description, "nothing answers " .. dispatcher.exec)
+    end
+    dispatcher = { sway = "exec " .. dispatcher.exec }
+  end
+
+  if type(dispatcher) ~= "table" or not dispatcher.sway then
+    return skip(keys, description, "no sway command")
+  end
+
+  local flags = ""
+  if opts.locked then
+    flags = flags .. " --locked"
+  end
+  if opts.release then
+    flags = flags .. " --release"
+  end
+  if not opts.repeating then
+    flags = flags .. " --no-repeat"
+  end
+
+  local line = kind .. flags .. " " .. combo
+  if bound[line] then
+    return skip(keys, description, "already bound to " .. bound[line])
+  end
+  bound[line] = description
+
+  print("# " .. description)
+  print(line .. " " .. dispatcher.sway)
+end
+
+hl = setmetatable({
+  dsp = dsp,
+  bind = function(keys, dispatcher, options)
+    bind(keys, dispatcher, options)
+    return { unbind = function() end }
+  end,
+}, {
+  __index = function()
+    return function() end
+  end,
+})
+
+require("default.hypr.helpers")
+require("default.hypr.bindings")
