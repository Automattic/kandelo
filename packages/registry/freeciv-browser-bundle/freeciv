#!/bin/sh
# The upstream client also inherits these paths when it spawns its server.
set -e
export ICU_DATA=/usr/share/icu
export FREECIV_DATA_PATH=/usr/share/freeciv
export SDL_AUDIODRIVER=dsp
if [ -z "${XDG_RUNTIME_DIR:-}" ] || [ ! -S "$XDG_RUNTIME_DIR/${WAYLAND_DISPLAY:-wayland-0}" ]; then
    export SDL_VIDEODRIVER=kmsdrm
    export SDL_EVDEV_DEVICES=2:/dev/input/event0,1:/dev/input/event1
    # A direct display has no window manager. Match Freeciv's drawing and
    # input coordinates to the display mode instead of stretching its 640x480
    # window across that mode. An explicit GUI argument block is user-owned.
    gui_options=no
    for arg do
        [ "$arg" != -- ] || gui_options=yes
    done
    if [ "$gui_options" = no ]; then
        exec /usr/libexec/freeciv/client.wasm --Announce none "$@" -- --fullscreen
    fi
fi
exec /usr/libexec/freeciv/client.wasm --Announce none "$@"
