@@ -467,6 +467,7 @@
 #[cfg(all(
     not(tokio_unstable),
     target_family = "wasm",
+    not(unix),
     any(
         feature = "fs",
         feature = "io-std",
--- a/src/macros/cfg.rs
+++ b/src/macros/cfg.rs
@@ -715,7 +715,7 @@
