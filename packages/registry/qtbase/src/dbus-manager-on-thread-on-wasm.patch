 QDBusConnectionManager::~QDBusConnectionManager()
 {
+#ifdef __wasm__
+    // The manager never ran as a thread: the connections live on the thread
+    // that opened them (the application's), so close them here instead of
+    // in run()'s epilogue.
+    const auto locker = qt_scoped_lock(mutex);
+    for (QDBusConnectionPrivate *d : std::as_const(connectionHash)) {
+        if (!d->ref.deref())
+            delete d;
+        else
+            d->closeConnection();
+    }
+    connectionHash.clear();
+#else
     quit();
     wait();
+#endif
 }
 
