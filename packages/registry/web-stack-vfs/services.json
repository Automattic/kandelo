{
  "version": 1,
  "services": [
    {
      "id": "web-static",
      "title": "nginx",
      "port": 8080,
      "shortcuts": {
        "title": "nginx",
        "summary": "Service demos keep the web preview primary, while actions inspect the same running service from a shell.",
        "groups": [
          {
            "title": "Service",
            "actions": [
              {
                "id": "curl-home",
                "label": "Fetch page",
                "description": "Fetch the served page from inside the machine.",
                "kind": "terminal.run",
                "payload": "curl -i http://127.0.0.1:8080/ | head -40"
              },
              {
                "id": "nginx-procs",
                "label": "Workers",
                "description": "Show nginx processes.",
                "kind": "terminal.run",
                "payload": "lsof | grep nginx | head -40 || true"
              },
              {
                "id": "nginx-conf",
                "label": "Config",
                "description": "Print the top of nginx.conf.",
                "kind": "terminal.run",
                "payload": "sed -n '1,80p' /etc/nginx/nginx.conf"
              }
            ]
          }
        ],
        "script": {
          "title": "Service check",
          "language": "sh",
          "initialText": "curl -i http://127.0.0.1:8080/ | head -40\necho \"--- nginx processes ---\"\nlsof | grep nginx | head -40 || true"
        },
        "companion": {
          "title": "Companion HTML",
          "srcDoc": "<!doctype html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    :root { color-scheme: dark; }\n    body {\n      margin: 0;\n      padding: 12px;\n      background: #191512;\n      color: #f3d6b3;\n      font: 12px ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif;\n    }\n    h1 {\n      margin: 0 0 8px;\n      font-size: 12px;\n      font-weight: 650;\n      letter-spacing: 0;\n      color: #fff2df;\n    }\n    p {\n      margin: 0 0 10px;\n      color: #b99d7d;\n      line-height: 1.4;\n    }\n    .row {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 6px;\n    }\n    button {\n      border: 1px solid rgba(255, 169, 86, 0.28);\n      background: rgba(255, 169, 86, 0.12);\n      color: #ffe0b9;\n      border-radius: 6px;\n      padding: 7px 9px;\n      font: inherit;\n      cursor: pointer;\n    }\n    button:hover { background: rgba(255, 169, 86, 0.2); }\n    #status {\n      min-height: 16px;\n      margin-top: 10px;\n      color: #d2b08b;\n      font-family: ui-monospace, SFMono-Regular, Menlo, monospace;\n      font-size: 11px;\n    }\n  </style>\n</head>\n<body>\n  <h1>nginx companion</h1>\n  <p>This frame has no kernel access. It can only request parent-approved action ids.</p>\n  <div class=\"row\"><button type=\"button\" data-action=\"curl-home\">Fetch</button><button type=\"button\" data-action=\"nginx-procs\">Workers</button><button type=\"button\" data-action=\"nginx-conf\">Config</button></div>\n  <div id=\"status\"></div>\n  <script>\n    const status = document.getElementById(\"status\");\n    document.addEventListener(\"click\", (event) => {\n      const button = event.target.closest(\"button[data-action]\");\n      if (!button) return;\n      const actionId = button.getAttribute(\"data-action\");\n      parent.postMessage({ type: \"kandelo.demoAction\", actionId }, \"*\");\n      status.textContent = \"sent \" + actionId;\n    });\n  </script>\n</body>\n</html>"
        }
      }
    },
    {
      "id": "web-php",
      "title": "nginx + PHP",
      "port": 8080,
      "shortcuts": {
        "title": "nginx + PHP",
        "summary": "The web preview is Adminer, auto-connected to a SQLite database that PHP-FPM seeds on first load. These actions inspect the same live FastCGI stack from a shell.",
        "groups": [
          {
            "title": "Service",
            "actions": [
              {
                "id": "curl-info",
                "label": "Status page",
                "description": "Fetch the PHP-FPM status page at /info.php.",
                "kind": "terminal.run",
                "payload": "curl -s http://127.0.0.1:8080/info.php | sed -n '1,40p'"
              },
              {
                "id": "show-db",
                "label": "SQLite file",
                "description": "Show the demo database PHP-FPM created (SQLite header included).",
                "kind": "terminal.run",
                "payload": "ls -l /var/www/data && echo '--- header ---' && head -c 16 /var/www/data/demo.db; echo"
              },
              {
                "id": "php-version",
                "label": "PHP",
                "description": "Print the PHP-FPM version.",
                "kind": "terminal.run",
                "payload": "/usr/sbin/php-fpm -v"
              },
              {
                "id": "php-procs",
                "label": "Workers",
                "description": "Show nginx and PHP-FPM processes.",
                "kind": "terminal.run",
                "payload": "lsof | grep -E 'nginx|php-fpm' | head -60 || true"
              }
            ]
          }
        ],
        "script": {
          "title": "Service check",
          "language": "sh",
          "initialText": "curl -s http://127.0.0.1:8080/info.php | sed -n '1,40p'\necho \"--- SQLite database (seeded by PHP-FPM on first load) ---\"\nls -l /var/www/data && head -c 16 /var/www/data/demo.db; echo\necho \"--- service processes ---\"\nlsof | grep -E 'nginx|php-fpm' | head -60 || true"
        }
      }
    },
    {
      "id": "web-python",
      "title": "nginx + Python",
      "port": 8080,
      "shortcuts": {
        "title": "nginx + Python",
        "summary": "Call a real Python (wsgiref) JSON API over SQLite, proxied by nginx.",
        "groups": [
          {
            "title": "Service",
            "actions": [
              {
                "id": "curl-home",
                "label": "Fetch page",
                "description": "Fetch the static page through nginx.",
                "kind": "terminal.run",
                "payload": "curl -i http://127.0.0.1:8080/ | head -40"
              },
              {
                "id": "list-notes",
                "label": "List notes",
                "description": "GET the JSON notes list from Python.",
                "kind": "terminal.run",
                "payload": "curl -s http://127.0.0.1:8080/api/notes; echo"
              },
              {
                "id": "create-note",
                "label": "Create note",
                "description": "POST a new note as JSON.",
                "kind": "terminal.run",
                "payload": "curl -s -X POST http://127.0.0.1:8080/api/notes -H 'Content-Type: application/json' -d '{\"title\":\"Hello\",\"body\":\"from curl\"}'; echo"
              },
              {
                "id": "py-version",
                "label": "Python",
                "description": "Print the Python version.",
                "kind": "terminal.run",
                "payload": "PYTHONHOME=/usr /usr/bin/python3 --version"
              }
            ]
          }
        ],
        "script": {
          "title": "Service check",
          "language": "sh",
          "initialText": "curl -i http://127.0.0.1:8080/ | head -40\necho \"--- list notes (JSON via Python) ---\"\ncurl -s http://127.0.0.1:8080/api/notes\necho\necho \"--- create a note ---\"\ncurl -s -X POST http://127.0.0.1:8080/api/notes \\\n  -H 'Content-Type: application/json' \\\n  -d '{\"title\":\"Hello\",\"body\":\"from curl\"}'\necho"
        }
      }
    },
    {
      "id": "web-ruby",
      "title": "Ruby + Roda todo",
      "port": 8080,
      "shortcuts": {
        "title": "Ruby + Roda todo",
        "groups": []
      }
    },
    {
      "id": "web-redis",
      "title": "Redis voting board",
      "port": 8080,
      "shortcuts": {
        "title": "Redis voting board",
        "groups": []
      }
    }
  ]
}
