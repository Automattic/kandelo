{
  "version": 1,
  "image": {
    "title": "Web Stack"
  },
  "defaultProfile": "nginx-php",
  "profiles": {
    "nginx": {
      "identity": {
        "title": "nginx",
        "summary": "Static HTTP service supervised by dinit and exposed through the browser bridge.",
        "accent": "#3a8f41",
        "glyph": "nx",
        "packages": [
          "dinit@local",
          "nginx@local",
          "bash@local",
          "coreutils@local"
        ]
      },
      "runtime": {
        "requests": {
          "maxWorkers": 24,
          "memoryPages": 16384
        }
      },
      "init": {
        "program": "/bin/sh",
        "args": [
          "/sbin/kandelo-init",
          "web-static"
        ],
        "cwd": "/root",
        "uid": 0,
        "gid": 0
      },
      "web": {
        "requiredPorts": [
          8080
        ]
      },
      "presentation": {
        "bootPrimary": "syslog",
        "runningPrimary": [
          "web",
          "syslog",
          "terminal"
        ],
        "terminalAccess": "drawer",
        "internalsAccess": "drawer"
      },
      "activity": {
        "shellCommand": "/usr/local/bin/kandelo-service start web-static"
      }
    },
