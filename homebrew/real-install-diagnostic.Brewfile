# Diagnostic-only closure for real in-guest Homebrew installation.
#
# This is intentionally smaller than the shipping main-shell Brewfile. Its
# exact dependency closure plus homebrew-bootstrap is recorded in
# real-install-diagnostic.json. It must never satisfy or replace the shipping
# shell's separate complete selection lock.
tap "kandelo-dev/tap-core"

brew "kandelo-dev/tap-core/bash"
brew "kandelo-dev/tap-core/coreutils"
brew "kandelo-dev/tap-core/ruby"
brew "kandelo-dev/tap-core/git"
brew "kandelo-dev/tap-core/curl"
brew "kandelo-dev/tap-core/findutils"
brew "kandelo-dev/tap-core/gawk"
brew "kandelo-dev/tap-core/tar"
brew "kandelo-dev/tap-core/posix-utils-lite"
brew "kandelo-dev/tap-core/bzip2"
