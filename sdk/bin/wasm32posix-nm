#!/usr/bin/env bash
# SDK wrapper: runs this worktree's SDK driver (crates/kandelo-cc) as
# wasm32posix-nm. The name tells the driver which tool to be.
WASM_POSIX_INVOKED_AS=wasm32posix-nm
export WASM_POSIX_INVOKED_AS
# Follow an `npm link` symlink back to this file in the checkout.
__kandelo_self="$0"
while [ -L "$__kandelo_self" ]; do
    __kandelo_link="$(readlink "$__kandelo_self")"
    case "$__kandelo_link" in
        /*) __kandelo_self="$__kandelo_link" ;;
        *) __kandelo_self="$(dirname "$__kandelo_self")/$__kandelo_link" ;;
    esac
done
. "$(dirname "$__kandelo_self")/../src/kandelo-cc.sh"
