--- a/runtime/druntime/src/ldc/eh_asm.S
+++ b/runtime/druntime/src/ldc/eh_asm.S
@@ -54,7 +54,15 @@

 // TODO: remove this when we can link against libunwind
 #if __wasm__
+#ifdef LDC_KANDELO_WEAK_CPP_EXCEPTION_TAG
+// Kandelo: D and C++ throw with this one tag. Since LLVM 22, objects only
+// reference it, and LLVM's libunwind (Unwind-wasm.c) defines it. A D-only
+// program does not link libunwind, so DRuntime still supplies the tag; a
+// program that also links the C++ unwinder uses libunwind's definition.
+.weak __cpp_exception
+#else
 .globl __cpp_exception
+#endif

 #if defined(__wasm32__)
     .tagtype __cpp_exception i32
