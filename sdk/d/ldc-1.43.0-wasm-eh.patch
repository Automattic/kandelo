+// LLVM lowers a Wasm catch to the libunwind personality and TLS slot by
+// default. DRuntime uses a D personality and needs distinct names when an
+// executable also links the C++ unwinder.
+class KandeloDExceptionSymbols : public llvm::ModulePass {
+public:
+  static char ID;
+  KandeloDExceptionSymbols() : ModulePass(ID) {}
+
+  bool runOnModule(llvm::Module &M) override {
+    bool changed = false;
+    auto rename = [&](llvm::StringRef source, llvm::StringRef target) {
+      if (auto *symbol = M.getNamedValue(source)) {
+        if (auto *definition = M.getNamedValue(target)) {
+          symbol->replaceAllUsesWith(definition);
+          symbol->eraseFromParent();
+        } else {
+          symbol->setName(target);
+        }
+        changed = true;
+      }
+    };
+    rename("_Unwind_CallPersonality", "__ldc_d_wasm_call_personality");
+    rename("__wasm_lpad_context", "__ldc_d_wasm_lpad_context");
+    return changed;
+  }
+};
+
+char KandeloDExceptionSymbols::ID;
+
+class KandeloDCodeGenPassManager : public llvm::legacy::PassManager {
+public:
+  explicit KandeloDCodeGenPassManager(bool useDExceptionSymbols)
+      : useDExceptionSymbols(useDExceptionSymbols) {}
+
+  void add(llvm::Pass *pass) override {
+    const bool followsWasmEH = useDExceptionSymbols &&
+                              pass->getPassID() == wasmEHPrepareID();
+    llvm::legacy::PassManager::add(pass);
+    if (followsWasmEH)
+      llvm::legacy::PassManager::add(new KandeloDExceptionSymbols);
+  }
+
+private:
+  static const void *wasmEHPrepareID() {
+    static const void *id = [] {
+      std::unique_ptr<llvm::FunctionPass> pass(llvm::createWasmEHPass());
+      return pass->getPassID();
+    }();
+    return id;
+  }
+
+  bool useDExceptionSymbols;
+};
