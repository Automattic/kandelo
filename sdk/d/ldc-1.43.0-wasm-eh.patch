+# Kandelo links D with the C++ unwinder, which also defines the Wasm
+# exception tag; see src/ldc/eh_asm.S.
+if("${TARGET_SYSTEM}" MATCHES "Kandelo")
+    set_source_files_properties(${RUNTIME_DIR}/src/ldc/eh_asm.S PROPERTIES
+        COMPILE_DEFINITIONS LDC_KANDELO_WEAK_CPP_EXCEPTION_TAG)
+endif()
