# LDC 1.43.0: keep D and C++ Wasm exception handling apart in one program.
#
# Applied by sdk/d/build.sh after ldc-1.43.0-kandelo.patch.
#
# Purpose: LLVM lowers every Wasm catch to calls to
# _Unwind_CallPersonality and to the __wasm_lpad_context TLS slot.
# DRuntime defines those names itself (rt/dwarfeh.d) with the D
# personality, and LLVM's libunwind, linked with libc++abi, defines them
# with the C++ personality. A program that links both cannot link, or
# would dispatch one language's exceptions through the other's
# personality.
#
# - driver/toobj.cpp: for a Kandelo Wasm target, after LLVM's WasmEHPrepare
#   pass, rename those references in D code to __ldc_d_wasm_call_personality
#   and __ldc_d_wasm_lpad_context.
# - rt/dwarfeh.d: on Kandelo, DRuntime defines its personality, landing-pad
#   context and delete function under those private names.
# - ldc/eh_asm.S, runtime/CMakeLists.txt: D and C++ throw with the one
#   __cpp_exception tag, so a program needs exactly one definition. With
#   LLVM 22, objects only reference the tag. DRuntime's eh_asm.S defines it
#   for D-only programs, and LLVM's libunwind (Unwind-wasm.c) defines it
#   too, so linking both failed with a duplicate symbol (ldc2 itself). On
#   Kandelo, DRuntime's definition is weak and libunwind's wins.
#
# Justification: LLVM has no per-function personality for Wasm (the
# upstream TODO this patch replaces). That is a toolchain limit, not a
# Kandelo gap. sdk/d/test/mixed_exceptions.{d,cpp} cover both languages
# throwing and catching in one executable. Drop this patch when LLVM's Wasm
# EH lowering takes the personality from the function, as it does on other
# targets.
--- a/driver/toobj.cpp
+++ b/driver/toobj.cpp
@@ -34,6 +34,7 @@
 #include "llvm/Target/TargetMachine.h"
 #include "llvm/Analysis/TargetLibraryInfo.h"
 #include "llvm/Analysis/TargetTransformInfo.h"
+#include "llvm/CodeGen/Passes.h"
 #include "llvm/CodeGen/TargetSubtargetInfo.h"
 #include "llvm/Transforms/Utils/Cloning.h"
 #include "llvm/IR/Module.h"
@@ -58,6 +59,60 @@
   pm.run(m);
 }

+// LLVM lowers a Wasm catch to the libunwind personality and TLS slot by
+// default. DRuntime uses a D personality and needs distinct names when an
+// executable also links the C++ unwinder.
+class KandeloDExceptionSymbols : public llvm::ModulePass {
+public:
+  static char ID;
+  KandeloDExceptionSymbols() : ModulePass(ID) {}
+
+  bool runOnModule(llvm::Module &M) override {
+    bool changed = false;
+    auto rename = [&](llvm::StringRef source, llvm::StringRef target) {
+      if (auto *symbol = M.getNamedValue(source)) {
+        if (auto *definition = M.getNamedValue(target)) {
+          symbol->replaceAllUsesWith(definition);
+          symbol->eraseFromParent();
+        } else {
+          symbol->setName(target);
+        }
+        changed = true;
+      }
+    };
+    rename("_Unwind_CallPersonality", "__ldc_d_wasm_call_personality");
+    rename("__wasm_lpad_context", "__ldc_d_wasm_lpad_context");
+    return changed;
+  }
+};
+
+char KandeloDExceptionSymbols::ID;
+
+class KandeloDCodeGenPassManager : public llvm::legacy::PassManager {
+public:
+  explicit KandeloDCodeGenPassManager(bool useDExceptionSymbols)
+      : useDExceptionSymbols(useDExceptionSymbols) {}
+
+  void add(llvm::Pass *pass) override {
+    const bool followsWasmEH = useDExceptionSymbols &&
+                              pass->getPassID() == wasmEHPrepareID();
+    llvm::legacy::PassManager::add(pass);
+    if (followsWasmEH)
+      llvm::legacy::PassManager::add(new KandeloDExceptionSymbols);
+  }
+
+private:
+  static const void *wasmEHPrepareID() {
+    static const void *id = [] {
+      std::unique_ptr<llvm::FunctionPass> pass(llvm::createWasmEHPass());
+      return pass->getPassID();
+    }();
+    return id;
+  }
+
+  bool useDExceptionSymbols;
+};
+
