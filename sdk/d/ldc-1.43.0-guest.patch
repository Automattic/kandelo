# LDC 1.43.0: build the compiler itself as a Kandelo guest program.
#
# Applied only by sdk/d/build-guest.sh, to a copy of the source that
# sdk/d/build.sh has already patched. These changes only affect building
# ldc2 as a wasm32 program; programs that ldc2 compiles are unaffected.
#
# - CMakeLists.txt: a cross build cannot run the target LLVM's llvm-config.
#   With CMAKE_CROSSCOMPILING and LLVM_DIR, take libraries and include
#   paths from the target LLVM's CMake package instead, and link only the
#   targets that LLVM was built with (WebAssembly) rather than
#   `all-targets`. A native build is unchanged.
# - dmd/target.d: defaultTargetOS() names the OS the compiler runs on and
#   has no case for Kandelo, so compiling it stops at `unknown TARGET`.
#   LDC never calls it, because it sets the target from the LLVM triple,
#   so it is left out of LDC builds.
# - dmd/root/dcompat.h, gen/ctfloat.cpp: on wasm32, C++ size_t is
#   `unsigned long` but D size_t is `uint`, so their mangled names differ
#   and the frontend's D and C++ halves do not link. Use the same d_size_t
#   mapping upstream already uses for 32-bit Apple targets.
# - cmake/Modules/BuildDExecutable.cmake: rebuild D objects when the host D
#   compiler changes. Otherwise objects built by an earlier host compiler
#   (for example, before the D SDK was rebuilt) are reused silently.
#
# Justification: these are cross-compilation portability fixes in LDC's
# build, not Kandelo platform gaps. The d_size_t and target.d changes are
# candidates for upstream; this patch stays until an LDC release in use
# includes equivalents.
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -29,13 +29,28 @@
 # Locate LLVM.
 #

-find_package(LLVM 18.0 REQUIRED
+set(ldc_llvm_components
-    all-targets analysis asmparser asmprinter bitreader bitwriter codegen core
+    analysis asmparser asmprinter bitreader bitwriter codegen core
     debuginfodwarf debuginfomsf debuginfopdb demangle
     instcombine ipo instrumentation irreader libdriver linker lto mc
     mcdisassembler mcparser objcarcopts object option profiledata scalaropts
     selectiondag support tablegen target transformutils vectorize
     windowsdriver windowsmanifest symbolize ${EXTRA_LLVM_MODULES})
+if(CMAKE_CROSSCOMPILING AND LLVM_DIR)
+    # A target LLVM's llvm-config cannot be executed by the build machine.
+    # Its CMake package exposes the same target library and include paths.
+    find_package(LLVM REQUIRED CONFIG)
+    if(LLVM_PACKAGE_VERSION VERSION_LESS 18.0)
+        message(FATAL_ERROR "LLVM 18.0 or newer is required")
+    endif()
+    set(LLVM_VERSION_STRING "${LLVM_PACKAGE_VERSION}")
+    llvm_map_components_to_libnames(LLVM_LIBRARIES ${LLVM_TARGETS_TO_BUILD} ${ldc_llvm_components})
+    include_directories(SYSTEM ${LLVM_INCLUDE_DIRS})
+    set(LLVM_CXXFLAGS "-fno-rtti")
+    set(LLVM_IS_SHARED OFF)
+else()
+    find_package(LLVM 18.0 REQUIRED all-targets ${ldc_llvm_components})
+endif()
 message(STATUS "Using LLVM Version ${LLVM_VERSION_MAJOR}.${LLVM_VERSION_MINOR}")
 # Remove LLVMTableGen library from list of libraries
 string(REGEX MATCH "[^;]*LLVMTableGen[^;]*" LLVM_TABLEGEN_LIBRARY "${LLVM_LIBRARIES}")
--- a/dmd/target.d
+++ b/dmd/target.d
@@ -55,6 +55,8 @@
     native              // the machine the compiler is being run on
 }

+// LDC initializes the target from the LLVM triple.
+version (IN_LLVM) {} else
 Target.OS defaultTargetOS() @safe
 {
     version (Windows)
--- a/dmd/root/dcompat.h
+++ b/dmd/root/dcompat.h
@@ -36,7 +36,7 @@
 };

 /// Corresponding C++ type that maps to D size_t
-#if __APPLE__ && (__i386__ || __ppc__)
+#if (__APPLE__ && (__i386__ || __ppc__)) || defined(__wasm32__)
 // size_t is 'unsigned long', which makes it mangle differently than D's 'uint'
 typedef unsigned d_size_t;
 #elif MARS && DMD_VERSION >= 2079 && DMD_VERSION <= 2081 && \
