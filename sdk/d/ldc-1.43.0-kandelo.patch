+// Record native language exception payloads before entering a common cleanup.
+// Other exception tags enter the same cleanup by unwinding around the probe.
+static llvm::BasicBlock *probeWasmException(IRState &irs,
+                                           llvm::Value *parent,
+                                           llvm::BasicBlock *cleanup,
+                                           llvm::AllocaInst *slot) {
+  auto *dispatch = irs.insertBB("cleanup.exception.dispatch");
+  auto *caught = irs.insertBB("cleanup.exception.probe");
+  auto *unreachable = irs.insertBB("cleanup.exception.unreachable");
+  auto *switchPad = llvm::CatchSwitchInst::Create(parent, cleanup, 1, "", dispatch);
+  switchPad->addHandler(caught);
+  irs.ir->SetInsertPoint(caught);
+  auto *catchPad = irs.ir->CreateCatchPad(switchPad, {getNullPtr()});
+  auto *exception = irs.ir->CreateCall(GET_INTRINSIC_DECL(wasm_get_exception, {}),
+                                      catchPad);
+  irs.ir->CreateStore(exception, slot);
+  irs.ir->CreateInvoke(GET_INTRINSIC_DECL(wasm_rethrow, {}), unreachable,
+                       cleanup, {}, {llvm::OperandBundleDef("funclet", catchPad)});
+  irs.ir->SetInsertPoint(unreachable);
+  irs.ir->CreateUnreachable();
+  return dispatch;
+}
