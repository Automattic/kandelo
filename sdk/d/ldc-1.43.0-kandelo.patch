+llvm::BasicBlock *
+TryCatchFinallyScopes::runKandeloWasmCleanup(CleanupCursor scope,
+                                            llvm::BasicBlock *unwindTo) {
+  if (isCatchSwitchBlock(cleanupScopes[scope].beginBlock()))
+    return cleanupScopes[scope].beginBlock();
+
+  const auto savedInsertPoint = irs.saveInsertPoint();
+  auto *slot = DtoRawAlloca(getOpaquePtrType(), 0, "cleanup.exception");
+  irs.ir->SetInsertPoint(slot->getParent(), std::next(slot->getIterator()));
+  irs.ir->CreateStore(getNullPtr(), slot);
+
+  auto *cleanup = irs.insertBB("cleanuppad");
+  auto *replacement = irs.insertBB("cleanup.replacement");
+  auto *resume = irs.insertBB("cleanupret");
+  auto *root = llvm::ConstantTokenNone::get(irs.context());
+  auto *cleanupPad = llvm::CleanupPadInst::Create(root, {}, "", cleanup);
+  auto *replacePad = llvm::CleanupPadInst::Create(cleanupPad, {}, "", replacement);
+  llvm::CleanupReturnInst::Create(cleanupPad, unwindTo, resume);
+
+  auto *dispatch = probeWasmException(irs, root, cleanup, slot);
+  auto *escape = probeWasmException(irs, cleanupPad, replacement, slot);
+  irs.ir->SetInsertPoint(cleanup);
+  auto *original = irs.ir->CreateLoad(getOpaquePtrType(), slot);
+  irs.ir->CreateStore(getNullPtr(), slot);
+  auto *body = cleanupScopes[scope].runCopying(irs, cleanup, resume, escape,
+                                               cleanupPad);
+  createBranch(body, cleanup);
+
+  irs.ir->SetInsertPoint(replacement);
+  auto *escaping = irs.ir->CreateLoad(getOpaquePtrType(), slot);
