 #ifndef IN_JITRT
+// A Wasm thread running a loop can otherwise go indefinitely without reaching
+// Kandelo's signal delivery code. Insert calls before spilling potential GC
+// roots so suspended threads expose live pointers to the collector.
+struct KandeloSafepoints : PassInfoMixin<KandeloSafepoints> {
+  PreservedAnalyses run(llvm::Module &module, ModuleAnalysisManager &manager) {
+    FunctionCallee poll;
+    bool preparedFunclets = false;
+    for (Function &function : module) {
+      if (function.isDeclaration())
+        continue;
+      SmallVector<std::pair<const BasicBlock *, const BasicBlock *>, 16> edges;
+      FindFunctionBackedges(function, edges);
+      if (edges.empty())
+        continue;
+
+      DenseMap<BasicBlock *, ColorVector> colors;
+      if (function.hasPersonalityFn() &&
+          isScopedEHPersonality(classifyEHPersonality(function.getPersonalityFn()))) {
+        colors = colorEHFunclets(function);
+        if (llvm::any_of(edges, [&](const auto &edge) {
+              const auto color = colors.find(const_cast<BasicBlock *>(edge.first));
+              return color != colors.end() && color->second.size() > 1;
+            })) {
+          // Give shared latches distinct funclet copies before adding calls.
+          // This is the same preparation used by the Wasm backend.
+          auto &functions = manager
+              .getResult<FunctionAnalysisManagerModuleProxy>(module)
+              .getManager();
+          auto preserved = WinEHPreparePass(/*DemoteCatchSwitchPHIOnly=*/true)
+                               .run(function, functions);
+          functions.invalidate(function, preserved);
+          preparedFunclets = true;
+          colors = colorEHFunclets(function);
+          edges.clear();
+          FindFunctionBackedges(function, edges);
+        }
+      }
+
+      SmallPtrSet<BasicBlock *, 16> latches;
+      for (const auto &edge : edges) {
+        auto *latch = const_cast<BasicBlock *>(edge.first);
+        if (!latches.insert(latch).second)
+          continue;
+        Instruction *terminator = latch->getTerminator();
+        // An exception dispatch block cannot contain a call. A loop through
+        // its handlers has a throwing instruction on its unwind path.
+        if (isa<CatchSwitchInst>(terminator))
+          continue;
+        if (!poll.getCallee())
+          poll = module.getOrInsertFunction("__ldc_kandelo_gc_safepoint",
+                                           llvm::Type::getVoidTy(module.getContext()));
+        SmallVector<OperandBundleDef, 1> bundles;
+        if (auto color = colors.find(latch); color != colors.end()) {
+          assert(color->second.size() == 1 && "safepoint latch has an ambiguous funclet");
+          auto *entry = color->second.front();
+          if (entry != &function.getEntryBlock()) {
+            auto *pad = cast<FuncletPadInst>(&*entry->getFirstNonPHIIt());
+            bundles.emplace_back("funclet", pad);
+          }
+        }
+        IRBuilder<> builder(terminator);
+        builder.CreateCall(poll, {}, bundles)->setDoesNotThrow();
+      }
+    }
+    return poll.getCallee() || preparedFunclets ? PreservedAnalyses::none()
+                                               : PreservedAnalyses::all();
+  }
+};
