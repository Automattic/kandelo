+        if (llvm::isa<llvm::ConstantTokenNone>(pad->getParentPad()))
+          pad->setParentPad(parent);
+      } else if (auto *ret = llvm::dyn_cast<llvm::CleanupReturnInst>(inst)) {
+        if (!ret->hasUnwindDest()) {
