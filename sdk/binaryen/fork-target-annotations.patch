+WasmBinaryWriter::getKandeloForkTargetsBuffer() {
+  return writeExpressionHints(
+    Name("metadata.code.kandelo.fork-targets"),
+    [](const CodeAnnotation& a) { return !a.kandeloForkTargets.empty(); },
+    [](const CodeAnnotation& a, BufferWithRandomAccess& buffer) {
+      BufferWithRandomAccess payload;
+      for (auto value : a.kandeloForkTargets) {
+        payload << U32LEB(value);
+      }
+      buffer << U32LEB(payload.size());
+      buffer.insert(buffer.end(), payload.begin(), payload.end());
+    });
 }
 
