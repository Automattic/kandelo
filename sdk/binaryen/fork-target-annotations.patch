+void WasmBinaryReader::readKandeloForkTargets(size_t payloadLen) {
+  readExpressionHints(Name("metadata.code.kandelo.fork-targets"), payloadLen,
+    [&](CodeAnnotation& a) {
+      auto size = getU32LEB();
+      if (size > input.size() - pos || !size || !a.kandeloForkTargets.empty()) {
+        throwError("bad or duplicate Kandelo fork targets");
+      }
+      auto end = pos + size;
+      while (pos < end) {
+        a.kandeloForkTargets.push_back(getU32LEB());
+      }
+      auto& values = a.kandeloForkTargets;
+      if (pos != end || values[0] > 1 ||
+          (values[0] == 0 && values.size() != 2)) {
+        throwError("bad Kandelo fork target payload");
+      }
+    });
+}
