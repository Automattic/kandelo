+// Kandelo's optional correctness-metadata extension for Binaryen 126.
+// Default-deny preservation: unsupported passes cannot emit stale restrictions.
+#ifndef wasm_ir_fork_target_metadata_h
+#define wasm_ir_fork_target_metadata_h
+#include "support/utilities.h"
+#include "wasm-traversal.h"
+#include "wasm.h"
+#include <atomic>
+#include <mutex>
+#include <set>
+#include <sstream>
+
+namespace wasm {
+class ForkTargetMetadata : public PassMetadataObserver {
+  Module& module;
+  bool strict;
+  std::atomic<bool> valid{true};
+  std::mutex mutex;
+  std::set<std::string> preserved, invalidated;
+
+  struct Count : PostWalker<Count> {
+    Function* func;
+    size_t calls = 0, known = 0;
+    Count(Function* func) : func(func) { walk(func->body); }
+    void visitCallIndirect(CallIndirect* curr) {
+      ++calls;
+      auto it = func->codeAnnotations.find(curr);
+      known += it != func->codeAnnotations.end() &&
+               !it->second.kandeloForkTargets.empty();
+    }
+  };
+
+public:
+  ForkTargetMetadata(Module& module, bool strict)
+    : module(module), strict(strict) {}
+  void beforePass(const std::string& name,
+                  bool preserves,
+                  Function* function = nullptr) override {
+    auto label = name.empty() ? std::string("anonymous-pass") : name;
+    if (!preserves && strict) {
+      Fatal() << "Kandelo fork facts: unaudited pass " << label << "\n";
+    }
+    std::lock_guard<std::mutex> lock(mutex);
+    (preserves ? preserved : invalidated).insert(label);
+    if (!preserves)
+      valid.store(false, std::memory_order_relaxed);
+    // Clear restrictions before unsupported rewrites, including module swaps
+    // that might otherwise discard the observer itself. Function-parallel
+    // callbacks mutate only their own function; module callbacks run serially.
+    if (!preserves || (!function && !valid.load(std::memory_order_relaxed))) {
+      auto clear = [](Function* f) {
+        for (auto& [expr, annotation] : f->codeAnnotations) {
+          annotation.kandeloForkTargets.clear();
+        }
+      };
+      if (function)
+        clear(function);
+      else
+        for (auto& f : module.functions)
+          clear(f.get());
+    }
+  }
+  bool canEmit(const std::string&) const override {
+    return valid.load(std::memory_order_relaxed);
+  }
+  void finish(Module& module) override {
+    size_t calls = 0, known = 0;
+    for (auto& func : module.functions) {
+      if (func->imported())
+        continue;
+      Count count(func.get());
+      calls += count.calls;
+      known += count.known;
+    }
+    if (!canEmit(""))
+      known = 0;
+    std::ostringstream report;
+    report << "v1\nvalid\t" << canEmit("") << "\ncurrent-calls\t" << calls
+           << "\nretained\t" << known << "\n";
+    // Sorted pass dispositions are deterministic under function parallelism.
+    // These summarize preservation decisions; they are not a rewrite history.
+    for (auto& name : preserved)
+      report << "preserves\t" << name << "\n";
+    for (auto& name : invalidated)
+      report << "invalidates-all\t" << name << "\n";
+    auto text = report.str();
+    module.customSections.erase(
+      std::remove_if(
+        module.customSections.begin(),
+        module.customSections.end(),
+        [](auto& s) { return s.name == "kandelo.fork-facts.report"; }),
+      module.customSections.end());
+    module.customSections.push_back(
+      CustomSection{"kandelo.fork-facts.report",
+                    std::vector<char>(text.begin(), text.end())});
+    std::cerr << "Kandelo fork facts: retained " << known << "/" << calls
+              << " call target annotations; preservation=" << canEmit("")
+              << "\n";
+  }
+};
