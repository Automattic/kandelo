set(CMAKE_SYSTEM_NAME Kandelo)
set(CMAKE_SYSTEM_PROCESSOR "${KANDELO_SDK_ARCH}")

set(CMAKE_C_COMPILER ${KANDELO_SDK_ARCH}posix-cc)
set(CMAKE_CXX_COMPILER ${KANDELO_SDK_ARCH}posix-c++)
set(CMAKE_AR ${KANDELO_SDK_ARCH}posix-ar)
set(CMAKE_RANLIB ${KANDELO_SDK_ARCH}posix-ranlib)
set(CMAKE_NM ${KANDELO_SDK_ARCH}posix-nm)
set(CMAKE_STRIP ${KANDELO_SDK_ARCH}posix-strip)

# WHY: a static archive can contain unresolved references, so CMake's
# function and library checks must link an executable through the SDK.
set(CMAKE_TRY_COMPILE_TARGET_TYPE EXECUTABLE)
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

if(DEFINED ENV{WASM_POSIX_SYSROOT})
  set(CMAKE_SYSROOT "$ENV{WASM_POSIX_SYSROOT}")
  set(CMAKE_FIND_ROOT_PATH "$ENV{WASM_POSIX_SYSROOT}")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
