+  memcpy(header, "KDS1", 4);
+  write32le(header + 4, kandeloDynsym.size());
+  write32le(header + 8, kandeloSymbols.size());
+  size_t nameOffset = 16 + kandeloSymbols.size() * 16;
+  uint8_t *row = header + 16;
+  for (const KandeloSymbol &entry : kandeloSymbols) {
+    uint64_t value;
+    uint32_t kind;
+    if (auto *f = dyn_cast<DefinedFunction>(entry.symbol)) {
+      if (!ctx.sym.indirectFunctionTable)
+        ctx.sym.indirectFunctionTable =
+            symtab->resolveIndirectFunctionTable(/*required=*/true);
+      if (!ctx.sym.indirectFunctionTable)
+        return;
+      out.elemSec->addEntry(f);
+      value = f->getTableIndex();
+      kind = 1;
+    } else {
+      auto *d = cast<DefinedData>(entry.symbol);
+      value = d->getVA();
+      kind = d->isTLS() ? 3 : 2;
+    }
+    write32le(row, nameOffset);
+    write32le(row + 4, kind);
+    write64le(row + 8, value);
+    memcpy(header + nameOffset, entry.name.data(), entry.name.size());
+    nameOffset += entry.name.size() + 1;
+    row += 16;
+  }
+}
