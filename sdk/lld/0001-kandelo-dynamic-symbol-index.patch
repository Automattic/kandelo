+void Writer::writeKandeloDynsym() {
+  if (kandeloDynsym.empty())
+    return;
+
+  // All existing address-taken functions have slots after relocation scanning.
+  // ElemSection adds slots for the remaining dynamic exports and deduplicates
+  // aliases of an already indexed InputFunction.
+  using namespace llvm::support::endian;
