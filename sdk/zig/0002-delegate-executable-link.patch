+// Use the SDK's executable link, including its CRT, libc, Wasm ABI flags and
+// post-link stamping. Pass the same relocatable inputs as the LLD path.
+fn kandeloLink(
+    lld: *Lld,
+    arena: Allocator,
+    full_out_path: []const u8,
+    zcu_obj_path: ?Cache.Path,
+    compiler_rt_path: ?Cache.Path,
+    ubsan_rt_path: ?Cache.Path,
+) !void {
+    const comp = lld.base.comp;
+    const io = comp.io;
+    const wasm = &lld.ofmt.wasm;
+    var argv: std.ArrayList([]const u8) = .empty;
+    try argv.appendSlice(arena, &.{ "wasm32posix-cc", "-o", full_out_path });
+    if (wasm.explicit_stack_size) |size|
+        try argv.append(arena, try arena.print("-Wl,-z,stack-size={d}", .{size}));
+    for (wasm.export_symbol_names) |name|
+        try argv.append(arena, try arena.print("-Wl,--export={s}", .{name}));
+
+    for (comp.link_inputs) |input| switch (input) {
+        .object, .archive => |obj| {
+            if (obj.must_link) try argv.append(arena, "-Wl,--whole-archive");
+            try argv.append(arena, try obj.path.toString(arena));
+            if (obj.must_link) try argv.append(arena, "-Wl,--no-whole-archive");
+        },
+        else => return comp.link_diags.fail("Kandelo executable links require static archives and objects", .{}),
+    };
+    for (comp.c_objects.items) |obj|
+        try argv.append(arena, try obj.status.success.object_path.toString(arena));
+    for ([_]?Cache.Path{ zcu_obj_path, compiler_rt_path, ubsan_rt_path }) |path| {
+        if (path) |p| try argv.append(arena, try p.toString(arena));
+    }
+
+    if (comp.verbose_link) try Compilation.dumpArgv(io, argv.items);
+    const result = std.process.run(arena, io, .{ .argv = argv.items }) catch |err| switch (err) {
+        error.OutOfMemory, error.Canceled => |e| return e,
+        else => return comp.link_diags.fail("could not run wasm32posix-cc: {t}", .{err}),
+    };
+    if (result.term != .exited or result.term.exited != 0)
+        return comp.link_diags.fail("wasm32posix-cc failed:\n{s}", .{result.stderr});
+    if (result.stderr.len != 0) log.warn("wasm32posix-cc:\n{s}", .{result.stderr});
+}
