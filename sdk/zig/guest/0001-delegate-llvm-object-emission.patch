+// Zig serializes LLVM bitcode itself. The SDK's Clang lowers it to a
+// relocatable object so the compiler executable can run without libLLVM.
+fn emitKandeloObject(comp: *Compilation, output: []const u8, bitcode: []const u8) link.Error!void {
+    const gpa = comp.gpa;
+    const io = comp.io;
+    const input = try std.fmt.allocPrint(gpa, "{s}.bc", .{output});
+    defer gpa.free(input);
+
+    const cwd: Io.Dir = .cwd();
+    {
+        const file = cwd.createFile(io, input, .{}) catch |err|
+            return comp.link_diags.fail("could not create SDK bitcode input: {t}", .{err});
+        defer file.close(io);
+        errdefer cwd.deleteFile(io, input) catch {};
+        file.writeStreamingAll(io, bitcode) catch |err|
+            return comp.link_diags.fail("could not write SDK bitcode input: {t}", .{err});
+    }
+    defer cwd.deleteFile(io, input) catch {};
+
+    const optimize: []const u8 = switch (comp.root_mod.optimize_mode) {
+        .debug => "-O0",
+        .safe, .fast => "-O3",
+        .small => "-Oz",
+    };
+    const argv = &.{ "wasm32posix-cc", "-c", "-x", "ir", optimize,
+        "-Wno-override-module", "-Wno-unused-command-line-argument", input, "-o", output };
+    const result = std.process.run(gpa, io, .{ .argv = argv }) catch |err| switch (err) {
+        error.OutOfMemory, error.Canceled => |e| return e,
+        else => return comp.link_diags.fail("could not run the Kandelo SDK backend: {t}", .{err}),
+    };
+    defer gpa.free(result.stdout);
+    defer gpa.free(result.stderr);
+    if (result.term != .exited or result.term.exited != 0)
+        return comp.link_diags.fail("Kandelo SDK object emission failed:\n{s}", .{result.stderr});
+    if (result.stderr.len != 0) log.warn("Kandelo SDK object emission:\n{s}", .{result.stderr});
+}
+
