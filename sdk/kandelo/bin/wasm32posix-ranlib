#!/bin/bash
set -euo pipefail

LLVM_DIR="${WASM_POSIX_LLVM_DIR:-/opt/kandelo/homebrew/opt/clang/libexec/llvm}"
TOOL="$LLVM_DIR/bin/llvm-ranlib"
[[ -x "$TOOL" ]] || {
  echo "wasm32posix-ranlib: missing $TOOL; set WASM_POSIX_LLVM_DIR to a complete LLVM toolchain root" >&2
  exit 1
}
exec "$TOOL" "$@"
