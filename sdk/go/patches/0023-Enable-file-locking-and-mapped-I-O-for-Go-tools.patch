 // license that can be found in the LICENSE file.
 
-//go:build darwin || dragonfly || freebsd || illumos || linux || netbsd || openbsd
+//go:build darwin || dragonfly || freebsd || illumos || kandelo || linux || netbsd || openbsd
 
 package filelock
 
diff --git a/src/syscall/mmap_kandelo.go b/src/syscall/mmap_kandelo.go
--- a/src/syscall/mmap_kandelo.go
+++ b/src/syscall/mmap_kandelo.go
@@ -11,6 +11,7 @@ const (
 	PROT_READ  = 1
 	PROT_WRITE = 2
 
+	MAP_FILE      = 0
