+	case OpWordBoundary:
+		f = c.empty(EmptyWordBoundary)
+	case OpNoWordBoundary:
+		f = c.empty(EmptyNoWordBoundary)
+	default:
+		panic("regexp: unhandled case in compile")
+	}
+	return f
