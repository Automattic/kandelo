diff --git a/src/regexp/syntax/compile_equivalence_test.go b/src/regexp/syntax/compile_equivalence_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..f1527bdca7df426cefe00d5edc2a9dc718188856
--- /dev/null
+++ b/src/regexp/syntax/compile_equivalence_test.go
@@ -0,0 +1,148 @@
+// Copyright 2026 The Go Authors. All rights reserved.
