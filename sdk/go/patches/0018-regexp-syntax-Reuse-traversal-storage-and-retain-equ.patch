+func (c *compiler) compileLeaf(re *Regexp) frag {
+	var f frag
+	switch re.Op {
+	case OpNoMatch:
+		f = c.fail()
+	case OpEmptyMatch:
+		f = c.nop()
+	case OpLiteral:
+		if len(re.Rune) == 0 {
+			f = c.nop()
+			break
+		}
+		for j := range re.Rune {
+			f1 := c.rune(re.Rune[j:j+1], re.Flags)
+			if j == 0 {
+				f = f1
+			} else {
+				f = c.cat(f, f1)
+			}
+		}
+	case OpCharClass:
+		f = c.rune(re.Rune, re.Flags)
+	case OpAnyCharNotNL:
+		f = c.rune(anyRuneNotNL, 0)
+	case OpAnyChar:
+		f = c.rune(anyRune, 0)
+	case OpBeginLine:
+		f = c.empty(EmptyBeginLine)
+	case OpEndLine:
+		f = c.empty(EmptyEndLine)
+	case OpBeginText:
+		f = c.empty(EmptyBeginText)
+	case OpEndText:
