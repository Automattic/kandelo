From 482ca0e533d67bedb9710c3397af90f13a3f3d86 Mon Sep 17 00:00:00 2001
From: Zxilly <zhouxinyu1001@gmail.com>
Date: Mon, 7 Sep 2026 20:00:06 +0800
Subject: [PATCH 04/22] internal/goarch, cmd/internal/sys: define the wasm32
 architecture

Define wasm32 with 4-byte pointers and ints, 8-byte integer registers,
and 8-byte stack and int64 alignment. Use the WebAssembly architecture
family and expose the same layout through go/types and the compiler's
type checker.

Platform registration follows in a later CL.

Updates #63131

Change-Id: If9b327399ea5fd5e070161cc1f13550795679f33

diff --git a/src/cmd/compile/internal/types2/sizeof_test.go b/src/cmd/compile/internal/types2/sizeof_test.go
index e2fce819aaf28ee350e0c54b1639f54ab46b3e87..9ce77b735f26f2bbcedddd677ee4e20235f2c0ad 100644
--- a/src/cmd/compile/internal/types2/sizeof_test.go
+++ b/src/cmd/compile/internal/types2/sizeof_test.go
@@ -13,6 +13,9 @@ import (
 
 func TestSizeof(t *testing.T) {
 	const _64bit = ^uint(0)>>32 != 0
+	// wasm32 has 32-bit pointers with 8-byte alignment for uint64.
+	_wasm32 := reflect.TypeFor[uintptr]().Size() == 4 &&
+		reflect.TypeFor[uint64]().Align() == 8
 
 	// Objects and Scope each have two position fields (syntax.Pos vs token.Pos),
 	// which accounts for 16 extra bytes in types2 on both 32-bit and 64-bit platforms.
@@ -63,6 +66,11 @@ func TestSizeof(t *testing.T) {
 		want := test._32bit
 		if _64bit {
 			want = test._64bit
+		} else if _wasm32 {
+			switch test.val.(type) {
+			case TypeParam:
+				want = 32
+			}
 		}
 		if got != want {
 			t.Errorf("unsafe.Sizeof(%T) = %d, want %d", test.val, got, want)
