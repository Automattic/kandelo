Translate byte offsets in Go’s syscall.Mmap into the existing Kandelo
mmap2 channel units. Exercise a nonzero offset in both shared and private
mappings, which the linker uses when reading Go archive members.

diff --git a/src/syscall/mmap_kandelo.go b/src/syscall/mmap_kandelo.go
index 33a3299a..34ccb1a6 100644
--- a/src/syscall/mmap_kandelo.go
+++ b/src/syscall/mmap_kandelo.go
@@ -28,10 +28,12 @@ var kandeloMappings = struct {
 }{lengths: make(map[uintptr]int)}
 
 func Mmap(fd int, offset int64, length int, prot int, flags int) ([]byte, error) {
-	if length <= 0 {
+	// The Kandelo syscall channel uses mmap2 offsets in 4 KiB units.
+	const offsetUnit = 4096
+	if length <= 0 || offset < 0 || offset%offsetUnit != 0 {
 		return nil, EINVAL
 	}
-	address, errno := kandeloSyscall6(kSysMmap, 0, int64(length), int64(prot), int64(flags), int64(fd), offset)
+	address, errno := kandeloSyscall6(kSysMmap, 0, int64(length), int64(prot), int64(flags), int64(fd), offset/offsetUnit)
 	if errno != 0 {
 		return nil, kandeloErrno(errno)
 	}
