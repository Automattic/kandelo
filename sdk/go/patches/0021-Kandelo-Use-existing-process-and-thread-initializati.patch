+	MOVD $runtime·kandeloThreadExitFrame(SB), R0
+	Get R0
+	I32WrapI64
+	Set SP
 	I32Const $0
-	Call runtime·kernelThreadExit(SB)
-#endif
+	I32AtomicStore
+	I32Const $0
+	Call runtime·kernelExit(SB)
 	UNDEF
+#else
+TEXT runtime·exitThread(SB), NOSPLIT, $0-0
+	UNDEF
+#endif
 
