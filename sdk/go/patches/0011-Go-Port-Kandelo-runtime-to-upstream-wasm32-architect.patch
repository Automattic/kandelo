+
+func Pipe2(fd []int, flags int) error {
+	if len(fd) < 2 {
+		return EINVAL
+	}
+	var pair [2]int32
+	_, errno := kandeloSyscall6(kSysPipe2, int64(uintptr(unsafe.Pointer(&pair[0]))), int64(flags), 0, 0, 0, 0)
+	runtime.KeepAlive(&pair)
