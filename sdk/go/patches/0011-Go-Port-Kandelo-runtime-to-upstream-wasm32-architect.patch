+type Stat_t struct {
+	Dev      uint64
+	Ino      uint64
+	Rdev     uint64
+	Filetype uint8
+	Nlink    uint64
+	Size     uint64
+	Atime    uint64
+	Mtime    uint64
+	Ctime    uint64
