+}
+
+func TestSDKTLSRelocation(t *testing.T) {
+	path := os.Getenv("KANDELO_WASM_TLS_RELOCATION_OBJECT")
+	if path == "" {
+		t.Skip("set KANDELO_WASM_TLS_RELOCATION_OBJECT to an SDK object with a TLS CODE relocation")
+	}
