From 5e196a61a223f2590d576909992bea8803d770f9 Mon Sep 17 00:00:00 2001
From: Zxilly <zhouxinyu1001@gmail.com>
Date: Mon, 7 Sep 2026 20:00:47 +0800
Subject: [PATCH 10/22] all: enable the wasip1/wasm32 port

Enable GOOS=wasip1 GOARCH=wasm32 in the build and test tools. Support
GOWASM options and use internal linking for -buildmode=c-shared WASI
reactors. Reuse the existing WASI execution wrapper.

Document the new port and extend compiler and WASI tests to wasm32.

Updates #63131

Change-Id: I5c536a5712a66c53c5e582f4e1660a5570e4990d

diff --git a/doc/next/7-ports.md b/doc/next/7-ports.md
index 8bea3f8fbc33f90f98bd40929a4a3a2fccb7481c..dfb5fd4df7ce52e62839bddc499a765a733e815b 100644
--- a/doc/next/7-ports.md
+++ b/doc/next/7-ports.md
@@ -1,2 +1,6 @@
 ## Ports {#ports}
 
+### WebAssembly {#wasm32}
+
+Go supports `GOARCH=wasm32` with `GOOS=wasip1`.
+The new architecture uses 32-bit pointers and `int` values.
diff --git a/lib/wasm/go_wasip1_wasm32_exec b/lib/wasm/go_wasip1_wasm32_exec
new file mode 100755
index 0000000000000000000000000000000000000000..b3bb1e13e4b6f891a52b45a0a2949d319e2e073b
--- /dev/null
+++ b/lib/wasm/go_wasip1_wasm32_exec
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+# Copyright 2026 The Go Authors. All rights reserved.
+# Use of this source code is governed by a BSD-style
+# license that can be found in the LICENSE file.
+
+SOURCE="${BASH_SOURCE[0]}"
+while [ -h "$SOURCE" ]; do
+	DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
+	SOURCE="$(readlink "$SOURCE")"
+	[[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
+done
+DIR="$( cd -P "$( dirname "$SOURCE" )" && pwd )"
+exec "$DIR/go_wasip1_wasm_exec" "$@"
