diff --git a/src/runtime/mem_wasm32.go b/src/runtime/mem_wasm32.go
new file mode 100644
index 0000000000000000000000000000000000000000..93782a5e7a09189af9bd2a92c66a19bcbe3d10ee
--- /dev/null
+++ b/src/runtime/mem_wasm32.go
@@ -0,0 +1,33 @@
+// Copyright 2023 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import "unsafe"
+
+func sbrk(n uintptr) unsafe.Pointer {
+	bl := bloc
+	if n > ^uintptr(0)-(physPageSize-1) {
+		return nil
+	}
+	n = memRound(n)
+	if n > ^uintptr(0)-bl {
+		return nil
+	}
+	if bl+n > blocMax {
+		grow := (bl + n - blocMax) / physPageSize
+		size := growMemory(int32(grow))
+		if size < 0 {
+			return nil
+		}
+		resetMemoryDataView()
+		blocMax = bl + n
+	}
+	bloc += n
+	return unsafe.Pointer(bl)
+}
+
+// Implemented in src/runtime/sys_wasm32.s
+func growMemory(pages int32) int32
+func currentMemory() int32
