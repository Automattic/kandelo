+			I32Const $2
+			I32Shl
+			I32Add
+			I32Load $0
+			I32Sub
+
+			Get R0 // PC_F
+			CallIndirect $0
+			Drop
+
+			Get PAUSE
+			I32Eqz
+			BrIf loop
+		End
+	End
