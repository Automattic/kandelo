@@ -86,76 +86,114 @@ func (c *compiler) init() {
 var anyRuneNotNL = []rune{0, '\n' - 1, '\n' + 1, unicode.MaxRune}
 var anyRune = []rune{0, unicode.MaxRune}
 
+type compileFrame struct {
+	re   *Regexp
+	next int
+	f    frag
+}
+
 func (c *compiler) compile(re *Regexp) frag {
