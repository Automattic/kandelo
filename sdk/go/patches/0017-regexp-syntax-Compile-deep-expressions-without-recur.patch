+	// Simplify can create deep expressions from counted repetitions. Use an
+	// explicit stack so compiling them does not require deep call stacks.
+	var inline [8]compileFrame
+	stack := inline[:0]
+	var f frag
+compile:
+	for {
+		switch re.Op {
+		case OpNoMatch:
+			f = c.fail()
+		case OpEmptyMatch:
+			f = c.nop()
+		case OpLiteral:
+			if len(re.Rune) == 0 {
