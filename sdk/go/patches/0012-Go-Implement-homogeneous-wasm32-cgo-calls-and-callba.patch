 	importedGlobals uint64
 	globalValues    []uint64
 	globalExports   map[string]uint64
@@ -165,9 +166,11 @@ func (module *wasmDebugModule) readImports(section []byte) error {
 		return err
 	}
 	for range count {
-		if _, err := wasmBytes(section, &offset); err != nil {
+		name, err := wasmBytes(section, &offset)
+		if err != nil {
 			return err
 		}
+		module.importModules = append(module.importModules, string(name))
 		if _, err := wasmBytes(section, &offset); err != nil {
 			return err
 		}
@@ -283,6 +286,14 @@ func (module *wasmDebugModule) readData(section []byte) error {
 		if err != nil {
 			return err
 		}
+		if mode == 1 {
+			// Passive bytes have no address until memory.init executes. Parse
+			// their payload but do not expose them as initialized constants.
+			if _, err := wasmBytes(section, &offset); err != nil {
+				return err
+			}
+			continue
+		}
 		if mode == 2 {
 			memoryIndex, err := wasmUnsigned(section, &offset)
 			if err != nil || memoryIndex != 0 {
@@ -366,3 +377,14 @@ func (module *wasmDebugModule) constants(count int) ([]int64, []float64, []strin
 	}
 	return integers, floats, strings, nil
 }
+
+// checkStaticImports rejects native dynamic-library bindings: Kandelo cgo
+// links C archives into one module and resolves these host namespaces itself.
+func (module *wasmDebugModule) checkStaticImports() error {
+	for _, name := range module.importModules {
+		if name != "env" && name != "kernel" {
+			return fmt.Errorf("unsupported Kandelo Wasm import module %q", name)
+		}
+	}
+	return nil
+}
diff --git a/src/cmd/cgo/wasm_test.go b/src/cmd/cgo/wasm_test.go
index 76e71e20cbb1d1ca5b858cf79980cec49e2996f5..0083312d91f455e822cff7de7d776f9749cf0122 100644
--- a/src/cmd/cgo/wasm_test.go
+++ b/src/cmd/cgo/wasm_test.go
@@ -118,3 +118,41 @@ func TestReadWasmDebugModuleWithImportedGlobal(t *testing.T) {
 		t.Fatalf("memory = %v", contents)
 	}
 }
+
+func TestWasmStaticImportNamespaces(t *testing.T) {
+	for _, name := range []string{"env", "kernel", "native-library"} {
+		payload := []byte{1}
+		payload = binary.AppendUvarint(payload, uint64(len(name)))
+		payload = append(payload, name...)
+		payload = append(payload, 1, 'f', 0, 0) // one function import, type index zero
+		module := new(wasmDebugModule)
+		if err := module.readImports(payload); err != nil {
+			t.Fatal(err)
+		}
+		err := module.checkStaticImports()
+		if name == "native-library" {
+			if err == nil {
+				t.Fatal("unsupported dynamic library import was accepted")
+			}
+		} else if err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestWasmPassiveDataIsNotAddressable(t *testing.T) {
+	module := &wasmDebugModule{globalExports: map[string]uint64{"value": 32}}
+	// One passive segment; its contents must not be assigned an invented address.
+	if err := module.readData([]byte{1, 1, 4, 1, 2, 3, 4}); err != nil {
+		t.Fatal(err)
+	}
+	if len(module.dataSegments) != 0 {
+		t.Fatal("passive segment became active")
+	}
+	if _, err := module.memory("value", 4); err == nil {
+		t.Fatal("passive constants were treated as initialized memory")
+	}
+	if err := module.readData([]byte{1, 1, 4, 1}); err == nil {
+		t.Fatal("truncated passive bytes were accepted")
+	}
+}
