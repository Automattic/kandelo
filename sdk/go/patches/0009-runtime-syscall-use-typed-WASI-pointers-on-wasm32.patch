From 6e4c07ab3e3bef1a9c2e1e7c3a069ed8f8b2955e Mon Sep 17 00:00:00 2001
From: Zxilly <zhouxinyu1001@gmail.com>
Date: Mon, 7 Sep 2026 20:00:36 +0800
Subject: [PATCH 09/22] runtime, syscall: use typed WASI pointers on wasm32

Use *byte in WASI I/O vectors and argument and environment pointer
arrays on wasm32 so the GC can track the referenced buffers. Continue
using uint32 on wasm, whose Go pointers are wider than WASI pointers.

Updates #63131

Change-Id: Iaf2e259844ade8b1bf20b38c757d556c1577892a

diff --git a/src/runtime/os_wasip1.go b/src/runtime/os_wasip1.go
index 34f1dd6da0d026abc499bd71de62e93765956a3f..5c7d1d548383d1cbc3fcd1aeea012d763d147ecc 100644
--- a/src/runtime/os_wasip1.go
+++ b/src/runtime/os_wasip1.go
@@ -11,15 +11,6 @@ import (
 	"unsafe"
 )
 
-// GOARCH=wasm currently has 64 bits pointers, but the WebAssembly host expects
-// pointers to be 32 bits so we use this type alias to represent pointers in
-// structs and arrays passed as arguments to WASI functions.
-//
-// Note that the use of an integer type prevents the compiler from tracking
-// pointers passed to WASI functions, so we must use KeepAlive to explicitly
-// retain the objects that could otherwise be reclaimed by the GC.
-type uintptr32 = uint32
-
 // https://github.com/WebAssembly/WASI/blob/a2b96e81c0586125cc4dc79a5be0b78d9a059925/legacy/preview1/docs.md#-size-u32
 type size = uint32
 
@@ -42,7 +33,8 @@ const (
 
 // https://github.com/WebAssembly/WASI/blob/a2b96e81c0586125cc4dc79a5be0b78d9a059925/legacy/preview1/docs.md#-iovec-record
 type iovec struct {
-	buf    uintptr32
+	_      structs.HostLayout
+	buf    wasiPtr
 	bufLen size
 }
 
@@ -51,7 +43,7 @@ func exit(code int32)
 
 //go:wasmimport wasi_snapshot_preview1 args_get
 //go:noescape
-func args_get(argv *uintptr32, argvBuf *byte) errno
+func args_get(argv *wasiPtr, argvBuf *byte) errno
 
 //go:wasmimport wasi_snapshot_preview1 args_sizes_get
 //go:noescape
@@ -63,7 +55,7 @@ func clock_time_get(clock_id clockid, precision timestamp, time *timestamp) errn
 
 //go:wasmimport wasi_snapshot_preview1 environ_get
 //go:noescape
-func environ_get(environ *uintptr32, environBuf *byte) errno
+func environ_get(environ *wasiPtr, environBuf *byte) errno
 
 //go:wasmimport wasi_snapshot_preview1 environ_sizes_get
 //go:noescape
@@ -71,7 +63,7 @@ func environ_sizes_get(environCount, environBufLen *size) errno
 
 //go:wasmimport wasi_snapshot_preview1 fd_write
 //go:noescape
-func fd_write(fd int32, iovs unsafe.Pointer, iovsLen size, nwritten *size) errno
+func fd_write(fd int32, iovs *iovec, iovsLen size, nwritten *size) errno
 
 //go:wasmimport wasi_snapshot_preview1 random_get
 //go:noescape
@@ -160,11 +152,11 @@ func poll_oneoff(in *subscription, out *event, nsubscriptions size, nevents *siz
 
 func write1(fd uintptr, p unsafe.Pointer, n int32) int32 {
 	iov := iovec{
-		buf:    uintptr32(uintptr(p)),
+		buf:    makeWASIPtr((*byte)(p)),
 		bufLen: size(n),
 	}
 	var nwritten size
-	if fd_write(int32(fd), unsafe.Pointer(&iov), 1, &nwritten) != 0 {
+	if fd_write(int32(fd), &iov, 1, &nwritten) != 0 {
 		throw("fd_write failed")
 	}
 	return int32(nwritten)
@@ -205,14 +197,14 @@ func goenvs() {
 
 	argslice = make([]string, argc)
 	if argc > 0 {
-		argv := make([]uintptr32, argc)
+		argv := make([]wasiPtr, argc)
 		argvBuf := make([]byte, argvBufLen)
 		if args_get(&argv[0], &argvBuf[0]) != 0 {
 			throw("args_get failed")
 		}
 
 		for i := range argslice {
-			start := argv[i] - uintptr32(uintptr(unsafe.Pointer(&argvBuf[0])))
+			start := wasiPtrOffset(argv[i], &argvBuf[0])
 			end := start
 			for argvBuf[end] != 0 {
 				end++
@@ -230,14 +222,14 @@ func goenvs() {
 
 	envs = make([]string, environCount)
 	if environCount > 0 {
-		environ := make([]uintptr32, environCount)
+		environ := make([]wasiPtr, environCount)
 		environBuf := make([]byte, environBufLen)
 		if environ_get(&environ[0], &environBuf[0]) != 0 {
 			throw("environ_get failed")
 		}
 
 		for i := range envs {
-			start := environ[i] - uintptr32(uintptr(unsafe.Pointer(&environBuf[0])))
+			start := wasiPtrOffset(environ[i], &environBuf[0])
 			end := start
 			for environBuf[end] != 0 {
 				end++
diff --git a/src/runtime/os_wasip1_wasm.go b/src/runtime/os_wasip1_wasm.go
new file mode 100644
index 0000000000000000000000000000000000000000..aeacff936dd21dc5164a0257579901b3e2b416e7
--- /dev/null
+++ b/src/runtime/os_wasip1_wasm.go
@@ -0,0 +1,19 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import "unsafe"
+
+// wasiPtr represents a 32-bit host pointer on wasm, where Go pointers are 64 bits.
+type wasiPtr = uint32
+
+//go:nosplit
+func makeWASIPtr(p *byte) wasiPtr {
+	return uint32(uintptr(unsafe.Pointer(p)))
+}
+
+func wasiPtrOffset(p wasiPtr, base *byte) uint32 {
+	return p - uint32(uintptr(unsafe.Pointer(base)))
+}
diff --git a/src/runtime/os_wasip1_wasm32.go b/src/runtime/os_wasip1_wasm32.go
new file mode 100644
index 0000000000000000000000000000000000000000..778e9b36ca968fffa9d1df2086acaa6c0ec8693a
--- /dev/null
+++ b/src/runtime/os_wasip1_wasm32.go
@@ -0,0 +1,19 @@
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package runtime
+
+import "unsafe"
+
+// wasiPtr is a Go pointer so the GC can track buffers referenced by WASI data.
+type wasiPtr = *byte
+
+//go:nosplit
+func makeWASIPtr(p *byte) wasiPtr {
+	return p
+}
+
+func wasiPtrOffset(p wasiPtr, base *byte) uint32 {
+	return uint32(uintptr(unsafe.Pointer(p)) - uintptr(unsafe.Pointer(base)))
+}
diff --git a/src/syscall/fs_wasip1.go b/src/syscall/fs_wasip1.go
index 2be32b2413db634af369da6ead2e7d90dd5b71ec..2835f0e43446367b4f3c5004fa265ea4aeeb964d 100644
--- a/src/syscall/fs_wasip1.go
+++ b/src/syscall/fs_wasip1.go
@@ -27,7 +27,6 @@ func init() {
 	SetNonblock(2, true)
 }
 
-type uintptr32 = uint32
 type size = uint32
 type fdflags = uint32
 type filesize = uint64
@@ -42,7 +41,7 @@ type fstflags = uint32
 
 type iovec struct {
 	_      structs.HostLayout
-	buf    uintptr32
+	buf    wasiPtr
 	bufLen size
 }
 
@@ -892,7 +891,7 @@ func Fsync(fd int) error {
 
 func makeIOVec(b []byte) *iovec {
 	return &iovec{
-		buf:    uintptr32(uintptr(unsafe.Pointer(unsafe.SliceData(b)))),
+		buf:    makeWASIPtr(unsafe.SliceData(b)),
 		bufLen: size(len(b)),
 	}
 }
diff --git a/src/syscall/fs_wasip1_test.go b/src/syscall/fs_wasip1_test.go
index 10fb56e5b1a6a09f818a1affa071dee9bd9a65f0..3cb61f501607b4be3c63db33d7128b0072b6f773 100644
--- a/src/syscall/fs_wasip1_test.go
+++ b/src/syscall/fs_wasip1_test.go
@@ -7,6 +7,7 @@
 package syscall_test
 
 import (
+	"strconv"
 	"syscall"
 	"testing"
 	"unsafe"
@@ -77,9 +78,13 @@ func BenchmarkJoinPath(b *testing.B) {
 }
 
 func TestRandomGetOverflow(t *testing.T) {
+	if strconv.IntSize == 32 {
+		t.Skip("test needs a 64-bit int to express a length larger than 4GiB")
+	}
 	// Use unsafe.Slice to avoid actually allocating ~4GB.
 	var dummy byte
-	b := unsafe.Slice(&dummy, int(1<<32))
+	length := int64(1) << 32
+	b := unsafe.Slice(&dummy, int(length))
 	if err := syscall.RandomGet(b); err != syscall.EINVAL {
 		t.Errorf("syscall.RandomGet succeeds given a slice that is larger than what random_get supports, want %v", syscall.EINVAL)
 	}
