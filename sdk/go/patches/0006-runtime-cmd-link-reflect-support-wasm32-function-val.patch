@@ -0,0 +1,25 @@
+// run -gcflags=all=-d=checkptr=1
+
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package main
+
+import "reflect"
+
+type T struct{}
+
+func (T) M() int { return 42 }
+
+func main() {
+	v := reflect.ValueOf(T{})
+	// Both paths construct a function value from a method's text offset.
+	// On wasm32, its code word is an integer function handle, not a pointer.
+	if got := v.Type().Method(0).Func.Call([]reflect.Value{v})[0].Int(); got != 42 {
+		panic("incorrect Type.Method result")
+	}
+	if got := v.Method(0).Call(nil)[0].Int(); got != 42 {
+		panic("incorrect Value.Method result")
+	}
+}
diff --git a/test/wasmfuncpc.go b/test/wasmfuncpc.go
new file mode 100644
index 0000000000000000000000000000000000000000..8ec4982d856051373675314141013ad5416220e8
--- /dev/null
+++ b/test/wasmfuncpc.go
@@ -0,0 +1,48 @@
+// run
+
+// Copyright 2026 The Go Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build wasm || wasm32
+
+package main
+
+import (
+	"reflect"
+	"runtime"
+	"unsafe"
+)
+
+// A runtime method has a low logical PC. Its code pointer must remain valid
+// when stack growth adjusts pointers in the caller's frame.
+func mapError() (err any) {
+	defer func() { err = recover() }()
+	var m map[any]int
+	_ = m[[]int{}]
+	return
+}
+
+//go:noinline
+func grow(n int, p unsafe.Pointer) {
+	var pad [512]byte
+	pad[n%len(pad)] = byte(n)
+	if n > 0 {
+		grow(n-1, p)
+	}
+	runtime.KeepAlive(p)
+	runtime.KeepAlive(&pad)
+}
+
+func main() {
+	m, ok := reflect.TypeOf(mapError()).MethodByName("Error")
+	if !ok {
+		panic("missing Error method")
+	}
+	p := m.Func.UnsafePointer()
+	if runtime.FuncForPC(uintptr(p)) == nil {
+		panic("missing function for method PC")
+	}
+	grow(1000, p)
+	runtime.KeepAlive(p)
+}
