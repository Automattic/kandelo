(module
  (type $legacy (func (param @PARAMETERS@) (result i32)))
  (import "env" "__wasm_dlopen" (func $legacy (type $legacy)))
  (table $functions (export "__indirect_function_table") @TABLE_WIDTH@ 4 funcref)
  (elem (@TABLE_POINTER@.const 1) func $first $second $legacy)
  (global (export "legacy_reference") (ref $legacy) (ref.func $legacy))
  (global $initialized (export "initialized") (mut i32) (i32.const 0))
  (global $checkpoints (export "checkpoints") (mut i32) (i32.const 0))
  (func $first global.get $initialized i32.const 1 i32.add global.set $initialized)
  (func $second global.get $initialized i32.const 10 i32.add global.set $initialized)
  (func (export "__wasm_posix_signal_checkpoint")
    global.get $checkpoints i32.const 1 i32.add global.set $checkpoints)
  (func (export "open") (param @PARAMETERS@) (result i32) @ARGUMENTS@ call $legacy)
  (export "legacy_alias" (func $legacy)))
