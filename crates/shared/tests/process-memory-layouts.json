{
  "$comment": [
    "Process memory layouts, with every expected value derived BY HAND from the",
    "rule in `wasm_posix_shared::process_memory::compute_layout`'s doc comment —",
    "never from the function itself. A corpus generated by running the code under",
    "test agrees with that code by construction and can only detect a later",
    "change, not a present mistake.",
    "",
    "`crates/shared/tests/process_memory_layout.rs` checks the Rust host",
    "against this file. The TypeScript half",
    "(`host/test/process-memory-layout.test.ts`, reaching the same function",
    "through a `wa_process_memory_layout` export) is written and held on",
    "`brandonpayton/lane-l-typescript-layout-held` — see 'the projection",
    "deadlock' in lane L of docs/plans/2026-09-11-MASTER-PLAN.md. Checking",
    "both against one file is what would make 'one layout' a fact a test can",
    "fail on rather than an intention.",
    "",
    "Working constants: page 65536; DEFAULT_INITIAL_PAGES 17;",
    "FALLBACK_BRK_BASE 16777216 (page 256); MAIN_CHANNEL_PRIMARY_PAGE 1;",
    "CHANNEL_PAGES 2."
  ],
  "cases": [
    {
      "name": "no heap base falls back to the fixed control base",
      "why": "control_base_page 256, channel 257, control_end 259",
      "request": {
        "maximumPages": 16384,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": null,
        "threadSlotCount": 1024
      },
      "layout": {
        "initialPages": 259,
        "maximumPages": 16384,
        "controlBase": 16777216,
        "controlEnd": 16973824,
        "channelOffset": 16842752,
        "channelPage": 257,
        "brkBase": 16973824,
        "mmapBase": 16973824,
        "brkLimit": 1073741824,
        "maxAddr": 1073741824,
        "threadSlotCount": 1024
      }
    },
    {
      "name": "a heap base BELOW the fallback still wins",
      "why": "2 MiB is page 32, so channel 33 and control_end 35. This is the case the two hosts disagreed about: crates/host-native ignored __heap_base and answered 256/257/259 here.",
      "request": {
        "maximumPages": 16384,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": 2097152,
        "threadSlotCount": 1024
      },
      "layout": {
        "initialPages": 35,
        "maximumPages": 16384,
        "controlBase": 2097152,
        "controlEnd": 2293760,
        "channelOffset": 2162688,
        "channelPage": 33,
        "brkBase": 2293760,
        "mmapBase": 2293760,
        "brkLimit": 1073741824,
        "maxAddr": 1073741824,
        "threadSlotCount": 1024
      }
    },
    {
      "name": "a heap base ABOVE the fallback keeps control memory off the program's data",
      "why": "32 MiB is page 512. The old native-host rule placed control memory at page 256 — INSIDE this program's own static data — which is the defect this corpus pins.",
      "request": {
        "maximumPages": 16384,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": 33554432,
        "threadSlotCount": 1024
      },
      "layout": {
        "initialPages": 515,
        "maximumPages": 16384,
        "controlBase": 33554432,
        "controlEnd": 33751040,
        "channelOffset": 33619968,
        "channelPage": 513,
        "brkBase": 33751040,
        "mmapBase": 33751040,
        "brkLimit": 1073741824,
        "maxAddr": 1073741824,
        "threadSlotCount": 1024
      }
    },
    {
      "name": "an unaligned heap base rounds UP to a page",
      "why": "2097153 is one byte into page 32, so control memory starts at page 33.",
      "request": {
        "maximumPages": 16384,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": 2097153,
        "threadSlotCount": 64
      },
      "layout": {
        "initialPages": 36,
        "maximumPages": 16384,
        "controlBase": 2162688,
        "controlEnd": 2359296,
        "channelOffset": 2228224,
        "channelPage": 34,
        "brkBase": 2359296,
        "mmapBase": 2359296,
        "brkLimit": 1073741824,
        "maxAddr": 1073741824,
        "threadSlotCount": 64
      }
    },
    {
      "name": "an imported memory minimum above the fallback raises the floor",
      "why": "600 pages is 39321600 bytes, past the 16 MiB fallback, so the floor comes from the import.",
      "request": {
        "maximumPages": 16384,
        "importedMinimumPages": 600,
        "requestedMinimumPages": 0,
        "heapBase": null,
        "threadSlotCount": 1024
      },
      "layout": {
        "initialPages": 603,
        "maximumPages": 16384,
        "controlBase": 39321600,
        "controlEnd": 39518208,
        "channelOffset": 39387136,
        "channelPage": 601,
        "brkBase": 39518208,
        "mmapBase": 39518208,
        "brkLimit": 1073741824,
        "maxAddr": 1073741824,
        "threadSlotCount": 1024
      }
    },
    {
      "name": "a caller's own minimum raises the floor too",
      "why": "1000 pages is 65536000 bytes; control memory follows at pages 1001..1002.",
      "request": {
        "maximumPages": 16384,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 1000,
        "heapBase": null,
        "threadSlotCount": 0
      },
      "layout": {
        "initialPages": 1003,
        "maximumPages": 16384,
        "controlBase": 65536000,
        "controlEnd": 65732608,
        "channelOffset": 65601536,
        "channelPage": 1001,
        "brkBase": 65732608,
        "mmapBase": 65732608,
        "brkLimit": 1073741824,
        "maxAddr": 1073741824,
        "threadSlotCount": 0
      }
    },
    {
      "name": "a smaller ceiling is honoured everywhere it appears",
      "why": "maximumPages 512 moves brkLimit and maxAddr, and nothing else.",
      "request": {
        "maximumPages": 512,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": null,
        "threadSlotCount": 1
      },
      "layout": {
        "initialPages": 259,
        "maximumPages": 512,
        "controlBase": 16777216,
        "controlEnd": 16973824,
        "channelOffset": 16842752,
        "channelPage": 257,
        "brkBase": 16973824,
        "mmapBase": 16973824,
        "brkLimit": 33554432,
        "maxAddr": 33554432,
        "threadSlotCount": 1
      }
    }
  ],
  "refusals": [
    {
      "name": "a ceiling that cannot hold the syscall channel",
      "request": {
        "maximumPages": 2,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": null,
        "threadSlotCount": 1024
      },
      "message": "invalid process maximum pages: 2"
    },
    {
      "name": "control memory alone past the ceiling",
      "why": "The fallback base needs 259 pages and the ceiling is 100.",
      "request": {
        "maximumPages": 100,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": null,
        "threadSlotCount": 1024
      },
      "message": "initial pages 259 exceed process maximum 100"
    },
    {
      "name": "control memory past a ceiling near the top of the page space saturates its report",
      "why": "heapBase is exactly maxAddr, so the ceiling check admits it and control memory's last page lands above u32::MAX. A truncated report would say 'initial pages 2', which reads as a request far smaller than the one being refused.",
      "request": {
        "maximumPages": 4294967295,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": 281474976645120,
        "threadSlotCount": 1024
      },
      "message": "initial pages 4294967295 exceed process maximum 4294967295"
    },
    {
      "name": "a heap base past the ceiling is refused before the page arithmetic",
      "why": "A program may export any __heap_base at all; 2^63 must refuse, not overflow.",
      "request": {
        "maximumPages": 16384,
        "importedMinimumPages": 0,
        "requestedMinimumPages": 0,
        "heapBase": 9223372036854775808,
        "threadSlotCount": 1024
      },
      "message": "initial pages 4294967295 exceed process maximum 16384"
    }
  ]
}
