{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "sourceMap": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "lib": ["ES2024", "ES2024.SharedMemory", "DOM"],
    "types": ["node"]
  },
  "include": ["src"]
}
