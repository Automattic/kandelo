  "implementation": {
    "originalCapture": "SpiderMonkey already had native Error.captureStackTrace. Original primordials preserve that intrinsic; earlier checkpoint absence assumption corrected by original engine source and guest control",
    "owner": "Canonical context state created before original initializers; traced callback/prototype/intrinsics and WeakMap ephemeron captures, runtime-wide recursion guard, no finalizer root cycle",
    "limits": "Original data properties without getter/coercion, including inherited data; Proxy boundary disables without traps. Numeric limits fixed at capture, owned constructor trimming counts retained frames",
    "accessors": "Actual own lazy get/set, successful values including undefined cached, callback exceptions retry, real recursive fallback, cross-realm target lookup",
    "callbacks": "Original creation global-this identity/error/trace and undefined receiver; fatal enhancer callbacks stored and invoked by actual phase dispatcher",
    "admission": "Binding getter requires successful original context initialization; error allocation may still use original terminal context capture state",
    "callSites": "Real source/name/line/column/string from traced SavedFrames; richer fields explicitly missing, no fabricated flags/function/receiver state",
    "unowned": "Original engine capture/formatting policy retained for ordinary shell realms",
    "originalFilenames": "Original names captured from active engine ScriptSources and traced separately from SavedFrame sourceURL/display names; unavailable historical filenames raise an implementation error"
  },
