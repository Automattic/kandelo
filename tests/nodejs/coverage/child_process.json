    "path": "doc/api/child_process.md",
    "sha256": "5f763352d3a7f6393f06f2055f1a11402105d97ccfb5c454b79a84d1d909964c"
  },
  "surfaceReview": "Three synchronous function headings reviewed. This is not the full child_process surface; async functions, classes, events, properties, descriptors, aliases and option combinations still require an audit.",
  "fullCompatibility": false,
  "controls": {
    "path": "host/test/fixtures/node-sync-processes.ts",
    "sha256": "439919095bada8614809d63dff6b99f243f3f1e401782361078d34cee51b29f1",
    "sourceTest": "host/test/node-sync-processes.test.ts",
    "nodeProductTest": "host/test/node-core-compat.test.ts",
    "browserProductTest": "apps/browser-demos/test/node-sync-processes.spec.ts",
    "allHostRunner": "scripts/run-nodejs-sync-process-tests.ts",
    "independentPeer": "host/test/fixtures/node-sync-process-peer.c"
  },
  "upstreamSelection": "tests/nodejs/selections/child-process-sync.json",
  "remainingReview": [
    "Setting uid/gid returns ENOSYS because the spawn seam has no arbitrary credential attributes. This is an implementation gap, not an inherent platform boundary.",
    "Node executable mode still depends on argv[0]; overriding it for the Node executable requires proper entry-point separation. The generic spawn seam preserves the supplied argv0.",
    "Full stdio/input/encoding/shell/URL/byte-path/error matrices, signals and process groups, descriptor/alias/inheritance behavior and the rest of child_process remain incomplete.",
    "Full Node core and broad POSIX/memory/performance suites have not been rerun for this focused work.",
    "Async spawn still coerces detached instead of rejecting nonboolean values; its full validation matrix remains incomplete."
  ],
  "rows": [
    {
      "api": "child_process.spawnSync(command[, args][, options])",
      "status": "partial",
      "review": "Actual POSIX execution, binary pipes, environment/cwd, status/signal, timeout/output limits and cleanup; full option/error matrices and credential changes remain incomplete."
    },
    {
      "api": "child_process.execFileSync(file[, args][, options])",
      "status": "partial",
      "review": "Actual POSIX execution, binary pipes, environment/cwd, status/signal, timeout/output limits and cleanup; full option/error matrices and credential changes remain incomplete."
    },
    {
      "api": "child_process.execSync(command[, options])",
      "status": "partial",
      "review": "Actual POSIX execution, binary pipes, environment/cwd, status/signal, timeout/output limits and cleanup; full option/error matrices and credential changes remain incomplete."
    }
  ],
